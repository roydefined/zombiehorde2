    teleport(102,0,0);
    acs_execute(41,0,1,0,0);
    SetFont("SMALLFONT");
}

script 46 (int status){//White Face set speed
	int i = random(12.0,16.0);
	if(status==0){//normal speed
	   SetActorProperty(100,APROP_Speed,3.0);
	}else if(status==1){//fast speed
		SetActorProperty(100,APROP_Speed,i);
	}
}␀␀