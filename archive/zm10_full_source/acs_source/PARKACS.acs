{
    GiveInventory(Random("StrangeBoxStamina", Random("StrangeBox2Flares", "StrangeBox2Crystal")), 1);
    Terminate;
}*/

Script 373 ENTER CLIENTSIDE
{
Delay(1);
    If(CheckInventory("Humanmaker"))
    {
        TakeInventory("ZombieImmune2", 1);
        GiveInventory("HumanImmune2", 1);
    }
    Else If(CheckInventory("Zombiemaker"))
    {
        TakeInventory("HumanImmune2", 1);
        GiveInventory("ZombieImmune2", 1);
    }
Restart;
}
