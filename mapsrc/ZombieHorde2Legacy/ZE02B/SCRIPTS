bool b_thunder_is_active = TRUE;

/* Level settings */
script "ze02b_open" open
{
    /* Unpassable slopes */
    SetLineBlocking(1, BLOCK_CREATURES);
    SetLineBlocking(2, BLOCK_CREATURES);

    /* Skybox sector */
    Sector_SetFade(21, 160, 0, 0);
    Scroll_Ceiling(21, 8, 8, 0);

    /* Lifts shields */
    TranslucentLine(50, 96, 0);
    Scroll_Texture_Both(50, 0, 0, 0, 200);
    Scroll_Texture_Both(-50, 0, 0, 0, 200);

    /* Thunder */
    while(b_thunder_is_active == TRUE)
    {
        delay(random(2,4)*35);

        AmbientSound("world/thunder1", 100);
        delay(10);
        Light_ChangeToValue(1, 225);
        Light_ChangeToValue(29, 225);
        Light_ChangeToValue(2, 225);
        Light_ChangeToValue(3, 225);
        Light_ChangeToValue(4, 225);
        Light_ChangeToValue(5, 225);
        Light_ChangeToValue(6, 225);
        Light_ChangeToValue(8, 225);
        delay(10);
        Light_fade(1, 160, 70);
        Light_fade(29, 160, 70);
        Light_fade(2, 160, 70);
        Light_fade(3, 160, 70);
        Light_fade(4, 160, 70);
        Light_fade(5, 160, 70);
        Light_fade(6, 160, 70);
        Light_fade(8, 160, 70);


        delay(random(10, 20) * 35);
    }
}


/* RESIST EVENT */
script "ze02b_internal_event_resistelapsed" (raw packetRaw)
{
	Event::ReceiveTimerElapsed((str)packetRaw);
	int index = Event::GetReceiveData(0);
	
	switch(index)
	{
		case 0:
			Floor_LowerByValue(8, 16, 216);
			SetLineBlocking(1, BLOCK_NOTHING);
			break;
		case 1:
			Floor_LowerByValue(5, 16, 216);
			SetLineBlocking(2, BLOCK_NOTHING);
			b_thunder_is_active = FALSE;

			// ZH2: Remove the fire that blocks zombies.
			Thing_Remove(30);
			break;
	}
}

/* Bottom of crater teleporter */
Script 2 (int num, int angle)
{
    if(!LineSide())
    {
        Teleport_NoFog(num, 0, 0);
        ThrustThing(angle, 20);

		// Note: This is for online, since the angle is not explicitly changed for some reason.
		SetActorAngle(0, 0.75);
    }
}

/* Third resist */
Script 5 (void)
{
    SetActivator(-1);
	Delay(Resist::StartResistByIndex(2));

    Ceiling_RaiseByValue(35, 64, 104);
    Ceiling_RaiseByValue(36, 64, 104);

    delay(35*5);

    // Close the doors
    //Generic_Ceiling(35, 32, 0, 4, 16); //ZH2 [AQW]
    //Generic_Ceiling(36, 32, 0, 4, 16); //ZH2 [AQW]
	Ceiling_LowerAndCrush(35,32,10,2); //ZH2 [AQW]
	Ceiling_LowerAndCrush(36,32,10,2); //ZH2 [AQW]
	TagWait(35); //ZH2 [AQW]
	TagWait(36); //ZH2 [AQW]
	Ceiling_LowerByValueTimes8(35,16,1); //ZH2 [AQW]
	Ceiling_LowerByValueTimes8(36,16,1); //ZH2 [AQW]

	delay(18); //ZH2 [AQW] Split the delay of 35 into 2.

	//==Start of edit== [AQW]
	//Because there is a gap between the door and the elevator, and if you use crushing ceiling, it will stop the elevators ceiling, making the elevators broken visually (but still works gameplay wise).
	//So because Xsnake already gave a TID to the gap sectors, I suggest this fix: making them crushing ceiling before activating the elevators.
	Ceiling_LowerAndCrush(37,32,50,2);
	Ceiling_LowerAndCrush(38,32,50,2);
	TagWait(37);
	TagWait(38);
	Ceiling_LowerByValueTimes8(37,16,1);
	Ceiling_LowerByValueTimes8(38,16,1);
	//==end of edit==

	delay(17); //ZH2 [AQW]
    // Move the elevators
    Generic_Floor(33, 32, 1760, 0, 16);
    Generic_Ceiling(33, 32, 1760, 0, 16);
    Generic_Floor(34, 32, 1760, 0, 16);
    Generic_Ceiling(34, 32, 1760, 0, 16);

	Tagwait(33);
	Tagwait(34);

    delay(35*5);
    Floor_LowerByValue(40, 21, 120);

    SetFont("SMALLFONT");
    PrintBold(s:"The secondary path has been opened!");
}

/* Final resist */
Script 6 (void)
{
    Floor_LowerByValue(19, 2, 16);
    Floor_LowerByValue(16, 2, 16);
    Ceiling_LowerByValue(16, 2, 16);

    SetFont("CONFONT");
    HudMessageBold(n:0, s:" has ignited the dynamites!\nPrepare for a huge volcanic eruption!!"; HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 3.0, 2.0);

    SetActivator(-1);
    delay(35*3);
	Delay(Resist::StartResistByIndex(3));

    //Generic_Ceiling(14, 2, 64, 5, 16); //ZH2 [AQW]
	Ceiling_LowerAndCrush(14,2,50,2); //ZH2 [AQW]

    TagWait(14);
	Ceiling_LowerByValueTimes8(14,16,1); //ZH2 [AQW]
    Radius_Quake(15, 35*15, 0, 50, 15);

    SetFont("BIGFONT");
    HudMessageBold(s:"\cGWarning : \cKVolcanic Eruption!!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
    delay(35*2);

    AmbientSound("world/volcano1", 127);
    delay(35);

	Game::KillUnsafePlayers();
}

/* Falling into lava */
Script 8 (int teleportid)
{
    if(!Player::GetIsZombie())
    {
        Thing_Damage(0, GetActorProperty(0, APROP_Health)/2, MOD_LAVA);
    }

    Teleport(teleportid);
}

