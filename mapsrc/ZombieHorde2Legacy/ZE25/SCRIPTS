Script WEEGEE_MAIN_SCRIPT (void)
{
	HudMessageBold(s:"KILL THE WEEGEE BEFORE THE HUMANS WILL DIE!!!"; HUDMSG_PLAIN, 0, CR_White, 0.05, 0.85, 0.1);
	AmbientSound("world/weegeespawn", 127);
	Acs_executeAlways(92,0);
	SpawnSpot("ZH2LegacyZE25Weegee",99,98,0);
	Acs_execute(98,0,98,0,0);
	SetThingSpecial(98,Acs_execute,95,0,0,0,0);
	Music_Change("D_WEEGEE",127);
	Delay(35);
	Acs_executealways(WEEGEE_HEALTH_SCRIPT,0,0,0,0);

	SetActivator(-1);

	for(int i = HumansDie; i > 0; i--)
	{
		ResistMessage1(i,"\cjHumans \cfdie in... ");
		Delay(35);
	}

	for(i = 0; i < BCSUtils::MAX_PLAYERS; ++i3)
	{
		int tid = Identity::GetTid(i);
		if (!PlayerInGame(i) || !BCSUtils::ActorIsAlive(tid) || !Player::GetPlayerIsHuman(i))
			continue;

		Thing_Damage(tid, 10000, MOD_UNKNOWN);
	}
}

SCRIPT 98 (int weegeeTID) //Thx kurwa
{
	for(int i = 0; i <= BCSUtils::MAX_PLAYERS; ++i)
	{
		int tid = Identity::GetTid(i);
		if (!PlayerInGame(i) || !BCSUtils::ActorIsAlive(tid))
			continue;

		if(Player::GetPlayerIsHuman(i))
			++humancount;
		else
			++zombiecount;
	}

	if(humancount != 0)
		SetActorProperty(weegeeTID, APROP_Health, 2500 + humancount * 1250);
}

