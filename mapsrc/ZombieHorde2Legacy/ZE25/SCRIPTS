script 14 (void) // airstrike
{
    if(EndReached == 0)
    {
        EndReached++;
        SetActivator(-1);
        for(int i = AirStrike; i > 0; i--)
        {
			ResistMessage1(i,"\cjAirstrike in... ");
			Delay(35);
		}
		Acs_Terminate(15,0);
		Acs_execute(16,0,0,0,0);
		Acs_execute(33,0,0,0,0);
		Ceiling_LowerAndCrush(235, 25, 99999999);
		Tagwait(235);
		for(i = 0; i <= BCSUtils::MAX_PLAYERS; i++)
		{
			if(!Game::GetPlayerIsSafe(i))
				Thing_Damage(Identity::GetTid(i), 10000, 20);
		}
		AmbientSound("world/nuke1",999);
		Fadeto (255, 25, 25, 1.0, 0);
		delay(105);
		Fadeto (0, 0, 0, 0, 6.0);

		// Opens the box
		Box++;
    }
}


