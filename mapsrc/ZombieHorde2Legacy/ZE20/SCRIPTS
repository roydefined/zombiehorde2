function void ResistMessageNew3(int time, int color)
{
	SetFont("BIGFONT");
	if(time == 1) HudMessageBold(s:"Resist: \cd", d:time; HUDMSG_FADEOUT, 422, color, 0.5, 0.1, 0, 1.0);
	else if(time < 5) HudMessageBold(s:"Resist: \cd", d:time; HUDMSG_PLAIN, 422, color, 0.5, 0.1, 0);
	else if(time < 10) HudMessageBold(s:"Resist: \ck", d:time; HUDMSG_PLAIN, 422, color, 0.5, 0.1, 0);
	else if(time < 15) HudMessageBold(s:"Resist: \ci", d:time; HUDMSG_PLAIN, 422, color, 0.5, 0.1, 0);
	else HudMessageBold(s:"Resist: \cg", d:time; HUDMSG_PLAIN, 422, color, 0.5, 0.1, 0);
}

function void SpawnComet(int num)
{
	SpawnSpot(cometname[num], 150 + num);
}

