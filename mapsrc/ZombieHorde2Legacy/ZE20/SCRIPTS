// Added in ZH2. Triggered at the lava pool. Instead of instantly killing humans/zombies, hurt and teleport them instead.
script "Lava_Teleport"
{
    if(Player::GetIsHuman())
        Thing_Damage2(0, 40, "Lava");
    else
        Thing_Damage2(0, 150, "Lava");

	Teleport(22, 0, true);
}

// TODO: Just use an array to track count instead of a random item like Cells.
script 4 (void)	// Generator script - first resist
{
	if(GetActorZ(0) > -40.0)
	{
		SetFont("CONFONT");
		j = CheckInventory("Cell");
		switch(j)
		{
			case 0:
				HudMessage(s:"No cheating!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
				break;

			case 1:
				HudMessage(s:"Hey, stop it!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
				break;

			case 2:
				HudMessage(s:"This is last warning!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
				break;

			default:
				HudMessage(s:"As you wish ..."; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
				DamageThing(0, 0);
				break;
		}
		GiveInventory("Cell", 1);
		delay(70);
		terminate;
	}

	SetActivator(-1);
	SetLineSpecial(10, 0, 0, 0, 0);
	SetLineTexture(10, SIDE_FRONT, TEXTURE_BOTTOM, "SW2GRAY");
	SetFont("BIGFONT");
	HudMessageBold(s:"Shutting down Power generator"; HUDMSG_PLAIN, 421, CR_BLUE, 0.5, 0.02, 0);
	for(j = 25; j > 0; j--)
	{
		if(!State) {
			ResistMessageNew3(j, CR_BLUE);
			if(j == 15) SpawnComet(random(0, 3));
		}
		Delay(35);
	}
	Door_Open(17, 16, 0);
	ChangeFloor(24, "W_140");
	ChangeFloor(25, "CRATELIT");
	Floor_RaiseByValue(24, 65535, 64);
	Floor_RaiseByValue(25, 65535, 32);
	Thing_Remove(7);
	if(State) terminate;
	Thing_Activate(201); // power
	Thing_Deactivate(202); // dynamite
		// Added ----------------------------------------------------------
		TranslucentLine(101, 0, 0);
		SetLineBlocking(101, BLOCK_NOTHING);
		Thing_Deactivate(37);
		// ----------------------------------------------------------------
	SetFont("BIGFONT");
	HudMessageBold(s:"Power offline"; HUDMSG_FADEOUT, 421, CR_DARKGRAY, 0.5, 0.02, 3.0, 1.0);
	State = 1;
}

