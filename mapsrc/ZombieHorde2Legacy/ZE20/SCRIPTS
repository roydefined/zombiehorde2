script 7 (void)
{
	if(State > 1) terminate;
	if(!CheckInventory("QuestItem1")) terminate;
	SetActivator(-1);
	Thing_Activate(201); // power
	Thing_Activate(202); // dynamite
	Thing_Deactivate(203); // explosion
	State = 2;
	SetFont("BIGFONT");
	HudMessageBold(s:"Dynamite set, prepare for explosion."; HUDMSG_FADEOUT, 421, CR_RED, 0.5, 0.02, 10.0, 1.0);
	SpawnSpot("Dynamite", 8, 7);
	SpawnComet(random(0, 3));
	for(i = 10; i > 0; i--)
	{
		ResistMessageNew3(i, CR_RED);
		Delay(35);
	}
	Thing_Activate(203); // explosion
	Floor_MoveToValue(1, 65535, 64, 1);
	Floor_MoveToValue(19, 65535, 64, 1);
	TagWait(1);
	Spawn("ZH2LegacyZE20Explosion", GetActorX(8), GetActorY(8), 88.0);
	Thing_Remove(7);
	Floor_MoveToValue(18, 65535, 48, 0);
	Floor_MoveToValue(27, 65535, 48, 0);
	Floor_MoveToValue(20, 65535, 48, 0);
	Floor_MoveToValue(26, 65535, 80, 0);
	ChangeFloor(1, "TRANS");
	ChangeFloor(19, "TRANS");
	State = 3;
	Setmusic("D_SLAND");
	Delay(70);
	SetFont("BIGFONT");
	HudMessageBold(s:"Cataclysm is coming!"; HUDMSG_PLAIN, 421, CR_RED, 0.5, 0.02, 0);
	SetFont("CONFONT");
	HudMessageBold(s:"Hide in \ctmagic\c- protected building before it comes!"; HUDMSG_FADEOUT, 0, CR_GREEN, 0.5, 0.04, 3.0, 1.0);
	Thing_Deactivate(204); // underground
	SpawnComet(random(0, 3));
	Delay(100);
	SetFont("BIGFONT");
	//ACS_Execute(57, 0, 0, 0, 0);
	HudMessageBold(s:"Cataclysm is coming!"; HUDMSG_PLAIN, 421, CR_RED, 0.5, 0.02, 0);
	for(i = 55; i > 0; i--)
	{
		ResistMessageNew3(i, CR_YELLOW);
		if(i == 45 || i == 30 || i == 15) SpawnComet(random(0, 3));
		if(i < 12 && i > 5) SpawnComet(random(0, 3));
		Delay(35);
	}
	HudMessageBold(s:"Cataclysm is here!"; HUDMSG_FADEOUT, 421, CR_RED, 0.5, 0.02, 0.5, 0.5);
	Delay(35);
	AmbientSound("world/nuke1", 127);
	Game::KillUnsafePlayers();
}

