// water trap
script 51 (void)
{
	if(PlayerNumber() == -1) terminate;
	Thing_Remove(13);
	delay(16);
	SetFont("CONFONT");
	HudMessage(s:"Seems like you have managed to trap yourself in my map."; HUDMSG_FADEOUT, 0, CR_GREEN, 0.5, 0.5, 2.0, 1.0);
	SpawnComet(random(0, 3));
	delay(80);
	if(Player::GetIsZombie() || CheckInventory("HandGrenadeAmmo")) {
		SetFont("CONFONT");
		HudMessage(s:"Well, this could help."; HUDMSG_FADEOUT, 0, CR_GREEN, 0.5, 0.5, 2.0, 1.0);
		Floor_RaiseByValue(23, 4, 64);
	} else {
		SpawnComet(random(0, 3));
		SetFont("CONFONT");
		HudMessage(s:"My bad, here, take this grenade and flare."; HUDMSG_FADEOUT, 0, CR_GREEN, 0.5, 0.5, 2.0, 1.0);
		GiveInventory("HandGrenadeAmmo", 1);
		GiveInventory("Flare", 1);
		delay(35);
		Floor_RaiseByValue(23, 16, 64);
	}
}

