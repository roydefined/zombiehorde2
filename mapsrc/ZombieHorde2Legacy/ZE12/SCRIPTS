/* RESIST EVENT */
script "ze12_internal_event_resistelapsed" (int index)
{
	switch(index)
	{
		case 0:
			floor_LowerByValue(36, 32, 264);
			floor_raisebyvalue(8,16,408);
			floor_raisebyvalue(9,16,536);
			delay(270);
			SetLineTexture(3, SIDE_FRONT, TEXTURE_MIDDLE, "LGTBEAM2");
			SetLineTexture(3, SIDE_BACK, TEXTURE_MIDDLE, "LGTBEAM2");
			AmbientSound("world/beacon1",127);
			break;
		case 1:
			floor_LowerByValue(33, 16, 112);
			break;
		case 2:
			// TODO: Support explosion
			//Spawn("Explosion", GetActorX(29), GetActorY(29), GetActorZ(29));
			AmbientSound("world/reveal1",127);
			floor_lowertonearest(33,16);
			floor_lowerinstant(28,0,2048);
			ceiling_lowerinstant(28,0,2048);
			break;
	}
}

