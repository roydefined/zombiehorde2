script 19 (void) //MO MONEY, MO PROBLEMS!!!
{
    if (Player::GetIsHuman())
    {
        if(CheckInventory(CURRENCY_CASH_NAME) < 50)
        {
            print(s:"You got a gold coin!");
            activatorsound("item/cash",128);
            giveInventory(CURRENCY_CASH_NAME, 1);
        }

        else if(CheckInventory(CURRENCY_CASH_NAME) ==50)
        {
            print(s:"You can't carry anymore.");
        }
    }

    else if(Player::GetIsZombie())
    {
        print(s:"Silly Zombie. You don't need gold -_-");
    }

}

script 20 (void) //bridge
{
    PrintBold(n:0, s:"\c- has raised the bridges! They will lower in \ca10 \c-seconds");
    SetActivator(-1);
    floor_raisebyvalue(25,8,256);
    ceiling_raisebyvalue(25,8,256);
    tagwait(25);
    delay(35*3);
    PrintBold(s:"\c- Bridges lowering!");
    floor_lowerbyvalue(25,8,256);
    ceiling_lowerbyvalue(25,8,256);
}