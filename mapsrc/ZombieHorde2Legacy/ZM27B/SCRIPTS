#define SOFTWARE_PLAYER 0

function int GetPlayerRender(void) {return GetCVar ("vid_renderer");}

Script 1 OPEN
{
    acs_execute(3, 0, 0, 0, 0);
}

script 2 OPEN CLIENTSIDE
{
    Thing_Deactivate(7);
    Thing_Deactivate(8);
    Thing_Deactivate(9);
    Thing_Deactivate(10);
    Thing_Deactivate(11);
}

// software detection
script 3 (int x) clientside
{
    if(getplayerrender() == SOFTWARE_PLAYER)
    {
        if (x == false)
        {
            SETFONT("CONFONT");
            HudMessagebold(s:"Welcome to Minecraft.\n\It appears you are playing in Software mode.\n\As you can see, the map doesnt look very good, because the doom palette doesnt support it too well.\n\For optimal gameplay, please switch to OpenGL the next time you will play this map."; HUDMSG_FADEINOUT, 0, CR_Gray, 0.2, 0.2, 15.0);
        }
    }
}

// redstone blocks
/*NOTE: multiple scripts are used to make it possible for multiple
blocks to be activated.*/

script 4 (void) CLIENTSIDE
{
    Thing_Activate(7);
    delay(random(350, 700));
    Thing_DeActivate(7);
