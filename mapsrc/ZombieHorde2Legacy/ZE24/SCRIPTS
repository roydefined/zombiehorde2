script 4 (void)
{
	if(GetActorZ(0) > 216.0) {
		SetFont("CONFONT");
		j = CheckInventory("Cell");
		switch(j) {
			case 0:
				HudMessageBold(s:"No cheating!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
			break;
			case 1:
				HudMessageBold(s:"Hey, stop it!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
			break;
			case 2:
				HudMessageBold(s:"This is last warning!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
			break;
			default:
				HudMessageBold(s:"As you wish ..."; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
				DamageThing(0, 0);
			break;
		}
		GiveInventory("Cell", 1);
		delay(70);
		terminate;
	}
	SetActivator(-1);
	SetLineSpecial(10, 0, 0, 0, 0);
	SetLineTexture(10, SIDE_FRONT, TEXTURE_BOTTOM, "SW2GRAY");
	SetFont("BIGFONT");
	HudMessageBold(s:"Power generator starting"; HUDMSG_PLAIN, 421, CR_BLUE, 0.5, 0.02, 0);
	for(j = 35; j > 0; j--) {
		if(!State) {
			ResistMessageNew3(j, CR_BLUE);
			if(j == 15) SpawnComet(random(0, 3));
		}
		Delay(35);
	}
	Door_Open(17, 16, 0);
	ChangeFloor(24, "W_140");
	ChangeFloor(25, "CRATELIT");
	Floor_RaiseByValue(24, 65535, 64);
	Floor_RaiseByValue(25, 65535, 32);
	Thing_Remove(7);
	if(State) terminate;
	Thing_Activate(201); // power
	Thing_Deactivate(202); // dynamite
	SetFont("BIGFONT");
	HudMessageBold(s:"Power online"; HUDMSG_FADEOUT, 421, CR_DARKGRAY, 0.5, 0.02, 3.0, 1.0);
	State = 1;
	SetFont("CONFONT");
	HudMessageBold(s:"Get \cgdynamyte\c- to blow up path underground."; HUDMSG_FADEOUT, 0, CR_GREEN, 0.5, 0.04, 3.0, 1.0);
}

