script 53 (int check)
{
	if(check && GetActorZ(0) > 0) terminate;
	if(shield) {
		SetFont("CONFONT");
		HudMessage(s:"broken"; HUDMSG_FADEOUT, 0, CR_DARKRED, 0.5, 0.5, 1.0, 1.0);
		terminate;
	}
	if(CheckInventory("zombiemaker")) {
		SetFont("CONFONT");
		HudMessage(s:"dis not brainsssss"; HUDMSG_FADEOUT, 0, CR_DARKRED, 0.5, 0.5, 1.0, 1.0);
		terminate;
	}
	SetFont("BIGFONT");
	HudMessageBold(n:0, s:"\c- activated anti-zombie shield."; HUDMSG_PLAIN, 500, CR_GREEN, 0.5, 0.2, 0);
	for(j = 0; j < 32; j++) {
		if(ZombieIn[j]) {
			SetActivator(600 + j);
			if(checkInventory("zombiemaker")) DamageThing(0, 0);
		}
	}
	SetActivator(-1);
	shield = 1;
	SetLineTexture(11, SIDE_FRONT, TEXTURE_MIDDLE, "LASER1");
	SetLineTexture(11, SIDE_BACK, TEXTURE_MIDDLE, "LASER1");
	delay(35);
	for(j = 25; j > 0; j--) {
		SetFont("CONFONT");
		HudMessageBold(s:"\cdanti-zombie shield\c- collapse in ", d:j; HUDMSG_PLAIN, 500, CR_RED, 0.5, 0.15, 0);
		delay(35);
	}
	SetLineTexture(11, SIDE_FRONT, TEXTURE_MIDDLE, "-");
	SetLineTexture(11, SIDE_BACK, TEXTURE_MIDDLE, "-");
	shield = 2;
	SetFont("CONFONT");
	HudMessageBold(s:"\cdanti-zombie shield\c- collapsed! "; HUDMSG_PLAIN, 500, CR_RED, 0.5, 0.15, 1.0);
}

