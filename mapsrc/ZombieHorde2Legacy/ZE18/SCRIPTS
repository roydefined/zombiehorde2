//This resist message is just like KGSWS' Resist message but the color is reversed.

function void ResistMessage4_TGK (int restime, str whyresist, str color)
{
	SetFont("BIGFONT");
	if (restime < 31){ //30 seconds is the maximum time to resist.
		HudMessageBold(s:"Resist for \cj", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
	}
	if (restime < 20){
		HudMessageBold(s:"Resist for \cq", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
	}
	if (restime < 15){
		HudMessageBold(s:"Resist for \ck", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
	}
	if (restime < 10){
		HudMessageBold(s:"Resist for \ci", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
	}
	if (restime < 5){
		HudMessageBold(s:"Resist for \cg", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
	}
	if (restime < 2){
		HudMessageBold(s:"Resist for \cm", d:restime, s:"\cd second"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
	}
	SetFont("SMALLFONT");
	HudMessageBold(s:whyresist; HUDMSG_FADEOUT, 998, color, 0.5, 0.17, 1.5, 0.5);
}


int i = 25;
int j = 20;
int k = 15;
int l = 30;
int resist1 = 25;
int resist2 = 20;
int resist3 = 15;
int resist_final = 30;

//Opening sequence and level setups
Script 1 OPEN
{
	SetLineBlocking (1, ON);
	SetLineBlocking (2, ON);
	SetLineBlocking (3, ON);
	Scroll_Texture_Both (1, 0, 0, 0, 120);
	Scroll_Texture_Both (-1, 0, 0, 0, 120);
	Scroll_Texture_Both (4, 0, 0, 0, 120);
	Scroll_Texture_Both (-4, 0, 0, 0, 120);
	TranslucentLine (1, 120, 0);
	TranslucentLine (4, 0, 0);
	TranslucentLine (5, 0, 0);
	SetLineTexture (1,SIDE_BACK, TEXTURE_MIDDLE, "LASER1");
	Sector_SetColor (35, 0, 0, 255);
	Delay (35*11);
	Music::SetMusic("D_ZE18", 0);
	Door_Open (1,75);
	Delay (70);
	Door_Open (19, 20);
}

/*First resist*/
Script 2 (void)
{
	SetActivator(-1);
	for(i = resist1; i > 0; i--) {
		ResistMessage4_TGK(i, "Opening back doors...", CR_WHITE);
		Delay(35);
	}
	Door_Open (2,20);
}

Script 3 ENTER
{
    GiveInventory (FLARE_ITEM, 1);
}

Script 4 (void) //Door
{
	PrintBold (n:0, s:" \cjhas closed the door!");
	SetActivator (-1);
	ceiling_LowerAndCrush(7, 115, 5,2); //ZH2 [AQW] hexen crushmode
	TagWait(7);
	Ceiling_LowerByValueTimes8(7,16,1);
}

/*Second resist*/
Script 5 (void)
{
	SetActivator(-1);
	for(j = resist2; j > 0; j--)
{
		ResistMessage4_TGK(j, "Deactivating security systems...", CR_WHITE);
		Delay(35);
	}
	SetLineBlocking (1,OFF);
	SetLineTexture (1,SIDE_BACK,TEXTURE_MIDDLE,"TRANS");
	SetLineTexture (2,SIDE_FRONT, TEXTURE_MIDDLE, "LITEBLU4");
	Door_Open (23, 20);
}

/*Third resist*/

Script 6 (void)
{
	SetActivator(-1);
	for(k = resist3; k > 0; k--)
{
		ResistMessage4_TGK(k, "Lowering wall...", CR_WHITE);
		Delay(35);
	}
	Floor_MoveToValue (10,20,8,0);
	Door_Open (11,20);
	SetLineBlocking (3, OFF);
}

/*Final resist*/
Script 7 (void)
{
	SetActivator(-1);
	SetFont ("CONFONT");
	HudMessageBold(s:"\cgThe building will self-destruct!\nGet into the \cfsafe zone \cgbefore it's too late!"; HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 3.0, 2.0);
	Delay (105);
	for(l = resist_final; l > 0; l--) {
		ResistMessage4_TGK(l, "Get in the \cfsafe zone!", CR_WHITE);
		Delay(35);
	}
	ceiling_LowerAndCrush(14,10,5,2);
	TagWait(14);
	Ceiling_LowerByValueTimes8(14,16,1);

	Delay(35*3);
	SetFont ("BigFont");
	HudMessageBold (s: "\cgWarning: \cjBuilding self-destruction!"; HUDMSG_FADEOUT,999,CR_GREEN,0.5,0.2, 2.0);
	Delay(35*3);
	AmbientSound ("world/nuke1", 127);
	Game::KillUnsafePlayers();
}

Script 8 (void)
{
	Thing_Damage(0, 5, MOD_UNKNOWN);
	Delay(20);
}

/*Forcefield*/
Script 9 (void)
{
    SetLineBlocking (4, BLOCK_EVERYTHING);
    TranslucentLine (4, 120, 0);
}

Script 11 (void) //Lift
{
    Floor_RaiseByValue (24, 50, 120);
    Delay (75);
    Floor_LowerByValue (24, 50, 120);
    tagwait(24);
}

Script 14 (void)
{
    Print (s: "\cjThis door is locked.");
}

