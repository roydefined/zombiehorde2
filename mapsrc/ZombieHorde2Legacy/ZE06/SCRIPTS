Script 3 (void) /* Waiting for the lift */
{
	SetActivator(-1);

	Delay(Resist::StartResistByIndex(0));

	ThingSound(11, "sound/ding1", 127);
	Polyobj_DoorSlide(2, 20, 128, 56, 35*7);
	Polyobj_DoorSlide(12, 20, 128, 56, 35*7);
	Delay(35*2);

	Delay(Resist::StartResistByIndex(1));

	ThingSound(11, "sound/ding1", 127);
	Delay(35*3);
	ACS_Execute(6, 0, 0, 0, 0);
	Floor_LowerByValue(29, 24, 2048);
	Ceiling_LowerByValue(29, 24, 2048);
	Delay(35*3);
	SetFont("BIGFONT");
	HudMessageBold(s:"Get into the second elevator before it leaves!!"; HUDMSG_FADEOUT, 0, CR_GREEN, 0.5, 0.2, 1.5, 1.0);
	Polyobj_DoorSlide(4, 20, 128, 56, 35*5);
	Polyobj_DoorSlide(14, 20, 128, 56, 35*5);
	Delay(35*7);
	Floor_LowerByValue(30, 24, 2048);
	ceiling_LowerByValue(30, 24, 2048);
	ACS_Execute(7, 0, 0, 0, 0);
	Delay(35*2);
	SetFont("BIGFONT");
	HudMessageBold(s:"\cGWarning : \cKNeurotoxins released in 69-70th floors!!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 1.0, 1.0);
	AmbientSound("world/gas1", 100);
	Delay(35*2);
	for(int i = 0; i <= BCSUtils::MAX_PLAYERS; i++)
	{
		if(!LiftReached[i])
		{
			int tid = Identity::GetTid(i);
			Thing_Damage(tid, 10000, MOD_EXIT);
		}
	}
	Delay(35*2);
	TeleportInSector(12, 33, 32, 0, 0);
	TeleportInSector(13, 33, 32, 0, 0);
	TeleportInSector(14, 33, 32, 0, 0);
	TeleportInSector(25, 35, 34, 0, 0);
	TeleportInSector(26, 35, 34, 0, 0);
	TeleportInSector(27, 35, 34, 0, 0);
	TeleportInSector(12, 51, 54, 0, 0);
	TeleportInSector(13, 51, 54, 0, 0);
	TeleportInSector(14, 51, 54, 0, 0);
	TeleportInSector(25, 52, 53, 0, 0);
	TeleportInSector(26, 52, 53, 0, 0);
	TeleportInSector(27, 52, 53, 0, 0);
	ACS_Execute(4, 0, 0, 0, 0);
	Delay(35*2);
	Floor_LowerByValue(21, 16, 960);
	ceiling_LowerByValue(21, 16, 960);
	TagWait(21);
	Floor_Waggle(21, 64, 35, 0, 0);
	Ceiling_Waggle(21, 64, 35, 0, 0);
	Delay(35);
	SetLineBlocking(3, BLOCK_NOTHING);
	TranslucentLine(3, 0, 0);
}

Script 4 (void) /* Displays the floor number*/
{
	SetActivator(-1);
	while(FloorNumber>1)
	{
		FloorNumber--;
		if(FloorNumber==10)
		{
			Acs_Execute(12, 0, 0, 0, 0);
			SetFont("BIGFONT");
			HudMessageBold( d:FloorNumber,s:"th floor..."; HUDMSG_FADEOUT, 999, CR_YELLOW, 0.5, 0.1, 1.0, 1.0);
		}
		else if(FloorNumber==3)
		{
			SetFont("BIGFONT");
			HudMessageBold( d:FloorNumber,s:"rd floor..."; HUDMSG_FADEOUT, 999, CR_YELLOW, 0.5, 0.1, 1.0, 1.0);
		}
		else if(FloorNumber==2)
		{
			SetFont("BIGFONT");
			HudMessageBold( d:FloorNumber,s:"nd floor..."; HUDMSG_FADEOUT, 999, CR_YELLOW, 0.5, 0.1, 1.0, 1.0);
		}
		else if(FloorNumber==1)
		{
			SetFont("BIGFONT");
			HudMessageBold( d:FloorNumber,s:"st floor..."; HUDMSG_FADEOUT, 999, CR_YELLOW, 0.5, 0.1, 1.0, 1.0);
		}
		else
		{
			SetFont("BIGFONT");
			HudMessageBold( d:FloorNumber,s:"th floor..."; HUDMSG_FADEOUT, 999, CR_YELLOW, 0.5, 0.1, 1.0, 1.0);
		}
		Delay(70);
	}

}

