Script 8 (void) // FIRST LIFT
{
	if(LineSide())
	{
		LiftReached[PlayerNumber()] = 1;
		LiftOne[PlayerNumber()] = 1;
	}
	else
	{
		LiftReached[PlayerNumber()] = 0;
		LiftOne[PlayerNumber()] = 0;
	}
}


Script 10 (void) // SECOND LIFT
{
	if(LineSide())
	{
		LiftReached[PlayerNumber()]=1;
		LiftTwo[PlayerNumber()]=1;
	}
	else
	{
		LiftReached[PlayerNumber()]=0;
		LiftTwo[PlayerNumber()]=0;
	}
}

Script 12 (void) /* 2nd teleport */
{
	SetActivator(-1);
	Floor_LowerByValue(41, 20, 1780);
	Ceiling_LowerByValue(41, 20, 1780);
	for(int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
	{
		int tid = Identity::GetTid(i);
		if(Player::GetPlayerIsZombie(i))
		{
			if(LiftOne[i])
				TeleportOther(tid, 200+i, 0);
			else
				TeleportOther(tid, 300+i, 0);
		}
		else
		{
			if(LiftOne[i])
				TeleportOther(tid, 250+i, 0);
			else
				TeleportOther(tid, 350+i, 0);
		}
	}

	TagWait(41);
	Acs_Terminate(5, 0);
	Acs_Terminate(6, 0);
	Acs_Terminate(7, 0);
	Polyobj_Move(8, 20, 128, 56);
	Polyobj_Move(16, 20, 128, 56);
	ThingSound(42, "sound/ding1", 127);
	Delay(35*12);
	Polyobj_Move(6, 20, 128, 56);
	Polyobj_Move(18, 20, 128, 56);
	ThingSound(45, "sound/ding1", 127);
}

