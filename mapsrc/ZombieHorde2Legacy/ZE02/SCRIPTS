Script 13 (void) // Pillars
{
	PrintBold(n:0, s:" has raised the pillars!\n\nThey will automatically lower in 25 seconds.");
	SetActivator(-1);
	Floor_RaiseByValue(23, 16, 128);
	Delay(35*27);
	Floor_LowerByValue(23, 16, 128);
	PrintBold(s:"Pillars lowered!");
}

Script 15 (void) // Locker
{
	// TODO: Add remaining checks?
	//if(!CheckInventory("hasalreadypanicked") || CheckInventory("PanickSpeed") || CheckInventory(WEAPON_SHOTGUN_NAME))
	if(CheckInventory(WEAPON_SHOTGUN_NAME))
		terminate;

	if(Player::GetIsHuman())
	{
		GiveInventory(WEAPON_SHOTGUN_NAME, 1);
		ActivatorSound("weapons/PICKUP", 100);
	}
}

Script 16 (void) // Falling into Lava
{
    if(Player::GetIsHuman())
        Thing_Damage2(0, 200, "Fire");
    else
        Teleport(19);
}