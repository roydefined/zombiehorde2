script 9 (void) //SECRET teleport to jacksgun
{
	if(!tele)
	{
		delay(35);
	}
	else if(!jacks)
	{
		print(s:"someone activated this already...");
		delay(99);
	}
	else if(Player::GetIsZombie())
	{
		print(s:"no zimbas allowed!");
		delay(50);
	}
	else if(CheckInventory(WEAPON_AMMO_JACKSGUN_NAME))
	{
		print(s:"you already have jacksgun!");
		delay(50);
	}
	else
	{
		teleport(61,0,0);
	}
}

script 10 (void) //little secret
{
	if(Player::GetIsZombie())
	{
		print(s:"these are apples, not brains...");
		delay(9);
	}
	else if(checkinventory(KEY_LARAROOM))
	{
		print(s:"don't be greedy!");
		delay(9);
	}
	else
	{
		switch(random(1,5))
		{
			case 1:
				healthing(15);
				print(s:"mmm, tasty!");
				giveinventory(KEY_LARAROOM,1);
				break;

			case 2:
				healthing(25);
				print(s:"damn, that's good!");
				giveinventory(KEY_LARAROOM,1);
				break;

			case 3:
				healthing(10);
				print(s:"not half bad...");
				giveinventory(KEY_LARAROOM,1);
				break;

			case 4:
				healthing(5);
				print(s:"urgh! it's rotten.");
				giveinventory(KEY_LARAROOM,1);
				break;

			case 5:
				healthing(20);
				print(s:"i want some more!");
				giveinventory(KEY_LARAROOM,1);
				break;
		}
	}
}
