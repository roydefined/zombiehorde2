
// Generally used when specifying clientside effects.
OptionValue "ClientLocalityType"
{
	0, "Nobody"
	1, "Only self"
	2, "Everyone"
}

// Configure log severity
OptionValue "LogSeverity"
{
	0, "Unspecified"
	1, "Debug and higher"
	2, "Info and higher"
	3, "Warning and higher"
	4, "Error and higher"
	5, "Log nothing"
}

OptionMenu "ZH2LibraryMenu"
{
	Title "Logging / Tracers / Footsteps / Weather"
	StaticText " "
	StaticText " "
	
	StaticText "Logging", 1
	Option "Overwrite log severity (server)", "sv_zh2_overridelogseverity", "LogSeverity"
	Option "Overwrite log severity (client)", "cl_zh2_overridelogseverity", "LogSeverity"
	Option "Use direct logging offline", "cl_zh2_offlinedirectlogging", "YesNo"
	Option "Use buffered logging", "cl_zh2_usebufferedlogging", "YesNo"
	
	StaticText " "
	
	StaticText "Tracers", 1
	Option "Enable tracers", "sv_zh2_enabletracers", "YesNo"
	Option "Tracer type", "cl_zh2_tracertype", "ClientLocalityType"
	
	StaticText " "
	
	StaticText "Footsteps", 1
	Option "Footstep type type", "cl_zh2_steptype", "ClientLocalityType"
	Slider "Max audible step distance", "cl_zh2_maxstepdistance", 100.0, 8000.0, 100.0
	
	StaticText " "
	
	StaticText "Weather", 1
	Option "Enable weather", "cl_zh2_enableweather", "YesNo"
}