#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Utils
{
    int PlayingBotCount()
    {
        int count = 0;
        for (int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
            if (PlayerInGame(i) && PlayerIsBot(i))
                count++;
        return count;
    }
}