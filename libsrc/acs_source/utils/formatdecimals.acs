#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Utils
{
    str FormatDecimals(fixed value, int decimalCount)
    {
        // Cast back and forth to remove decimals quickly.
        if (decimalCount <= 0)
            return str(BCSUtils::IRound(value));

        int scaleInt = 1;
        for (int i = 0; i < decimalCount; ++i)
            scaleInt *= 10;

        fixed scaled = value * fixed(scaleInt);
        int scaledInt = BCSUtils::IRound(scaled);

        int sign = 1;
        if (scaledInt < 0)
        {
            sign = -1;
            scaledInt = -scaledInt;
        }

        int intPart = scaledInt / scaleInt;
        int fracScaled = scaledInt % scaleInt;

        str fracStr = "";
        for (int i = 0; i < decimalCount; ++i)
        {
            int digit = fracScaled % 10;
            fracScaled /= 10;
            fracStr = str(digit) + fracStr;
        }

        str prefix = "";
        if (sign < 0)
            prefix = "-";

        return prefix + str(intPart) + "." + fracStr;
    }
}
