Lock 100
{
    Message "$PD_ANY"
    RemoteMessage "$PD_ANYOBJ"
    Mapcolor 128 128 255
}

Lock 228
{
    Message "$PD_ANY"
    RemoteMessage "$PD_ANYOBJ"
