const int DOOMTALLTORCHEFFECTHEIGHT = 60;

actor ZH2DoomTallTorchRed : ZH2DoomLightSource replaces RedTorch
{
	Radius 16
	Height 68
	ProjectilePassHeight -16
	
	+SOLID
	
	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
			TTRR AAABBBCCCDDDEEEFFFGGGHHHIIIJJJ 1 bright light("ZH2DoomTallTorchRedLight") A_SpawnItemEx("ZH2DoomTallTorchRedFlare", 0, 0, DOOMTALLTORCHEFFECTHEIGHT)
			loop
		
		Spawn.NoSight:
			TTRR A 1 bright light("ZH2DoomTallTorchRedLight")
			goto Spawn
	}
}

