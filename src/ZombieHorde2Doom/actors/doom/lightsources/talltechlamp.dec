actor ZH2DoomTallTechLamp : ZH2DoomLightSource replaces TechLamp
{
    Radius 16
    Height 80
    ProjectilePassHeight -16

    Tag "Tall tech lamp"

    +SOLID

    states
    {
        Spawn:
            TLA3 AAAABBBBCCCCDDDD 1 NoDelay bright light("ZH2DoomTallTechLampLight") A_SpawnItemEx("ZH2DoomTallTechLampLensFlare", 0, 0, 66)
            loop
    }
}

actor ZH2DoomTallTechLampLensFlare : ZH2DoomLightSourceLensFlare
{
    YScale .6
    XScale 1.4

    States
    {
        Spawn:
            LFLR B 1 NoDelay Bright
            stop
    }
}
