actor ZH2DoomTallTechLamp : ZH2DoomLightSource replaces TechLamp
{
	Radius 16
	Height 80
	ProjectilePassHeight -16
	
	Tag "Tall tech lamp"
	
	+SOLID
	
	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
			TLA3 AAAABBBBCCCCDDDD 1 bright light("ZH2DoomTallTechLampLight") A_SpawnItemEx("ZH2DoomTallTechLampLensFlare", 0, 0, 66)
			loop
		
		Spawn.NoSight:
			TLA3 A 1 bright light("ZH2DoomTallTechLampLight")
			goto Spawn
	}
}

actor ZH2DoomTallTechLampLensFlare : ZH2DoomLightSourceLensFlare
{
	YScale .6
	XScale 1.4
	
	States
	{
		Spawn:
			LFLR B 1 NoDelay Bright
			stop
	}
}
