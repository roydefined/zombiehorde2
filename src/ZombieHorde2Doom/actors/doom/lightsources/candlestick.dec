actor ZH2DoomCandleStick : ZH2DoomLightSource replaces Candlestick
{
    Radius 20
    Height 14
    Scale .5
    ProjectilePassHeight -16

    Tag "Candlestick"

    +SOLID

    states
    {
        Spawn:
            CAN3 AAAABBBB 1 nodelay bright light("ZH2DoomCandleStickLight") A_SpawnItemEx("ZH2DoomCandleStickLensFlare", 0, 0, 18)
            loop
    }
}

actor ZH2DoomCandleStickLensFlare : ZH2DoomLightSourceLensFlare
{
    Scale .2
    Alpha .3

    States
    {
        Spawn:
            LFLR A 1 NoDelay Bright
            stop
    }
}
