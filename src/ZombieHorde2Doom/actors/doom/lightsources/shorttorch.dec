const int DOOMSHORTTORCHEFFECTHEIGHT = 40;

actor ZH2DoomShortTorchRed : ZH2DoomLightSource replaces ShortRedTorch
{
    Radius 16
    Height 37
    ProjectilePassHeight -16

    +SOLID

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
            STRR AAABBBCCCDDDEEEFFFGGGHHHIIIJJJ 1 bright light("ZH2DoomShortTorchRedLight") A_SpawnItemEx("ZH2DoomShortTorchRedFlare", 0, 0, DOOMSHORTTORCHEFFECTHEIGHT)
            loop

        Spawn.NoSight:
            STRR A 1 bright light("ZH2DoomShortTorchRedLight")
            goto Spawn
    }
}

