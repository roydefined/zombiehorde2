splash zh2_splash_lava
{
	SmallClass "ZH2LavaSplashSmall"
	SmallSound "terrainstep/LAVA2"
	
	BaseClass "ZH2LavaSplashBig"
	Sound "terrainstep/LAVA2"
}

terrain	zh2_terrain_lava
{
	Splash	 zh2_splash_lava
	Footclip 6
	Friction 0.9
	Liquid
}

floor LAVA1 zh2_terrain_lava
floor LAVA2 zh2_terrain_lava
floor LAVA3 zh2_terrain_lava
floor LAVA4 zh2_terrain_lava

// ZE29
floor NEWLAVA zh2_terrain_lava