/* LIFT DOOR */

:LiftDoor
    door 1
    play sequence/lift1door
    nostopcutoff
end

/* MANSION DOOR HEAVY */

:MansionDoorHeavyOpen
    door 2
    play sequence/door1open
    nostopcutoff
end

:MansionDoorHeavyClose
    door 2
    play D_NULL
    stopsound sequence/door1close
    //nostopcutoff
end

[MansionDoorHeavy
    door 2
    0  MansionDoorHeavyOpen
    1  MansionDoorHeavyClose
    2  MansionDoorHeavyOpen
    3  MansionDoorHeavyClose
]

/* MANSION DOOR LIGHT */

:MansionDoorLightOpen
    door 3
    play sequence/door2open
    nostopcutoff
end

:MansionDoorLightClose
    door 3
    play D_NULL
    stopsound sequence/door2close
    //nostopcutoff
end

[MansionDooright
    door 3
    0  MansionDoorLightOpen
    1  MansionDoorLightClose
    2  MansionDoorLightOpen
    3  MansionDoorLightClose
]

/* TOMB RAIDER DOOR */

:TRDoor
    door 4
    play sequence/tomb1door
    nostopcutoff
end
