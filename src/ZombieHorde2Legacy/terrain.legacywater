splash zh2_splash_water
{
	// Slime sounds good here
	SmallClass "ZH2WaterSplashSmall"
	SmallSound "terrainstep/SLIME2"
	
	BaseClass "ZH2WaterSplashBig"
	Sound "terrainstep/SLIME2"
}

terrain	zh2_terrain_water
{
	Splash	 zh2_splash_water
	Footclip 6
	Friction 0.9
	Liquid
}

