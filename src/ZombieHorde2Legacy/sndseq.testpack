// ZM19
:AOMansionDoorLightOpen
	Door 5
	play sequence/oniopen1
	nostopcutoff
end

:AOMansionDoorLightClose
	Door 5
	play D_NULL
	stopsound sequence/oniclose1
	//nostopcutoff
end

[AOMansionDooright
 Door 5
 0  AOMansionDoorLightOpen
 1  AOMansionDoorLightClose
 2  AOMansionDoorLightOpen
 3  AOMansionDoorLightClose
]
