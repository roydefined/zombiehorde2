actor ZH2LegacyZE20Comet
{
	Projectile
	Damage 1234
	Speed 30
	Height 30
	Radius 30
	Scale 2.0
	+RIPPER
	+NODAMAGETHRUST
	+FORCEXYBILLBOARD
	
	obituary "%o was hit by ... something ... big"
	DamageType "ZH2SetOnFire"
	
	States
	{
		Spawn:
			COMT A 0
			COMT AABBCC 1 Bright A_SpawnItemEx("ZH2LegacyZE20CometTail", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
			Goto Spawn+2
			
		Death:
			// TODO: Comets need to set zombies on fire.
			//COMT D 0 A_SpawnItemEx("ZombieBurnerInsane", 0, 0, 8, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
			
			COMT D 0 ACS_ExecuteAlways(56, 0, 0, 0, 0)
			COMT D 0 A_SpawnItemEx("ZH2LegacyZE20CometSmoke", 0, 0, 0, 0, 0, 16, 0, SXF_NOCHECKPOSITION)
			COMT DDDDDDDDDDDDDDDDDD 0 A_SpawnItemEx("ZH2LegacyZE20CometSpawnFire", random(-32, 32), random(-32, 32), random(8, 32), random(-15, 15) * 0.25, random(-15, 15) * 0.25, random(20, 50) * 0.25, 0, SXF_NOCHECKPOSITION)
			COMT DDDDDDDDDDDDDDDDDD 0 A_SpawnItemEx("ZH2LegacyZE20CometSpawnFire", random(-32, 32), random(-32, 32), random(8, 32), 25, 25, random(0, 4) * 0.25, random(0, 255), SXF_NOCHECKPOSITION)
			COMT D 0 A_Explode(1234, 512)
			COMT D 0 A_Explode(100, 1024)
			COMT DEFGHI 1 Bright
			TNT1 A 70
			stop
	}
}

actor ZH2LegacyZE20CometSmoke
{
	+NOCLIP
	+NOBLOCKMAP
	+NOGRAVITY
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	RenderStyle Add
	Scale 24.0
	States
	{
		Spawn:
			COMT PONMLKJ 2 Bright
			stop
	}
}

actor ZH2LegacyZE20CometTail
{
	+NOCLIP
	+NOBLOCKMAP
	+NOGRAVITY
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	Scale 8.0
	RenderStyle Add
	States
