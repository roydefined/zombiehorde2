			stop
	}
}

actor ZH2LegacyZE20CometSpawnFire
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+BRIGHT
	+NOGRAVITY
	+NOBLOCKMAP
	+NOCLIP
	
	RenderStyle Translucent
	Alpha 0.6
	
	States
	{
		Spawn:
			FIR1 ABCDABCDABCDEFGHI 1
			stop
	}
}