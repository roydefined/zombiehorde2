actor ZH2LegacyZE20ExplosiveBoom
{
    RenderStyle Add
    Alpha 0.8
    Obituary "%o was on wrong place in wrong time."
    +NOCLIP
    +NOGRAVITY

    states
    {
        spawn:
            MISL BCD 5 Bright A_Explode(16, 64)
            stop
    }
}

actor ZH2LegacyZE20ExplosiveBoomClient : ZH2LegacyZE20ExplosiveBoom
{
    Scale 0.5
    +CLIENTSIDEONLY

    states
    {
        spawn:
            MISL BCD 5 Bright
            stop
    }
}

actor ZH2LegacyZE20ExplosiveTrail
{
    Height 8
    Radius 8
    Damage 20
    DeathSound "sound/explosion1"
    Obituary "%o was on wrong place in wrong time."
    RenderStyle None
    PROJECTILE
    -NOGRAVITY
    +LOWGRAVITY
    states
    {
        spawn:
            TNT1 A 6 A_SpawnItemEx("ZH2LegacyZE20ExplosiveBoomClient", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
            TNT1 A 0 A_Explode(16, 32)
            TNT1 A 0 A_Scream
            loop
    }
}

// Note: Also used in ZE20B
actor ZH2LegacyZE20Explosion
{
    Health 2
    DeathSound "sound/explosion1"
    RenderStyle None
    +NOCLIP
    +NOGRAVITY
    states
    {
        spawn:
            TNT1 A 0
            TNT1 A 0 A_Scream
            TNT1 AAAA 2 A_SpawnItemEx("ZH2LegacyZE20ExplosiveBoom", random(-80, 80), random(-80, 80), random(0, 80), 0, 0, 0, 0, SXF_NOCHECKPOSITION)
            TNT1 A 0 A_SpawnItemEx("ZH2LegacyZE20ExplosiveTrail", random(-32, 32), random(-32, 32), random(32, 48), random(-32, 32) * 0.1, random(-32, 32) * 0.1, random(16, 24) * 0.2, 0, SXF_NOCHECKPOSITION)
            TNT1 A 2 A_GetHurt
            loop
    }
}