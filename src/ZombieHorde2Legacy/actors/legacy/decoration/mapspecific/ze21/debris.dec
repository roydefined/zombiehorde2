//--------------

//small trail definition (because SXF_TRANSFERSCALE is a 2.7.0 feature)

ACTOR ZH2LegacyZe21SpaceRockTrailSmall1
{
  +NOGRAVITY
  -SOLID
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD

  States
  {
	Spawn:
	TNT1 A 1 				//first frame doesn't do anything to prevent
    ROK1 A 1 A_Fadeout(0.2)// the trail from morping into the rock.
    loop
  }
}

ACTOR ZH2LegacyZe21SpaceRockTrailSmall2 : ZH2LegacyZe21SpaceRockTrailSmall1
{
  States
  {
	Spawn:
    TNT1 A 1
    ROK1 B 1 A_Fadeout(0.2)
    loop
  }
}

