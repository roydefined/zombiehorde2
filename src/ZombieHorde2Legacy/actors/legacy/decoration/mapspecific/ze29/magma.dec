actor ZH2LegacyZe29MagmaSpawner 20043
{
	//$Sprite SPKOA0
	
	scale 1.4
	+NOGRAVITY
	+CLIENTSIDEONLY
	States
	{
		Spawn:
			TNT1 A 50 A_SpawnitemEx("ZH2LegacyZe29MagmaSparkle", 0, 0, 0, Random(-5, 5), Random(-5, 5), Random(0, 5))
			Loop
	}
}

actor ZH2LegacyZe29MagmaSparkle
{
	Height 0
	Radius 0
	Mass 0
	+Missile
	+NOGRAVITY
	+NoBlockMap
	+DontSplash
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+THRUACTORS
	+CLIENTSIDEONLY
	RenderStyle Add
	Scale 0.08
	States
	{
		Spawn:
			SPKO A 1 Bright A_FadeOut(0.005)
			Loop
	}
}