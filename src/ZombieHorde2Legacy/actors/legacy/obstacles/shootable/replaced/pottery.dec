// Will be replaced with a spawner spawning different pots.
actor ZH2LegacyReplacedPottery : ZH2LegacyReplacedPottery3 20029
{
	Tag "Pottery"
	states
	{
		death:
			TNT1 A 0 A_Fall
			TNT1 AAAAAAAAA 0 A_SpawnItemEx("ZH2LegacyPotteryPart", random(-8, 8), random(-8, 8), random(1, 34), random(-4, 4), random(-4, 4), random(0, 8), random(0, 365))
			TNT1 A 0 A_SpawnItem("ZH2LegacyPotteryBreakFX")
			stop
	}
}

Actor ZH2LegacyPotteryPart
{
	Radius 1
	Height 1
	
	+MISSILE
	+NOBLOCKMAP
	+CLIENTSIDEONLY
	
	var int user_fadeAmount;

	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetScale(Frandom(0.6, 1.0), Frandom(0.6, 1.0))
			TNT1 A 0 A_Jump(256, 0, 1, 2, 3, 4, 5, 6, 7, 8)
			PBIT ABCDEGHIJ -1
			
			
		Death:
			PBIT "#" 35
			PBIT "#" 1 A_FadeOut(0.02)
			wait
	}
}

Actor ZH2LegacyPotteryBreakFX
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	
	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_PlaySound("decorate/potbreak")
			stop
	}
}
