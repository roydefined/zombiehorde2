// Note, uses the pottery FX from the regular pottery.
actor ZH2LegacyZE20Pottery : ZH2LegacyReplacedPottery3 21003
{
    // These do not work, but neither did the old ones.
    DropItem "ZH2WeaponFireGrenadeSpawn", 8
    DropItem "ZH2WeaponChaingunSpawn", 16
    DropItem "ZH2WeaponShotgunSpawn", 16

    Tag "Pottery (drops items)"

    states
    {
        death:
            TNT1 A 0 A_Fall
            TNT1 AAAAAAAAA 0 A_SpawnItemEx("ZH2LegacyPotteryPart", random(-8, 8), random(-8, 8), random(1, 34), random(-4, 4), random(-4, 4), random(0, 8), random(0, 365))
            TNT1 A 0 A_SpawnItem("ZH2LegacyPotteryBreakFX")
            stop
    }
}