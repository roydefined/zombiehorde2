// Note, the tree spawner of ZE20 used to be able to set on fire by fire grenades.
// It's such a niche feature that I didn't support it (yet? TODO)

actor ZH2LegacyZE20TreeSpawn : ZH2LegacyTree 21000
{
	Height 180
	Mass 0x7FFFFFFF
	Health 0x7FFFFFFF
	
	+SOLID
	+SHOOTABLE
	+NOBLOOD
	+NODAMAGETHRUST
	
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump(4, "Live")
			TNT1 A 0 A_Jump(32, "Gray")
			TRE2 A -1 A_Jump(128, 1)
			TRE8 A -1
			stop
		Gray:
			TREA A -1 A_Jump(128, 1)
			TRE9 A -1
			stop
		Live:
			TRE1 A -1
			stop
	}
}