actor ZH2LegacyTreeClient1 : ZH2LegacyTree 20001
{
    +CLIENTSIDEONLY
    +FORCEYBILLBOARD
    -SOLID

    states
    {
        spawn:
            TRE1 A -1
            stop
    }
}
