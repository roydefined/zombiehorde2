actor ZH2LegacyZe29KeycardWhite : ZH2CustomInventoryKey
{
	Inventory.Amount 1
	Inventory.MaxAmount 1
	Inventory.Icon "KCWHITEI"
	inventory.pickupmessage "Picked up a white keycard."
	inventory.pickupsound "item/keycard"
	states
	{
		Spawn:
			CRDW A -1
			Stop
		Pickup:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
			stop
			TNT1 A 0 A_RailWait
			Stop
		Use:
			TNT1 A 0
			fail
	}
}

actor ZH2LegacyZe29KeycardRed : ZH2LegacyZe29KeycardWhite
{
	Inventory.Icon "KCREDI"
	inventory.pickupmessage "Picked up a red keycard."
	states
	{
		Spawn:
			CRDR A -1
			Stop
	}
}

