Actor ZH2BlueKeyCard : ZH2LegacyKey replaces BlueCard
{
    //$Sprite "BLCKA0"

    Radius 20
    Height 16

    Inventory.PickupMessage "Blue keycard"
    Inventory.PickupSound "items/KEYCARD"
    Inventory.Icon "KYBLUEI"

    Tag "Blue keycard"

    states
    {
        Spawn:
            BLCK AAAAABBBBBCCCCCDDDDDEEEEEDDDDDCCCCCBBBBB 1 NoDelay A_SpawnItemEx("ZH2BlueKeycardFlare", 0, 0, 4)
            loop
    }
}

