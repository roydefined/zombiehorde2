actor ZH2LegacyGrunt : ZH2LegacyMonster 31150
{
    Health 0x7fffffff
    PainChance 180
    Speed 30
    Radius 16
    Height 56
    Mass 0x7fffffff
    scale .75
    meleedamage 9999
    meleerange 64
    Monster
    +FLOORCLIP
    +FASTER
    +FASTMELEE
    SeeSound "monster/grunt/see"
    painsound "monster/grunt/pain"
    attacksound "monster/grunt/attack"
    activesound "monster/grunt/active"
    Obituary "%o was scared to death by the Grunt."
    tag "Grunt"

    states
    {
        Spawn:
            GRUN AB 5
        Spawn.Rest:
            GRUN AB 5 A_Look
            Loop

        See:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Spawn")
            GRUN AB 1 A_chase

        Melee:
            GRUN DE 1  A_MeleeAttack
            Goto See

        Pain:
            GRUN C 4 bright A_Pain
            Goto See

        Death:
            GRUN C 8
            GRUN C 8 //A_Scream // No death sound on this monster
            GRUN C 4
            GRUN C 4 A_NoBlocking
            GRUN CCCCCCCCCCCCCCCC 4 A_fadeout(0.2)
            Stop
    }
}