actor ZH2LegacyZm19Bat : ZH2LegacyMonster 31163
{
    Health 10
    Radius 12
    Height 24
    Speed 14
    MONSTER

    +ALWAYSRESPAWN

    +NOGRAVITY
    +FLOAT

    SeeSound "monster/bat/idle"
    PainSound "monster/bat/pain"
    DeathSound "monster/bat/death"
    ActiveSound "monster/bat/idle"
    HitObituary "%o was scratched by a bat familiar"
    tag "Bat"

    States
    {
        Spawn:
            BFAM ABCB 3 A_Look
            Loop

        See:
            BFAM ABCB 3 A_Chase
            Loop

        Pain:
            BFAM A 2
            BFAM A 2 A_Pain
            Goto See

        Death:
            TNT1 A 0 A_Die
            TNT1 A 0 A_NoBlocking
            BFAM D 5 A_Scream
            BFAM E 5
            BFAM FDEF 5
            Goto Death+5

        Crash:
            TNT1 A 0 A_SetFloorClip
            BFAM G 6 A_PlaySound("monster/bat/crash")
            BFAM H 7
            BFAM I 8
            BFAM J -1
            Stop
    }
}