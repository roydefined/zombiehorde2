actor ZH2LegacyZm19Oni : ZH2LegacyMonster 31160
{
    Health 0x7fffffff
    Radius 20
    Height 100
    Mass 100
    Speed 20
    PainChance 30
    MONSTER
    SeeSound "monster/aooni/see"

    Obituary "%o was found by the Oni."
    tag "The Oni"

    +FLOORCLIP
    +BRIGHT
    +NOTIMEFREEZE
    +LOOKALLAROUND

    STATES
    {
        Spawn:
            AONI A 1
        Spawn.Rest:
            AONI A 1 A_Look
            AONI A 0 A_StopSound(CHAN_VOICE)
            loop

        // TODO: Support footsteps
        see:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Spawn")
            AONI ABC 2 A_Chase
            //AONI A 0 A_SpawnItem("Footstep",0,1)
            AONI ABC 2 A_Chase
            //AONI A 0 A_SpawnItem("Footstep",0,1)
            loop

        Melee:
            AONI A 1 A_FaceTarget
            AONI C 35 A_CustomMeleeAttack(10000, "Aooni/See", "none")
            goto see

        Pain:
            AONI A 6 A_Pain
            goto see

        death:
            AONI A 0 A_Scream
            AONI A 0 A_NoBlocking
            AONI ABC 2
            AONI A 0 A_StopSound(CHAN_VOICE)
            AONI A -1
            stop
    }
}