actor ZH2LegacyZm19Oni : ZH2LegacyMonster 31160
{
    OBITUARY "%o was raped to death by The Oni"
    Health 0x7fffffff
    Radius 20
    Height 100
    Mass 100
    Speed 20
    PainChance 30
    MONSTER
    SeeSound "monster/aooni/see"

    +FLOORCLIP
    +BRIGHT
    +NOTIMEFREEZE
    +LOOKALLAROUND

    STATES
    {
        Spawn:
            AONI A 1 A_LOOK
            AONI A 0 A_STOPSOUND(CHAN_VOICE)
            loop

        // TODO: Support footsteps
        see:
            AONI ABC 2 A_CHASE
            //AONI A 0 A_SpawnItem("Footstep",0,1)
            AONI ABC 2 A_CHASE
            //AONI A 0 A_SpawnItem("Footstep",0,1)
            loop

        Melee:
            AONI A 1 A_FaceTarget
            AONI C 35 A_CustomMeleeAttack(10000, "Aooni/See", "none")
            goto see

        Pain:
            AONI A 6 A_Pain
            goto see

        death:
            AONI A 0 A_SCREAM
            AONI A 0 A_NOBLOCKING
            AONI ABC 2
            AONI A 0 A_STOPSOUND(CHAN_VOICE)
            AONI A -1
            stop
    }
}