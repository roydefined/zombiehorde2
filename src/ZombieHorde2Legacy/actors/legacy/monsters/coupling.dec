actor ZH2LegacyLargeCoupling : ZH2LegacyMonster 16928
{
	Health 250
	Mass 0x7FFFFFFF
	Radius 15
	Height 140
	Scale 0.6
	deathsound "sound/explosion1"
	monster
	
	+SHOOTABLE
	+NOBLOOD
	-PUSHABLE
	
	states
	{
		spawn:
			HUGE A 4 bright 
			HUGE B 4 bright 
			HUGE C 4 bright 
			HUGE D 4 bright 
			loop
		
		death:
			MISL B 0 A_SpawnItemEx ("ZH2LegacyLargeCouplingBoom", 0, 0, 64, 0, 0, 0, 0, 160)
			MISL B 0 A_SpawnItemEx ("ZH2LegacyLargeCouplingBoom", 0, 0, 32, 0, 0, 0, 0, 160)
			MISL B 0 A_SpawnItemEx ("ZH2LegacyLargeCouplingBoom", 0, 0, 96, 0, 0, 0, 0, 160)
			MISL B 0 A_StopSoundEx ("SoundSlot7")
			MISL B 4 bright A_PlaySound("sound/explosion1")
			MISL C 4 bright 
			MISL D 4 bright 
			stop
	}
}
 
actor ZH2LegacyLargeCouplingBoom
{
