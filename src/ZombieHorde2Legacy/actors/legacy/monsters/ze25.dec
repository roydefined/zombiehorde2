// TODO: Get rid of the hardcoded script execution

actor ZH2LegacyZE25Weegee
{
    monster

    health 1500
    radius 100
    height 256
    mass 0x7FFFFFFF
    speed 0

    -NOGRAVITY
    +STANDSTILL

    states
    {
        Spawn:
            WEGE A 10 A_Look
            loop

        See:
            WEGE A 10 A_Chase
            loop

        Death:
            WEGE ABCDEABCDE 5
            WEGE ABCDEABCDE 4
            WEGE ABCDEABCDE 3
            WEGE ABCDEABCDE 2
            WEGE ABCDEABCDEABCDEABCDEABCDEABCDE 1
            TNT1 A 0 ACS_Terminate(97, 0)
            TNT1 A 0 ACS_Execute(96, 0, 0, 0, 0)
            TNT1 A 0 A_PlaySound("world/nuke1")
            stop
    }
}