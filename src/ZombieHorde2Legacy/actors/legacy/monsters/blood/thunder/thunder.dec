
// TODO: Both seem like a bad copy paste of kameleon
// Note, both are also used in ZM16

Actor ZH2LegacyZm25ThunderZone : ZH2LegacyMonster 27858
{
    //$Sprite THNDA0

    Health 0x7fffffff
    radius 32
    height 64
    Speed 16
    Painsound ""
    Deathsound ""
    Activesound ""
    mass 0x7fffffff
    Speed 0
    Obituary "%o was destroyed by thunder."
    tag "Thunder"
    MONSTER
    +FLOORCLIP
    +FASTER
    +FASTMELEE
    +QUICKTORETALIATE
    +LOOKALLAROUND
    +FLOORCLIP
    +NODROPOFF
    +NOBLOCKMONST
    +NOCLIP
    -SOLID
    -COUNTKILL
    -SHOOTABLE
    MaxDropOffHeight 64
    meleedamage 9999
    meleerange 1024
    States
    {
        Spawn:
            TNT1 A 1 A_Look
            loop
        See:
            TNT1 A 0 A_JumpIfTargetInLos(2)
            TNT1 A 0 A_Jump(256,2)
            TNT1 A 1 A_Chase
            Goto See
            TNT1 A 1 A_ClearTarget
            Goto Spawn
        Melee:
            TNT1 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1,"Melee2")
            TNT1 A 5 A_GivetoTarget("ZH2LegacyZM25ThunderSpawn",1)
            TNT1 AAAAAAA 35
            goto See
        Melee2:
            TNT1 A 0 A_PlaySound("monster/kameleon/melee")
            TNT1 A 5 A_MeleeAttack
            goto see
            Death:
            stop
    }
}

Actor ZH2LegacyZm25DiscoThunderZone : ZH2LegacyMonster 27859
{
    //$Sprite THNDA0

    Health 0x7fffffff
    radius 32
    height 64
    Speed 16
    Painsound ""
    Deathsound ""
    Activesound ""
    mass 0x7fffffff
    Speed 0
    Obituary "%o was destroyed by thunder."
    tag "Thunder"
    MONSTER
    +FLOORCLIP
    +FASTER
    +FASTMELEE
    +QUICKTORETALIATE
    +LOOKALLAROUND
    +FLOORCLIP
    +NODROPOFF
    +NOBLOCKMONST
    +NOCLIP
    -SOLID
    -COUNTKILL
    -SHOOTABLE
    MaxDropOffHeight 64
    meleedamage 9999
    meleerange 492
    States
    {
        Spawn:
            TNT1 A 35 A_SpawnItemEx("ZH2LegacyZM25DiscoThunderWhite",random(-784,784),random(-784,784))
            TNT1 A 35 A_SpawnItemEx("ZH2LegacyZM25DiscoThunderTan",random(-784,784),random(-784,784))
            TNT1 A 35 A_SpawnItemEx("ZH2LegacyZM25DiscoThunderGreen",random(-784,784),random(-784,784))
            TNT1 A 35 A_SpawnItemEx("ZH2LegacyZM25DiscoThunderRed",random(-784,784),random(-784,784))
            TNT1 A 35 A_SpawnItemEx("ZH2LegacyZM25DiscoThunderBlue",random(-784,784),random(-784,784))
            TNT1 A 35 A_SpawnItemEx("ZH2LegacyZM25DiscoThunderPink",random(-784,784),random(-784,784))
            loop
        Death:
            stop
    }
}
