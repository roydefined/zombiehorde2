actor ZH2LegacyZm25MistSpawner
{
    Height 1
    Radius 1
    Speed 0
    PROJECTILE
    +NOCLIP
    +DONTSPLASH
    +CLIENTSIDEONLY
    States
    {
        Spawn:
            TNT1 A 1 A_CustomMissile("ZH2LegacyZm25MistTrail2",0,0,random(0,360))
            TNT1 A 1 A_CustomMissile("ZH2LegacyZm25MistTrail2",0,0,random(0,360))
            TNT1 A 1 A_CustomMissile("ZH2LegacyZm25MistTrail2",0,0,random(0,360))
            TNT1 A 1 A_CustomMissile("ZH2LegacyZm25MistTrail2",0,0,random(0,360))
            stop
    }
}

