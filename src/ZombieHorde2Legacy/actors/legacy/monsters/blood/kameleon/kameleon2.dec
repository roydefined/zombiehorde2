// Actor used in ZM25. Just gave it the same name as the other Kameleon

// TODO: This actor uses hardcoded content like script execution.
// TODO: This actor appears to be unused.

actor ZH2LegacyZM18Kameleon2 : ZH2LegacyZM18Kameleon
{
  States
  {
  Spawn:
    TNT1 A 0 A_JumpIfInventory("ZH2LegacyZM18LabScriptUsed",1,4)
    TNT1 A 0 ACS_ExecuteAlways(80,0,0,0,0)
    TNT1 A 0 ACS_ExecuteAlways(82,0,0,0,0)
    TNT1 A 0 A_GiveInventory("ZH2LegacyZM18LabScriptUsed",1)
    PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1,"Spawn2")
    PLA3 A 1 A_Look
    loop
  See:
    TNT1 A 0 A_JumpIfInventory("ZH2LegacyZM18LabScriptUsed",1,4)
    TNT1 A 0 ACS_ExecuteAlways(80,0,0,0,0)
    TNT1 A 0 ACS_ExecuteAlways(82,0,0,0,0)
    TNT1 A 0 A_GiveInventory("ZH2LegacyZM18LabScriptUsed",1)
    PLA3 A 0 A_ChangeFlag("FRIGHTENED", 0)
    PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1, "See2")
    TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Seee")
    PLA3 AABBCCDD 2 A_Chase
    Goto See
  }
}