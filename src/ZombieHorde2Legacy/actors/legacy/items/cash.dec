actor ZH2LegacyCash : ZH2LegacyCurrencyInventory 20205
{
    Inventory.amount 1
    Inventory.maxamount 50
    Inventory.Icon "CASHA0"
    Inventory.PickupMessage "You picked up some gold."
    Inventory.PickupSound "item/cash"
    +INVENTORY.HUBPOWER

    States
    {
        Spawn:
            CASH A -1
            stop
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == false, "Ignore")
            TNT1 A 0 A_RailWait
            Stop
        Ignore:
            CASH A 1
            Stop
        Use:
            TNT1 A 0
            fail
    }
}