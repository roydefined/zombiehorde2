actor ZH2LegacyReplacedLamp : ZH2LegacyReplacedLightSource 20078
{
    Radius 10
    Height 20
    scale .75
    -SOLID
    +NOGRAVITY
    States
    {
        Spawn:
            LAMP B 1
            goto active
        Active:
            LAMP A 1 bright light("ZH2LampLight2")
            loop
        Inactive:
            LAMP B -1
            loop
        Disco:
            LAMP C -1 bright light("ZH2LampLight2")
            loop
    }
}