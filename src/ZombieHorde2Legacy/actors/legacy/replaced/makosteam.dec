Actor ZH2LegacyReplacedMakoSteamSpawner : ZH2LegacyReplacedSwitchableDecoration 20904
{
    //$NotAngled
    //$Sprite TNT2A0

    Height 2
    Radius 1
    Mass 0

    +NOBLOCKMAP
    +NOGRAVITY
    +NOINTERACTION
    +CLIENTSIDEONLY

    States
    {
        Spawn:
            TNT1 A 4 NoDelay A_SpawnItemEx("ZH2LegacyReplacedMakoSteamParticle", 0, 0, 1, (0.5)*Random(0, 4), (0.5)*Random(0, 4), (0.1)*Random(35, 40), Random(0, 360), 128)
            Loop
    }
}

Actor ZH2LegacyReplacedMakoSteamParticle
{
    Height 1
    Radius 1

    RenderStyle Add
    Scale 2.0
    Alpha 0.65

    +MISSILE
    +NOGRAVITY
    +NOBLOCKMAP
    +DONTSPLASH
    +CLIENTSIDEONLY

    States
    {
        Spawn:
            MAKO A 2 NoDelay A_SetTranslucent(0.6, 1)
            MAKO B 2 A_SetTranslucent(0.55, 1)
            MAKO C 2 A_SetTranslucent(0.5, 1)
            MAKO D 2 A_SetTranslucent(0.45, 1)
            MAKO E 2 A_SetTranslucent(0.4, 1)
            MAKO F 2 A_SetTranslucent(0.35, 1)
            MAKO G 2 A_SetTranslucent(0.3, 1)
            MAKO H 2 A_SetTranslucent(0.25, 1)
            MAKO I 2 A_SetTranslucent(0.2, 1)
            MAKO J 2 A_SetTranslucent(0.15, 1)
            MAKO K 2 A_SetTranslucent(0.1, 1)
            MAKO L 2 A_SetTranslucent(0.05, 1)
            Stop
    }
}
