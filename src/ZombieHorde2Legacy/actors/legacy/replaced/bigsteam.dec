Actor ZH2LegacyReplacedBigSteamSpawner : ZH2LegacyReplacedSwitchableDecoration 20903
{
    //$Sprite TNT2A0

    Height 2
    Radius 1
    Mass 0

    +NOBLOCKMAP
    +NOGRAVITY
    +NOINTERACTION
    +CLIENTSIDEONLY

    States
    {
        Spawn:
        Active:
            TNT1 A 0
            TNT1 A 0 A_JumpIf(Args[0] == 1, "Down")
            TNT1 A 0 A_JumpIf(Args[0] > 1, "Forward")
            TNT1 A 0 A_JumpIf(Args[3] > 0, 2)
            TNT1 A 4 A_SpawnItemEx("ZH2LegacyReplacedBigSteamParticle", 0, 0, 1, (0.1)*Random(0, 4), 0, (0.1)*Random(35, 40), Random(0, 360), 128)
        Loop
        Down:
            TNT1 A 4 A_SpawnItemEx("ZH2LegacyReplacedBigSteamParticle", 0, 0, 0, (0.1)*Random(0, 4), 0, (-0.1)*Random(35, 40), Random(0, 360), 128)
            Loop
        Forward:
            TNT1 A 4 A_SpawnItemEx("ZH2LegacyReplacedBigSteamParticle", 0, 0, 0, (0.1)*Random(35, 40), 0, (0.1)*Random(-5, 5), Random(-8, 8), 128)
            Loop
        Inactive:
            TNT1 A 1 A_StopSoundEx("SoundSlot7")
            TNT1 A 1
            Goto Inactive+1
    }
}

Actor ZH2LegacyReplacedBigSteamParticle : ZH2LegacyReplacedSteamParticle
{
    Scale 3.0
}
