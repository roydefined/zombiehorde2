// All of these should no longer be used. We have a universal flarespot now instead.

actor ZH2LegacyFlareOrange : ZH2LegacyReplacedFlare 20951
{
	//$Color 19
	//$Sprite FLARD0
	Tag "Flare (orange)"
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetArg(0, 4)
			TNT1 A 0 A_SetArg(2, true)
			Goto Super::Spawn.Start
	}
}

