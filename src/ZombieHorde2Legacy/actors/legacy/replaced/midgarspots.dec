// The spots will receive a new and improved actor that allows you to control everything

Actor ZH2LegacyReplacedLightParticleGreen : ZH2LegacyReplacedActor 20910
{
    //$NotAngled

    Height 1
    Radius 1

    +NOGRAVITY
    +NOBLOCKMAP
    +DONTSPLASH
    +CLIENTSIDEONLY

    Scale 0.10

    States
    {
        Spawn:
            LIGH B -1 Bright
            Stop
    }
}

Actor ZH2LegacyReplacedLightParticleRed : ZH2LegacyReplacedLightParticleGreen 20911
{
    //$NotAngled

    Scale 0.20

    States
    {
        Spawn:
            LIGH D 15 Bright A_SetTranslucent(1.0, 1)
            LIGH D 5 Bright A_SetTranslucent(0.9, 1)
            LIGH D 5 Bright A_SetTranslucent(0.8, 1)
            LIGH D 5 Bright A_SetTranslucent(0.7, 1)
            LIGH D 5 Bright A_SetTranslucent(0.6, 1)
            LIGH D 5 Bright A_SetTranslucent(0.5, 1)
            LIGH D 5 Bright A_SetTranslucent(0.4, 1)
            LIGH D 5 Bright A_SetTranslucent(0.3, 1)
            LIGH D 5 Bright A_SetTranslucent(0.2, 1)
            LIGH D 5 Bright A_SetTranslucent(0.1, 1)
            LIGH D 15 Bright A_SetTranslucent(0.0, 1)

            LIGH D 15 Bright A_SetTranslucent(0.0, 1)
            LIGH D 5 Bright A_SetTranslucent(0.1, 1)
            LIGH D 5 Bright A_SetTranslucent(0.2, 1)
            LIGH D 5 Bright A_SetTranslucent(0.3, 1)
            LIGH D 5 Bright A_SetTranslucent(0.4, 1)
            LIGH D 5 Bright A_SetTranslucent(0.5, 1)
            LIGH D 5 Bright A_SetTranslucent(0.6, 1)
            LIGH D 5 Bright A_SetTranslucent(0.7, 1)
            LIGH D 5 Bright A_SetTranslucent(0.8, 1)
            LIGH D 5 Bright A_SetTranslucent(0.9, 1)
            LIGH D 15 Bright A_SetTranslucent(1.0, 1)
            Loop
    }
}