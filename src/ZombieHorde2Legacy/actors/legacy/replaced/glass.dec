// Will be merged and improved in general using the args.

actor ZH2LegacyReplacedGlassBreakX : ZH2LegacyReplacedSwitchableDecoration 21004
{
    //$Sprite SGSAA0
    deathsound "decorate/glassbreak1"
    tag "Glass (X-axis)"
    states
    {
        spawn:
            TNT1 A -1
            stop

        active:
            TNT1 A 0 A_Scream
            TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2LegacyReplacedNewGlassShard", random(-32, 32), 0, random(0, 64), random(-32, 32) * 0.1, random(-32, 32) * 0.1, random(-8, 32) * 0.2, 0, SXF_NOCHECKPOSITION)
            stop
    }
}

actor ZH2LegacyReplacedGlassBreakY : ZH2LegacyReplacedSwitchableDecoration 21005
{
    //$Sprite SGSAA0
    deathsound "decorate/glassbreak1"
    tag "Glass (Y-axis)"
    states
    {
        spawn:
            TNT1 A -1
            stop

        active:
            TNT1 A 0 A_Scream
            TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2LegacyReplacedNewGlassShard", 0, random(-32, 32), random(0, 64), random(-32, 32) * 0.1, random(-32, 32) * 0.1, random(-8, 32) * 0.2, 0, SXF_NOCHECKPOSITION)
            stop
    }
}

actor ZH2LegacyReplacedNewGlassShard
{
    Height 4
    Radius 4
    RenderStyle Translucent
    Alpha 0.4

    +CLIENTSIDEONLY
    +DONTSPLASH

    states
    {
        spawn:
            SGSA BCDE 4 A_CheckFloor("Death")
            loop

        death:
            SGSA A -1
            stop
    }
}
