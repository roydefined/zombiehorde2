// Blood spot models.
// BLDS frame A-C remains sprites instead of models.

Model ZH2BloodSpot
{
	Path "models/blood"
	Model 0 "BloodSpot.md3"
	Skin 0 "BloodSpot1.png"
	ZOffset 0.1
	FrameIndex BLDS D 0 0
}

