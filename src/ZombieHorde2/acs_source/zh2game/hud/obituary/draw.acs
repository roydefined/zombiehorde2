#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawInitialChosen(int queueIndex, fixed yOffset)
    {
        int index = Obituary::GetQueueData(queueIndex, 0);
        int id = Obituary::GetQueueData(queueIndex, 1);
        int multiple = Obituary::GetQueueData(queueIndex, 2);

        HudSetPointInternal(-26.0, yOffset);
        BCSUtils::HudDrawText(--_drawnHudId, BCSUtils::PlayerName(id));
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_CENTER, BCSUtils::HUD_ALIGN_CENTER);

        HudSetPointInternal(-18.0, yOffset);
        BCSUtils::HudDrawImage(--_drawnHudId, HUD_OBITUARY_HUMAN);
        DebugDraw();

        HudSetPointInternal(0.0, yOffset);
        BCSUtils::HudDrawImage(--_drawnHudId, HUD_OBITUARY_INITIAL_CHOSEN);
        DebugDraw();

        // With multiple zombies we want to show the index of this zombie.
        if (multiple)
        {
            BCSUtils::HudSetFont("SMALLFONT");
            BCSUtils::HudSetTextColor(CR_RED);

            HudSetPointInternal(-6.0, yOffset - 3.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(index + 1));
            DebugDraw();
        }
    }

    internal void DrawPlayerSafe(int queueIndex, fixed yOffset)
    {
        int id = Obituary::GetQueueData(queueIndex, 0);
        int type = Obituary::GetQueueData(queueIndex, 1);
        str graphic = TranslateSpecieGraphic(type);

        HudSetPointInternal(-26.0, yOffset);
        BCSUtils::HudDrawText(--_drawnHudId, BCSUtils::PlayerName(id));
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_CENTER, BCSUtils::HUD_ALIGN_CENTER);

        if (graphic != (str)0)
        {
            HudSetPointInternal(-18.0, yOffset);
            BCSUtils::HudDrawImage(--_drawnHudId, graphic);
            DebugDraw();
        }

        HudSetPointInternal(0.0, yOffset);
        BCSUtils::HudDrawImage(--_drawnHudId, HUD_OBITUARY_SAFE);
        DebugDraw();
    }

    internal void DrawPlayerScratched(int queueIndex, fixed yOffset, fixed alpha)
    {
        int infected = Obituary::GetQueueData(queueIndex, 0);
        int infector = Obituary::GetQueueData(queueIndex, 1);
        int infectorType = Obituary::GetQueueData(queueIndex, 2);
        str infectorGraphic = TranslateSpecieGraphic(infectorType);

        HudSetPointInternal(-18.0, yOffset);
        BCSUtils::HudDrawText(--_drawnHudId, BCSUtils::PlayerName(infector));
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_CENTER, BCSUtils::HUD_ALIGN_CENTER);

        if (infectorGraphic != (str)0)
        {
            HudSetPointInternal(-9.0, yOffset);
            BCSUtils::HudDrawImage(--_drawnHudId, infectorGraphic);
            DebugDraw();
        }

        HudSetPointInternal(9.0, yOffset);
        BCSUtils::HudDrawImage(--_drawnHudId, HUD_OBITUARY_HUMAN);
        DebugDraw();

        fixed effectAlpha = BCSUtils::Max(0, alpha - 0.4);
        BCSUtils::HudSetAlpha(effectAlpha);

        HudSetPointInternal(9.0, yOffset);
        BCSUtils::HudDrawImage(--_drawnHudId, HUD_OBITUARY_SCRATCH);
        DebugDraw();

        BCSUtils::HudSetAlpha(alpha);

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);

        HudSetPointInternal(18.0, yOffset);
        BCSUtils::HudDrawText(--_drawnHudId, BCSUtils::PlayerName(infected));
        DebugDraw();
    }

