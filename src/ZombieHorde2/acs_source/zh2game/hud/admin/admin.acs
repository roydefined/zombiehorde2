#ifdef __IMPORTED__
    #error This file must be #included.
#endif

#include "player.acs"
#include "round.acs"
#include "start.acs"
#include "timer.acs"
#include "resist.acs"

strict namespace Hud
{
    internal void DrawAdminHud()
    {
        fixed scale = ZH2Game::GetHudAdminScale();
        BCSUtils::HudResetState();
        BCSUtils::HudSetVirtualSize(640.0, 480.0);
        BCSUtils::HudSetScale(scale);
        BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);
        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_TOP);

        fixed x = BCSUtils::HudLeft(),
              y = BCSUtils::HudTop();

        x += 100.0;
        y += 120.0;

        x += _xShakeOffset;
        y += _yShakeOffset;
        
        _drawnHudId = HUDID_ADMIN;
        switch(_currentAdminMenu)
        {
            case ADMINMENU_START: DrawStartMenuHud(x, y, scale); break;
            case ADMINMENU_PLAYER: DrawPlayerMenuHud(x, y, scale); break;
            case ADMINMENU_TIMER: DrawTimerMenuHud(x, y, scale); break;
            case ADMINMENU_ROUND: DrawRoundMenuHud(x, y, scale); break;
            case ADMINMENU_RESIST: DrawResistMenuHud(x, y, scale); break;
        }
    }
}