#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawRoundMenuHud(fixed x, fixed y, fixed scale)
    {
        BCSUtils::HudSetPoint(x, y);
        BCSUtils::HudSetTextColor(CR_WHITE);
        BCSUtils::HudDrawText(--_drawnHudId, "\cfRound");

        y += 10.0 * scale;
        if (DrawClickableText(--_drawnHudId, x, y, 100.0 * scale, 10.0 * scale, "Back to start"))
            OpenAdminMenu(ADMINMENU_START);
        
        y += 20.0 * scale;

        BCSUtils::HudSetPoint(x, y);
        if (DrawClickableTextConditional(
            Round::GetActiveKnownRoundState() == Round::STATEPLAYING, --_drawnHudId, x, y, 60.0 * scale, 10.0 * scale, "End game"))
        {
            Admin::AdminEndGameClientside();
        }

        y += 10.0 * scale;

        // Kill unsafe players
        if (DrawClickableTextConditional(
            Round::GetActiveKnownRoundState() == Round::STATEPLAYING, --_drawnHudId, x, y, 80.0 * scale, 10.0 * scale, "Kill unsafe players"))
        {
            Admin::AdminKillUnsafePlayersClientSide();
        }

        y += 20.0 * scale;
        BCSUtils::HudSetPoint(x, y);
        BCSUtils::HudSetTextColor(CR_WHITE);
        BCSUtils::HudDrawText(--_drawnHudId, "\cfSet round state");

        y += 10.0 * scale;

        // Explicit button for disabling the current round state.
        BCSUtils::HudSetPoint(x, y);
        if (DrawClickableTextConditional(
            Round::GetActiveRoundStateIndex() != 0, --_drawnHudId, x, y, 80.0 * scale, 10.0 * scale, "Disable round state"))
        {
            Admin::AdminSetRoundStateClientside(0);
        }

        y += 10.0 * scale;
        int rows = 0;
        Round::RoundStateContextT[]& rounds = ZH2Game::GameContext.MapDetails.Rounds;
        for (int index = 0; index < lengthof(rounds); ++index)
        {
            if (!Round::GetRoundDefined(index)) continue;

            if (DrawClickableTextConditional(
                Round::GetActiveRoundStateIndex() != index, --_drawnHudId, x, (y + fixed(10 * rows) * scale), 80.0 * scale, 10.0 * scale, Round::GetRoundStateIndexAsString(index)))
            {
                Admin::AdminSetRoundStateClientside(index);
            }

            rows++;
        }

        y += (20.0 + fixed(10 * rows)) * scale;
        BCSUtils::HudSetPoint(x, y);
        BCSUtils::HudSetTextColor(CR_WHITE);
        BCSUtils::HudDrawText(--_drawnHudId, "\cfSet round timer");

        y += 10.0 * scale;

        // Explicit button for disabling the current timer.
        BCSUtils::HudSetPoint(x, y);
        if (DrawClickableTextConditional(
            RoundTimer::GetActiveTimerIndex() != 0, --_drawnHudId, x, y, 80.0 * scale, 10.0 * scale, "Disable timer"))
        {
            Admin::AdminSetRoundTimerClientside(0);
        }

        y += 10.0 * scale;

        rows = 0;
        RoundTimer::RoundTimerContextT[]& roundTimers = ZH2Game::GameContext.MapDetails.Timers;
        for (int index = 0; index < lengthof(roundTimers); ++index)
        {
            if (!RoundTimer::GetTimerDefined(index)) continue;

            if (DrawClickableTextConditional(
                RoundTimer::GetActiveTimerIndex() != index, --_drawnHudId, x, (y + fixed(10 * rows)), 80.0 * scale, 10.0 * scale, RoundTimer::GetTimerIndexAsString(index)))
            {
                Admin::AdminSetRoundTimerClientside(index);
            }

            rows++;
        }
    }
}