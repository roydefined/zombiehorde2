    #define HUD_ENDINGZOMBIEKILLS HUD_ENDINGHUMANKILLS + 150
    #define HUD_ENDINGINFECTS HUD_ENDINGZOMBIEKILLS + 150

    #define HUD_SUMMARYHEADER HUD_ENDINGINFECTS + 10
    #define HUD_SUMMARYTIP HUD_ENDINGINFECTS + 5
    #define HUD_SUMMARYMAPLIST HUD_SUMMARYTIP + 100
    
    #define HUD_CLIENTSETTINGSHEADER HUD_SUMMARYMAPLIST
    #define HUD_CLIENTSETTING HUD_CLIENTSETTINGSHEADER + 100

    // WEAPONS
    #define HUD_WEAPONSNIPER HUD_CLIENTSETTING + 3 // background, meter, meter pointer
