    #define HUD_GAME HUD_RESIST_STATES + 2
    #define HUD_PLAY_TIME HUD_GAME + 1
    #define HUD_FULLSERVER HUD_PLAY_TIME + 12 // Every character of "Full Server!" takes an id.

    #define HUD_RESISTS HUD_FULLSERVER + 2 * MAX_RESISTS
    #define HUD_ADMIN HUD_RESISTS + 200

    // Stat specific drawing uses a lot of IDs because it currently draws 2 things for each player.
    #define HUD_ENDINGHEADER HUD_ADMIN + 10
    #define HUD_ENDINGSURVIVORS HUD_ENDINGHEADER + 150
    #define HUD_ENDINGHORDE HUD_ENDINGSURVIVORS + 150
