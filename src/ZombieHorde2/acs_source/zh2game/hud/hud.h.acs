    #define HUD_BASE 5000
    #define HUD_CURSOR HUD_BASE
    #define HUD_VERSION HUD_CURSOR + 3
    #define HUD_PLAYERSTATUS HUD_VERSION + 200
    #define HUD_PLAYERPOWERS HUD_PLAYERSTATUS + 60
    #define HUD_PLAYERBAR HUD_PLAYERPOWERS + 4
    #define HUD_PLAYERBLUR HUD_PLAYERBAR + 3 // Underwater blur, hurt blur, hurt blur (heartbeat based).
    #define HUD_PLAYERINVENTORY HUD_PLAYERBLUR + 100
    #define HUD_PREGAMESTATE HUD_PLAYERINVENTORY + 2
    #define HUD_TIMER HUD_PREGAMESTATE + 3
