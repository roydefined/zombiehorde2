#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace IO
{
    internal bool ParseItems(int handle, str identifyingSymbol)
    {
        // Also supporting plurals
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "items"))
            return false;

        Logger::LogDebug(LOGSOURCE , "Start parsing items.");

        int braceLevel = Tokenizer::GetBraceLevel(handle);
        if (!Tokenizer::ExpectNextChar(handle, '{'))
            return false;

        Tokenizer::Next(handle);

        // While the brace level does not match the end level, we keep parsing.
        while (Tokenizer::CanRead(handle) && Tokenizer::GetBraceLevel(handle) != braceLevel)
        {
            if (ParseItem(handle))
                continue;

            Tokenizer::SetErrored(handle, "Unknown symbol whilst parsing items: '" + Tokenizer::GetSymbol(handle) + "'.");
            return false;
        }

        // Peek next character, see if we have a comma.
        // These are optional and if so, make sure to skip it.
        Tokenizer::Next(handle, false);
        if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
            Tokenizer::Next(handle, false);

        Logger::LogDebug(LOGSOURCE , "Finished parsing items of this lump.");
        return true;
    }

    internal bool ParseItem(int handle)
    {
        if (!BCSUTILS::StrIEquals(Tokenizer::GetSymbol(handle), "item"))
            return false;

        Logger::LogDebug(LOGSOURCE , "Start parsing single item.");
        Tokenizer::Next(handle);

        // Expecting a string-like type for the name
        Tokenizer::TokenTypeT token = Tokenizer::GetToken(handle);
        if (token != Tokenizer::TSYMBOL && token != Tokenizer::TSTRING)
        {
            Tokenizer::SetErrored(handle, "Expected symbol or string for item, received '" + Tokenizer::GetSymbol(handle) + "'.");
            return false;
        }

        str name = Tokenizer::GetSymbol(handle);

        if (!Tokenizer::ExpectNextToken(handle, Tokenizer::TLBRACE)) return false;
        int braceLevel = Tokenizer::GetBraceLevel(handle);

        Tokenizer::Next(handle);

        // No more room for more items. Log a warning and skip the remaining body.
        int count = ZH2Game::PersistingGameContext.ItemCollection.Size;
        if (count >= MAX_ITEMS)
        {
            Logger::LogWarning(LOGSOURCE , "The maximum number of configurable items was reached (" + str(count) + ").");
            Tokenizer::ParseRemainingBodyAsEmpty(handle);
            return true;
        }

        // As long as we are inside this body, parse properties and insert them into the new item.
        while (Tokenizer::CanRead(handle) && Tokenizer::GetBraceLevel(handle) == braceLevel)
        {
            str symbol = Tokenizer::GetSymbol(handle);
            if (ParseItemSpecieOwned(handle, symbol)
                || ParseItemGiveOnSpawn(handle, symbol)
                || ParseItemGiveOnSpecie(handle, symbol)
                || ParseItemType(handle, symbol)
                || ParseItemGraphic(handle, symbol)
                || ParseItemLabel(handle, symbol)
                || ParseItemDescription(handle, symbol)
                || ParseItemBloodSeverity(handle, symbol)
                || ParseItemBloodTics(handle, symbol)
                || ParseItemTakeOnPanic(handle, symbol))
            {
                // Optional comma.
                Tokenizer::Next(handle, false);
                if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
                    Tokenizer::Next(handle, false);

                continue;
            }

            Tokenizer::SetErrored(handle, "Unknown symbol whilst parsing an item: '" + Tokenizer::GetSymbol(handle) + "'.");
            return false;
        }

        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];
        context.Name = name;

        // Optional comma.
        Tokenizer::Next(handle, false);
        if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
            Tokenizer::Next(handle, false);

        // TODO: Log data
        Logger::LogDebug(LOGSOURCE , "Finished parsing item: \cd" + context.Name + "\cj.");
        ZH2Game::PersistingGameContext.ItemCollection.Size++;
        return true;
    }

    internal bool ParseItemSpecieOwned(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "humanowned")
            && !BCSUTILS::StrIEquals(identifyingSymbol, "zombieowned")) return false;

        str specie = Tokenizer::GetSymbol(handle);
        Tokenizer::Next(handle);

        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];
        if (BCSUTILS::StrIEquals(specie, "humanowned")) context.HumanOwned = true;
        else context.ZombieOwned = true;

        Logger::LogDebug(LOGSOURCE , "Parsed item specie owned. Specie symbol: \cd" + specie + "\cj.");
        return true;
    }

    internal bool ParseItemGiveOnSpawn(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "giveonspawn")) return false;

        str specie = Tokenizer::GetSymbol(handle);
        Tokenizer::Next(handle);

        if (!Tokenizer::TryParseIntValue(handle))
        {
            Tokenizer::SetErrored(handle, "The given value for GiveOnSpawn is not a correct value. Expected a valid numeric value within bounds.");
            return false;
        }

        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];

        int parsedValue = (int)Tokenizer::GetParsedValue();
        context.GiveOnSpawnCount = parsedValue;

        Tokenizer::Next(handle);

        Logger::LogDebug(LOGSOURCE , "Parsed item give on spawn. Amount: \cd" + str(parsedValue) + "\cj.");
        return true;
    }

    internal bool ParseItemGiveOnSpecie(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "giveonhuman")
            && !BCSUTILS::StrIEquals(identifyingSymbol, "giveonzombie")) return false;

        str specie = Tokenizer::GetSymbol(handle);
        Tokenizer::Next(handle);

        if (!Tokenizer::TryParseIntValue(handle))
        {
            Tokenizer::SetErrored(handle, "The given value for GiveOnHuman/GiveOnZombie is not a correct value. Expected a valid numeric value within bounds.");
            return false;
        }

        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];

        int parsedValue = (int)Tokenizer::GetParsedValue();
        if (BCSUTILS::StrIEquals(specie, "giveonhuman")) context.GiveOnHumanCount = parsedValue;
        else context.GiveOnZombieCount = parsedValue;

        Tokenizer::Next(handle);

        Logger::LogDebug(LOGSOURCE , "Parsed item give on specie. Specie symbol: \cd" + specie + "\cj. Amount: \cd" + str(parsedValue) + "\cj.");
        return true;
    }

    internal bool ParseItemType(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "isweaponitem")
            && !BCSUTILS::StrIEquals(identifyingSymbol, "isinventoryitem")
            && !BCSUTILS::StrIEquals(identifyingSymbol, "iskeyitem")) return false;

        Tokenizer::Next(handle);

        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];
        context.Type = BCSUTILS::StrIEquals(identifyingSymbol, "isweaponitem") ? Item::TYPE_WEAPON
                     : BCSUTILS::StrIEquals(identifyingSymbol, "isinventoryitem") ? Item::TYPE_INVENTORY
                     : BCSUTILS::StrIEquals(identifyingSymbol, "iskeyitem") ? Item::TYPE_KEY
                     : Item::TYPE_NONE;

        Logger::LogDebug(LOGSOURCE , "Parsed item type: " + str(context.Type) + ".");
        return true;
    }

    internal bool ParseItemGraphic(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "graphic")) return false;
        Tokenizer::Next(handle);

        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];
        context.Graphic = Tokenizer::GetSymbol(handle);

        Tokenizer::Next(handle);

        Logger::LogDebug(LOGSOURCE , "Parsed item graphic: \cd" + context.Graphic + "\cj.");
        return true;
    }

