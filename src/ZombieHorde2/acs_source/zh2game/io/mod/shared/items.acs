    internal bool ParseItemTakeOnPanic(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "takeonpanic")) return false;

        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];
        context.TakeOnPanic = true;

        Logger::LogDebug(LOGSOURCE , "Parsed item take on panic.");
        return true;
    }
}