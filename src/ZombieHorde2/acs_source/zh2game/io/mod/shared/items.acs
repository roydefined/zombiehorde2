    internal bool ParseItemBloodSeverity(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "bloodseverity")) return false;
        Tokenizer::Next(handle);

        if (!Tokenizer::TryParseIntValue(handle))
        {
            Tokenizer::SetErrored(handle, "The given value for blood severity is not a correct value. Expected a valid numeric value within bounds.");
            return false;
        }

        int parsedValue = (int)Tokenizer::GetParsedValue();
        Item::ItemContextT global:PERSISTINGGAMECONTEXTINDEX& context = ZH2Game::PersistingGameContext.ItemCollection.Collection[ZH2Game::PersistingGameContext.ItemCollection.Size];
        context.BloodSeverity = parsedValue;

        Tokenizer::Next(handle);

        Logger::LogDebug(LOGSOURCE , "Parsed blood severity: \cd" + str(context.BloodSeverity) + "\cj.");
        return true;
    }

