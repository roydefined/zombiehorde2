#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Event
{
    void ReceiveInitialsChosen(str packet)
    {
        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int count = Packet::Packet_Rval;
        SetReceiveData(0, count);

        int index = 1;
        while (count--)
        {
            packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
            SetReceiveData(index++, Packet::Packet_Rval);
        }
    }

    void ReceivePlayerLeftRound(str packet)
    {
        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int id = Packet::Packet_Rval;

        SetReceiveData(0, id);
    }

    void ReceivePlayerDied(str packet)
    {
        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int killedId = Packet::Packet_Rval;

        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int killerId = Packet::Packet_Rval;

        SetReceiveData(0, killedId);
        SetReceiveData(1, killerId);
    }

    void ReceivePlayerScratched(str packet)
    {
        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int attackedId = Packet::Packet_Rval;

        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int attackerId = Packet::Packet_Rval;

        SetReceiveData(0, attackedId);
        SetReceiveData(1, attackerId);
    }

