    void ReceivePlayerSpecieChanged(str packet)
    {
        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int id = Packet::Packet_Rval;

        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int specieInt = Packet::Packet_Rval;

        SetReceiveData(0, id);
        SetReceiveData(1, specieInt);
    }

    void ReceivePlayerSafe(str packet)
    {
        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int id = Packet::Packet_Rval;

        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int safe = Packet::Packet_Rval;

        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int firstTime = Packet::Packet_Rval;

        SetReceiveData(0, id);
        SetReceiveData(1, safe);
        SetReceiveData(2, firstTime);
    }

