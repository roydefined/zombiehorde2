    void ReceiveRoundSwitched(str packet)
    {
        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int prevIndex = Packet::Packet_Rval;

        packet = Packet::Packet_Read(packet, Packet::PACKET_WORD);
        int newIndex = Packet::Packet_Rval;

        SetReceiveData(0, prevIndex);
        SetReceiveData(1, newIndex);
    }

