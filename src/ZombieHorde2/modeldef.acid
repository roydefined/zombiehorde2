// Everything related to the "acid spit" zombie ability.
// Note every model defined here has its skin baked in, hence why `Skin` is not specified.

Model ZH2ZombieAcidSpitMissile
{
	Path "models/acid"
	Model 0 "zombieacid.md3"
	Scale 0.8 0.8 0.8
	PITCHFROMMOMENTUM

	FrameIndex ACID J 0 0
}

Model ZH2ZombieAcidSpot
{
	Path "models/acid"
	Model 0 "acidspot.md3"
	Scale 35 35 35
	ZOffset 0.1

	FrameIndex ACIF A 0 0
}

Model ZH2ZombieAcidSpotSmall
{
	Path "models/acid"
	Model 0 "acidspot.md3"
	Scale 25 25 25
	ZOffset 0.1

	FrameIndex ACIF A 0 0
}

Model ZH2ZombieAcidSpotBig
{
	Path "models/acid"
	Model 0 "acidspot.md3"
	Scale 50 50 50
	ZOffset 0.1
	
	FrameIndex ACIF A 0 0
}