Actor ZH2TeleportFog replaces TeleportFog
{
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTELEPORT
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_PlaySound("sound/TELEPORT")
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2TeleportFogParticle", FRandom(-20.0, 20.0), FRandom(-20.0, 20.0), FRandom(0.0, 60), 0, 0, FRandom(0.2, 1.5), Random(0, 360))
			Stop
	}
}

Actor ZH2TeleportFogParticle
{
	+MISSILE
	+BRIGHT
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEXYBILLBOARD
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_Jump(128, 1)
			Goto Spawn.Rest
			TNT1 B 0
			
		Spawn.Rest:
			TNT1 "#" 0 A_SetScale(FRandom(0.1, 0.5), FRandom(0.1, 0.5))
			TNT1 "#" 0 A_SetTranslucent(FRandom(0.6, 0.9))
			TSPK "#" 0 A_SetTics(Random(20, 35))
			TSPK "#" 1 A_FadeOut(0.05)
			Wait
		
		Death:
			TNT1 A 0
	}
}