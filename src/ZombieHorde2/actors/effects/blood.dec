
// Human blood and zombie blood are both the set defaults for the human and zombie classes.

actor ZH2HumanBlood : Blood
{
	Height 2
	Radius 2
	
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEXYBILLBOARD
	+THRUACTORS
	+DONTSPLASH
	+NOTELEPORT
	+MISSILE
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetTranslucent(FRandom(0.8, 1.0))
			TNT1 A 0 A_SetScale(FRandom(0.6, 1.0), FRandom(0.6, 1.0))
		Spawn.Rest:
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Death.Underwater")
			BLDD A 1 A_SetScale(ScaleX * FRandom(0.95, 0.99), ScaleY * FRandom(0.95, 0.99))
			TNT1 A 0 A_FadeOut(FRandom(0.01, 0.04))
			loop
		
		Death:
			TNT1 A 0 A_SpawnItemEx("ZH2BloodSpot", FRandom(-5.0, 5.0), FRandom(-5.0, 5.0), FRandom(-5.0, 5.0), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION)
			Stop
		
		Death.Underwater:
			TNT1 A 0 A_SetScale(FRandom(0.1, 0.4), FRandom(0.1, 0.4))
		Death.UnderwaterRest:
			BLDU A 1 A_ScaleVelocity(0.90)
			TNT1 A 0 A_SetScale(ScaleX * FRandom(1.01, 1.05), ScaleY * FRandom(1.01, 1.05))
			TNT1 A 0 A_FadeOut(FRandom(0.01, 0.05))
			Loop
	}
}

actor ZH2ZombieBlood : ZH2HumanBlood
{
	Translation "0:255=%[0.00,0.00,0.00]:[0.00,1.31,0.00]"
}

actor ZH2BloodSpot
{
	Radius 1
    Height 1
	Renderstyle Translucent
	Alpha 0.6
	Scale .3
	
	+CLIENTSIDEONLY
	+NOTELEPORT
	+NOBLOCKMAP
	+MOVEWITHSECTOR
	+DONTSPLASH
	+NOTIMEFREEZE
	
	States
	{
		// Randomized spawn frame.
		// Frames ABC are regular sprites.
		// Frames DEF are 3d models.
		// Bigger chance to spawn a 3d model.
		
		// Frames GH are for when the blood is placed in liquid, which means it shows a different model.
		
		Spawn:
			TNT1 A 0 NoDelay A_JumpIf(z - floorz < 16 && CallACS("zh2_dec_isliquid") == true, "Spawn.Liquid")
			TNT1 A 0 A_Jump(220, "Spawn.Model")
			TNT1 A 0 A_Jump(170, 1, 2)
			Goto Spawn.Rest
			TNT1 B 0
			Goto Spawn.Rest
			TNT1 C 0
			Goto Spawn.Rest
			
		Spawn.Model:
			TNT1 D 0 A_Jump(170, 1, 2)
			Goto Spawn.Rest
			TNT1 E 0
			Goto Spawn.Rest
			TNT1 F 0
			Goto Spawn.Rest
			
		Spawn.Rest:
			TNT1 "#" 0 A_JumpIf(waterlevel != 0, "Death")
			BLDS "#" 0 A_SetTics(Random(20, 60))
			BLDS "#" 1 A_FadeOut(.05)
			Wait
			
		Spawn.Liquid:
			TNT1 G 0 A_Jump(128, 1)
			Goto Spawn.LiquidRest
			TNT1 H 0
			
		Spawn.LiquidRest:
			TNT1 "#" 0 A_SetScale(FRandom(0.1, 0.4), FRandom(0.1, 0.4))
		Spawn.LiquidRestRest:
			BLDS "#" 1 A_FadeOut(FRandom(0.005, 0.02))
			TNT1 "#" 0 A_SetScale(ScaleX * FRandom(1.005, 1.02), ScaleY * FRandom(1.005, 1.02))
			Loop
		
		Death:
			TNT1 A 0
			stop
	}
}
