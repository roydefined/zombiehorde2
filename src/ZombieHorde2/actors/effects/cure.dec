actor ZH2CureEffect
{
    +CLIENTSIDEONLY
    +NOINTERACTION
    +NOTELEPORT

    states
    {
        spawn:
            TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 NoDelay A_SpawnItemEx("Internal_ZH2CureParticle", FRandom(-20.0, 20.0), FRandom(-20.0, 20.0), FRandom(0.0, 60), 0, 0, FRandom(0.2, 1.5), Random(0, 360))
            TNT1 A 10 Light("ZH2CureEffectLight1")
            TNT1 A 8 Light("ZH2CureEffectLight2")
            TNT1 A 6 Light("ZH2CureEffectLight3")
            TNT1 A 4 Light("ZH2CureEffectLight4")
            stop
    }
}

actor Internal_ZH2CureParticle
{
    renderstyle add

    +BRIGHT
    +NOINTERACTION
    +CLIENTSIDEONLY
    +FORCEXYBILLBOARD

    states
    {
        spawn:
            TNT1 A 0 nodelay A_SetScale(FRandom(0.1, 0.5), FRandom(0.1, 0.5))
            SPAK A 0 A_SetTics(Random(20, 35))
            SPAK A 1 A_FadeOut(FRandom(0.05, 0.1))
            wait
    }
}