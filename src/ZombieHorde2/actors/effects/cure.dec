actor CureEffect
{
    +CLIENTSIDEONLY
    +NOINTERACTION
    +NOTELEPORT

    states
    {
        spawn:
            TNT1 A 0 nodelay A_PlaySound("specie/CURE", CHAN_AUTO)
            TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("Internal_CureParticle", FRandom(-20.0, 20.0), FRandom(-20.0, 20.0), FRandom(0.0, 60), 0, 0, FRandom(0.2, 1.5), Random(0, 360))
            TNT1 A 5 Light("CureLight1")
            TNT1 A 5 Light("CureLight2")
            TNT1 A 5 Light("CureLight3")
            TNT1 A 5 Light("CureLight4")
            stop
    }
}

actor Internal_CureParticle
{
    renderstyle add

    +BRIGHT
    +NOINTERACTION
    +CLIENTSIDEONLY
    +FORCEXYBILLBOARD

    states
    {
        spawn:
            TNT1 A 0 nodelay A_SetScale(FRandom(0.1, 0.5), FRandom(0.1, 0.5))
            TNT1 A 0 A_SetTics(Random(20, 35))
            SPAK A 1 A_FadeOut(FRandom(0.05, 0.1))
            wait
    }
}