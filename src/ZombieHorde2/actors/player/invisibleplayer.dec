actor InvisiblePlayer : PlayerPawn
{
	Health 100
	Radius 16
	Height 56
	
	Player.DamageScreenColor none, 0.0
	
	Player.DisplayName ""
	Player.Soundclass ""
	
    Player.StartItem "ZH2NothingWeapon"
	
	States
	{
		Spawn:
			TNT1 A 1
			loop
		
		See:
			TNT1 A 0
			goto Spawn
		
		Missile:
			TNT1 A 0
			Goto Spawn
		
		Melee:
			TNT1 A 0
			goto Missile
			
		Death:
			TNT1 A 0
			
		XDeath:
			TNT1 A 0
	}
}