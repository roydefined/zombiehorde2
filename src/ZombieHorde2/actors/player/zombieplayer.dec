actor ZombiePlayer : PlayerPawn
{
	Player.forwardmove 0.8
	Player.sidemove 0.4
	Player.MaxHealth 999999
	Speed 1.25
	
	// Value is determined upon infection unless you morphed through debugging or something.
	Health 1000
	
	Radius 16
    Height 56
	PainChance 255
	
	Mass 40
	
	Player.AirCapacity 0
	Player.DamageScreenColor none, 0.0
	Player.RunHealth 100
	
	Player.DisplayName "Zombie"
	Player.Soundclass "zombie"
	BloodType "ZH2ZombieBlood"
	BloodColor 0 100 0
	
	+USEDAMAGEEVENTSCRIPT
	+NOMORPHLIMITATIONS
	+CROUCHABLEMORPH
	
	States
	{
		Spawn:
			NULL A 1
			wait
			
		See:
			NULL ABCDEF 5
			loop
			
		Melee:
		Missile:
			TNT1 A 0 A_Jump(128, "FireRight")
		
		FireLeft:
			NULL G 3
			NULL H 2
			goto Spawn
			
		FireRight:
			NULL R 3
			NULL S 2
			goto Spawn
			
		Pain:
			TNT1 A 0 A_SetBlend ("00 20 00", 0.7, 6)
			NULL L 8 A_Pain
			goto Spawn
			
		Death:
		XDeath:
		AltSkinDeath:
		AltSkinXDeath:
			NULL M 3 A_PlayerScream
			NULL N 3
			NULL N 3
			NULL O 3 A_NoBlocking
			NULL PQ 3
			NULL Q -1
	}
}