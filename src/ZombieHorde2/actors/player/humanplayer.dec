actor HumanPlayer : PlayerPawn
{
    Health 100
    Radius 16
    Height 56
    Mass 40

    Player.ForwardMove 0.8
    Player.SideMove  0.4
    Player.DamageScreenColor none, 0.0
    Player.MaxHealth 100
    Player.RunHealth 20

    Player.DisplayName "Human"
    Player.Soundclass "human"
    BloodType "ZH2HumanBlood"

    +USEDAMAGEEVENTSCRIPT
    +NOMORPHLIMITATIONS
    +CROUCHABLEMORPH
    +NODAMAGETHRUST

    States
    {
        Spawn:
            NULL A -1
            loop

        See:
            NULL ABCD 5
            goto Spawn

        Missile:
            NULL E 12
            Goto Spawn

        Melee:
            NULL F 6
            goto Missile

        Pain.Drowning:
            TNT1 A 0 A_PlaySound("*drownpain")
            goto Pain.Rest
        Pain:
            TNT1 A 0 A_SetBlend ("20 00 00", 0.7, 6)
            TNT1 A 0 A_Pain
        Pain.Rest:
            NULL G 5
            goto Spawn

        Pain.Silent:
            TNT1 A 0
            goto Spawn

        Death.Drowning:
            TNT1 A 0 A_PlaySound("*drowndeath")
            goto Death.Rest

        Death:
            TNT1 A 0 A_PlayerScream
        Death.Rest:
            NULL H 10
            NULL I 10
            NULL J 10 A_NoBlocking
            NULL KLM 10
            NULL N -1

        XDeath:
            NULL O 5
            NULL P 5 A_XScream
            NULL Q 5 A_NoBlocking
            NULL RSTUV 5
            NULL W -1
    }
}