actor ZH2WeaponRiotGunSpinning : Boolean {}

actor ZH2WeaponRiotgunSpawn : ZH2WeaponSpawn 25198
{
    inventory.PickupMessage "Riot Gun"
    tag "Riot Gun"

    states
    {
        Spawn:
            WRGI A -1
            stop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_GiveInventory("ZH2WeaponRiotGun", 1)
            stop
    }
}

actor ZH2WeaponRiotGun : ZH2Weapon
{
    tag "Riot gun"

    weapon.SlotNumber 4
    weapon.KickBack 60

    States
    {
        Ready:
            WRGR A 1 A_WeaponReady
            loop

        Deselect:
            WRGS KJIHGFEDCBA 2
            TNT1 A 0 A_Lower
            wait

        Select:
            TNT1 A 0 A_Raise
            TNT1 A 0 A_WeaponReady(WRF_NOFIRE | WRF_NOSWITCH)
            WRGS ABCDEFGHIJK 2
            goto Ready

        Fire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
		
			// Check if we spun up. If not we should do that first.
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponRiotGunSpinning", 1, "Fire.Main")
            goto Fire.SpinUp
		
        Fire.Main:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Fire.SpinDown")
            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, true)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", true)
			
            TNT1 A 0 A_AlertMonsters
            TNT1 A 0 A_Quake(1, 8, 0, 128)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_tracer_prepare", 12, 5)
			TNT1 A 0 A_FireBullets(5.0, 5.0, 8, 25 + random(-1, 1) * 5, "ZH2WeaponBulletPuff", FBF_NORANDOM)

            WRGF ABC 1 bright
			WRGF DEFGH 1

            TNT1 A 0 A_Refire("Fire.Main")
            goto Fire.SpinDown
			
		Fire.SpinUp:
            TNT1 A 0 A_WeaponReady(WRF_NOFIRE | WRF_NOSWITCH)
            WRGB BC 5
            WRGB DE 4
            WRGB F 3
			
			// Brief moment where we can switch.
            WRGB GH 2 A_WeaponReady(WRF_NOFIRE)
            WRGB A 1
			
			// Require refire or spin back down.
			TNT1 A 0 A_Refire("Fire.Main")
			goto Fire.SpinDown
			
		Fire.SpinDown:
			TNT1 A 0 A_WeaponReady(WRF_NOFIRE | WRF_NOSWITCH)
            WRGB BC 1
            WRGB DE 2
            WRGB F 3
            WRGB GH 4
			
			// Brief moment where we can switch.
            WRGB A 5 A_WeaponReady(WRF_NOFIRE)
			
			// On holding fire we spin back up.
			TNT1 A 0 A_Refire("Fire.SpinUp")
			goto Ready
    }
}