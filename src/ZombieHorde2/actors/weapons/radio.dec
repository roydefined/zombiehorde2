Actor ZH2WeaponRadioSpawn : ZH2WeaponSpawn 11007
{
	radius 16
	height 8
	
	Inventory.PickupMessage "Radio"
	Tag "Radio"
	
	States
	{
		Spawn:
			RDIA A -1
			Stop
		Pickup:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
			stop
			TNT1 A 0 A_GiveInventory("ZH2WeaponRadio", 1)
			stop
	}
}

Actor ZH2WeaponRadio : ZH2Weapon
{
	weapon.PreferredSkin "Radio"
	Tag "Radio"
	Weapon.SlotNumber 1
	
	+WEAPON.NOAUTOFIRE
	
	States
	{
		Ready:
			RDIO A 1 A_WeaponReady(WRF_ALLOWRELOAD)
			wait
		
		Deselect:
			RDIS FEDCBA 1
			TNT1 A 0 A_Lower
			wait
			
		Select:
			TNT1 A 0 A_Raise
			RDIS ABCDEFGHI 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			goto Ready
		
		Fire:
			TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_radio_cyclemusic", 1)
			goto Ready
			
		Altfire:
			TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_radio_cyclemusic", -1)
			goto Ready
		
		Reload:
			TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
			RDIW ABCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX Y 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			TNT1 A 0 A_PlaySound("weapons/radio/EJECT")
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_radio_stopmusic")
			RDIX Y 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIW EFGHIJKLM 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIW N 3 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIW OPQRSTUVWXYZ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX B 2 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			TNT1 A 0 A_PlaySound("weapons/radio/PLACE")
			RDIX C 3 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			TNT1 A 0 A_PlaySound("weapons/radio/INSERT")
			RDIX D 2 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX EFGHI 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX JK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX Z 4 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			TNT1 A 0 A_PlaySound("weapons/radio/CLOSE")
			RDIX Z 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX L 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_radio_setcurrentmusic")
			RDIX M 3 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX N 2 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			RDIX OPQ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			goto Ready
	}
}