actor ZH2FloatyIcon : FloatyIcon replaces FloatyIcon
{
    States
    {
        Spawn:
            TNT1 A 0
            stop

        CHAT:
            TALK ABC 10 bright
            loop
        VOICECHAT:
            SPKR ABC 5 bright
            loop
        INCONSOLE:
            CNSL AB 8 bright
            loop
        INMENU:
            MENU AB 8 bright
            loop

        // TODO
        ALLY:
            TNT1 A -1
            loop
        ENEMY:
            TNT1 A -1
            loop

        LAG:
            LAGG ABC 8
            loop
    }
}
