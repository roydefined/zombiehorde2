// Remaining sprint energy of a human.
actor ZH2SprintEnergy : Integer { Inventory.MaxAmount 1000 }

// Represents the timestamp when the zombie teleport is to trigger.
actor ZH2ZombieTeleportTimestamp : Integer {}

// Used with map voting to determine when this player voted for a map.
// Used as a cooldown so the player doesn't send too many picks.
actor ZH2PlayerPickTimestamp : Integer {}

// Indicates the index of the ability to trigger on the claws.
actor ZH2DoZombieAbilityIndex : Integer {}

// Timestamp cools down different zombie abilities
actor ZH2ZombieAbility0Timestamp : Integer {}
actor ZH2ZombieAbility1Timestamp : Integer {}

// Indicates to the client and the server that the weapon may not be fired.
actor ZH2BlockWeaponFiring : Boolean {}