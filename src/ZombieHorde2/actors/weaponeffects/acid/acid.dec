Actor ZH2ZombieAcidSmoke
{
	+MISSILE
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEXYBILLBOARD
	+THRUACTORS
	
	Alpha 0
	
	RenderStyle Translucent
	var int user_Tics;
			
	States
	{
		Spawn.Rest:
			TNT1 A 0 A_SetUserVar("user_Tics", user_Tics-1)
			TNT1 A 0 A_JumpIf(user_Tics < 0, "Spawn.Ending")
			TNT1 A 0 A_ScaleVelocity(FRandom(0.95, 0.99))
			ASMK A 2 A_FadeIn(0.01)
			loop
		Spawn.Ending:
			ASMK A 4 A_FadeOut(0.05)
			loop
	}
}

#include "actors/weaponeffects/acid/floor.dec"
#include "actors/weaponeffects/acid/missile.dec"