Actor ZH2ZombieAcidSpot
{
	+NOTELEPORT
	+NOBLOCKMAP
	+NODAMAGETHRUST
	+MOVEWITHSECTOR
	+DONTSPLASH
	+BRIGHT
	
	Radius 8
	Height 4
	
    Renderstyle Translucent
	
	States
	{
		Spawn:
			TNT1 AAA 0 NoDelay A_SpawnItemEx("ZH2ZombieAcidSpotSmoke", Random(-10, 10), Random(-10, 10), Random(2, 10), FRandom(-1.0, 1.0), FRandom(-1.0, 1.0), FRandom(0.1, 1.0))
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 25 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 100, 200, 5)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 25 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 100, 200, 5)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 25 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 100, 200, 5)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 25 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 100, 200, 5)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 25 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 100, 200, 5)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 25 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 100, 200, 5)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 25 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 100, 200, 5)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 1 A_FadeOut(.02)
			Wait
			
		Spawn.Water:
			ACIF A 1 A_FadeOut(.05)
			stop
	}
}

Actor ZH2ZombieAcidSpotBig : ZH2ZombieAcidSpot
{
	Scale .8
	
	States
	{
		Spawn:
			TNT1 AAAA 0 NoDelay A_SpawnItemEx("ZH2ZombieAcidSpotSmokeBig", Random(-10, 10), Random(-10, 10), Random(2, 10), FRandom(-1.5, 1.5), FRandom(-1.5, 1.5), FRandom(0.1, 0.7))
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 10 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 200, 200, 10)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 10 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 200, 200, 10)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 10 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 200, 200, 10)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 10 ACS_NamedExecuteAlways("zh2_dec_setacid_area_targetsource", 0, 200, 200, 10)
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 1 A_FadeOut(.01)
			Wait
	}
}

Actor ZH2ZombieAcidSpotSmall : ZH2ZombieAcidSpot
{
	Scale 1.2
	
	States
	{
		Spawn:
			TNT1 AAA 0 NoDelay A_SpawnItemEx("ZH2ZombieAcidSpotSmokeSmall", Random(-10, 10), Random(-10, 10), Random(2, 10), FRandom(-0.5, 0.5), FRandom(-0.5, 0.5), FRandom(0.1, 0.5))
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 10
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 10
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Spawn.Water")
			ACIF A 1 A_FadeOut(.05)
			Wait
	}
}

Actor ZH2ZombieAcidSpotSmoke : ZH2ZombieAcidSmoke
{
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetUserVar("user_Tics", Random(30, 60))
			TNT1 A 0 A_SetScale(FRandom(0.4, 0.8), FRandom(0.4, 0.8))
			goto Spawn.Rest
	}
}

Actor ZH2ZombieAcidSpotSmokeBig : ZH2ZombieAcidSmoke
{
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetUserVar("user_Tics", Random(50, 90))
			TNT1 A 0 A_SetScale(FRandom(0.5, 1.0), FRandom(0.5, 1.0))
			goto Spawn.Rest
	}
}

Actor ZH2ZombieAcidSpotSmokeSmall : ZH2ZombieAcidSmoke
{
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetUserVar("user_Tics", Random(10, 30))
			TNT1 A 0 A_SetScale(FRandom(0.1, 0.3), FRandom(0.1, 0.3))
			goto Spawn.Rest
	}
}