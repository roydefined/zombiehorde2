Actor ZH2ZombieAcidSpitMissileSmall
{
	Radius 8
	Height 16
	
	Projectile
	
	Scale 0.35
	Gravity 0.2
	Speed 10
	
	-NOGRAVITY
	+DONTSPLASH
	+NODAMAGETHRUST
	+FORCEXYBILLBOARD
	+BRIGHT
	
	Renderstyle Add
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_ScaleVelocity(FRandom(1.0, 2.0))
			ACID A 1 A_Jumpif(waterlevel != 0, "Death")
			wait
		
		Death:
			ACID BCD 2
			ACID EFGH 2 A_SpawnItemEx("ZH2ZombieAcidSpotSmall", Random(-15, 15), Random(-15, 15), 1, 0, 0, 0, 0)
		Death.Rest:
			ACID I 1 A_FadeOut(0.05)
			TNT1 A 0 A_JumpIf(waterlevel != 0, 1)
			loop
			TNT1 A 0
			stop
	}
}

Actor ZH2ZombieAcidSpitMissile : ZH2ZombieAcidSpitMissileSmall
{
	Scale 0.8
	Speed 22
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_Jumpif(waterlevel != 0, "Death")
			ACID J 3 A_SpawnItemEx("ZH2ZombieAcidSpitMissileSmall", 0, 0, 0, FRandom(-0.5, 0.5), FRandom(-0.5, 0.5), FRandom(-2.0, -0.2))
			loop
			
		Death:
			TNT1 A 0 A_PlaySound("weapons/acid/ACIDLOOP", CHAN_BODY)
			TNT1 AA 0 A_SpawnItemEx("ZH2ZombieAcidSpotBig", Random(-20, 20), Random(-20, 20), 1, 0, 0, 0, 0)
			ACID BCD 2 A_SpawnItemEx("ZH2ZombieAcidSpot", Random(-30, 30), Random(-30, 30), 1, 0, 0, 0, 0)
			TNT1 AAAAA 0  A_SpawnItemEx("ZH2ZombieAcidSpitMissileSecond", Random(-10, 10), Random(-10, 10), 1, 10.0, 10.0, FRandom(1.0, 2.5), Random(0, 360))
			ACID EEFFGGHH 1 A_SpawnItemEx("ZH2ZombieAcidSpotSmall", Random(-50, 50), Random(-50, 50), 1, 0, 0, 0, 0)
		Death.Rest:
			ACID I 1 A_FadeOut(0.05)
			TNT1 A 0 A_JumpIf(waterlevel != 0, 1)
			loop
			TNT1 A 0
			stop
	}
}


Actor ZH2ZombieAcidSpitMissileSecond : ZH2ZombieAcidSpitMissileSmall
{
	Gravity 0.6
	Scale 0.5
	
	States
	{
		Spawn:
			ACID A 1 NoDelay A_Jumpif(waterlevel != 0, "Death")
			wait
			
		Death:
			TNT1 A 0 A_PlaySound("weapons/acid/ACIDLOOP", CHAN_BODY)
			TNT1 A 0 A_SpawnItemEx("ZH2ZombieAcidSpotBig", Random(-20, 20), Random(-20, 20), 1, 0, 0, 0, 0)
			ACID BCD 2 A_SpawnItemEx("ZH2ZombieAcidSpot", Random(-30, 30), Random(-30, 30), 1, 0, 0, 0, 0)
			ACID EFGH 2 A_SpawnItemEx("ZH2ZombieAcidSpotSmall", Random(-50, 50), Random(-50, 50), 1, 0, 0, 0, 0)
		Death.Rest:
			ACID I 1 A_FadeOut(0.05)
			TNT1 A 0 A_JumpIf(waterlevel != 0, 1)
			loop
			TNT1 A 0
			stop
	}
}