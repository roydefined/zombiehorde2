Actor ZH2WeaponJacksGunSmokeInitial : ZH2WeaponSmokeSpawnerInternal
{
    States
    {
        Spawn.Regular:
            TNT1 AAAAAA 0 A_SpawnItemEx("ZH2WeaponSmokeInternal1", 0, Random(-5, 5), Random(-5, 5), 0, Random(-10, 10), Random(-10, 10))
            Stop

        Spawn.Underwater:
            TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2WeaponBubble", 0, 0, 0, 0, FRandom(-0.5, 0.5), FRandom(-0.5, 0.5), 0)
            Stop
    }
}

