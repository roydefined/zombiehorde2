Actor ZH2WeaponSmokeSpawnerInternal
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    Speed 60

    States
    {
        Spawn:
            // Intentional delay spawns the actor further in front.
            TNT1 A 1
            TNT1 A 0 A_Stop
            TNT1 A 0 A_JumpIf(waterlevel == 0, "Spawn.Regular")
            TNT1 A 0 A_Jump(256, "Spawn.Underwater")
    }
}

Actor ZH2WeaponSmokeInternal1
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +DONTSPLASH
    +FORCEXYBILLBOARD

    RenderStyle Add
    Scale 0.35
    Alpha 0.8

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_ScaleVelocity(0.8)
            TNT1 A 0 A_SetScale(ScaleX * FRandom(0.95, 0.99), ScaleY * FRandom(0.95, 0.99))
            SMKP A 1 A_FadeOut(0.05)
            Loop
    }
}

Actor ZH2WeaponSmokeInternal2 : ZH2WeaponSmokeInternal1
{
    Scale 0.25
    Alpha 0.7
}

Actor ZH2WeaponSmokeInternal3 : ZH2WeaponSmokeInternal1
{
    Scale 0.20
    Alpha 0.6
}

Actor ZH2WeaponSmokeInternal4 : ZH2WeaponSmokeInternal1
{
    Scale 0.15
    Alpha 0.5
}

actor ZH2WeaponBubble
{
    Height 0
    Radius 0
    Mass 0
    Alpha 0.6
    Scale 0.5

    +MISSILE
    +NOGRAVITY
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +DONTSPLASH
    +NOTIMEFREEZE
    +ALLOWPARTICLES
    +NOBLOCKMAP

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_ChangeVelocity(velx + FRandom(-0.5, 0.5), vely + FRandom(-0.5, 0.5), velZ + FRandom(0.2, 1.5))
            TNT1 A 0 A_Jump(180, 1)
            goto Spawn.Rest
            TNT1 B 0

        Spawn.Rest:
            TNT1 "#" 0 A_ChangeVelocity(0, 0, FRandom(0.01, 0.08))
            BUBL "#" 1 A_JumpIf(waterlevel < 1, 1)
            loop
            TNT1 A 0
            stop
    }
}

