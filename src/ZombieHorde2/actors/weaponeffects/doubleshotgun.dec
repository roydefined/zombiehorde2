	{
		Spawn.Regular:
			TNT1 AAAAAAAA 0 A_SpawnItemEx("ZH2WeaponSmokeInternal1", 0, Random(-4, 4), Random(-4, 4), 0, Random(-4, 4), Random(-4, 4))
			Stop
		
		Spawn.Underwater:
