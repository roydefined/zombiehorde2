actor ZH2WeaponRiotgunAmmoSpawn : ZH2AmmunitionSpawn 25197
{
    states
    {
        Spawn:
            WRGA A -1
            stop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
