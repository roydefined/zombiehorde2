actor ZH2ItemRewardOrbMinor : ZH2CustomInventoryPowerup 12015
{
    //$Sprite "RORBA0"
    //$Title "Reward orb (minor)"

    Radius 12
    Height 26

    inventory.Amount 1

    Inventory.Icon "RWDORB1I"
    Inventory.PickupMessage "Reward orb (minor)"
    Tag "Reward orb (minor)"

    Inventory.PickupSound "world/BONUSMINOR"

    +NOGRAVITY
    +BRIGHT
    +FLOATBOB

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
            TNT1 A 0 A_SpawnItemEx("ZH2RewardOrbFlare", 0, 0, 16)
            RORB A 1
            loop

        Spawn.NoSight:
            RORB A 1
            goto Spawn

        Pickup:
            TNT1 A 0 A_RailWait
            stop

        // Note, fail to take the item from ACS.
        Use:
            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_triggerreward", 0, REWARDORBMINOR)
            fail
    }
}

actor ZH2ItemRewardOrbMajor : ZH2CustomInventoryPowerup 12016
{
    //$Sprite "RORBB0"
    //$Title "Reward orb (major)"

    Radius 12
    Height 26

    inventory.Amount 1

    Inventory.Icon "RWDORB2I"
    Inventory.PickupMessage "Reward orb (major)"
    Tag "Reward orb (major)"

    Inventory.PickupSound "world/BONUSMAJOR"

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
            TNT1 A 0 A_SpawnItemEx("ZH2RewardOrbFlare", 0, 0, 16)
            RORB B 1
            loop

        Spawn.NoSight:
            RORB B 1
            goto Spawn

        Pickup:
            TNT1 A 0 A_RailWait
            stop

        // Note, fail to take the item from ACS.
        Use:
            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_triggerreward", 0, REWARDORBMAJOR)
            fail
    }
}

actor ZH2RewardOrbFlare : ZH2ItemLensFlare
{
    Scale .6
    Alpha .3

    States
    {
        Spawn:
            LFLR B 1 NoDelay Bright
            stop
    }
}