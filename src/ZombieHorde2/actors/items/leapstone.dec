actor ZH2ItemLeapstone : ZH2CustomInventoryPowerup 8024
{
	//$Sprite "LEAPA0"
	
	radius 8
	height 24
	
	Scale .8
	
	inventory.Amount 2
	inventory.MaxAmount 2
	
	inventory.icon "LEAPI"
	inventory.PickupMessage "Leap stone"
	tag "Leap stone"
	
	+NOGRAVITY
	+BRIGHT
	+FLOATBOB
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
			LEAP AAAAAAAAAABBBBBBBBBB 1 A_SpawnItemEx("ZH2LeapstoneFlare", 0, 0, 18)
			loop
		
		Spawn.NoSight:
			LEAP A 1
			goto Spawn
			
		Pickup:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == false, 2)
			TNT1 A 0 A_RailWait
			stop
			TNT1 A 0
			fail
		
		Use:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
			stop
			
			// Always work when in liquid.
			TNT1 A 0 A_JumpIf(waterlevel != 0, "Use.Rest")
			
			// Only use if grounded.
			TNT1 A 0 A_JumpIf(z - floorz < 16, "Use.Rest")
			stop
		Use.Rest:
			TNT1 A 0 A_PlaySound("items/LEAPSTONE")
			TNT1 A 0 ThrustThingZ (0, 100, 0, 0)
			TNT1 AAAAAAA 0 A_SpawnItemEx("ZH2LeapstoneSpark", FRandom(-5.0, 5.0), 0, 2, Frandom(-4.0, 4.0), Frandom(-4.0, 4.0), 0, 0, 0)
			TNT1 AAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2LeapstoneSpark", FRandom(-5.0, 5.0), 0, 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(3.0, 14.0), 0, 0)
			stop
	}
}

actor ZH2LeapstoneFlare : ZH2ItemLensFlare
{
	Scale .4
	Alpha .4
	
	States
	{
		Spawn:
			LFLR B 1 NoDelay Bright
			stop
	}
}

actor ZH2LeapstoneSpark
{
	Radius 4
	Height 4
	Alpha .4
	Scale .3
	
	RenderStyle Add
	
	+BRIGHT
	+NOINTERACTION
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_ChangeVelocity(0, 0, FRandom(0.05, 0.2))
			SPAK B 1 A_FadeOut(0.04)
			loop
	}
}