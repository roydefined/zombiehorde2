actor ZH2ItemFireMineThrown
{
	Radius 12
	Height 9
	speed 10
	monster
	
	+STANDSTILL
	+FLOORCLIP
	+FORCEXYBILLBOARD
	-SOLID
	+BRIGHT
	
	var int user_timer;
	var int user_firetotalcount;
	
	States
	{
		// Wait until we hit the floor before we start doing anything.
		Spawn:
			TNT1 A 0 NoDelay A_CheckFloor("Spawn.Floor")
			FBOM A 1
			loop

		Spawn.Floor:
			TNT1 A 0 A_Stop
			TNT1 A 0 A_SetUserVar("user_timer", 8)
			FBOM A 18
		Spawn.FloorRest:
			TNT1 A 0 A_JumpIf(user_timer == 0, "Spawn.Floor2")
			TNT1 A 0 A_PlaySound("items/FIREMINETIC")
			FBOM BBCCBB 2
			TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
			FBOM A 6
			loop
			
		Spawn.Floor2:
			TNT1 A 0 A_SetUserVar("user_timer", 8)
		Spawn.Floor3Rest:
			TNT1 A 0 A_JumpIf(user_timer == 0, "Spawn.Floor3")
			TNT1 A 0 A_PlaySound("items/FIREMINETIC")
			FBOM BCB 2
			TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
			FBOM A 2
			loop
			
		Spawn.Floor3:
			TNT1 A 0 A_SetUserVar("user_timer", 8)
		Spawn.Floor3Rest:
			TNT1 A 0 A_JumpIf(user_timer == 0, "Spawn.Floor4")
			TNT1 A 0 A_PlaySound("items/FIREMINETIC")
			FBOM BCB 1
			TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
			FBOM A 1
			loop
			
		Spawn.Floor4:
			TNT1 A 0 A_SetUserVar("user_timer", 12)
		Spawn.Floor4Rest:
			TNT1 A 0 A_JumpIf(user_timer == 0, "Spawn.Floor5")
			TNT1 A 0 A_PlaySound("items/FIREMINETIC")
			FBOM C 1
			TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
			FBOM B 1
			loop
			
		Spawn.Floor5:
			TNT1 A 0 A_SetUserVar("user_timer", 16)
		Spawn.Floor5Rest:
			TNT1 A 0 A_JumpIf(user_timer == 0, "Spawn.FloorEnd")
			TNT1 A 0 A_PlaySound("items/FIREMINETIC")
			FBOM C 1
			TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
			loop
			
		Spawn.FloorEnd:
			FBOM D 15 A_PlaySound("items/FIREMINETRIGGER")
			TNT1 A 0 A_SpawnItem("ZH2ItemFireMineExplosion")
			
			// Remain active for a period and turn it off after.
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_set_fire_mine_time", 0)
			TNT1 A 0 A_SetUserVar("user_timer", 0)
			
		Spawn.FloorEndRest:
		
			// This is ugly, but there doesn't seem to be a better way to have the sound play and be stoppable.
			TNT1 A 0 A_JumpIf(user_timer != 0, 3)
			TNT1 A 0 A_PlaySound("decoration/fire", CHAN_ITEM)
			TNT1 A 0 A_SetUserVar("user_timer", user_timer + 40)
			
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfire_area", 0, 120, 100, 10)
			TNT1 AA 0 A_SpawnItemEx("ZH2ItemFireMineFlame", Random(5, 64), Random(5, 64), 0, 0, 0, FRandom(0.1, 1.2), Random(0, 359))
			TNT1 A 0 A_SpawnItemEx("ZH2ItemFireMineFloorFlame", Random(10, 64), 0, 0, 0, 0, 0, Random(0, 359))
			
			TNT1 A 5
			
			TNT1 A 0 A_SetUserVar("user_timer", user_timer - 1)
			TNT1 A 0 A_SetUserVar("user_firetotalcount", user_firetotalcount - 1)
			TNT1 A 0 A_JumpIf(user_firetotalcount == 0, 1)
			loop
			TNT1 A 0 A_StopSound(CHAN_ITEM)
			stop
	}
}

actor ZH2ItemFireMineExplosion
{
	RenderStyle Translucent
	Alpha 0.6
	
	+FORCEYBILLBOARD
	+CLIENTSIDEONLY
	+BRIGHT
	
	states
	{
		spawn:
			TNT1 A 0 NoDelay A_PlaySound("sound/explosion1")
			EXP2 ABCDEFGHIJKLMN 2
			stop
	}
}

actor ZH2ItemFireMineFloorFlame
{
	RenderStyle Translucent
	Alpha 0.4
	
	+FORCEYBILLBOARD
	+CLIENTSIDEONLY
	+BRIGHT
	
	states
	{
		spawn:
			FFLG ABCDE 3 Light("ZH2FireMineFlameLight")
		spawn.Loop:
			FFLG FGHIJKLMNOPQ 3 Light("ZH2FireMineFlameLight") A_Fadeout(0.04)
			loop
	}
}

actor ZH2ItemFireMineFlame
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY
	+BRIGHT
	
	Renderstyle Add
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetTranslucent(Frandom(0.2, 0.6))
			TNT1 A 0 A_SetScale(Frandom(0.1, 0.4), Frandom(0.1, 0.4))
			FIR1 ABCDABCDABCDEFGHI 1
			Stop
	}
}