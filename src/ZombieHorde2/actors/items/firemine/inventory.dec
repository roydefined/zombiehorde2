actor ZH2ItemFireMine : ZH2CustomInventoryPowerup 21031
{
    Inventory.Amount 1
    Inventory.MaxAmount 1

    inventory.icon "FBOMBI"
    Inventory.PickupMessage "Fire mine"
    Tag "Fire mine"

    states
    {
        Spawn:
            FBOM A -1
            stop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_RailWait
            Stop

        Use:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_FireCustomMissile("ZH2ItemFireMineThrown", 0, false)
            stop
    }
}