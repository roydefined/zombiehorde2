actor ZH2ItemCirculator : ZH2CustomInventoryPowerup 24115
{
	Scale 0.7
	
	Inventory.Amount 1
	Inventory.MaxAmount 1
	
	Inventory.Icon "CCLIA0"
	Inventory.PickupMessage "Circulator"
	
	Tag "Circulator"
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
			CCLS D 1 A_SpawnItemEx("ZH2CirculatorFlare", 0, 0, 18)
			loop
		
		Spawn.NoSight:
			CCLS D 1
			goto Spawn
			
		Use:
			TNT1 A 1 A_SpawnItemEx ("ZH2ItemCirculatorThrown", 56, 0, 8, 0, 0, 0, 0, 1)
			Stop
	}
}

