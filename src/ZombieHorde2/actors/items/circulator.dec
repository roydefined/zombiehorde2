actor ZH2CirculatorFireBall
{
	Projectile
	Radius 8
	Height 8
	Speed 33
	Damage 1
	Alpha 0.75
	
	RenderStyle Add
	DeathSound "items/CIRCULATORFIREHIT"
	
	DamageType "ZH2SetOnFire"
	
	+RANDOMIZE
	
	States
	{
		Spawn:
			CCLZ ABCD 4
			Loop
			
		Death:
			CCLX ABC 6 Bright
			Stop
	}
}


Actor ZH2CirculatorFlare : ZH2ItemLensFlare
{
	Scale .6
	Alpha .4
	
	States
	{
		Spawn:
			LFLR B 1 NoDelay Bright
			stop
	}
}