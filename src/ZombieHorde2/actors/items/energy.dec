// Note, ZM26 and ZE29 uses this under the given doomednum.
Actor ZH2ItemEnergy : ZH2CustomInventoryPowerup 20046
{
    //$Sprite "ENERA0"

    Radius 4
    Height 17

    Inventory.Amount 1
    Inventory.MaxAmount 1

    inventory.icon "ENERGYI"
    Inventory.PickupMessage "Energy drink"
    Tag "Energy drink"

    states
    {
        Spawn:
            ENER A 1 NoDelay A_SpawnItemEx("ZH2EnergyFlare", 0, 0, 8)
            Loop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_RailWait
            TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_checkautouseenergy", 0)
            Stop

        Use:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            Stop
            TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_useenergy", 0)
            fail
    }
}

Actor ZH2EnergyFlare : ZH2ItemLensFlare
{
    Scale .4
    Alpha .3

    States
    {
        Spawn:
            LFLR B 1 NoDelay Bright
            stop
    }
}