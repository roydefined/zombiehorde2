actor ZH2ItemRewardBox : ZH2CustomInventoryPowerup 21426
{
	Radius 12
	Height 26
	
	Inventory.PickupMessage "Picked up some strange box!"
	Tag "Reward box"
	
	States
	{
		Spawn:
			BBOX A -1
			stop
			
		Pickup:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
			stop
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_givecontainer", 0, REWARDORBMINOR)
			stop
	}
}