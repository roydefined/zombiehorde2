actor ZH2ItemHolyCross : ZH2CustomInventoryPowerup 8023
{
    radius 18
    inventory.MaxAmount 1

    Scale .4

    inventory.icon "CROSSI"
    inventory.PickupMessage "Holy cross"
    tag "Holy cross"

    +NOGRAVITY
    +BRIGHT
    +FLOATBOB

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS AAA 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS AAA 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS AAA 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS AAA 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS AAA 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS AAA 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS BBB 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS CCC 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS DDD 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS EEE 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnEffect", 0, 0, 25)
            CROS FFF 1 A_SpawnItemEx("ZH2HolyCrossFlare", 0, 0, 24)
            loop

        Spawn.NoSight:
            CROS A 1
            goto Spawn

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == false, 2)
            TNT1 A 0 A_RailWait
            stop
            TNT1 A 0
            fail

        Use:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_PlaySound ("items/HOLYCROSS")
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, 1, 0, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, -1, 0, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, 0, 1, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, 0, -1, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, .5, 0, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, -.5, 0, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, 0, .5, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, 0, -.5, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2HolyCrossLight", 30, 0, 30, 10, 0, 0, 0, 0)
            stop
    }
}

actor ZH2HolyCrossFlare : ZH2ItemLensFlare
{
    Scale .6
    Alpha .5

    States
    {
        Spawn:
            LFLR D 1 NoDelay Bright
            stop
    }
}

actor ZH2CrossSpawnEffect
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(150, 1)
            stop
            TNT1 A 0 A_SpawnItemEx("ZH2CrossSpawnSpark", Random(-12, 12), Random(-12, 12), Random(-8, 8), 0, 0, 0, 0, 0)
            stop
    }
}

actor ZH2CrossSpawnSpark
{
    +BRIGHT
    +NOINTERACTION
    +CLIENTSIDEONLY
    +FORCEXYBILLBOARD

    Alpha 0
    RenderStyle Add
    var int user_Amount;

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(180, 1)
            stop
            TNT1 A 0 A_SetUserVar("user_Amount", random(0, 8))
            TNT1 A 0 A_SetScale(0.05 + 0.01 * user_Amount, 0.05 + 0.01 * user_Amount)
            SPAK BBBBBBBBBBBBBBBBBBB 1 A_FadeIn(0.005*user_Amount)
            SPAK BBBBBBBBBBBBBBBBBBB 1 A_FadeOut(0.005*user_Amount)
            stop
    }
}