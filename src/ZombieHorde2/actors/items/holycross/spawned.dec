actor ZH2HolyCrossLight
{
    Radius 13
    Height 8
    Damage 1000
    Projectile
    RenderStyle Add

    +BRIGHT

    States
    {
        Spawn:
            TNT1 AAAAAA 0 NoDelay A_SpawnItemEx("ZH2CrossSpark", 0, 0, 0, Random(10, 20), Random(-5, 5), Random(-3, 10), 0, 0)

        Spawn.Rest:
            SPAK B 1 A_SpawnItemEx("ZH2CrossSpark", 0, 0, 0, Random(-5, 5), Random(-5, 5), Random(-10, -1), 0, 0, 0)
            loop

        Death:
            TNT1 AAAAAA 0 A_SpawnItemEx("ZH2CrossSparkLong", 0, 0, 0, Random(-5, 5), Random(-5, 5), Random(-10, -1), 0, 0)
            stop
    }
}

actor ZH2CrossSpark : ZH2CrossSpawnSpark
{
    Radius 4
    Height 18
    Alpha .8

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(150, 1)
            stop
            TNT1 A 0 A_SetUserVar("user_Amount", random(0, 8))
            TNT1 A 0 A_SetScale(0.1+0.03*user_Amount, 0.1+0.03*user_Amount)
            SPAK BBBBBBBBBBBBBBBBBBB 1 bright A_FadeOut(0.08)
            stop
    }
}

actor ZH2CrossSparkLong : ZH2CrossSpark
{
    -NOINTERACTION
    Gravity 0.5

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_Amount", random(0, 8))
            TNT1 A 0 A_SetScale(0.1+0.03*user_Amount, 0.1+0.03*user_Amount)
            SPAK BBBBBBBBBBBBBBBBBBBBBBBBBB 1
            SPAK BBBBBBBBBBBBBBBBBBBBBBBB 1 A_FadeOut(0.05)
            stop
    }
}