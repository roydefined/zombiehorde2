// Note, ZM18 uses this under the given doomednum.
actor ZH2ItemCure : ZH2CustomInventoryPowerup 28583
{
    Radius 8
    Height 16

    inventory.icon "CUREI"
    Inventory.PickupMessage "Cure"
    Tag "Cure"

    states
    {
        spawn:
            CURE A 1 NoDelay A_SpawnItemEx("ZH2CureFlare", 0, 0, 6)
            loop

        pickup:
            TNT1 A 0 A_RailWait
            stop

        Use:
            TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_usecure", 0)
            fail
    }
}

actor ZH2CureFlare : ZH2ItemLensFlare
{
    Scale .5
    Alpha .2

    states
    {
        spawn:
            LFLR B 1 NoDelay Bright
            stop
    }
}