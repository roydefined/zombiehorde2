actor ZH2CrystalEffect
{
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +NOBLOCKMAP
    +NOGRAVITY

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(200, 2)
            TNT1 A 0 A_SpawnItemEx("ZH2CrystalSpark", random(-5, 5), random(-5, 5), random(5, 15), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0))
            TNT1 A 0 A_Jump(200, 2)
            TNT1 A 0 A_SpawnItemEx("ZH2CrystalSmoke", random(-4, 4), random(-4, 4), random(8, 16), Frandom(-0.1, 0.1), Frandom(-0.1, 0.1), Frandom(0.2, 0.6))
            TNT1 A 0
            stop
    }
}

actor ZH2CrystalSpark
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEXYBILLBOARD
    +THRUACTORS
    +BRIGHT
    +MISSILE

    RenderStyle Add

    var int user_Tics;
    var int user_Scale;

    alpha 0

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_JumpIf(WaterLevel > 0, "Death")
            TNT1 A 0 A_SetUserVar("user_Scale", random(0, 6))
            TNT1 A 0 A_SetScale(0.01 + 0.005 * user_Scale, 0.01 + 0.005 * user_Scale)
            SPAK CCCCCCCCCCCCCCC 1 A_FadeIn(FRandom(.01, .06))
            SPAK CCCCCCCCCCCCCCC 1 A_ChangeVelocity(FRandom(-0.05, 0.05), FRandom(-0.05, 0.05), 0, 0)

        Spawn.FadeOut:
            SPAK C 1 A_ChangeVelocity(FRandom(-0.05, 0.05), FRandom(-0.05, 0.05), 0, 0)
            TNT1 A 0 A_FadeOut(FRandom(.01, .06))
            loop

        Death:
            TNT1 A 0
            Stop
    }
}

actor ZH2CrystalSmoke
{
    +Missile
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEXYBILLBOARD

    Scale 0.3
    Alpha 0
    RenderStyle Translucent

    States
    {
        Spawn:
            SMKD AAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 NoDelay A_FadeIn(0.01)
            SMKD A 1 A_FadeOut(0.01)
            wait
    }
}

#include "actors/items/firecrystal/inventory.dec"
#include "actors/items/firecrystal/spawned.dec"