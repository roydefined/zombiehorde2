actor ZH2ItemFireCrystal : ZH2CustomInventoryPowerup 21006
{
    //$Sprite "CRSTA0"

    radius 8
    height 15

    Scale .3

    inventory.MaxAmount 1

    inventory.icon "CRYSTALI"
    inventory.pickupmessage "Fire crystal"
    tag "Fire crystal"

    +NOGRAVITY
    +BRIGHT

    states
    {
        Spawn:
            CRST A 1 NoDelay light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
            loop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == false, 2)
            TNT1 A 0 A_RailWait
            stop
            TNT1 A 0
            fail

        Use:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_FireCustomMissile("ZH2FireCrystal", 0, false)
            stop
    }
}

actor ZH2CrystalFlare : ZH2ItemLensFlare
{
    Scale .3
    Alpha .6

    States
    {
        Spawn:
            LFLR C 1 NoDelay Bright
            stop
    }
}