OptionMenu "ZH2DebugMenu"
{
    Title "Debug"
    StaticText " "
    StaticText " "
    
    StaticText "Admin", 1
    Command "Enable admin mode", "pukename zh2_action_enableadmin"
    Command "Disable admin mode", "pukename zh2_action_disableadmin"
    
    StaticText " "
    
    StaticText "Sync debug commands", 1
    Command "Sync all", "pukename zh2_action_syncall"
    Command "Call sync all on client", "pukename zh2_action_callclientsyncall"
    Command "Sync all on client", "pukename zh2_action_clientsyncall"
    
    StaticText " "
    
    StaticText "Debug commands (general)", 1
    Command "Unlock player", "pukename zh2_action_unlockplayer"
    Command "Give start weapons", "pukename zh2_action_debuggivestartweapons"
    Command "Log requested client settings (clientside)", "pukename zh2_action_debugrequestedclientsettings_clientside"

    StaticText " "
	
    Command "Set self solid", "pukename zh2_action_debugsetsolid 1"
    Command "Set self unsolid", "pukename zh2_action_debugsetsolid 0"
    
    StaticText " "
    
    StaticText "Debug commands (powers)", 1
    Command "Log powers", "pukename zh2_action_debugpowers"
    Command "Log calculated factors (serverside)", "pukename zh2_action_debugcalculatedfactors_serverside"
    Command "Log calculated factors (clientside)", "pukename zh2_action_debugcalculatedfactors_clientside"
    
    StaticText " "
    
    StaticText "Debug commands (maps)", 1
    Command "Log parsed maps (serverside)", "pukename zh2_action_debugparsedmaps_serverside"
    Command "Log parsed maps (clientside)", "pukename zh2_action_debugparsedmaps_clientside"
    Command "Log map rotation (serverside)", "pukename zh2_action_debugmaprotation_serverside"
    Command "Log map rotation (clientside)", "pukename zh2_action_debugmaprotation_clientside"
    Command "Log votable maps (serverside)", "pukename zh2_action_debugvotablemaps_serverside"
    
    StaticText " "
    
    StaticText "Debug commands (parsed mod definitions)", 1
    Command "Log items (serverside)", "pukename zh2_action_debugmoddefinitions_items_serverside"
    Command "Log items (clientside)", "pukename zh2_action_debugmoddefinitions_items_clientside"
    Command "Log rewards (serverside)", "pukename zh2_action_debugmoddefinitions_rewards_serverside"
}