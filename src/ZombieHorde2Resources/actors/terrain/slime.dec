actor ZH2SlimeSplashSmall
{
	Radius 2
	Height 1
	
	Alpha 0.5
	Scale 0.5
	
	RenderStyle shaded
	stencilcolor "695c3d"
	
	+DONTSPLASH
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEYBILLBOARD
	
	States
	{
		Spawn:
			TNT1 AAAA 0 NoDelay A_SpawnItemEx("SlimeSplashParticle", Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), 12, Frandom(-2.5, 2.5), Frandom(-2.5, 2.5), Frandom(3.5, 6.0),  random(0, 360))
			TNT1 AAAAAAAAA 0 A_SpawnItemEx("SlimeSplashParticle", Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), 12, Frandom(-1.0, 1.0), Frandom(-1.0, 1.0), Frandom(4.0, 9.0),  random(0, 360))
			SPLS ABCDEFGHIJKLM 2 A_FadeOut(FRandom(0.01, 0.05))
			Stop
	}
}

actor ZH2SlimeSplashBig : ZH2SlimeSplashSmall
{
	Alpha 0.7
	Scale 0.8
	
	States
	{
		Spawn:
			TNT1 AAAAAAAAAAAA 0 NoDelay A_SpawnItemEx("SlimeSplashParticle", Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), 8, Frandom(-2.5, 2.5), Frandom(-2.5, 2.5), Frandom(3.5, 6.0),  random(0, 360))
			TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("SlimeSplashParticle", Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), 8, Frandom(-1.0, 1.0), Frandom(-1.0, 1.0), Frandom(6.0, 14.0),  random(0, 360))
			SPLB ABCDEFGHIJKLM 2 A_FadeOut(FRandom(0.01, 0.05))
			Stop
	}
}

actor SlimeSplashParticle : ZH2SplashParticle
{
	RenderStyle shaded
	stencilcolor "695c3d"
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetScale(FRandom(.5, .8), FRandom(.5, .8))
			SPLP AAAAAABBBBBBCCCCCC 1 A_Fadeout(.05)
			Stop
	}
}