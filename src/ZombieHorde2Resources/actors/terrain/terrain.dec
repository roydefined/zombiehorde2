actor ZH2SplashParticle
{
	Height 1
	Radius 1
	Mass 0
	
	+Missile
	-NOGRAVITY
	+NOBLOCKMAP
	+FORCEXYBILLBOARD
	+THRUACTORS
	+CLIENTSIDEONLY
	+NOTELEPORT
	+DONTSPLASH
	+NOTIMEFREEZE
}

actor ZH2TerrainSmoke
{
	+MISSILE
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEXYBILLBOARD
	+THRUACTORS
	
	Alpha 0
	
	RenderStyle Translucent
	var int user_Tics;
			
	States
	{
		Spawn.Rest:
			TNT1 A 0 A_SetUserVar("user_Tics", user_Tics-1)
			TNT1 A 0 A_JumpIf(user_Tics < 0, "Spawn.Ending")
			TNT1 A 0 A_ScaleVelocity(Frandom(0.88, 0.99))
			SMKD A 2 A_FadeIn(0.01)
			loop
		Spawn.Ending:
			SMKD A 4 A_FadeOut(0.05)
			loop
	}
}

