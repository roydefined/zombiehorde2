actor ZH2LavaWalkSplash
{
    Radius 2
    Height 1

    Alpha 0.5
    Scale 0.5

    RenderStyle shaded
    stencilcolor "fd7900"

    +DONTSPLASH
    +NOBLOCKMAP
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +THRUACTORS

    States
    {
        Spawn:
            TNT1 AAA 0 NoDelay A_SpawnItemEx("ZH2LavaWalkSpark", random(-8, 8), random(-8, 8), 2, Frandom(-0.4, 0.4), Frandom(-0.4, 0.4), Frandom(1.0, 2.0))
            TNT1 AAAA 0 A_SpawnItemEx("LavaSplashSmokeSmall", random(-10, 10), random(-10, 10), 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
            Stop
    }
}

actor ZH2LavaWalkSpark : ZH2LavaSplashSpark
{
}