actor ZH2BlackNukageSplashSmall
{
	Radius 2
	Height 1
	
	Alpha 0.5
	Scale 0.5
	
	+DONTSPLASH
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEYBILLBOARD
	
	States
	{
		Spawn:
			TNT1 AAA 0 NoDelay A_SpawnItemEx("BlackNukageSplashSmokeSmall", random(-10, 10), random(-10, 10), 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
			Stop
	}
}

actor ZH2BlackNukageSplashBig : ZH2BlackNukageSplashSmall
{
	Alpha 0.7
	Scale 0.8
	
	States
	{
		Spawn:
			TNT1 AAAAA 0 NoDelay A_SpawnItemEx("BlackNukageSplashSmokeBig", random(-10, 10), random(-10, 10), 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
			TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx("BlackNukageSplashParticle", Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), 8, Frandom(-1.0, 1.0), Frandom(-1.0, 1.0), Frandom(3.0, 6.0),  random(0, 360))
			Stop
	}
}

actor BlackNukageSplashSmokeSmall : ZH2TerrainSmoke
{
	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetUserVar("user_Tics", 30)
			TNT1 A 0 A_SetScale(Frandom(0.2, 0.6), Frandom(0.2, 0.6))
			goto Spawn.Rest
	}
}

actor BlackNukageSplashSmokeBig : ZH2TerrainSmoke
{
	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetUserVar("user_Tics", 50)
			TNT1 A 0 A_SetScale(Frandom(0.4, 0.8), Frandom(0.4, 0.8))
			goto Spawn.Rest
	}
}

actor BlackNukageSplashParticle : ZH2SplashParticle
{
	RenderStyle shaded
	stencilcolor "4e4e4e"
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetScale(FRandom(.5, .8), FRandom(.5, .8))
			SPLP AAAAAABBBBBBCCCCCC 1 A_Fadeout(.05)
			Stop
	}
}