actor ZH2Cannon : ZH2Monster 25003
{
	Health 1000
	Radius 20
	Height 64
	Mass 100000
	Speed 0
	PainChance 0
	Monster
	MinMissileChance 160
	+MISSILEMORE
	+FLOORCLIP
	+NORADIUSDMG
	+DONTMORPH
	+NOBLOOD
	+LOOKALLAROUND
	States
	{
		Spawn:
			CANN a 10 A_Look
			Loop
		See:
			CANN A 3 A_chase
			Loop
		Missile:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetishuman", 0, 0, 0) == true, "Spawn")
			TNT1 A 0 A_JumpIfCloser(3500, 1)
			Goto Spawn
			CANN A 6 A_FaceTarget
			CANN A 0 A_Playsound("monster/cannonshot")
			CANN A 0 A_SpawnItem("ZH2BigSmokeCaller")
			CANN A 12 A_CustomMissile("ZH2Cannonball", 48, 0, 0, CMF_OFFSETPITCH || CMF_AIMDIRECTION, -45)
			CANN A 3 
			Goto Spawn
		Pain:
			CANN A 10 A_Pain
			Goto See
		Death:
			MISL B 0 A_SpawnItem("ZH2BigSmokeCaller")
			MISL B 8 Bright A_Explode(5, 128)
			MISL C 6 Bright
			MISL D 4 Bright
			Stop
	}
}

actor ZH2Cannonball
{
	Radius 11
	Height 8
	Speed 50
	Projectile
	
	DeathSound "decorate/modernexplosion"
	Obituary "%o was obliterated by a cannonball."
	
	States
	{
		Spawn:
			CNBL A 1 A_SpawnItemEx ("ZH2CannonShotSmoke", 0, 0, 0, 0, 0, 0, 0, 0, 0)
			Loop
		Death:
			MISL B 0 A_SpawnItem("ZH2BigSmokeCaller")
			MISL B 8 Bright A_Explode(5, 128)
			MISL C 6 Bright
			MISL D 4 Bright
			Stop
	}
}

ACTOR ZH2BigSmokeCaller
{   
   Radius 2
   Height 2
   Speed 0
   Scale 0.90
   projectile
   renderstyle Add
   alpha 0.50
   
   +NOGRAVITY
   
   States
   {
		Spawn:
			TNT1 A 0 nodelay A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 0, 0, 0) 
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 20, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 40, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 60, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 80, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 100, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 120, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 140, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 160, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), 180, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -20, 0, 0)  
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -40, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -60, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -80, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -100, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -120, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -140, 0, 0)
			TNT1 A 0 A_SpawnItemEx ("ZH2CannonExplosionSmoke", 0, 0, 0, random(-5,5), random(-5,5), random(-5,5), -160, 0, 0)
			stop
   }
}

actor ZH2CannonShotSmoke
{   
   Radius 2
   Height 2
   Speed 5
   Scale .2
   projectile
   renderstyle Add
   alpha 0.30
   
   +CLIENTSIDEONLY
   +FORCEXYBILLBOARD
   +NOGRAVITY
   
   States
   {
	   Spawn:
		  TNT1 AA 0 A_Jump(196, "Spawn2", "Spawn3", "Spawn4")
		  SMOK AAAAAAAAAAAAAAAAAAAAAAA 4 A_FadeOut(0.05)
		  stop
	   Spawn2:
		  SMOK BBBBBBBBBBBBBBBBBBBBBBB 4 A_FadeOut(0.4)
		  stop
	   Spawn3:
		  SMOK CCCCCCCCCCCCCCCCCCCCCCC 4 A_FadeOut(0.4)
		  stop
	   Spawn4:
		  SMOK DDDDDDDDDDDDDDDDDDDDDDD 4 A_FadeOut(0.4)
		  stop
   }
}

actor ZH2CannonExplosionSmoke : ZH2CannonShotSmoke
{   
   Scale .5
   alpha 0.50
   
   +CLIENTSIDEONLY
   +FORCEXYBILLBOARD
   +NOGRAVITY
   
   States
   {
	   Spawn:
		  TNT1 AA 0 A_Jump(196, "Spawn2", "Spawn3", "Spawn4")
		  SMOK AAAAAAAAAAAAAAAAAAAAAAA 4 A_FadeOut(0.05)
		  stop
	   Spawn2:
		  SMOK BBBBBBBBBBBBBBBBBBBBBBB 4 A_FadeOut(0.4)
		  stop
	   Spawn3:
		  SMOK CCCCCCCCCCCCCCCCCCCCCCC 4 A_FadeOut(0.4)
		  stop
	   Spawn4:
		  SMOK DDDDDDDDDDDDDDDDDDDDDDD 4 A_FadeOut(0.4)
		  stop
   }
}