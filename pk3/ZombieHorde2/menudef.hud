OptionMenu "ZH2HudMenu"
{
    Title "Hud"

    StaticText " "

    StaticText " "
    Option "Enable HUD", "cl_zh2_drawhud", "YesNo"
    Option "Force hud skin", "sv_zh2_forcehudskin", "HudSkinForceOption"
    Option "Hud skin", "cl_zh2_hudskin", "HudSkinOption"
    StaticText " "

    StaticText "Hud shaking", 1
    Option "Enable globally", "sv_zh2_shakehud", "YesNo"
    Option "Enable clientside", "cl_zh2_ShakeHud", "YesNo"
    //Slider "Intensity multiplier", "cl_zh2_HudShakeIntensityMultiplier", 0.1, 5.0, 0.1
    //Slider "Frequency multiplier", "cl_zh2_HudShakeFrequencyMultiplier", 0.1, 5.0, 0.1
    //Slider "Shake duration in tics", "cl_zh2_HudShakeDurationTics", 1, 20, 1

    StaticText " "

    StaticText "Version", 1
    Option "Draw hud", "cl_zh2_DrawVersionHud", "YesNo"

    StaticText " "

    StaticText "Player - status", 1
    Option "Draw hud", "cl_zh2_DrawPlayerStatusHud", "YesNo"
    Slider "Horizontal hud offset", "cl_zh2_HudPlayerStatusOffsetX", 0.0, 200.0, 5.0
    Slider "Vertical hud offset", "cl_zh2_HudPlayerStatusOffsetY", 0.0, 40.0, 1.0

    StaticText " "

    StaticText "Player - powers", 1
    Option "Draw hud", "cl_zh2_DrawPlayerPowersHud", "YesNo"
    Slider "Horizontal hud offset", "cl_zh2_HudPlayerPowersOffsetX", -200.0, 200.0, 5.0
    Slider "Vertical hud offset", "cl_zh2_HudPlayerPowersOffsetY", -40.0, 40.0, 1.0

    StaticText " "

    StaticText "Player - bars", 1
    Option "Draw hud", "cl_zh2_DrawPlayerBarsHud", "YesNo"
    Slider "Horizontal hud offset", "cl_zh2_HudPlayerBarsOffsetX", -200.0, 200.0, 5.0
    Slider "Vertical hud offset", "cl_zh2_HudPlayerBarsOffsetY", -40.0, 40.0, 1.0

    StaticText " "

    StaticText "Round", 1
    Option "Draw hud", "cl_zh2_DrawRoundHud", "YesNo"
    Slider "Horizontal hud offset", "cl_zh2_HudRoundOffsetX", -200.0, 200.0, 5.0
    Slider "Vertical hud offset", "cl_zh2_HudRoundOffsetY", 0.0, 40.0, 1.0

    StaticText " "

    StaticText "Game", 1
    Option "Draw hud", "cl_zh2_DrawGameHud", "YesNo"

    StaticText " "

    StaticText "Obituary", 1
    Option "Draw hud", "cl_zh2_drawobituaryhud", "YesNo"
    Slider "Horizontal hud offset", "cl_zh2_hudobituaryoffsetx", -200.0, 200.0, 5.0
    Slider "Vertical hud offset", "cl_zh2_hudobituaryoffsety", 0.0, 40.0, 1.0

    StaticText " "

    StaticText "Resists", 1
    Option "Draw hud", "cl_zh2_DrawResistsHud", "YesNo"
}