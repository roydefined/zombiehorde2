OptionMenu "ZH2GameMenu"
{
    Title "Game"
    StaticText " "
    StaticText " "

    Slider "Minimum client count", "sv_zh2_minimumclientcount", 2, 64, 1
    Option "Increase play timer on infect", "sv_zh2_infecttimeincrease", "YesNo"
    Slider "Players per initial", "sv_zh2_playersperinitial", 6, 64, 1
    Option "Show resists to zombies", "sv_zh2_showzombiesresists", "YesNo"
    Option "Enable full server event", "sv_zh2_enablefullserver", "YesNo"
    Slider "Full server round interval", "sv_zh2_fullserverroundinterval", 1, 100, 1
    Option "Zombie skin behaviour", "sv_zh2_zombieskinbehaviour", "ZombieSkinBehaviour"

    StaticText " "

    StaticText "Round", 1
    Option "Initial pick method", "sv_zh2_initialpickmethod", "InitialZombiePickMethodOption"
    Option "Initial pick remember last map", "sv_zh2_initialpickrememberlastmap", "YesNo"

    StaticText " "

    StaticText "Compensation", 1
    Slider "Max secs returned", "sv_zh2_compensatemaxsecondsreturned", 0, 100, 1
	
    StaticText " "

    StaticText "Obituaries", 1
    Option "Enable globally", "sv_zh2_enableobituaries", "YesNo"
    Option "Enable clientside", "cl_zh2_enableobituaries", "YesNo"
    Slider "Shown obituaries on screen", "cl_zh2_shownobituaries", 1, 32, 1

    StaticText " "

    StaticText "End of round rewards", 1
    Slider "Reward no. players", "sv_zh2_endofroundrewardcount", 0, 64, 1
    Option "Only reward safe players", "sv_zh2_endofroundrewardsafeplayers", "YesNo"

    StaticText " "

    StaticText "Settings consolidation", 1
    Command "Consolidate settings", "pukename zh2_action_consolidateclientsettings"
    Command "Open client settings", "pukename zh2_action_enableclientsettingshud"
    Option "Inform of misconfigured cvars", "cl_zh2_informclientofcvars", "YesNo"

    StaticText " "

    StaticText "Anti telefrag system", 1
    Option "Enable anti-telefrag system", "sv_zh2_enableantitelefragsystem", "YesNo"
	
    StaticText " "

    StaticText "Modifiers - knockback", 1
    Option "Use custom knockback modifier", "sv_zh2_usecustomknockbackmodifier", "YesNo"
    Slider "Knockback multiplier", "sv_zh2_customknockbackmodifiermultiplier", 0.1, 10.0, 0.1
	
    StaticText " "

    StaticText "Modifiers - damage", 1
    Option "Use custom damage factor", "sv_zh2_usecustomdamagefactormodifier", "YesNo"
    Slider "Damage factor multiplier", "sv_zh2_customdamagefactormodifiermultiplier", 0.1, 10.0, 0.1

    StaticText " "

    StaticText "Voting", 1
    Option "Allow map voting", "sv_zh2_AllowMapVoting", "YesNo"
    Option "Include played maps", "sv_zh2_voteincludeplayedmaps", "YesNo"
    Option "Allow spectator votes", "sv_zh2_allowspectatorvoting", "YesNo"
    Slider "Max no. of maps shown", "sv_zh2_MaxVotableMapsShown", 1, 6, 1
    Slider "Required % of player votes", "sv_zh2_PlayerVotePercentage", 1, 100, 1
    Slider "Tics between player map picks", "sv_zh2_PlayerPickCooldownTics", 0, 350, 1

    StaticText " "

    StaticText "Features", 1
    Option "Use 'ResetMap' feature", "sv_zh2_usemapresetsfeature", "YesNo"
    Option "Use 'DeadSpectators' feature", "sv_zh2_usedeadspectatorsfeature", "YesNo"
    Option "Use custom knockback feature", "sv_zh2_usecustomknockbackfeature", "YesNo"
    Option "Use anti SR-50", "sv_zh2_useantisr50", "YesNo"
}