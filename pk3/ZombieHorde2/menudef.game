OptionMenu "ZH2GameMenu"
{
    Title "Game"
    StaticText " "
    StaticText " "
    
    Slider "Minimum client count", "sv_zh2_minimumclientcount", 2, 64, 1
    Option "Increase play timer on infect", "sv_zh2_infecttimeincrease", "YesNo"
    Slider "Players per initial", "sv_zh2_playersperinitial", 6, 64, 1
    Option "Show resists to zombies", "sv_zh2_showzombiesresists", "YesNo"
    Option "Enable full server event", "sv_zh2_enablefullserver", "YesNo"
    Slider "Full server round interval", "sv_zh2_fullserverroundinterval", 1, 100, 1
    Option "Zombie skin behaviour", "sv_zh2_zombieskinbehaviour", "ZombieSkinBehaviour"
    
    StaticText " "
    
    StaticText "Obituaries", 1
    Option "Enable (server)", "sv_zh2_enableobituaries", "YesNo"
    Option "Enable (client)", "cl_zh2_enableobituaries", "YesNo"
    Slider "Shown obituaries", "cl_zh2_shownobituaries", 1, 32, 1
    
    StaticText " "
    
    Slider "End of round reward player count", "sv_zh2_endofroundrewardcount", 0, 64, 1
    Option "Only reward safe players", "sv_zh2_endofroundrewardsafeplayers", "YesNo"
    
    StaticText " "
    
    StaticText "Settings", 1
    Command "Consolidate settings", "pukename zh2_action_consolidateclientsettings"
    Command "Open client settings", "pukename zh2_action_enableclientsettingshud"
    Option "Validate client cvars", "cl_zh2_informclientofcvars", "YesNo"
    
    StaticText " "
    
    StaticText "Voting", 1
    Option "Allow voting for maps after the round ends", "sv_zh2_AllowMapVoting", "YesNo"
    Option "Include played maps in voting", "sv_zh2_voteincludeplayedmaps", "YesNo"
    Option "Allow spectators to vote", "sv_zh2_allowspectatorvoting", "YesNo"
    Slider "Maximum number of maps shown whilst voting", "sv_zh2_MaxVotableMapsShown", 1, 6, 1
    Slider "Required percentage of players voting for a map", "sv_zh2_PlayerVotePercentage", 1, 100, 1
    Slider "Tics between player map picks", "sv_zh2_PlayerPickCooldownTics", 0, 350, 1
    
    StaticText " "
    
    StaticText "Compatibility", 1
    Option "Use 'ResetMap' feature", "sv_zh2_usemapresets", "YesNo"
    Option "Use 'DeadSpectators' feature", "sv_zh2_usedeadspectators", "YesNo"
}