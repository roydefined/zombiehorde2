// This constant is also defined in ACS and defines the TID on an actor that must always face the console player.
const int FACEPLAYER_TID = 1000000000;

actor BooleanPersist : inventory
{
    inventory.MaxAmount 1

    +inventory.Undroppable
    -inventory.Invbar
}

actor Boolean : BooleanPersist
{
    Inventory.InterhubAmount 0
}

actor IntegerPersist : Inventory
{
    Inventory.MaxAmount 0x7fffffff

    +inventory.Undroppable
    -inventory.Invbar
}

actor Integer : IntegerPersist
{
    Inventory.InterhubAmount 0
}

