        str packet = Packet::Packet_New();
        packet = Packet::Packet_AppendStr(packet, EVENTPLAYERKILLEDBYPLAYER);
        packet = Packet::Packet_Append(packet, killedId, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, killerId, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, itemIndex, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, addFireEffect, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, addAcidEffect, Packet::PACKET_WORD);
        EventBus::CallEvent(packet);
    }

