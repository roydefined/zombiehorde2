    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_Append(packet, prevIndex, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, newIndex, Packet::PACKET_WORD);
        EventBus::CallEvent(EVENTROUNDSWITCHED, packet);
    }

