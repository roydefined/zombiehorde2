#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Event
{
    internal void SendInitialsChosen(int chosenCount)
    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_AppendStr(packet, EVENTINITIALSCHOSEN);
        packet = Packet::Packet_Append(packet, chosenCount, Packet::PACKET_WORD);

        for(int i = 0; i < BCSUTILS::MAX_PLAYERS; ++i)
        {
            if (Player::GetPlayerInitialZombie(i))
                packet = Packet::Packet_Append(packet, i, Packet::PACKET_WORD);
        }

        EventBus::CallEvent(packet);
    }

