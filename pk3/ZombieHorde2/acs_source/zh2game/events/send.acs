#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Events
{
    internal void SendPlayerLeftRound(int id)
    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_Append(packet, id, Packet::PACKET_WORD);
        EventBus::CallEvent(EVENTPLAYERLEFTROUND, packet);
    }

    internal void SendPlayerDied(int killedId, int killerId)
    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_Append(packet, killedId, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, killerId, Packet::PACKET_WORD);
        EventBus::CallEvent(EVENTPLAYERDIED, packet);
    }

    internal void SendPlayerScratched(int attackedId, int attackerId)
    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_Append(packet, attackedId, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, attackerId, Packet::PACKET_WORD);
        EventBus::CallEvent(EVENTSCRATCHED, packet);
    }

    internal void SendPlayerCured(int id)
    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_Append(packet, id, Packet::PACKET_WORD);
        EventBus::CallEvent(EVENTCURED, packet);
    }

    internal void SendPlayerInfected(int id)
    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_Append(packet, id, Packet::PACKET_WORD);
        EventBus::CallEvent(EVENTINFECTED, packet);
    }

    internal void SendPlayerSpecieChanged(int id, Player::PlayerSpecieT specie)
    {
        str packet = Packet::Packet_New();
        packet = Packet::Packet_Append(packet, id, Packet::PACKET_WORD);
        packet = Packet::Packet_Append(packet, specie, Packet::PACKET_WORD);
        EventBus::CallEvent(EVENTPLAYERSPECIECHANGED, packet);
    }

    internal void SendResistStarted(int index)
