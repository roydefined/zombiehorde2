#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Decorate
{
    internal str BuildTrackMessage(str name, str author)
    {
        return buildmsg(StrParam())
        {
            Append(s:"\cd");
            Append(s:name);
            if ((raw)author != 0 && author != "")
            {
                Append(s:"\cj by \cd");
                Append(s:author);
            }
        }
    }

    script "zh2_dec_radio_cyclemusic" (raw direction) net clientside
    {
        if (PlayerNumber() != ConsolePlayerNumber())
            terminate;

        if (GetRadioCollectionSize() == 0)
            terminate;

        if (ZH2Game::GetInvertRadioNavigation())
            direction = -direction;

        ZH2Game::GameContext.RadioCurrentlySelectedIndex += (int)direction;
        if (ZH2Game::GameContext.RadioCurrentlySelectedIndex < 0) ZH2Game::GameContext.RadioCurrentlySelectedIndex = BCSUtils::Max(GetRadioCollectionSize() - 1, 0);
        if (ZH2Game::GameContext.RadioCurrentlySelectedIndex >= GetRadioCollectionSize()) ZH2Game::GameContext.RadioCurrentlySelectedIndex = 0;
    }

    script "zh2_dec_radio_stopmusic" net clientside
    {
        if (PlayerNumber() != ConsolePlayerNumber())
            terminate;

        SetMusic("");
    }

    script "zh2_dec_radio_setcurrentmusic" net clientside
    {
        if (PlayerNumber() != ConsolePlayerNumber())
            terminate;

        // We have no tracks, no point in changing.
        if (Decorate::GetRadioCollectionSize() == 0)
        {
            Logger::LogActivator("You don't have any music tracks.");
            terminate;
        }

        int trackIndex = GetClientRadioCurrentlySelectedIndex();
        SetClientCurrentRadioTrackIndex(trackIndex);

        str lump = GetRadioTrackLumpName(trackIndex);
        str name = GetRadioTrackName(trackIndex);
        str author = GetRadioTrackAuthor(trackIndex);
        SetRadioBroadcastClientside(PlayerNumber(), lump);
        Logger::LogActivator("Now playing " + BuildTrackMessage(name, author) + "\cj.");

        str packet = Packet::New();
        packet = Packet::AppendStr(packet, lump);
        packet = Packet::AppendStr(packet, name);
        packet = Packet::AppendStr(packet, author);

        if(!Packet::Send("zh2_internal_radio_settrack", packet))
            Logger::LogError(LOGSOURCE, "Failed to call internal set radio track.");
    }

    script "zh2_internal_radio_settrack" (raw packet) net
    {
        if (!CheckWeapon(WEAPON_RADIO_NAME))
            terminate;

        // Avoid spamming radio music changes.
        int ticsLeft = GetRadioTrackCooldownTicsLeft();
        if (ticsLeft > 0)
        {
            int secondsLeft = int(BCSUtils::Ceil(fixed(ticsLeft) / 35.0));
            str secondsPlural = secondsLeft == 1 ? "" : "s";

            // Only makes sense to log when not playing alone.
            // You won't notice the cooldown otherwise.
            if (BCSUtils::ClientCount() > 1)
                Logger::LogActivator("The music recently changed, so the track change won't be shared. Try again in " + str(secondsLeft) + " second" + secondsPlural + ".");

            Logger::LogDebug(LOGSOURCE, "Radio: rejected track change from (\cd" + str(PlayerNumber())
                + "\cj) " + BCSUtils::PlayerName(PlayerNumber()) + " - \cd" + str(ticsLeft) + "\cj tics of cooldown left.");
            terminate;
        }

        UpdateRadioTrackCooldown();

        // Peek the lump without consuming `packet`, which we still need to forward as-is below.
        str peek = packet;
        peek = Packet::ReadStr(peek);
        str lump = Packet::Value;

        int sourceId = PlayerNumber();

        // Only one broadcaster at a time, so tell the previous one's client directly (with the new lump)
        // so they switch immediately. The regular broadcast below won't reach them if they ignore radio.
        if (GetRadioBroadcastActive() && GetRadioBroadcastPlayerId() != sourceId)
        {
            int previousBroadcasterId = GetRadioBroadcastPlayerId();

            Logger::LogDebug(LOGSOURCE, "Radio: (\cd" + str(sourceId) + "\cj) " + BCSUtils::PlayerName(sourceId)
                + " is taking over the radio from (\cd" + str(previousBroadcasterId) + "\cj) "
                + BCSUtils::PlayerName(previousBroadcasterId) + ".");

            str forceStopPacket = Packet::New();
            forceStopPacket = Packet::Append(forceStopPacket, sourceId);
            forceStopPacket = Packet::AppendStr(forceStopPacket, lump);
            if (!Packet::Send("zh2_internal_radio_forcestop_client", forceStopPacket, previousBroadcasterId))
                Logger::LogError(LOGSOURCE, "Failed to call zh2_internal_radio_forcestop_client");
        }

        SetRadioBroadcast(sourceId, lump);
        Sync::SyncRadio();

        Logger::LogDebug(LOGSOURCE, "Radio: (\cd" + str(sourceId) + "\cj) " + BCSUtils::PlayerName(sourceId)
            + " is now broadcasting \cd" + lump + "\cj.");

        if (!Packet::Send("zh2_internal_radio_settracktoclient", packet))
            Logger::LogError(LOGSOURCE, "Failed to call zh2_internal_radio_settracktoclient");
    }

    script "zh2_internal_radio_forcestop_client" (raw packetRaw) clientside
    {
        BCSUtils::SetActivatorToConsolePlayer();

        str packet = (str)packetRaw;
        packet = Packet::Read(packet);
        int newBroadcasterId = Packet::Value;

        packet = Packet::ReadStr(packet);
        str lump = Packet::Value;

        Logger::LogDebug(LOGSOURCE, "Radio: our broadcast was displaced by (\cd" + str(newBroadcasterId)
            + "\cj) " + BCSUtils::PlayerName(newBroadcasterId) + " playing \cd" + lump + "\cj.");

        Logger::LogActivator("Your radio broadcast was stopped because \cd" + BCSUtils::PlayerName(newBroadcasterId) + "\cj started playing theirs.");

        // Silences our own broadcast and immediately starts following the new one instead.
        SetRadioBroadcastClientside(newBroadcasterId, lump);
    }

    script "zh2_internal_radio_settracktoclient" (raw packet) clientside
    {
        int sourceId = PlayerNumber();
        BCSUtils::SetActivatorToConsolePlayer();

        packet = Packet::ReadStr(packet);
        str lump = Packet::Value;

        packet = Packet::ReadStr(packet);
        str name = Packet::Value;

        packet = Packet::ReadStr(packet);
        str author = Packet::Value;

        // We're the source, we already switched tracks and confirmed it locally.
        if (sourceId == ConsolePlayerNumber())
            terminate;

        str trackMessage = BuildTrackMessage(name, author);

        bool ignore = ZH2Game::GetIgnoreRadioMusic();
        bool playRandom = ZH2Game::GetTrackNotFoundPlayRandom();

        if (Decorate::GetRadioCollectionSize() == 0)
        {
            str message;
            buildmsg(message = StrParam())
            {
                Append(s:BCSUtils::PlayerName(sourceId));
                Append(s:" is now playing ");
                Append(s:trackMessage);

                if (ignore)
                    Append(s:"\cj. You've chosen to ignore this track.");
                else
                    Append(s:"\cj, but you don't have any music tracks.");
            }

            Logger::LogActivator(message);
            Logger::LogDebug(LOGSOURCE, "Radio: (\cd" + str(sourceId) + "\cj) " + BCSUtils::PlayerName(sourceId)
                + " played \cd" + lump + "\cj, but we have no tracks at all. ignore=\cd" + str((int)ignore) + "\cj.");
            terminate;
        }

        int trackIndex = GetRadioTrackIndexByLumpName(lump);

        Logger::LogDebug(LOGSOURCE, "Radio: received track change from (\cd" + str(sourceId) + "\cj) "
            + BCSUtils::PlayerName(sourceId) + " - lump=\cd" + lump + "\cj trackIndex=\cd" + str(trackIndex)
            + "\cj ignore=\cd" + str((int)ignore) + "\cj playRandom=\cd" + str((int)playRandom) + "\cj.");

        // Possible random track if we didn't find the track we wanted.
        int replaceTrackIndex = Random(0, GetRadioCollectionSize() - 1);
        str replaceLump = GetRadioTrackLumpName(replaceTrackIndex);
        str replaceName = GetRadioTrackName(replaceTrackIndex);
        str replaceAuthor = GetRadioTrackAuthor(replaceTrackIndex);
        str replaceTrackMessage = BuildTrackMessage(replaceName, replaceAuthor);

        str message;
        buildmsg(message = StrParam())
        {
            Append(s:BCSUtils::PlayerName(sourceId));
            Append(s:" is now playing ");
            Append(s:trackMessage);

            if (ignore)
            {
                Append(s:"\cj. You've chosen to ignore this track.");
            }
            else if (trackIndex == -1)
            {
                Append(s:"\cj, but you don't have this track.");

                if (playRandom)
                {
                    Append(s:" Playing \cd");
                    Append(s:replaceTrackMessage);
                    Append(s:"\cj instead.");
                }
                else
                {
                    Append(s:" Nothing will play for you. You can add it under the lump \cd");
                    Append(s:lump);
                    Append(s:" \cjto play it.");
                }
            }
            else
            {
                Append(s:"\cj.");
            }
        }

        Logger::LogActivator(message);

        if (ignore)
            terminate;

        // Not found: only fall back to a random substitute if the listener actually wants that -
        // otherwise there's nothing to play.
        if (trackIndex == -1)
        {
            if (!playRandom)
                terminate;

            SetRadioBroadcastClientside(sourceId, replaceLump);
        }

        // Found: always play the exact match. `playRandom` only ever applies to the not-found case above.
        else
        {
            SetRadioBroadcastClientside(sourceId, lump);
        }
    }
}
