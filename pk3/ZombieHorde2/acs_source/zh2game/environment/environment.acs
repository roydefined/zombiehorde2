#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Environment
{
    internal str GetVersion()
    {
        return buildmsg(StrParam())
        {
            Append(d:VersionMajor);
            Append(s:".");
            Append(d:VersionMinor);
            Append(s:".");
            Append(d:VersionPatch);
            Append(s:VersionSuffix);
        }
    }

    internal bool IsDevelopment()
    {
        return
    #ifdef DEV
            true
    #else
            false
    #endif
        ;
    }

    internal bool IsProduction()
    {
        return !IsDevelopment();
    }

    internal bool DevelopmentPlayerCap()
    {
        return
    #ifdef DEV_PLAYERCAP
            true
    #else
            false
    #endif
        ;
    }
}