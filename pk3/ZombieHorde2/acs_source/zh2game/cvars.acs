    internal DropGrenadeOnInfectT GetDropGrenadeOnInfect()
    {
        switch(BCSUTILS::Clamp(GetCvar("sv_zh2_dropgrenadeoninfect"), 0, 2))
        {
            case 0:
                return DROPBEHAVIOUR_ALWAYS;
            case 1:
                return DROPBEHAVIOUR_ONLY_REGULAR_ZOMBIES;
