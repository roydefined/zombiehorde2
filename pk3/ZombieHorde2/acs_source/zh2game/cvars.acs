strict namespace ZH2Game
{
    // Admin
    internal bool GetClAdminSpawnBotInFront(int playerId) { return (bool)GetUserCvar(playerId, "cl_zh2_adminspawnbotinfront"); }

    // Game
    internal int GetMinimumClientCount() { return BCSUTILS::Clamp(GetCvar("sv_zh2_minimumclientcount"), 0, BCSUTILS::MAX_PLAYERS); }
    internal bool GetInfectTimeIncrease() { return (bool)GetCvar("sv_zh2_infecttimeincrease"); }
    internal int GetPlayersPerInitial() { return BCSUTILS::Clamp(GetCvar("sv_zh2_playersperinitial"), 6, BCSUTILS::MAX_PLAYERS); }
    internal bool GetShowZombiesResists() { return (bool)GetCvar("sv_zh2_showzombiesresists"); }
    internal bool GetEnableFullServer() { return (bool)GetCvar("sv_zh2_enablefullserver"); }
    internal int GetFullServerRoundInterval() { return BCSUTILS::Clamp(GetCvar("sv_zh2_fullserverroundinterval"), 1, 100); }
    internal ZombieSkinBehaviourT GetZombieSkinBehaviour()
    {
        switch(BCSUTILS::Clamp(GetCvar("sv_zh2_zombieskinbehaviour"), 0, 2))
        {
            case 1:
                return BEHAVIOUR_FORCEOLDSKIN;
            case 2:
                return BEHAVIOUR_FORCENEWSKIN;
            default:
                return BEHAVIOUR_DEFAULT;
        }
    }

    internal int GetEndOfRoundRewardCount() { return BCSUTILS::Clamp(GetCvar("sv_zh2_endofroundrewardcount"), 0, 64); }
    internal bool GetEndOfRoundRewardSafePlayers() { return (bool)GetCvar("sv_zh2_endofroundrewardsafeplayers"); }

    // Game - Round
    internal InitialZombiePickMethodT GetInitialZombiePickMethod()
    {
        switch(BCSUTILS::Clamp(GetCVar("sv_zh2_initialpickmethod"), 0, 2))
        {
            case 1:
                return INITIALZOMBIEPICKMETHOD_LEGACY;
            case 2:
                return INITIALZOMBIEPICKMETHOD_WEIGHT;
            default:
                return INITIALZOMBIEPICKMETHOD_RANDOM;
        }
    }
    internal bool GetInitialPickRememberLastMap() { return (bool)GetCvar("sv_zh2_initialpickrememberlastmap"); }

    // Game - Compensation
    internal int GetCompensateMaxSecondsReturned() { return BCSUTILS::Clamp(GetCvar("sv_zh2_compensatemaxsecondsreturned"), 0, 100); }
    internal int GetCompensateHealthFactorReturned() { return BCSUTILS::Clamp(GetCvar("sv_zh2_compensatemaxhealthfactorreturned"), 0, 200); }
    internal int GetCompensateRestartIfSpecBeforeSeconds() { return BCSUTILS::Clamp(GetCvar("sv_zh2_compensaterestartifspecbeforeseconds"), 0, 300); }
    internal int GetCompensateAwardKillDamagePercentage() { return BCSUTILS::Clamp(GetCvar("sv_zh2_compensateawardkilldamagepercentage"), 0, 100); }

    // Game - AFK prevention
    internal bool GetAfkMoveAtRoundStart() { return (bool)GetCvar("sv_zh2_afkmoveatroundstart"); }
    internal int GetAfkMoveAtRoundStartBeforeSeconds() { return BCSUTILS::Clamp(GetCvar("sv_zh2_afkmoveatroundstartbeforeseconds"), 0, 60); }
    internal bool GetAfkMoveAsZombie() { return (bool)GetCvar("sv_zh2_afkmoveaszombie"); }
    internal int GetAfkZombieMoveGraceTics() { return BCSUTILS::Clamp(GetCvar("sv_zh2_afkzombiemovegracetics"), 0, 700); }
    internal int GetAfkZombieMoveCheckTics() { return BCSUTILS::Clamp(GetCvar("sv_zh2_afkzombiemovechecktics"), 0, 700); }
    internal int GetAfkZombieMoveWarnSeconds() { return BCSUTILS::Clamp(GetCvar("sv_zh2_afkzombiemovewarnseconds"), 0, 20); }

    // Game - Obituary
    internal bool GetSvEnableObituaries() { return (bool)GetCvar("sv_zh2_enableobituaries"); }
    internal bool GetClEnableObituaries(int playerId) { return (bool)GetUserCvar(playerId, "cl_zh2_enableobituaries"); }
    internal int GetShownObituaries(int playerId) { return BCSUTILS::Clamp(GetUserCvar(playerId, "cl_zh2_shownobituaries"), 1, OBITUARY_COLLECTION_MAX_SIZE); }

    // Game - Settings
    internal bool GetInformClientOfCVars() { return (bool)GetCvar("cl_zh2_informclientofcvars"); }

    internal bool GetEnableAntiTelefragSystem() { return (bool)GetCvar("sv_zh2_enableantitelefragsystem"); }

