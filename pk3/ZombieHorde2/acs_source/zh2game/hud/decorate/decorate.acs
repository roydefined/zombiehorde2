#ifdef __IMPORTED__
    #error This file must be #included.
#endif

#include "sniper.acs"
#include "radio.acs"

strict namespace Hud
{
    // General weapon hud elements.
    // Not to be confused with ammo counters. Those are handled separately.

    internal void DrawWeaponsHud()
    {
        /* SNIPER */
        BCSUtils::HudResetState();
        HudSetScaledVirtualSize(960.0, 720.0, CVar::GetClHudWeaponSniperScale());
        BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);

        PrepareHud(
            HudCenterX(),
            HudCenterY(),
            false);

        DrawSniperHud();

        /* RADIO */
        BCSUtils::HudResetState();
        HudSetScaledVirtualSize(960.0, 720.0, CVar::GetClHudWeaponRadioScale());
        BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetCenterText(false);

        PrepareHud(
            BCSUtils::HudLeft() + 80.0,
            BCSUtils::HudTop() + 200.0,
            false);

        DrawRadioHud();
    }
}