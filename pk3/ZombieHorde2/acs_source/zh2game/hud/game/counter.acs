#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawPlayerCounters()
    {
        int humanCount = Game::HumanCount();
        int zombieCount = Game::ZombieCount();

        fixed x = 0.0;

        if (humanCount > 0)
        {

            HudSetPointInternal(-15.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDHBACK");
            DebugDraw();

            HudSetPointInternal(-10.0, 2.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUD_CHUM");
            DebugDraw();

            HudSetPointInternal(8.0, 2.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(humanCount));
            DebugDraw();

            x += 50.0;
        }

        if (zombieCount > 0)
        {
            HudSetPointInternal(x - 15.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDZBACK");
            DebugDraw();

            HudSetPointInternal(x - 10.0, 2.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUD_CZOM");
            DebugDraw();

            HudSetPointInternal(x + 8.0, 2.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(zombieCount));
            DebugDraw();
        }
    }

    internal void DrawStatCounters()
    {
        int kills = Player::GetZombieKills();
        int infects = Player::GetInfects();

        if (kills > 0 || infects > 0)
        {
            HudSetPointInternal(-18.0, -2.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDTBACK");
            DebugDraw();
        }

        fixed x = 0.0;

        if (kills > 0)
        {
            HudSetPointInternal(-10.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUD_CZKL");
            DebugDraw();

            HudSetPointInternal(8.0, 0.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(kills));
            DebugDraw();

            x += 30.0;
        }

        if (infects > 0)
        {
            HudSetPointInternal(x - 10.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUD_CINF");
            DebugDraw();

            HudSetPointInternal(x + 8.0, 0.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(infects));
            DebugDraw();
        }
    }
}