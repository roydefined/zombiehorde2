#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    // Zombie teleport graphics
    #define HUD_ZTELE_ZOMBIEOLD "HUD_TEL1"
    #define HUD_ZTELE_ZOMBIEINITIAL "HUD_TEL2"
    #define HUD_ZTELE_ZOMBIEREGULAR "HUD_TEL3"

    // Cached results of the computations used to decide what should be drawn.
    // Recalculated once per draw via `UpdateSharedState()` so skins can read them as often as needed
    // without repeating the underlying (potentially costly) checks.
    internal struct SharedStateT
    {
        bool DrawKevlarArmor;
        bool DrawCurrentOwnedItem;
        bool DrawKeyList;

        // TODO: Should come from a lump.
        bool DrawPrimaryWeaponBackground;
        bool DrawSecondaryWeaponBackground;

        bool DrawZombieTeleportsLeft;

        bool DrawZombieAbilities;
        bool DrawZombieAbilityByIndex[ABILITY_COUNT];

        bool DrawCalculatedFactorByIndex[MAX_POWER_TYPES];

        bool DrawHudStateByIndex[MAX_HUD_STATES];

        bool DrawSprintBar;
        bool DrawAirSupplyBar;

        bool DrawAfkBar;
        int AfkBarMaxTics;
        int AfkBarTicsLeft;

        bool DrawTimer;
    };
}
