#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawPlayerCounters(Player::ZombieSkinTypeT skinType)
    {
        int humanCount = Game::HumanCount();
        int zombieCount = Game::ZombieCount();

        fixed x = 0.0;

        if (humanCount > 0)
        {
            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
            HudSetPointInternal(-18.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDHBACK");
            DebugDraw();

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_CENTER);
            HudSetPointInternal(-4.0, 2.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDCHUMN");
            DebugDraw();

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
            BCSUtils::HudSetScale(0.6);
            HudSetPointInternal(8.0, 2.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(humanCount));
            DebugDraw();
            BCSUtils::HudSetScale(1.0);

            x += 50.0;
        }

        if (zombieCount > 0)
        {
            // NOTE: Initial not currently working because we don't check initial zombies by design.
            str zombieGraphic;
            switch(skinType)
            {
                case Player::ZOMBIESKIN_INITIAL:
                    zombieGraphic = "HUDCZOMI";
                    break;
                case Player::ZOMBIESKIN_REGULAR:
                    zombieGraphic = "HUDCZOMR";
                    break;
                case Player::ZOMBIESKIN_OLD:
                    zombieGraphic = "HUDCZOMO";
                    break;
            }

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
            HudSetPointInternal(x - 18.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDZBACK");
            DebugDraw();

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_CENTER);
            HudSetPointInternal(x + 0.0, 1.0);
            BCSUtils::HudDrawImage(--_drawnHudId, zombieGraphic);
            DebugDraw();

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
            BCSUtils::HudSetScale(0.6);
            HudSetPointInternal(x + 10.0, 2.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(zombieCount));
            DebugDraw();
            BCSUtils::HudSetScale(1.0);
        }
    }

    internal void DrawStatCounters(Player::ZombieSkinTypeT skinType)
    {
        int kills = Player::GetZombieKills();
        int infects = Player::GetInfects();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        if (kills > 0 || infects > 0)
        {
            HudSetPointInternal();
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDTBACK");
            DebugDraw();
        }

        fixed x = 48.0;

        if (kills > 0)
        {
            // NOTE: Initial not currently working because we don't check initial zombies by design.
            str zombieGraphic;
            switch(skinType)
            {
                case Player::ZOMBIESKIN_INITIAL:
                    zombieGraphic = "HUDKCZMI";
                    break;
                case Player::ZOMBIESKIN_REGULAR:
                    zombieGraphic = "HUDKCZMR";
                    break;
                case Player::ZOMBIESKIN_OLD:
                    zombieGraphic = "HUDKCZMO";
                    break;
            }

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_CENTER);
            HudSetPointInternal(x + 2.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, zombieGraphic);
            DebugDraw();

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
            BCSUtils::HudSetScale(0.6);
            HudSetPointInternal(x + 8.0, 2.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(kills));
            DebugDraw();
            BCSUtils::HudSetScale(1.0);

            x -= 30.0;
        }

        if (infects > 0)
        {
            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_CENTER);
            HudSetPointInternal(x + 2.0, 0.0);
            BCSUtils::HudDrawImage(--_drawnHudId, "HUDCINFC");
            DebugDraw();

            BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
            BCSUtils::HudSetScale(0.6);
            HudSetPointInternal(x + 8.0, 2.0);
            BCSUtils::HudDrawText(--_drawnHudId, str(infects));
            DebugDraw();
            BCSUtils::HudSetScale(1.0);
        }
    }
}