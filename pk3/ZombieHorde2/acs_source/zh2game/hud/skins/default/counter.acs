#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawHumanPlayerCounter(fixed x, fixed y, int count)
    {
        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetPoint(x - 18.0, y);
        BCSUtils::HudDrawImage(--_drawnHudId, "HUDHBACK");
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetPoint(x - 4.0, y + 2.0);
        BCSUtils::HudDrawImage(--_drawnHudId, "HUDCHUMN");
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetScale(0.6);
        BCSUtils::HudSetPoint(x + 8.0, y + 2.0);
        BCSUtils::HudDrawText(--_drawnHudId, str(count));
        DebugDraw();
        BCSUtils::HudSetScale(1.0);
    }

    internal void DrawZombiePlayerCounter(fixed x, fixed y, Player::ZombieSkinTypeT skinType, int count)
    {
        // NOTE: Initial not currently working because we don't check initial zombies by design.
        str zombieGraphic;
        switch (skinType)
        {
            case Player::ZOMBIESKIN_INITIAL:
                zombieGraphic = "HUDCZOMI";
                break;
            case Player::ZOMBIESKIN_REGULAR:
                zombieGraphic = "HUDCZOMR";
                break;
            case Player::ZOMBIESKIN_OLD:
                zombieGraphic = "HUDCZOMO";
                break;
        }

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetPoint(x - 18.0, y);
        BCSUtils::HudDrawImage(--_drawnHudId, "HUDZBACK");
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetPoint(x, y + 1.0);
        BCSUtils::HudDrawImage(--_drawnHudId, zombieGraphic);
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetScale(0.6);
        BCSUtils::HudSetPoint(x + 10.0, y + 2.0);
        BCSUtils::HudDrawText(--_drawnHudId, str(count));
        DebugDraw();
        BCSUtils::HudSetScale(1.0);
    }

    internal void DrawPlayerCounters(fixed x, fixed y, Player::ZombieSkinTypeT skinType)
    {
        int humanCount = Game::HumanCount();
        int zombieCount = Game::ZombieCount();

        fixed zombieX = x;

        if (humanCount > 0)
        {
            DrawHumanPlayerCounter(x, y, humanCount);
            zombieX += 50.0;
        }

        if (zombieCount > 0)
            DrawZombiePlayerCounter(zombieX, y, skinType, zombieCount);
    }

    internal void DrawStatCountersBackground(fixed x, fixed y)
    {
        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetPoint(x, y);
        BCSUtils::HudDrawImage(--_drawnHudId, "HUDTBACK");
        DebugDraw();
    }

    // Generic icon+count widget shared by the kills/infects stat counters.
    internal void DrawStatCounter(fixed x, fixed y, str iconGraphic, int count)
    {
        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetPoint(x + 2.0, y);
        BCSUtils::HudDrawImage(--_drawnHudId, iconGraphic);
        DebugDraw();

        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_CENTER);
        BCSUtils::HudSetScale(0.6);
        BCSUtils::HudSetPoint(x + 8.0, y + 2.0);
        BCSUtils::HudDrawText(--_drawnHudId, str(count));
        DebugDraw();
        BCSUtils::HudSetScale(1.0);
    }

    internal void DrawStatCounters(fixed x, fixed y, Player::ZombieSkinTypeT skinType)
    {
        int kills = Player::GetZombieKills();
        int infects = Player::GetInfects();

        if (kills > 0 || infects > 0)
            DrawStatCountersBackground(x, y);

        fixed statX = x + 48.0;

        if (kills > 0)
        {
            // NOTE: Initial not currently working because we don't check initial zombies by design.
            str zombieGraphic;
            switch (skinType)
            {
                case Player::ZOMBIESKIN_INITIAL:
                    zombieGraphic = "HUDKCZMI";
                    break;
                case Player::ZOMBIESKIN_REGULAR:
                    zombieGraphic = "HUDKCZMR";
                    break;
                case Player::ZOMBIESKIN_OLD:
                    zombieGraphic = "HUDKCZMO";
                    break;
            }

            DrawStatCounter(statX, y, zombieGraphic, kills);
            statX -= 30.0;
        }

        if (infects > 0)
            DrawStatCounter(statX, y, "HUDCINFC", infects);
    }
}
