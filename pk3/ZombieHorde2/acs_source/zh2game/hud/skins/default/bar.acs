#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawSprintBar()
    {
        if (!GetSharedState().DrawSprintBar)
            return;

        int left = Player::GetSprintLeft();
        int id = DEFAULT_HUDID_SPRINTBAR;

        HudSetPointInternal();
        BCSUtils::HudDrawImage(--id, DEFAULT_BAR_SPRINT_NAME);

        fixed percentage = fixed(left) / fixed(SPRINT_ITEM_MAX);
        fixed clipX = BCSUtils::Round(fixed(DEFAULT_BAR_SPRINT_WIDTH) * percentage);

        //BCSUtils::HudSetAlpha(BCSUtils::Min(1.0, percentage * 1.5));
        BCSUtils::HudSetClipRect(fixed(-DEFAULT_BAR_SPRINT_WIDTH / 2), fixed(-DEFAULT_BAR_SPRINT_HEIGHT), clipX, fixed(DEFAULT_BAR_SPRINT_HEIGHT));
        BCSUtils::HudDrawImage(--id, DEFAULT_BAR_SPRINT_METER_NAME);
        BCSUtils::HudRemoveClipRect();
        BCSUtils::HudSetAlpha(1.0);

        DebugDraw();
    }

    internal void DrawAirSupplyBar()
    {
        if (!GetSharedState().DrawAirSupplyBar)
            return;

        int airSupply = GetAirSupply(ConsolePlayerNumber());
        int id = DEFAULT_HUDID_AIRBAR;

        HudSetPointInternal();
        BCSUtils::HudDrawImage(--id, DEFAULT_BAR_AIRSUPPLY_NAME);

        fixed percentage = fixed(airSupply) / fixed(MAX_AIRSUPPLY);
        fixed clipX = BCSUtils::Round(fixed(DEFAULT_BAR_AIRSUPPLY_WIDTH) * percentage);

        //BCSUtils::HudSetAlpha(BCSUtils::Min(1.0, percentage * 1.5));
        BCSUtils::HudSetClipRect(fixed(-DEFAULT_BAR_AIRSUPPLY_WIDTH / 2), fixed(-DEFAULT_BAR_AIRSUPPLY_HEIGHT), clipX, fixed(DEFAULT_BAR_AIRSUPPLY_HEIGHT));
        BCSUtils::HudDrawImage(--id, DEFAULT_BAR_AIRSUPPLY_METER_NAME);
        BCSUtils::HudRemoveClipRect();
        BCSUtils::HudSetAlpha(1.0);

        DebugDraw();
    }

    internal void DrawAfkBar()
    {
        if (!GetSharedState().DrawAfkBar)
            return;

        int max = GetSharedState().AfkBarMaxTics;
        int tics = GetSharedState().AfkBarTicsLeft;

        int id = DEFAULT_HUDID_AFKBAR;

        HudSetPointInternal();
        BCSUtils::HudDrawImage(--id, DEFAULT_BAR_AFKPREVENTION_NAME);

        fixed percentage = fixed(tics) / fixed(max);
        fixed clipX = BCSUtils::Round(fixed(DEFAULT_BAR_AFKPREVENTION_WIDTH) * percentage);

        //BCSUtils::HudSetAlpha(BCSUtils::Min(1.0, percentage * 1.5));
        BCSUtils::HudSetClipRect(fixed(-DEFAULT_BAR_AFKPREVENTION_WIDTH / 2), fixed(-DEFAULT_BAR_AFKPREVENTION_HEIGHT), clipX, fixed(DEFAULT_BAR_AFKPREVENTION_HEIGHT));
        BCSUtils::HudDrawImage(--id, DEFAULT_BAR_AFKPREVENTION_METER_NAME);
        BCSUtils::HudRemoveClipRect();
        DebugDraw();

        BCSUtils::HudSetAlpha(1.0);

        BCSUtils::HudSetTextColor(CR_WHITE);
        BCSUtils::HudSetFont("SmallFont");
        BCSUtils::HudSetStayTime(0.0);
        BCSUtils::HudSetDisappearTime(1.0);

        HudSetPointInternal(0.0, 10.0);
        BCSUtils::HudDrawText(--id, "Move to avoid getting kicked for inactivity");

        DebugDraw();
    }
}