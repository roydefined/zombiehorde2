#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawTimerMenuHud()
    {
        fixed x = GetHudX(),
              y = GetHudY();

        BCSUtils::HudSetTextColor(CR_WHITE);

        HudSetPointInternal();
        BCSUtils::HudDrawText(--_drawnHudId, "\cfTimers");

        if (DrawClickableText(--_drawnHudId, x, y + 10.0, 100.0, 10.0, "Back to start"))
            OpenAdminMenu(ADMINMENU_START);

        int index = RoundTimer::GetActiveTimerIndex();
        if (RoundTimer::GetTimerDefined(index))
        {
            BCSUtils::HudSetPoint(x, y);
            BCSUtils::HudSetTextColor(CR_WHITE);

            
            HudSetPointInternal(0.0, 30.0);
            BCSUtils::HudDrawText(--_drawnHudId, "\cfAdd current timer");

            // Helper
            fixed addY = 40.0;

            // Increment / decrement
            if (DrawClickableText(--_drawnHudId, x, y + addY, 30.0, 10.0, "-1m"))
                Admin::AdminIncrementCurrentTimerClientSide(-35 * 60);

            if (DrawClickableText(--_drawnHudId, x + 30.0, y + addY, 30.0, 10.0, "-10s"))
                Admin::AdminIncrementCurrentTimerClientSide(-35 * 10);

            if (DrawClickableText(--_drawnHudId, x + 60.0, y + addY, 30.0, 10.0, "-1s"))
                Admin::AdminIncrementCurrentTimerClientSide(-35 * 1);

            if (DrawClickableText(--_drawnHudId, x + 90.0, y + addY, 30.0, 10.0, "+1s"))
                Admin::AdminIncrementCurrentTimerClientSide(35 * 1);

            if (DrawClickableText(--_drawnHudId, x + 120.0, y + addY, 30.0, 10.0, "+10s"))
                Admin::AdminIncrementCurrentTimerClientSide(35 * 10);

            if (DrawClickableText(--_drawnHudId, x + 150.0, y + addY, 30.0, 10.0, "+1m"))
                Admin::AdminIncrementCurrentTimerClientSide(35 * 60);

            // Pause / resume
            if (DrawClickableTextConditional(
                !RoundTimer::GetTimerPaused(index), --_drawnHudId, x, y + addY + 10.0, 80.0, 10.0, "Pause timer"))
            {
                Admin::AdminPauseCurrentTimerClientSide();
            }

            if (DrawClickableTextConditional(
                RoundTimer::GetTimerPaused(index), --_drawnHudId, x, y + addY + 20.0, 80.0, 10.0, "Resume timer"))
            {
                Admin::AdminResumeCurrentTimerClientSide();
            }
        }
    }
}