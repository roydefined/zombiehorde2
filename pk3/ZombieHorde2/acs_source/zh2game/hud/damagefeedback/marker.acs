#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    internal void DrawMarker()
    {
        BCSUtils::HudResetState();
        BCSUtils::HudSetVirtualSize(1280.0, 960.0);
        BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);

        PrepareHud(640.0, 480.0, false);

        // Booleans are used to determine if we did hit once.
        // This ensures we can use tic 0 for displaying feedback.
        bool hasHitOnce = DamageFeedback::GetHitFeedbackTics() > 0;
        bool hasKillOnce = DamageFeedback::GetKillFeedbackTics() > 0;

        // Booleans indicate if the user configured the markers to show.
        CVar::DamageFeedbackMarkerShowTypeT markerShowType = CVar::GetClDamageFeedbackMarkerShowType();
        bool showHitMarkers = markerShowType == CVar::DAMAGEFEEDBACK_MARKER_SHOW_HITS || markerShowType == CVar::DAMAGEFEEDBACK_MARKER_SHOW_BOTH;
        bool showKillMarkers = markerShowType == CVar::DAMAGEFEEDBACK_MARKER_SHOW_KILLS || markerShowType == CVar::DAMAGEFEEDBACK_MARKER_SHOW_BOTH;

        // First draw hit, then kill.
        // Kill will be drawn over any hit graphics.
        int elapsedHit = DamageFeedback::GetElapsedHitFeedbackTics();
        int elapsedKill = DamageFeedback::GetElapsedKillFeedbackTics();

        // These values indicate the max amount of tics the markers are shown for.
        int shownHitTics = CVar::GetClDamageFeedbackHitMarkerShownTics();
        int shownKillTics = CVar::GetClDamageFeedbackKillMarkerShownTics();

        int ticsLeft = BCSUtils::Max(0, shownHitTics - elapsedHit);
        if (showHitMarkers && hasHitOnce && ticsLeft > 0)
        {
            HudSetPointInternal();
            BCSUtils::HudSetAlpha(CalculateFeedbackAlpha(ticsLeft));
            BCSUtils::HudDrawImage(--_drawnHudId, FEEDBACK_HIT_GRAPHIC);
        }

        ticsLeft = BCSUtils::Max(0, shownKillTics - elapsedKill);
        if (showKillMarkers && hasKillOnce && ticsLeft > 0)
        {
            HudSetPointInternal();
            BCSUtils::HudSetAlpha(CalculateFeedbackAlpha(ticsLeft));
            BCSUtils::HudDrawImage(--_drawnHudId, FEEDBACK_KILL_GRAPHIC);
        }
    }
}