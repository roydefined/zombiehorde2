#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Hud
{
    // NOTE: Setting CVars uses ConsoleCommand which might break in the future. We do notify of this on the UI.
    // https://wiki.zandronum.com/ConsoleCommand

    internal void DrawClientSettingsHud()
    {
        BCSUtils::HudResetState();
        BCSUtils::HudSetVirtualSize(32.0, 32.0);
        BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);
        Utils::ScaleToScreen();

        PrepareHud(64.0, 64.0, false);
        BCSUtils::HudSetAlpha(CLIENT_SETTINGS_TINT_ALPHA);
        HudSetPointInternal();
        BCSUtils::HudDrawImage(HUDID_CLIENTSETTINGS_TINT, "BLACK");

        BCSUtils::HudResetState();
        HudSetScaledVirtualSize(640.0, 480.0, CVar::GetClHudClientSettingsScale());
        BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);
        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_LEFT, BCSUtils::HUD_ALIGN_TOP);

        fixed x = BCSUtils::HudLeft() + 100.0;
        fixed y = BCSUtils::HudTop() + 50.0;

        PrepareHud(x, y, false);

        // The header returns how much space it used, the settings go below it.
        y += DrawClientSettingsHeader() + 10.0;

        PrepareHud(x, y, false);
        BCSUtils::HudSetFont("BigFont");
        HudSetPointInternal();

        int count = ZH2Game::GameContext.RequestedClientSettingCount;
        if (count == 0)
        {
            BCSUtils::HudSetTextColor(CR_GREEN);
            BCSUtils::HudDrawText(--_drawnHudId, "All settings are up to date.");
            return;
        }

        BCSUtils::HudDrawText(--_drawnHudId, "\cjSettings");

        BCSUtils::HudSetFont("SmallFont");
        BCSUtils::HudSetTextColor(CR_YELLOW);

        HudSetPointInternal(0.0, 20.0);
        BCSUtils::HudDrawText(--_drawnHudId, "Type");

        HudSetPointInternal(90.0, 20.0);
        BCSUtils::HudDrawText(--_drawnHudId, "Name");

        HudSetPointInternal(250.0, 20.0);
        BCSUtils::HudDrawText(--_drawnHudId, "Yours");

        HudSetPointInternal(340.0, 20.0);
        BCSUtils::HudDrawText(--_drawnHudId, "Recommended");

        HudSetPointInternal(450.0, 20.0);
        BCSUtils::HudDrawText(--_drawnHudId, "Action");

        // Only as many settings as fit on the screen are shown.
        int shownCount = BCSUtils::Min(count, CLIENT_SETTINGS_MAX_SHOWN);
        for (int i = 0; i < shownCount; ++i)
        {
            PrepareHud(x, y + 40.0 + fixed(30 * i), false);
            DrawInvalidSetting(i);
        }

        if (count > shownCount)
        {
            PrepareHud(x, y + 40.0 + fixed(30 * shownCount), false);
            BCSUtils::HudSetFont("SmallFont");
            BCSUtils::HudSetTextColor(CR_GRAY);
            HudSetPointInternal();
            BCSUtils::HudDrawText(--_drawnHudId, "And " + str(count - shownCount) + " more. Fix the settings above and refresh to see them.");
        }
    }

    // Returns the height the header used.
    internal fixed DrawClientSettingsHeader()
    {
        BCSUtils::HudSetFont("BigFont");

        HudSetPointInternal();
        BCSUtils::HudDrawText(--_drawnHudId, "Client settings");
        DebugDraw();

        int count = ZH2Game::GameContext.RequestedClientSettingCount;
        int persistingCount = ZH2Game::PersistingGameContext.RequestedClientSettingCount;

        BCSUtils::HudSetFont("SmallFont");
        BCSUtils::HudSetTextColor(CR_WHITE);

        HudSetPointInternal(0.0, 20.0);
        BCSUtils::HudDrawText(--_drawnHudId, "\cd" + str(count) + "\cj of \cd" + str(persistingCount) + "\cj settings differ from what Zombie Horde 2 recommends.");

        // The notes can be long, so they wrap. Two lines are reserved for each.
        fixed addY = 35.0;
        BCSUtils::HudSetWordWrap(true);
        BCSUtils::HudSetTextColor(CR_YELLOW);

        HudSetPointInternal(0.0, addY);
        BCSUtils::HudDrawText(--_drawnHudId, "Note: \cjFixing a CVar uses ConsoleCommand, which may stop working in a future engine version.");
        DebugDraw();
        addY += 20.0;

        // Inform client of cl_protectcvars if set.
        if (CVar::GetClProtectCVars())
        {
            HudSetPointInternal(0.0, addY);
            BCSUtils::HudDrawText(--_drawnHudId, "Note: \cj'cl_protectcvars' is enabled, so fixes are undone when you disconnect. Disable it to keep them.");
            DebugDraw();
            addY += 20.0;
        }

        BCSUtils::HudSetWordWrap(false);

        BCSUtils::HudSetFont("BigFont");

        HudSetPointInternal(0.0, addY + 5.0);
        BCSUtils::HudDrawText(--_drawnHudId, "Actions");

        BCSUtils::HudSetFont("SmallFont");

        // Clickable buttons
        if (DrawClickableText(--_drawnHudId, 0.0, addY + 25.0, 140.0, 10.0, "Refresh settings"))
            Settings::UpdateCurrentClientSettings();

        if (DrawClickableText(--_drawnHudId, 0.0, addY + 40.0, 140.0, 10.0, "Close settings"))
            Settings::CloseClientSettingsMenu();

        if (DrawClickableText(--_drawnHudId, 160.0, addY + 25.0, 140.0, 10.0, "Open keybinds menu"))
            Settings::CloseMenuAndOpenZh2KeybindsMenu();

        if (DrawClickableText(--_drawnHudId, 160.0, addY + 40.0, 140.0, 10.0, "Open Zombie Horde 2 menu"))
            Settings::CloseMenuAndOpenZh2Menu();

        return addY + 50.0;
    }

    internal void DrawInvalidSetting(int index)
    {
        str type = Settings::GetInvalidClientSettingType(index);
        str name = Settings::GetInvalidClientSettingName(index);
        int value = Settings::GetInvalidClientSettingValue(index);
        str label = Settings::GetInvalidClientSettingLabel(index);

        BCSUtils::HudSetFont("SmallFont");
        BCSUtils::HudSetTextColor(CR_WHITE);

        HudSetPointInternal();
        BCSUtils::HudDrawText(--_drawnHudId, type == "cvar" ? "CVar" : "Keybind");

        HudSetPointInternal(90.0, 0.0);
        BCSUtils::HudDrawText(--_drawnHudId, "\cd" + name);

        HudSetPointInternal(250.0, 0.0);
        if (type == "cvar") BCSUtils::HudDrawText(--_drawnHudId, "\cg" + str(GetCvar(name)));
        else BCSUtils::HudDrawText(--_drawnHudId, "\cg" + (BCSUtils::KeyBound(name) ? "Bound" : "Not bound"));

        HudSetPointInternal(340.0, 0.0);
        if (type == "cvar") BCSUtils::HudDrawText(--_drawnHudId, "\cd" + str(value));
        else BCSUtils::HudDrawText(--_drawnHudId, "\cd" + (value ? "Bound" : "Not bound"));

        // CVars can be fixed directly.
        // Restrictions of ConsoleCommand prevents us from binding/unbinding, so keys link to the keybinds menu instead.
        if (type == "cvar")
        {
            if (DrawClickableText(--_drawnHudId, 450.0, 0.0, 100.0, 10.0, "Fix"))
                UpdateSettingToRequested(index);
        }
        else
        {
            if (DrawClickableText(--_drawnHudId, 450.0, 0.0, 100.0, 10.0, "Open keybinds"))
                Settings::CloseMenuAndOpenZh2KeybindsMenu();
        }

        // The description can be long, so it wraps.
        BCSUtils::HudSetTextColor(CR_GRAY);
        BCSUtils::HudSetWordWrap(true);

        HudSetPointInternal(0.0, 10.0);
        BCSUtils::HudDrawText(--_drawnHudId, label);

        BCSUtils::HudSetWordWrap(false);
    }

    internal void UpdateSettingToRequested(int index)
    {
        str type = Settings::GetInvalidClientSettingType(index);

        // Failsafe, should not allow when we try (un)bind a key
        if (type != "cvar")
            return;

        str name = Settings::GetInvalidClientSettingName(index);
        int value = Settings::GetInvalidClientSettingValue(index);

        // ConsoleCommand because SetCVar / SetGameplaySetting do not allow changing CVars we define.
        ConsoleCommand(name + " " + str(value));

        Settings::UpdateCurrentClientSettings();
    }
}