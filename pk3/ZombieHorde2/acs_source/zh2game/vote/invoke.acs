strict namespace Vote
{
    script "zh2_vote_endround"
    {
        Logger::LogInformation(LOGSOURCE, "Vote \cdendround\cj passed.");
    }

    script "zh2_vote_restartmap"
    {
        Logger::LogInformation(LOGSOURCE, "Vote \cdrestartmap\cj passed.");
    }

    script "zh2_vote_extendtime" (int seconds)
    {
        Logger::LogInformation(LOGSOURCE, "Vote \cdextendtime\cj passed with \cd" + str(seconds) + "\cj seconds.");
    }
}
