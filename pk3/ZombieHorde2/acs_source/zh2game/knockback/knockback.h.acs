#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Knockback
{
    // Minimum and maximum values that match Zandronum's behavior.
    // If no mass is set, this value is used.
    #define ENGINE_MAX_THRUST 32
    #define ENGINE_MIN_THRUST 0.01

    // Same divisor the engine uses for its thrust.
    #define SLOWDOWN_MASS_DIVISOR 8
    #define SLOWDOWN_MAX_PERCENT 100
}