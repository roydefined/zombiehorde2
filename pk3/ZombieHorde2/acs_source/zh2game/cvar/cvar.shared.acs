    // The one cvar with a setter: the getter still goes through the macro, but the setter is kept
    // as a plain function since nothing else here generates setters.
    CVAR_ENGINE_FIXED(GetSndMusicVolume, "snd_musicvolume")

    // NOTE: this uses ConsoleCommand, it should get a better alternative sometime.
    void SetSndMusicVolume(fixed volume) { ConsoleCommand("snd_musicvolume " + str(volume)); }
