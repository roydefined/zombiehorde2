    // Game - Obituary
    // 0 = don't force (use client preference), 1 = graphical, 2 = text, 3 = legacy text.
    CVAR_SV_CUSTOM_CLAMPED(ForceObituaryDisplayMode, ObituaryDisplayModeOverrideT, 0, 3,
    {
        case 1: return OBITUARYDISPLAYOVERRIDE_GRAPHICAL;
        case 2: return OBITUARYDISPLAYOVERRIDE_TEXT;
        case 3: return OBITUARYDISPLAYOVERRIDE_LEGACYTEXT;
        default: return OBITUARYDISPLAYOVERRIDE_NONE;
    })

    // 0 = graphical, 1 = text, 2 = legacy text.
    CVAR_CL_CUSTOM_CLAMPED(ObituaryDisplayMode, ObituaryDisplayModeT, 0, 2,
    {
        case 1: return OBITUARYDISPLAY_TEXT;
        case 2: return OBITUARYDISPLAY_LEGACYTEXT;
        default: return OBITUARYDISPLAY_GRAPHICAL;
    })

    // Not a cvar itself: combines the server override with the client's own preference.
    ObituaryDisplayModeT GetObituaryDisplayMode(int playerId)
    {
        switch (GetSvForceObituaryDisplayMode())
        {
            case OBITUARYDISPLAYOVERRIDE_GRAPHICAL: return OBITUARYDISPLAY_GRAPHICAL;
            case OBITUARYDISPLAYOVERRIDE_TEXT: return OBITUARYDISPLAY_TEXT;
            case OBITUARYDISPLAYOVERRIDE_LEGACYTEXT: return OBITUARYDISPLAY_LEGACYTEXT;
            default: return GetClObituaryDisplayModeByPlayerId(playerId);
        }
    }

