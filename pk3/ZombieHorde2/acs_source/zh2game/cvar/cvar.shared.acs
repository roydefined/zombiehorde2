    // Hud
    CVAR_CL_BOOL(DrawHud)

    // If a type argument contains "::" then it breaks the compiler's tokenizer.
    // Aliasing the qualified type to a plain name first works around it.
    typedef Weapon::WeaponSkinBehaviourT ForceWeaponSkinTypeT;
    CVAR_SV_CUSTOM_CLAMPED(ForceWeaponSkin, ForceWeaponSkinTypeT, 0, 2,
    {
        case 1: return Weapon::WEAPONSKINBEHAVIOUR_FORCEDEFAULTSKIN;
        case 2: return Weapon::WEAPONSKINBEHAVIOUR_FORCELEGACYSKIN;
        default: return Weapon::WEAPONSKINBEHAVIOUR_DEFAULT;
    })

    // Same as the above.
    typedef RoundTimer::TimerSkinBehaviourT ForceTimerSkinTypeT;
    CVAR_SV_CUSTOM_CLAMPED(ForceTimerSkin, ForceTimerSkinTypeT, 0, 2,
    {
        case 1: return RoundTimer::TIMERSKINBEHAVIOUR_FORCEDEFAULTSKIN;
        case 2: return RoundTimer::TIMERSKINBEHAVIOUR_FORCELEGACYSKIN;
        default: return RoundTimer::TIMERSKINBEHAVIOUR_DEFAULT;
    })

    CVAR_SV_CUSTOM_CLAMPED(ForceHudSkin, HudSkinBehaviourT, 0, 2,
    {
        case 1: return HUDSKINBEHAVIOUR_FORCEDEFAULTSKIN;
        case 2: return HUDSKINBEHAVIOUR_FORCELEGACYSKIN;
        default: return HUDSKINBEHAVIOUR_DEFAULT;
    })

