#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Event
{
    internal void SendInitialsChosen(int chosenCount)
    {
        str packet = Packet::New();
        packet = Packet::AppendStr(packet, EVENTINITIALSCHOSEN);
        packet = Packet::Append(packet, chosenCount);

        for(int i = 0; i < BCSUTILS::MAX_PLAYERS; ++i)
        {
            if (Player::GetPlayerInitialZombie(i))
                packet = Packet::Append(packet, i);
        }

        EventBus::CallEvent(packet);
    }

