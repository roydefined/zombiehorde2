        packet = Packet::Append(packet, killedId);
        packet = Packet::Append(packet, killerId);
        packet = Packet::Append(packet, itemIndex);
        packet = Packet::Append(packet, addFireEffect);
        packet = Packet::Append(packet, addAcidEffect);
        EventBus::CallEvent(packet);
    }

