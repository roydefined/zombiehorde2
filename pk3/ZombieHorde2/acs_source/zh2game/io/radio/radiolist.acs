#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace IO
{
    // Radio track the code is parsing.
    internal Decorate::RadioTrackContextT _parsingRadioTrack;

    internal bool ParseRadioList(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, RADIO_DEF_LUMP_RADIO_LIST_BLOCK_KEYWORD))
            return false;

        Logger::LogDebug(LOGSOURCE, "Start parsing radio tracks.");
        return ParseRadioBlock(handle);
    }

    internal bool ParseRadioBlock(int handle)
    {
        int braceLevel = Tokenizer::GetBraceLevel(handle);
        if (!Tokenizer::ExpectNextChar(handle, '{'))
            return false;

        Tokenizer::Next(handle);

        // While the brace level does not match the end level, we keep parsing.
        while (Tokenizer::CanRead(handle) && Tokenizer::GetBraceLevel(handle) != braceLevel)
        {
            if (ParseRadioTrack(handle))
                continue;

            Tokenizer::SetErrored(handle, "Unknown symbol whilst parsing radio tracks: '" + Tokenizer::GetSymbol(handle) + "'.");
            return false;
        }

        // Peek next character, see if we have a comma.
        // These are optional and if so, make sure to skip it.
        Tokenizer::Next(handle, false);
        if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
            Tokenizer::Next(handle, false);

        Logger::LogDebug(LOGSOURCE, "Finished parsing radio tracks.");
        return true;
    }

    internal bool ParseRadioTrack(int handle)
    {
        if (!BCSUTILS::StrIEquals(Tokenizer::GetSymbol(handle), RADIO_DEF_LUMP_RADIO_LIST_TRACK_KEYWORD))
            return false;

        Logger::LogDebug(LOGSOURCE, "Start parsing single radio track.");
        Tokenizer::Next(handle);

        // Expecting a string-like type for the name
        Tokenizer::TokenTypeT token = Tokenizer::GetToken(handle);
        if (token != Tokenizer::TSYMBOL && token != Tokenizer::TSTRING)
        {
            Tokenizer::SetErrored(handle, "Expected symbol or string for track, received '" + Tokenizer::GetSymbol(handle) + "'.");
            return false;
        }

        str lumpName = Tokenizer::GetSymbol(handle);

        if (!Tokenizer::ExpectNextToken(handle, Tokenizer::TLBRACE)) return false;
        Tokenizer::Next(handle);

        // Lumps are sent to other clients, so skip tracks with an invalid lump.
        int lumpLength = StrLen(lumpName);
        if (lumpLength == 0 || lumpLength > RADIO_LUMP_MAX_LENGTH)
        {
            Logger::LogWarning(LOGSOURCE, "Radio track \cd" + lumpName + "\cj was skipped. Its lump must be 1 to " + str(RADIO_LUMP_MAX_LENGTH) + " characters long.");
            Tokenizer::ParseRemainingBodyAsEmpty(handle);
            return true;
        }

        if (!Decorate::ValidateRadioProperty(lumpName, RADIO_LUMP_ALLOWED_CHARACTERS))
        {
            Logger::LogWarning(LOGSOURCE, "Radio track \cd" + lumpName + "\cj was skipped. Its lump contains illegal characters, only letters, digits and \cd" + RADIO_LUMP_ALLOWED_CHARACTERS + "\cj are allowed.");
            Tokenizer::ParseRemainingBodyAsEmpty(handle);
            return true;
        }

        // No more room for more items. Log a warning and skip the remaining body.
        int count = ZH2Game::PersistingGameContext.RadioTrackCollection.Size;
        if (count >= MAX_RADIO_TRACKS)
        {
            Logger::LogWarning(LOGSOURCE, "The maximum number of radio tracks was reached (" + str(count) + ").");
            Tokenizer::ParseRemainingBodyAsEmpty(handle);
            return true;
        }

        _parsingRadioTrack.LumpName = lumpName;
        _parsingRadioTrack.Name = (raw)0;
        _parsingRadioTrack.Author = (raw)0;
        _parsingRadioTrack.Remark = (raw)0;

        // As long as we are inside this body, parse properties and insert them into the new item.
        int braceLevel = Tokenizer::GetBraceLevel(handle);
        while (Tokenizer::CanRead(handle) && Tokenizer::GetBraceLevel(handle) == braceLevel)
        {
            str symbol = Tokenizer::GetSymbol(handle);
            if (ParseName(handle, symbol)
                || ParseAuthor(handle, symbol)
                || ParseRemark(handle, symbol))
            {
                // Optional comma.
                Tokenizer::Next(handle, false);
                if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
                    Tokenizer::Next(handle, false);

                continue;
            }

            Tokenizer::SetErrored(handle, "Unknown symbol whilst parsing a radio track: '" + Tokenizer::GetSymbol(handle) + "'.");
            return false;
        }

        // Optional comma.
        Tokenizer::Next(handle, false);
        if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
            Tokenizer::Next(handle, false);

        // Validate values. Name and author are optional.
        if (_parsingRadioTrack.Name != (raw)0)
        {
            if (StrLen(_parsingRadioTrack.Name) > RADIO_TEXT_MAX_LENGTH)
            {
                Logger::LogWarning(LOGSOURCE, "Radio track \cd" + lumpName + "\cj name \cd" + _parsingRadioTrack.Name + "\cj is longer than " + str(RADIO_TEXT_MAX_LENGTH) + " characters.");
                return true;
            }

            if (!Decorate::ValidateRadioProperty(_parsingRadioTrack.Name, RADIO_TEXT_ALLOWED_CHARACTERS))
            {
                Logger::LogWarning(LOGSOURCE, "Radio track \cd" + lumpName + "\cj name \cd" + _parsingRadioTrack.Name + "\cj contains illegal characters, only letters, digits and \cd" + RADIO_TEXT_ALLOWED_CHARACTERS + "\cj are allowed.");
                return true;
            }
        }

        if (_parsingRadioTrack.Author != (raw)0)
        {
            if (StrLen(_parsingRadioTrack.Author) > RADIO_TEXT_MAX_LENGTH)
            {
                Logger::LogWarning(LOGSOURCE, "Radio track \cd" + lumpName + "\cj author \cd" + _parsingRadioTrack.Author + "\cj is longer than " + str(RADIO_TEXT_MAX_LENGTH) + " characters.");
                return true;
            }

            if (!Decorate::ValidateRadioProperty(_parsingRadioTrack.Author, RADIO_TEXT_ALLOWED_CHARACTERS))
            {
                Logger::LogWarning(LOGSOURCE, "Radio track \cd" + lumpName + "\cj author \cd" + _parsingRadioTrack.Author + "\cj contains illegal characters, only letters, digits and \cd" + RADIO_TEXT_ALLOWED_CHARACTERS + "\cj are allowed.");
                return true;
            }
        }

        Decorate::RadioTrackContextT global:PERSISTING_GAME_CONTEXT_INDEX& context = ZH2Game::PersistingGameContext.RadioTrackCollection.Collection[count];
        context.LumpName = _parsingRadioTrack.LumpName;
        context.Name = _parsingRadioTrack.Name;
        context.Author = _parsingRadioTrack.Author;
        context.Remark = _parsingRadioTrack.Remark;

        // TODO: Log data
        Logger::LogDebug(LOGSOURCE, "Finished parsing radio track: \cd" + context.lumpName + "\cj.");
        ZH2Game::PersistingGameContext.RadioTrackCollection.Size++;
        return true;
    }

    internal bool ParseName(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "name")) return false;
        Tokenizer::Next(handle);

        _parsingRadioTrack.Name = Tokenizer::GetSymbol(handle);

        Logger::LogDebug(LOGSOURCE, "Parsed radio track name: \cd" + _parsingRadioTrack.Name + "\cj.");
        return true;
    }

    internal bool ParseAuthor(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "author")) return false;
        Tokenizer::Next(handle);

        _parsingRadioTrack.Author = Tokenizer::GetSymbol(handle);

        Logger::LogDebug(LOGSOURCE, "Parsed radio track author: \cd" + _parsingRadioTrack.Author + "\cj.");
        return true;
    }

    internal bool ParseRemark(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "remark")) return false;
        Tokenizer::Next(handle);

        _parsingRadioTrack.Remark = Tokenizer::GetSymbol(handle);

        Logger::LogDebug(LOGSOURCE, "Parsed radio track remark: \cd" + _parsingRadioTrack.Remark + "\cj.");
        return true;
    }
}