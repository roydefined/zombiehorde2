#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Player
{
    internal void SetInitialZombie(bool set) { SetPlayerInitialZombie(PlayerNumber(), set); }
    internal void SetPlayerInitialZombie(int id, bool set)
    {
        if (!Identity::IsValidID(id))
        {
            Logger::LogError(LOGSOURCE, "Unable to set player as initial zombie. Id " + str(id) + " is not valid.");
            return;
        }

        if (GetPlayerInitialZombie(id) == set) return;
        ZH2Game::GameContext.Players[id].IsInitialZombie = set;
        Logger::LogDebug(LOGSOURCE, (set ? "Added" : "Removed") + " (\cd" + str(id) + "\cj) \cd" + BCSUTILS::PlayerName(id) + "\cj as an initial zombie.");
    }

    internal bool GetInitialZombie() { return GetPlayerInitialZombie(PlayerNumber()); }
    internal bool GetPlayerInitialZombie(int id)
    {
        if (!Identity::IsValidID(id))
        {
            Logger::LogError(LOGSOURCE, "Unable to get player as initial zombie. Id " + str(id) + " is not valid.");
            return false;
        }

        return ZH2Game::GameContext.Players[id].IsInitialZombie;
    }

    internal void SetInitialZombiePreviously(bool set) { SetPlayerInitialZombiePreviously(PlayerNumber(), set); }
    internal void SetPlayerInitialZombiePreviously(int id, bool set)
    {
        VALIDATE_ID_VALID_FUNCTION(id);

        if (GetPlayerInitialZombiePreviously(id) == set)
            return;

        ZH2Game::PersistingGameContext.Players[id].InitialPickContext.InitialZombiePreviously = set;
        Logger::LogDebug(LOGSOURCE, (set ? "Added" : "Removed") + " (\cd" + str(id) + "\cj) \cd" + BCSUTILS::PlayerName(id) + "\cj as a previously initial zombie.");
    }

    internal bool GetInitialZombiePreviously() { return GetPlayerInitialZombiePreviously(PlayerNumber()); }
    internal bool GetPlayerInitialZombiePreviously(int id)
    {
        VALIDATE_ID_VALID_FUNCTION_RETURN(id, false);
        return ZH2Game::PersistingGameContext.Players[id].InitialPickContext.InitialZombiePreviously;
    }

    internal void SetInitialZombieLastMap(bool set) { SetPlayerInitialZombieLastMap(PlayerNumber(), set); }
    internal void SetPlayerInitialZombieLastMap(int id, bool set)
    {
        VALIDATE_ID_VALID_FUNCTION(id);

        if (GetPlayerInitialZombieLastMap(id) == set)
            return;

        ZH2Game::PersistingGameContext.Players[id].InitialPickContext.InitialZombieLastMap = set;
        Logger::LogDebug(LOGSOURCE, (set ? "Added" : "Removed") + " (\cd" + str(id) + "\cj) \cd" + BCSUTILS::PlayerName(id) + "\cj as a last map initial zombie.");
    }

    internal bool GetInitialZombieLastMap() { return GetPlayerInitialZombieLastMap(PlayerNumber()); }
    internal bool GetPlayerInitialZombieLastMap(int id)
    {
        VALIDATE_ID_VALID_FUNCTION_RETURN(id, false);
        return ZH2Game::PersistingGameContext.Players[id].InitialPickContext.InitialZombieLastMap;
    }

    internal void SetInitialZombiePickWeight(int weight) { SetPlayerInitialZombiePickWeight(PlayerNumber(), weight); }
    internal void SetPlayerInitialZombiePickWeight(int id, int weight)
    {
        VALIDATE_ID_VALID_FUNCTION(id);

        if (GetPlayerInitialZombiePickWeight(id) == weight)
            return;

        ZH2Game::PersistingGameContext.Players[id].InitialPickContext.PickWeight = weight;
        Logger::LogDebug(LOGSOURCE, "Set initial zombie pick weight for (\cd" + str(id) + "\cj) \cd" + BCSUTILS::PlayerName(id) + "\cj to \cd" + str(weight) + "\cj.");
    }

    internal int GetInitialZombiePickWeight() { return GetPlayerInitialZombiePickWeight(PlayerNumber()); }
    internal int GetPlayerInitialZombiePickWeight(int id)
    {
        VALIDATE_ID_VALID_FUNCTION_RETURN(id, 0);
        return ZH2Game::PersistingGameContext.Players[id].InitialPickContext.PickWeight;
    }

    // Internal because I don't want to expose this when it has `bool` previous.
    // Use the two methods below instead.
    internal int InitialsCountInternal(bool previous, bool includeDead = false)
    {
        int count;
        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            // Count optionally allows for including dead players.
            if (!includeDead
                && (!PlayerInGame(i) || !BCSUtils::ActorIsAlive(Identity::GetTID(i))))
            {
                continue;
            }

            bool check = previous
                ? GetPlayerInitialZombiePreviously(i)
                : GetPlayerInitialZombie(i);
            if (!check) continue;

            count++;
        }

        return count;
    }

    internal int InitialZombieCount(bool includeDead = false)
    {
        return InitialsCountInternal(false, includeDead);
    }

    internal int PreviouslyInitialZombieCount(bool includeDead = false)
    {
        return InitialsCountInternal(true, includeDead);
    }

    internal fixed GetInitialZombiePickChance()
    {
        return GetPlayerInitialZombiePickChance(PlayerNumber());
    }

    internal fixed GetPlayerInitialZombiePickChance(int id)
    {
        ZH2Game::InitialZombiePickMethodT pickMethod = ZH2Game::GetInitialZombiePickMethod();
        bool rememberLastMap = ZH2Game::GetInitialPickRememberLastMap();

        switch (pickMethod)
        {
            case ZH2Game::INITIALZOMBIEPICKMETHOD_LEGACY:
                return GetPlayerInitialZombiePickChanceLegacy(id, rememberLastMap);
            case ZH2Game::INITIALZOMBIEPICKMETHOD_WEIGHT:
                return GetPlayerInitialZombiePickChanceWeight(id, rememberLastMap);
            default:
                return GetPlayerInitialZombiePickChanceRandom(id);
        }
    }

    internal fixed GetPlayerInitialZombiePickChanceLegacy(int id, bool checkLastMap)
    {
        if (checkLastMap && GetPlayerInitialZombieLastMap(id))
            return 0.0;

        if (GetPlayerInitialZombiePreviously(id))
            return 0.0;

        int eligiblePlayers = 0;

        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            if (!PlayerInGame(i))
                continue;

            if (checkLastMap && GetPlayerInitialZombieLastMap(i))
                continue;

            if (GetPlayerInitialZombiePreviously(i))
                continue;

            eligiblePlayers++;
        }

        return 1.0 / fixed(eligiblePlayers);
    }

    internal fixed GetPlayerInitialZombiePickChanceRandom(int id)
    {
        int eligiblePlayers = 0;

        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            if (!PlayerInGame(i))
                continue;

            eligiblePlayers++;
        }

        return 1.0 / fixed(eligiblePlayers);
    }

    internal fixed GetPlayerInitialZombiePickChanceWeight(int id, bool checkLastMap)
    {
        if (checkLastMap && GetPlayerInitialZombieLastMap(id))
            return 0.0;

        int playerWeight = GetPlayerInitialZombiePickWeight(id) + 1;

        if (playerWeight <= 0)
            return 0.0;

        int totalWeight = 0;

        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            if (!PlayerInGame(i))
                continue;

            if (checkLastMap && GetPlayerInitialZombieLastMap(i))
                continue;

            int weight = GetPlayerInitialZombiePickWeight(i) + 1;

            if (weight <= 0)
                continue;

            totalWeight += weight;
        }

        if (totalWeight == 0)
            return 0.0;

        return fixed(playerWeight) / fixed(totalWeight);
    }
}