#ifdef __IMPORTED__
    #error This file must be #included.
#endif

#define LOGSOURCE "Debug"

#include "admin.acs"
#include "io.acs"
#include "map.acs"
#include "power.acs"
#include "player.acs"
#include "setting.acs"

strict namespace Debug
{
    script "zh2_action_syncall" net
    {
        // Can't be called when not offline, not in development and we are not admin.
        if (!IsNetworkGame() && !Environment::IsDevelopment() && !Admin::GetIsAdmin())
        {
            Logger::LogActivator("You're not allowed to call sync scripts.");
            terminate;
        }

        Sync::SyncAll();
        Sync::LibSyncAll();
        Logger::LogActivator("Sync all triggered.");
    }

    script "zh2_action_callclientsyncall" net
    {
        // Can't be called when not offline, not in development and we are not admin.
        if (!IsNetworkGame() && !Environment::IsDevelopment() && !Admin::GetIsAdmin())
        {
            Logger::LogActivator("You're not allowed to call sync scripts.");
            terminate;
        }

        Sync::CallClientSyncAll();
        Sync::CallClientLibSyncAll();
        Logger::LogActivator("Call client sync all triggered.");
    }

    script "zh2_action_clientsyncall" net clientside
    {
        // Can't be called when not offline, not in development and we are not admin.
        if (!IsNetworkGame() && !Environment::IsDevelopment() && !Admin::GetIsAdmin())
        {
            Logger::LogActivator("You're not allowed to call sync scripts.");
            terminate;
        }

        Sync::SyncAllClientside();
        Sync::LibSyncAllClientside();

        Logger::LogActivator("Sync all clientside triggered.");
    }
}

#undef LOGSOURCE