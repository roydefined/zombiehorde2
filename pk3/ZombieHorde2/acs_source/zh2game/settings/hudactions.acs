#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Settings
{
    internal void CloseMenuAndOpenCustomizeMenu()
    {
        if (!ACS_NamedExecute("zh2_internal_client_settings_close_menu_and_open_customize_menu", 0, 0))
            Logger::LogError(LOGSOURCE, "Failed to call menu close and open customize controls menu.");
    }

    internal void CloseMenuAndOpenZh2Menu()
    {
        if (!ACS_NamedExecute("zh2_internal_client_settings_close_menu_and_open_customize_menu", 0, 1))
            Logger::LogError(LOGSOURCE, "Failed to call menu close and open customize controls menu.");
    }

    script "zh2_internal_client_settings_close_menu_and_open_customize_menu" (int index) clientside
    {
        CloseClientSettingsMenu();

        // Artificial delay so we can make sure the menu is closed and we are unfrozen.
        Delay(const: 1);

        // Determine the menu to open.
        str menuName = index == 0 ? "CustomizeControls"
            : index == 1 ? "ZH2OptionsMenu"
            : "UnknownMenu";

        if (!OpenMenu(menuName))
            Logger::LogWarning(LOGSOURCE, "Could not open menu " + menuName + ".");
    }

    internal void OpenClientSettingsMenu()
    {
        // Ignore if the game ended.
        // The ending has a lot of HUD elements and clickable buttons which would interfere.
        if (Round::GetActiveKnownRoundState() >= Round::STATEENDING)
            return;

        ZH2Game::GameContext.HasClientSettingsHudOpen = true;
        ZH2Game::GameContext.HasAdminHudOpen = false; // Also make sure the admin hud is disabled.
        Hud::SetCursorEnabled(true);
        Player::LockMovement(true);
    }

    internal void CloseClientSettingsMenu()
    {
        ZH2Game::GameContext.HasClientSettingsHudOpen = false;
        Hud::SetCursorEnabled(false);
        Player::LockMovement(false);
    }

    // Sets the global HUD scale and the scale of every HUD part back to the default.
    internal void ResetAllHudScaling()
    {
        int playerId = ConsolePlayerNumber();
        raw defaultScale = (raw)1.0;

        SetUserCVar(playerId, "cl_zh2_hudscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudversionscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudplayerstatusscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudplayerpowersscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudplayerbarsscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudroundscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudgamescale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudobituaryscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_huddebugscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudresistsscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudadminscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudendingscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudvotingscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudclientsettingsscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudweaponsniperscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudweaponradioscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_hudfullserverscale", defaultScale);
        SetUserCVar(playerId, "cl_zh2_cursorscale", defaultScale);
    }
}
