#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Map
{
    // Serverside, tracks how often and how long the current map has been played in a row.
    struct MapPlayContextT
    {
        // The number of times the current map was played in a row.
        int PlayCount;

        // The total play time in tics of the current map, accumulated over its plays.
        int PlayTime;

        // The handle of the map the values are tracking for.
        int MapHandle;
    };
}
