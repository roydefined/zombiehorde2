#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Item
{
    #define MAX_ITEMS 80
    #define MAX_HUMANSTARTITEMS 16
    #define MAX_HUMANSTARTITEM_RULES 8

    struct ItemCollectionContextT
    {
        ItemContextT Collection[MAX_ITEMS];
        int Size;

        // This is a predetermined collection of the different item types.
        // This is used for iteration so we don't need to hassle with if the current item fits the required type.
        // Each entry is the index of the relevant item.
        int WeaponCollection[MAX_ITEMS];
        int InventoryCollection[MAX_ITEMS];
        int KeyCollection[MAX_ITEMS];
        int WeaponCollectionSize;
        int InventoryCollectionSize;
        int KeyCollectionSize;

        bool HasSplitItems;
    };

    struct ItemContextT
    {
        str Name;
        ItemTypeT Type;
        bool HumanOwned;
        bool ZombieOwned;
        int GiveOnSpawnCount;
        int GiveOnHumanCount;
        int GiveOnZombieCount;
        bool TakeOnPanic;

        // Item specific (inventory/key)
        str Graphic;
        str Label;
        str Description;

        // Weapon specific
        int BloodSeverity;
        int BloodTics;
        int Kickback;
        str ObituaryGraphic;
        int ObituaryGraphicWidth;

        str WeaponType;
        int Skin;
        str SpawnClassName;
    };

    // An item that is distributed on a share of the humans at the start of the map.
    // The share is determined by the rules, which map a player count to a percentage of players receiving the item.
    struct HumanStartItemT
    {
        str Name;
        int Amount;

        // Rules are matched in order, the first rule where the player count <= `RuleMaxPlayers` applies.
        int RuleMaxPlayers[MAX_HUMANSTARTITEM_RULES];
        int RuleChance[MAX_HUMANSTARTITEM_RULES];
        int RuleCount;

        // The chance used when none of the rules apply.
        int DefaultChance;
    };

    struct HumanStartItemCollectionContextT
    {
        HumanStartItemT Collection[MAX_HUMANSTARTITEMS];
        int Size;
    };

    enum ItemTypeT : int
    {
        TYPE_NONE,
        TYPE_WEAPON,
        TYPE_INVENTORY,
        TYPE_KEY,
    };

    enum ItemSkinT : int
    {
        ITEMSKIN_NONE,
        ITEMSKIN_DEFAULT,
        ITEMSKIN_LEGACY,
    };
}