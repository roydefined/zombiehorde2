    }

    script "zh2_internal_obituary_playerdied" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerDied(packet);

        if (ZH2Game::GetSvEnableObituaries() && ZH2Game::GetClEnableObituaries(ConsolePlayerNumber()))
            QueuePlayerDied();
        else
            LogPlayerDied();
    }

    script "zh2_internal_obituary_playerfragged" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerFragged(packet);

        int killedId = Event::GetReceiveData(0);
        int killerId = Event::GetReceiveData(1);

        // Attempt to receive the player's weapon.
        // If we can't determine it, or `GetWeapon()` returns "None", then default to 0.
        // After that, determine the item's definition in the custom lumps for its index.
        str weapon = (str)0;
        if (SetActivatorToPlayer(killerId))
        {
            weapon = GetWeapon();
            if (BCSUtils::StrIEquals(weapon, "none"))
                weapon = (str)0;
        }

        int weaponIndex = Item::GetItemIndexByName(weapon);

        if (ZH2Game::GetSvEnableObituaries() && ZH2Game::GetClEnableObituaries(ConsolePlayerNumber()))
            QueuePlayerFragged(killedId, killerId, weaponIndex);
        else
            LogPlayerFragged(killedId, killerId, weaponIndex);
    }
}
