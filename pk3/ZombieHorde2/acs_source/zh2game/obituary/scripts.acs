#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Obituary
{
    script "zh2_internal_obituary_initialschosen_client" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceiveInitialsChosen(packet);

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueueInitialsChosen(); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: LegacyLogInitialsChosen(); break;
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogInitialsChosen(); break;
        }
    }

    script "zh2_internal_obituary_playersafe_client" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerSafe(packet);

        bool safe = Event::GetReceiveData(1);
        int slot = Event::GetReceiveData(2);
        bool firstTime = Event::GetReceiveData(3);

        // We only handle if players entered the safezone, not left.
        // We also only handle first time safety.
        if (!safe || !firstTime)
            terminate;

        // Do not show hidden slots.
        if (Game::GetSafeHidden(slot))
            terminate;

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueuePlayerSafe(); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: break; // Not supported: ZH1 had no safezone message.
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogPlayerSafe(); break;
        }
    }

    script "zh2_internal_obituary_playerscratched" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerScratched(packet);

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueuePlayerScratched(); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: LegacyLogPlayerScratched(); break;
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogPlayerScratched(); break;
        }
    }

    script "zh2_internal_obituary_playerinfected" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerInfected(packet);

        int type = Event::GetReceiveData(1);
        int source = Event::GetReceiveData(2);

        // Initial infection is not handled, there is a separate event (initialschosen).
        if (type == Game::INFECT_INITIAL)
            terminate;

        // Source being another player is not handled, there is a separate event (playerscratched).
        if (source == Game::INFECTSOURCE_PLAYER)
            terminate;

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueuePlayerInfected(); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: LegacyLogPlayerInfected(); break;
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogPlayerInfected(); break;
        }
    }

    script "zh2_internal_obituary_playercured" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerCured(packet);

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueuePlayerCured(); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: LegacyLogPlayerCured(); break;
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogPlayerCured(); break;
        }
    }

    script "zh2_internal_obituary_playerdied" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerDied(packet);

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueuePlayerDied(); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: LegacyLogPlayerDied(); break;
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogPlayerDied(); break;
        }
    }

    script "zh2_internal_obituary_playerkilledByPlayer" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerKilledByPlayer(packet);

        int killedId = Event::GetReceiveData(0);
        int killerId = Event::GetReceiveData(1);
        int itemIndex = Event::GetReceiveData(2);
        bool addFireEffect = Event::GetReceiveData(3);
        bool addAcidEffect = Event::GetReceiveData(4);

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueuePlayerKilledByPlayer(killedId, killerId, itemIndex, addFireEffect, addAcidEffect); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: LegacyLogPlayerKilledByPlayer(killedId, killerId); break;
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogPlayerKilledByPlayer(killedId, killerId, itemIndex); break;
        }
    }

    script "zh2_internal_obituary_playerkilledByMonster" (raw packetStr) clientside
    {
        str packet = (str)packetStr;
        Event::ReceivePlayerKilledByMonster(packet);

        int id = Event::GetReceiveData(0);
        str monsterName = Event::GetReceiveData(1);

        switch (ZH2Game::GetObituaryDisplayMode(ConsolePlayerNumber()))
        {
            case ZH2Game::OBITUARYDISPLAY_GRAPHICAL: QueuePlayerKilledByMonster(id, monsterName); break;
            case ZH2Game::OBITUARYDISPLAY_LEGACYTEXT: LegacyLogPlayerKilledByMonster(id); break;
            case ZH2Game::OBITUARYDISPLAY_TEXT: LogPlayerKilledByMonster(id, monsterName); break;
        }
    }
}
