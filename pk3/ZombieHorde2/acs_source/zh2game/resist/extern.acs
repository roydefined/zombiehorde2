    // Prepares the HUD coordinate space for drawing a message at the resist HUD's location.
    bool PrepareResistMessageHud()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION_RETURN(false);

        return Resist::PrepareResistHudPoint();
    }
