#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Resist
{
    // Hardcoded limit on resists to avoid too many of them.
    // Also, the actor based sync approach requires preset cvars which must be extended to match this count.
    // In the future I will support the ability to allocate these to allow for more, but this requires an extra library.
    #define MAX_RESISTS 20

    #define RESIST_SCRIPT_HANDLER_NAME "zh2_internal_resist_script_handler"
    #define RESIST_SCRIPT_HANDLER_AWAITER_NAME "zh2_internal_resist_script_handler_awaiter"

    internal struct ResistInitialStateT
    {
        str TopReasonLabel, TimeReasonLabel;
        int Length;
        int Flags;

        // Serverside, exclusive scripts for the resist which will be invoked before and after the script runs.
        str PreResistScript, PostResistScript;
    };

    internal struct ResistT
    {
        ResistInitialStateT InitialState;
        ResistRunStateT RunState;

        int EndingTic;
        int PauseTic;

        // Set to `true` if we defined the resist index.
        // This one is used with a sync so we know if the index is actually defined at all.
        bool Defined;
    };

    struct ResistHookDataT
    {
        int Index;
    };

    enum ResistRunStateT : int
    {
        STATENONE,
        STATEPRESCRIPT,
        STATEREADYTORUN,
        STATERUNNING,
        STATEPOSTSCRIPT,
        STATEREADYTOSTOP,
        STATEREADYTOELAPSE,
        STATEPAUSED,
        STATEENDED,
    };

    enum ResistFlagT : int
    {
        FLAG_NONE = 0,
        FLAG_HIDE_TOP_REASON  = 1 << 0,
        FLAG_HIDE_TIME_REASON = 1 << 1,
        FLAG_NO_FADE = 1 << 2,
        FLAG_SHOW_WHEN_PAUSED = 1 << 3,
        FLAG_DONT_AWAIT_PRE_SCRIPT = 1 << 4,
        FLAG_DONT_AWAIT_POST_SCRIPT = 1 << 5,

        FLAG_HIDE_REASONS = FLAG_HIDE_TOP_REASON | FLAG_HIDE_TIME_REASON,
    };

    extern int CreateResist(
        int length,
        str topReasonLabel = (raw)0,
        str timeReasonLabel = (raw)0,
        str preResistScript = (raw)0,
        str postResistScript = (raw)0,
        int flags = FLAG_NONE);

    extern void CreateResistByIndex(
        int index,
        int length,
        str topReasonLabel = (raw)0,
        str timeReasonLabel = (raw)0,
        str preResistScript = (raw)0,
        str postResistScript = (raw)0,
        int flags = FLAG_NONE);

    extern int StartResistByIndex(int index);
    extern void StopResistByIndex(int index);
    extern void ElapseResistByIndex(int index);
    extern void PauseResistByIndex(int index);
    extern void ResumeResistByIndex(int index);
    extern void ResetResistByIndex(int index, bool preserveRunningState = false);
    extern int GetTicsLeftByIndex(int index);
    extern int GetMaximumTicsByIndex(int index);
    extern str GetTopReasonLabelByIndex(int index);
    extern str GetTimeReasonLabelByIndex(int index);
    extern bool IsResistRunningByIndex(int index);
    extern bool IsResistPausedByIndex(int index);
    extern bool IsResistEndedByIndex(int index);
    extern str FormatLabel(str label, int ticsLeft);
    extern int GetTimeTokenIndex(str label);
    extern bool PrepareResistMessageHud();
}