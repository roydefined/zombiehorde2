#define WEAPON_SNIPER_DEFAULT_NAME "ZH2WeaponSniperDefault"
#define WEAPON_SNIPER_LEGACY_NAME "ZH2WeaponSniperLegacy"

strict namespace Weapon
{
    // Called from map scripts, so these must stay linkable across libraries.
    extern bool CheckOwnedShotgun();
    extern void GiveShotgun(int amount);

    internal enum WeaponSkinT : int
    {
        WEAPONSKIN_DEFAULT,
        WEAPONSKIN_LEGACY,
    };

    internal enum WeaponSkinBehaviourT : int
    {
        WEAPONSKINBEHAVIOUR_DEFAULT,
        WEAPONSKINBEHAVIOUR_FORCEDEFAULTSKIN,
        WEAPONSKINBEHAVIOUR_FORCELEGACYSKIN,
    };

    internal enum WeaponTypeT : int
    {
        WEAPONTYPE_CHAINGUN,
        WEAPONTYPE_CLAWS,
        WEAPONTYPE_DOUBLESHOTGUN,
        WEAPONTYPE_FIREGRENADE,
        WEAPONTYPE_HANDGUN,
        WEAPONTYPE_JACKSGUN,
        WEAPONTYPE_RADIO,
        WEAPONTYPE_RIOTGUN,
        WEAPONTYPE_SHOTGUN,
        WEAPONTYPE_SNIPER,
    };

    // A tracked fake weapon spawn spot. `WeaponType` indicates what should be spawned in its place.
    internal struct WeaponSpawnSpotT
    {
        int Tid;
        WeaponTypeT WeaponType;
    };

    internal struct WeaponSpawnContextT
    {
        WeaponSpawnSpotT Spots[MAX_WEAPONSPAWNSPOTS];
        int SpotCount;
    };

    struct WeaponSpawnerConfigT
    {
        str Name;
        str SpawnSpotClassName;
    };

    struct WeaponSpawnerCollectionContextT
    {
        WeaponSpawnerConfigT Collection[MAX_WEAPONSPAWNERS];
        int Size;
    };
}
