// The actual wielded weapon classes, split per skin.
#define WEAPON_CHAINGUN_DEFAULT_NAME "ZH2WeaponChaingunDefault"
#define WEAPON_CHAINGUN_LEGACY_NAME "ZH2WeaponChaingunLegacy"
#define WEAPON_CLAWS_DEFAULT_NAME "ZH2WeaponClawsDefault"
#define WEAPON_CLAWS_LEGACY_NAME "ZH2WeaponClawsLegacy"
#define WEAPON_DOUBLESHOTGUN_DEFAULT_NAME "ZH2WeaponDoubleShotgunDefault"
#define WEAPON_DOUBLESHOTGUN_LEGACY_NAME "ZH2WeaponDoubleShotgunLegacy"
