#ifdef __IMPORTED__
    #error This file must be #included.
#endif

// The EndReason is the reason why a round would have ended.
// It hints to clients what would have happened for a round to end. For example, an admin could have ended it.

strict namespace Game
{
    // Preset data for the three endings.
    // TODO: Receive from lump so it can be edited.
    internal EndingTypeT _endingTypes[] =
    {
        {
            { "\ciMission failed!", "\ciFission mailed!" },
            { "\ckHow did you manage to do this?", "\ckWhat the...?!" },
            { "NWIN" },

            1,
            { "D_WINN" }
        },
        {
            { "\chHumans \cjwin!", "\chHumans \cjVictory!" },
            { "\cjHumanity is safe... for now!", "\cjDon't mess with humans, bro!" },
            { "HWIN_OLD", "HWIN_NEW" },

            4,
            { "D_WINH1", "D_WINH2", "D_WINH3", "D_WINH4" },
        },
        {
            { "\cgZombies \cjwin!", "\cgZombies \cjVictory!" },
            { "\cgBring bigger guns next time!", "\cgEarth is their new home now!" },
            { "ZWIN_OLD", "ZWIN_NEW" },

            6,
            { "D_WINZ1", "D_WINZ2", "D_WINZ3", "D_WINZ4", "D_WINZ5", "D_WINZ6" },
        },
    };

    // HACK
    // I don't have a proper fix for this yet, but this will prevent the final music track restarting when `ClientBuildEnding` is called multiple times.
    internal bool _hasStartedEndMusic;

    // Called clientside to build up the ending screen.
    internal void ClientBuildEnding()
    {
        WinningSpecieT winningSpecie = GetWinningSpecie();
        int index = (int)winningSpecie - 1;
        EndingTypeT module& ending = _endingTypes[index];

        // The graphic needs a separate check for zombies as this one has two graphics.
        Player::ZombieSkinTypeT skinType = Player::GetZombieSkinType(false);
        ZH2Game::_gameContext.WinGraphic = winningSpecie == Game::SPECIETIE
            ? ending.WinGraphics[0]
            : ending.WinGraphics[(int)(skinType != Player::ZOMBIESKIN_OLD)];

        // Messages
        ZH2Game::_gameContext.WinMessageTop = ending.WinMessagesTop[Random(0, lengthof(ending.WinMessagesTop) - 1)];
        ZH2Game::_gameContext.WinMessageBottom = ending.WinMessagesBottom[Random(0, lengthof(ending.WinMessagesBottom) - 1)];

        // Only the default flow and a repeat show the stats.
        Game::EndActionT action = Game::GetEndAction();
        if (action != Game::ACTION_DEFAULT && action != Game::ACTION_REPEAT)
            return;

        // Play a track for the winning type.
        // Only do this with the default flow.
        if (action == Game::ACTION_DEFAULT && ending.TrackCount != 0 && !_hasStartedEndMusic && !CVar::GetSvNoEndMusic() && !CVar::GetClNoEndMusicByConsolePlayer())
        {
            int index = Random(0, ending.TrackCount - 1);
            str track = ending.Tracks[index];
            if (track != (raw)0 && track != "")
                SetMusic(track);

            _hasStartedEndMusic = true;
        }

        // Set the ordered lists indicating the final stats.

        Shuffle::SortByHumanKills();
        ZH2Game::_gameContext.HumanKillsOrderedCount = Shuffle::GetRelevantSize();
        for (int i = 0; i < ZH2Game::_gameContext.HumanKillsOrderedCount; ++i)
            ZH2Game::_gameContext.HumanKillsOrdered[i] = Shuffle::GetIndexValue(i);

        Shuffle::SortByZombieKills();
        ZH2Game::_gameContext.ZombieKillsOrderedCount = Shuffle::GetRelevantSize();
        for (int i = 0; i < ZH2Game::_gameContext.ZombieKillsOrderedCount; ++i)
            ZH2Game::_gameContext.ZombieKillsOrdered[i] = Shuffle::GetIndexValue(i);

        Shuffle::SortByInfects();
        ZH2Game::_gameContext.InfectsOrderedCount = Shuffle::GetRelevantSize();
        for (int i = 0; i < ZH2Game::_gameContext.InfectsOrderedCount; ++i)
            ZH2Game::_gameContext.InfectsOrdered[i] = Shuffle::GetIndexValue(i);

        Shuffle::ShuffleBySurvived();
        ZH2Game::_gameContext.SurvivorsShuffledCount = Shuffle::GetRelevantSize();
        for (int i = 0; i < ZH2Game::_gameContext.SurvivorsShuffledCount; ++i)
            ZH2Game::_gameContext.SurvivorsShuffled[i] = Shuffle::GetIndexValue(i);

        Shuffle::ShuffleByHorde();
        ZH2Game::_gameContext.HordeShuffledCount = Shuffle::GetRelevantSize();
        for (int i = 0; i < ZH2Game::_gameContext.HordeShuffledCount; ++i)
            ZH2Game::_gameContext.HordeShuffled[i] = Shuffle::GetIndexValue(i);

        Shuffle::ShuffleByDead();
        ZH2Game::_gameContext.DeadShuffledCount = Shuffle::GetRelevantSize();
        for (int i = 0; i < ZH2Game::_gameContext.DeadShuffledCount; ++i)
            ZH2Game::_gameContext.DeadShuffled[i] = Shuffle::GetIndexValue(i);
    }

    internal void SetEndReason(EndReasonT reason)
    {
        ZH2Game::_gameContext.EndReason = reason;
    }

    internal EndReasonT GetEndReason()
    {
        return ZH2Game::_gameContext.EndReason;
    }

    internal void SetEndAction(EndActionT action)
    {
        ZH2Game::_gameContext.EndAction = action;
    }

    internal EndActionT GetEndAction()
    {
        return ZH2Game::_gameContext.EndAction;
    }

    internal EndReasonT GetEndReasonTypeByIndex(int index)
    {
        static EndReasonT collection[] = { REASONNONE, REASONSPECIEWON, REASONHUMANLEFT, REASONZOMBIELEFT, REASONADMINENDED, REASONVOTEENDED, };
        return collection[index];
    }

    internal EndActionT GetEndActionTypeByIndex(int index)
    {
        static EndActionT collection[] = { ACTION_DEFAULT, ACTION_RESTART, ACTION_REPEAT, };
        return collection[index];
    }
}
