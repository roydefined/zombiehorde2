strict namespace Game
{
    internal void SetForceSpawnSpecie(Player::PlayerSpecieT specie)
    {
        ZH2Game::GameContext.ForceSpawnSpecie = specie;
    }

    internal Player::PlayerSpecieT GetForceSpawnSpecie()
    {
        return ZH2Game::GameContext.ForceSpawnSpecie;
    }
}