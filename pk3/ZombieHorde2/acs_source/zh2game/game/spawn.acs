#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Game
{
    internal void SetForceSpawnSpecie(Player::PlayerSpecieT specie)
    {
        ZH2Game::_gameContext.ForceSpawnSpecie = specie;
    }

    internal Player::PlayerSpecieT GetForceSpawnSpecie()
    {
        return ZH2Game::_gameContext.ForceSpawnSpecie;
    }

    internal void SetLastJoinedPlayerId(int id)
    {
        ZH2Game::_gameContext.LastJoinedPlayerId = id;
    }

    internal int GetLastJoinedPlayerId()
    {
        return ZH2Game::_gameContext.LastJoinedPlayerId;
    }
}