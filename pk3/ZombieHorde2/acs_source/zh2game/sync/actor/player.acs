    internal int SyncWritePreviouslyInitialZombies(int syncId)
    {
        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Start writing previously initial zombie packs through actors. Sync id: " + str(syncId) + "."));

        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            BitMath::SetBit64(BitMath::GetBitPack1(), BitMath::GetBitPack2(), i, Player::GetPlayerPreviouslyInitialZombie(i));
        }

        BCSUtils::SyncVariable(--syncId, BitMath::GetBitPack1());
        BCSUtils::SyncVariable(--syncId, BitMath::GetBitPack2());

        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Finished writing previously initial zombie packs through actors. Pack1 \cd" + str(BitMath::GetBitPack1()) + "\cj, pack2 \cd" + str(BitMath::GetBitPack2()) + "\cj."));
        return syncId;
    }

    internal int SyncReadPreviouslyInitialZombies(int syncId)
    {
        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Start reading previously initial zombie packs on client through actors. Sync id: " + str(syncId) + "."));

        int pack1 = BCSUtils::GetSyncVarDefault(--syncId, 0);
        int pack2 = BCSUtils::GetSyncVarDefault(--syncId, 0);

        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            ZH2Game::PersistingGameContext.Players[i].PreviouslyInitialZombie = bool(BitMath::GetBit64(pack1, pack2, i));
        }

        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Finished syncing previously initial zombie packs to client."));
        return syncId;
    }

    #undef SYNC_CATEGORY
}
