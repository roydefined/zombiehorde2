#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Sync
{
    #define SYNC_CATEGORY "ROUND"

    internal void SyncRoundStateActor()
    {
        int syncId = SYNC_ROUND;

        syncId = SyncWriteRoundStates(syncId);

        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Finished writing round state packs through actors."));
        VERIFY_SYNCID(syncId, SYNC_ROUND, SYNC_ROUND_LENGTH);
    }

    internal void CallSyncRoundStateActorOnClients()
    {
        if (!ACS_NamedExecuteAlways("zh2_internal_sync_round_state_actor_clientside", 0))
            Logger::LogError(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Failed to invoke clientside sync for round state."));
    }

    script "zh2_internal_sync_round_state_actor_clientside" clientside
    {
        SyncRoundStateActorClientside();
    }

    internal void SyncRoundStateActorClientside()
    {
        int syncId = SYNC_ROUND;
        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Start reading round timer packs on client through actors. Sync id: " + str(syncId) + "."));

        syncId = SyncReadRoundStates(syncId);

        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Synced round states to client."));
        VERIFY_SYNCID(syncId, SYNC_ROUND, SYNC_ROUND_LENGTH);
    }

    internal int SyncWriteRoundStates(int syncId)
    {
        Round::RoundStateContextT[] module& rounds = ZH2Game::GameContext.MapDetails.Rounds;

        Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Start writing round state packs through actors. Sync id: " + str(syncId) + ". Length: " + str(lengthof(rounds)) + "."));

        // The second value represents the length of the collection, so the client can also allocate accordingly.
        BCSUtils::SyncVariable(--syncId, lengthof(rounds));
        BCSUtils::SyncVariable(--syncId, ZH2Game::GameContext.MapDetails.ActiveRoundStateIndex);

        for (int i = 0; i < lengthof(rounds); ++i)
        {
            // Skip if undefined.
            BCSUtils::SyncVariable(--syncId, int(rounds[i].Defined));
            if (!rounds[i].Defined)
            {
                --syncId;
                continue;
            }

            BCSUtils::SyncVariable(--syncId, rounds[i].DenyJoin);
            BCSUtils::SyncVariable(--syncId, rounds[i].IsEnding);
        }

        return syncId;
    }

    internal int SyncReadRoundStates(int syncId)
    {
        Round::RoundStateContextT[] module& rounds = ZH2Game::GameContext.MapDetails.Rounds;
        int collectionLength = BCSUtils::GetSyncVarDefault(--syncId, 0);

        int index = BCSUtils::GetSyncVarDefault(--syncId, 0);
        ZH2Game::GameContext.MapDetails.ActiveRoundStateIndex = index;

        // TODO: Add reallocation like with timers if we ever end up supporting it.

        for (int i = 0; i < collectionLength; ++i)
        {
            rounds[i].Defined = BCSUtils::GetSyncVarDefault(--syncId, -1);
            if (!rounds[i].Defined)
            {
                --syncId;
                continue;
            }

            rounds[i].DenyJoin = BCSUtils::GetSyncVarDefault(--syncId, 0);
            rounds[i].IsEnding = BCSUtils::GetSyncVarDefault(--syncId, 0);

            Logger::LogDebug(LOGSOURCE, FormatLog(SYNC_CATEGORY, "Synced timer under index " + str(i) + "."));
        }

        return syncId;
    }

    #undef SYNC_CATEGORY
}