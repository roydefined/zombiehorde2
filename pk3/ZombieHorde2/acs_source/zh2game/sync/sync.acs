strict namespace Sync
{
    // Run each tic to check if we need to flush any pending syncs called from the mod's code.
    // This function handles both setting sup the serversided sync actors and notifying the client.
    // - The server uses a buffer that is flushed when this function tics.
    // - The client also uses a buffer, but depends on two timestamps that determine when to sync.
    //   Only if these delays elapse, will the client be informed of the new data.
    //   This ensures we do not constantly ask the client to update and to prevent sending too much traffic.
    //
    // NOTE: The server runs independedly to ensure it has time to set up the sync actors.
    // This way there should be enough time to send the internal actor traffic before we ask the client to update.
    void FlushPendingSyncs()
    {
        int min = 0;
        int max = MAX_SYNC_TYPES - 1;
        for (int i = min; i <= max; ++i)
        {
            if (ZH2Game::GameContext.SyncContext.PendingWrite[i])
            {
                ZH2Game::GameContext.SyncContext.PendingWrite[i] = false;
                TriggerSyncWrite(i + MAX_LIB_SYNC_TYPES);
            }

            int notifyTic = ZH2Game::GameContext.SyncContext.NotifyTic[i];
            if (notifyTic != 0 && Timer() >= notifyTic)
            {
                ZH2Game::GameContext.SyncContext.NotifyTic[i] = 0;
                TriggerSyncNotify(i + MAX_LIB_SYNC_TYPES);
            }
        }
    }

    internal void TriggerSyncWrite(int syncId)
    {
        switch(syncId)
        {
            case SYNCTYPE_PLAYERS: SyncPlayersActor(); return;
            case SYNCTYPE_TIMERS: SyncTimersActor(); return;
            case SYNCTYPE_RESISTS: SyncResistsActor(); return;
            case SYNCTYPE_ROUNDSTATE: SyncRoundStateActor(); return;
            case SYNCTYPE_POWERS: SyncPowersActor(); return;
            case SYNCTYPE_ADMINS: SyncAdminsActor(); return;
            case SYNCTYPE_GAME: SyncGameActor(); return;
            case SYNCTYPE_MAPVOTING: SyncMapVotingActor(); return;
            case SYNCTYPE_AFKPREVENTION: SyncAfkPreventionActor(); return;
            case SYNCTYPE_RADIO: SyncRadioActor(); return;

            default:
                Logger::LogError(LOGSOURCE, __FUNCTION__ + ": Failed to write sync index " + str(syncId) + " as it's not known.");
                return;
        }
    }

    internal void TriggerSyncNotify(int syncId)
    {
        switch(syncId)
        {
            case SYNCTYPE_PLAYERS: CallSyncPlayersOnClients(); return;
            case SYNCTYPE_TIMERS: CallSyncTimersOnClients(); return;
            case SYNCTYPE_RESISTS: CallSyncResistsOnClients(); return;
            case SYNCTYPE_ROUNDSTATE: CallSyncRoundStateOnClients(); return;
            case SYNCTYPE_POWERS: CallSyncPowersOnClients(); return;
            case SYNCTYPE_ADMINS: CallSyncAdminsOnClients(); return;
            case SYNCTYPE_GAME: CallSyncGameOnClients(); return;
            case SYNCTYPE_MAPVOTING: CallSyncMapVotingOnClients(); return;
            case SYNCTYPE_AFKPREVENTION: CallSyncAfkPreventionOnClients(); return;
            case SYNCTYPE_RADIO: CallSyncRadioOnClients(); return;

            default:
                Logger::LogError(LOGSOURCE, __FUNCTION__ + ": Failed to notify sync index " + str(syncId) + " as it's not known.");
                return;
        }
    }

    internal void DoSync(int syncId)
    {
        // Buffering not enabled - write and notify immediately, back to back.
        if (!ZH2Lib::GetUseSyncBuffer())
        {
            TriggerSyncWrite(syncId);
            TriggerSyncNotify(syncId);
            return;
        }

        // Remove whatever base the lib gave us so we now use zero-indexed ids.
        syncId -= MAX_LIB_SYNC_TYPES;

        int min = 0;
        int max = MAX_SYNC_TYPES - 1;
        if (syncId < min || syncId > max)
        {
            Logger::LogError(LOGSOURCE, __FUNCTION__ + ": Invalid sync id " + str(syncId) + ". Id must be between " + str(min) + " and " + str(max) + " (inclusive).");
            return;
        }

        // Any number of calls collapse into one pending write - the write itself is never delayed,
        // `FlushPendingSyncs` fires it as soon as it sees this flag.
        ZH2Game::GameContext.SyncContext.PendingWrite[syncId] = true;

        // The notify is what's actually delayed, and it's scheduled here rather than after the
        // write happens - the write is immediate, but clients still need to wait long enough for
        // it to replicate before being told to read it. Only schedule if one isn't already pending,
        // so a burst of calls still only results in one notify, same as the write above.
        if (ZH2Game::GameContext.SyncContext.NotifyTic[syncId] == 0)
        {
            int earliestNotifyTic = Timer() + BCSUtils::Max(ZH2Lib::GetSyncDelay(), 1);
            ZH2Game::GameContext.SyncContext.NotifyTic[syncId] = BCSUtils::Max(earliestNotifyTic, ZH2Lib::GetInitialSyncDelay());
        }
    }

    // Basic log formatter to include an additional sync category.
    internal str FormatLog(str category, str message)
    {
        return "[" + category + "] " + message;
    }

    /* COMBINED */

    internal void SyncAll()
    {
        VALIDATE_IS_SERVERSIDE_FUNCTION();

        Sync::SyncPlayers();
        Sync::SyncTimers();
        Sync::SyncResists();
        Sync::SyncRoundState();
        Sync::SyncPowers();
        Sync::SyncAdmins();
        Sync::SyncGame();
        Sync::SyncMapVoting();
        Sync::SyncAfkPrevention();
        Sync::SyncRadio();
    }

    internal void CallClientSyncAll()
    {
        VALIDATE_IS_SERVERSIDE_FUNCTION();

        Sync::CallSyncPlayersOnClients();
        Sync::CallSyncTimersOnClients();
        Sync::CallSyncResistsOnClients();
        Sync::CallSyncRoundStateOnClients();
        Sync::CallSyncPowersOnClients();
        Sync::CallSyncAdminsOnClients();
        Sync::CallSyncGameOnClients();
        Sync::CallSyncMapVotingOnClients();
        Sync::CallSyncAfkPreventionOnClients();
        Sync::CallSyncRadioOnClients();
    }

    internal void SyncAllClientside()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION();

        Sync::SyncPlayersClientside();
        Sync::SyncTimersClientside();
        Sync::SyncResistsClientside();
        Sync::SyncRoundStateClientside();
        Sync::SyncPowersClientside();
        Sync::SyncAdminsClientside();
        Sync::SyncGameClientside();
        Sync::SyncMapVotingClientside();
        Sync::SyncAfkPreventionClientside();
        Sync::SyncRadioClientside();
    }

    /* PLAYERS */

    internal void SyncPlayers()
    {
        VALIDATE_IS_SERVERSIDE_FUNCTION();

        if (!IsNetworkGame())
        {
            FinalizePlayersSyncedClientside();
            return;
        }

        DoSync(SYNCTYPE_PLAYERS);
    }

    internal void CallSyncPlayersOnClients()
    {
        VALIDATE_IS_SERVERSIDE_FUNCTION();

        if (IsNetworkGame())
            ACS_NamedExecute("zh2_internal_sync_players_clientside", 0);
    }

    script "zh2_internal_sync_players_clientside" clientside
    {
        SyncPlayersClientside();
    }

    internal void SyncPlayersClientside()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION();

        if (IsNetworkGame())
            SyncPlayersActorClientSide();

        FinalizePlayersSyncedClientside();
    }

    internal void FinalizePlayersSyncedClientside()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION();
        Event::SendDataSynced(SYNCTYPE_PLAYERS);
    }

