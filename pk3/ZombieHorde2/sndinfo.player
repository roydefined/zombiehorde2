human/TAUNT "sounds/player/human/taunt.ogg"
human/DROWNDEATH "sounds/player/human/drowndeath.ogg"

human/HEARTBEATFAR "sounds/player/human/heartbeatfar.ogg"
human/HEARTBEATLOCAL "sounds/player/human/heartbeatlocal.ogg"
human/HEARTBEATHURT1 "sounds/player/human/heartbeathurt1.ogg"
human/HEARTBEATHURT2 "sounds/player/human/heartbeathurt2.ogg"

human/DROWNPAIN1 "sounds/player/human/drownpain1.ogg"
human/DROWNPAIN2 "sounds/player/human/drownpain2.ogg"
human/DROWNPAIN3 "sounds/player/human/drownpain3.ogg"
$random human/DROWNPAIN { human/DROWNPAIN1 human/DROWNPAIN2 human/DROWNPAIN3 }

human/PAIN1 "sounds/player/human/pain1.ogg"
human/PAIN2 "sounds/player/human/pain2.ogg"
human/PAIN3 "sounds/player/human/pain3.ogg"
$random human/PAIN { human/PAIN1 human/PAIN2 human/PAIN3 }

human/DEATH1 "sounds/player/human/death1.ogg"
human/DEATH2 "sounds/player/human/death2.ogg"
$random human/DEATH { human/DEATH1 human/DEATH2 }

zombie/WAKE1 "sounds/player/zombie/wake1.wav"
zombie/WAKE2 "sounds/player/zombie/wake2.wav"
zombie/WAKE3 "sounds/player/zombie/wake3.wav"
zombie/WAKE4 "sounds/player/zombie/wake4.wav"
zombie/WAKE5 "sounds/player/zombie/wake5.wav"
$random zombie/WAKE { zombie/WAKE1 zombie/WAKE2 zombie/WAKE3 zombie/WAKE4 zombie/WAKE5 }

zombie/IDLE1 "sounds/player/zombie/idle1.mp3"
zombie/IDLE2 "sounds/player/zombie/idle2.mp3"
zombie/IDLE3 "sounds/player/zombie/idle3.mp3"
zombie/IDLE4 "sounds/player/zombie/idle4.mp3"
zombie/IDLE5 "sounds/player/zombie/idle5.mp3"
zombie/IDLE6 "sounds/player/zombie/idle6.mp3"
$random zombie/IDLE { zombie/IDLE1 zombie/IDLE2 zombie/IDLE3 zombie/IDLE4 zombie/IDLE5 zombie/IDLE6 }

zombie/DEATH "sounds/player/zombie/death.wav"
zombie/PAIN  "sounds/player/zombie/pain.wav"

// Sounds for human species.
$playeralias human male	*death		"human/DEATH"
$playeralias human male *xdeath		"human/DEATH"
$playeralias human male *gibbed		"human/DEATH"
$playeralias human male *drowndeath "human/DROWNDEATH"
$playeralias human male *drownpain  "human/DROWNPAIN"
$playeralias human male *pain100	"human/PAIN"
$playeralias human male *pain75		"human/PAIN"
$playeralias human male *pain50		"human/PAIN"
$playeralias human male *pain25		"human/PAIN"
$playeralias human male *taunt		"human/TAUNT"
$playersound human male *grunt		"sound/null"
$playersound human male *land		"sound/null"

// Sounds for human species.
$playeralias zombie male *death		 "zombie/DEATH"
$playeralias zombie male *xdeath	 "zombie/DEATH"
$playeralias zombie male *gibbed	 "zombie/DEATH"
$playeralias zombie male *drowndeath "sound/null"
$playeralias zombie male *drownpain  "sound/null"
$playeralias zombie male *pain100	 "zombie/PAIN"
$playeralias zombie male *pain75	 "zombie/PAIN"
$playeralias zombie male *pain50	 "zombie/PAIN"
$playeralias zombie male *pain25	 "zombie/PAIN"
$playeralias zombie male *taunt		 "sound/null"
$playersound zombie male *grunt		 "sound/null"
$playersound zombie male *land		 "sound/null"