actor ZH2NothingWeapon : Weapon
{
    weapon.PreferredSkin "Regular"
    tag ""

    +WEAPON.NOAUTOAIM

    States
    {
        Ready:
            TNT1 A 1 A_WeaponReady
            loop

        Select:
            TNT1 A 0 A_Raise
            goto Ready

        Deselect:
            TNT1 A 0 A_Lower
            wait

        Fire:
            TNT1 A 0
            goto Ready
    }
}