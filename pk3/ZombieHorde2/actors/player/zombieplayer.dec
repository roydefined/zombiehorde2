actor ZombiePlayer : PlayerPawn
{
    Player.forwardmove 0.8
    Player.sidemove 0.4
    Player.MaxHealth 999999
    Speed 1.25

    // Value is determined upon infection unless you morphed through debugging or something.
    Health 1000

    Radius 16
    Height 56

    PainChance 255

    Mass 40

    Player.AirCapacity 0
    Player.DamageScreenColor none, 0.0
    Player.RunHealth 100

    Player.DisplayName "Bagel"
    Player.Soundclass "zombie"
    BloodType "ZH2ZombieBlood"
    BloodColor 0 100 0

    +USEDAMAGEEVENTSCRIPT
    +NOMORPHLIMITATIONS
    +CROUCHABLEMORPH

    States
    {
        Spawn:
            TEMP A 1
            wait

        See:
            TNT1 A 0
            TEMP AABBCCDDEEFFGGHH 1
            loop

        Melee:
        Missile:
            TNT1 A 0
            TEMP AABBCCEEFFGGHH 1
            goto Spawn

        Pain:
            TEMP JJKKLLMMMMMMMMMMMMMM 1 A_Pain // MMMMMMM........... Bagels................
            goto Spawn

        Death:
        XDeath:
        AltSkinDeath:
        AltSkinXDeath:
            TNT1 A 0
            TNT1 A 0 A_PlayerScream
            TNT1 A 0 A_NoBlocking
            TEMP NOPQRSTUVWX 2
            TNT1 A -1
            Loop
        Dummy:
            TEMP I 1
    }
}


Actor FallingDeadBagel
{
    Radius 10
    Height 10

    +NOBLOCKMAP

    States
    {
        Spawn:
        Falling.BagelOld:
            TNT1 A 0
            BAO0 YZ 2
            BAO1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2
            BAO2 ABCDEFGHIJK 2
        Finish.BagelOld:
            BAO2 L -1
            Loop

        Falling.Bagel:
            TNT1 A 0
            BGL0 YZ 2
            BGL1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2
            BGL2 ABCDEFGHIJK 2
        Finish.Bagel:
            BGL2 L -1
            Loop

        Falling.Donut:
            TNT1 A 0
            DON0 YZ 2
            DON1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2
            DON2 ABCDEFGHIJK 2
        Finish.Donut:
            DON2 L -1
            Loop


    }
}