actor ZombiePlayer : PlayerPawn
{
    Player.forwardmove 0.8
    Player.sidemove 0.4
    Player.MaxHealth 999999
    Speed 1.25

    // Value is determined upon infection unless you morphed through debugging or something.
    Health 1000

    Radius 16
    Height 56
    PainChance 255

    Mass 40

    Player.AirCapacity 0
    Player.DamageScreenColor none, 0.0
    Player.RunHealth 100

    Player.DisplayName "Bagel"
    Player.Soundclass "zombie"
    BloodType "ZH2ZombieBlood"
    BloodColor 0 100 0

    +USEDAMAGEEVENTSCRIPT
    +NOMORPHLIMITATIONS
    +CROUCHABLEMORPH

    States
    {
        Spawn:
            BAGE A 1
            wait

        See:
            BAGE ABCDEFG 5
            loop

        Melee:
        Missile:
            BAGE ABCDEFG 5
            goto Spawn

        Pain:
            TNT1 A 0 A_SetBlend ("00 20 00", 0.7, 6)
            BAGE L 8 A_Pain
            goto Spawn

        Death:
        XDeath:
        AltSkinDeath:
        AltSkinXDeath:
            BAGE M 3 A_PlayerScream
            BAGE N 3
            BAGE N 3
            BAGE O 3 A_NoBlocking
            BAGE PQ 3
            BAGE Q -1
    }
}