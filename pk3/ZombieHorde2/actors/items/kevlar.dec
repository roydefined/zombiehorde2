Actor ZH2ItemKevlar : ZH2CustomInventoryHealthAndArmor 1338
{
	//$Sprite "KEVLA0"
	
	Radius 13
	Height 24
	
	Scale .8
	
	Inventory.PickupMessage "Kevlar vest"
	Inventory.PickupSound "items/KEVLAR"
	Inventory.Icon "KEVLARI"
	
	Tag "Kevlar vest"
	
	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
			KEVL A 1 A_SpawnItemEx("ZH2KevlarFlare", 0, 0, 8)
			loop
		
		Spawn.NoSight:
			KEVL A 1
			goto Spawn
			
		Pickup:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
			stop
			TNT1 A 0 A_RailWait
			TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_checkautousekevlar", 0)
			stop
		
		Use:
			TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_wearkevlar", 0)
			fail
	}
}

Actor ZH2KevlarFlare : ZH2ItemLensFlare
{
	Scale .5
	Alpha .4
	
	States
	{
		Spawn:
			LFLR B 1 NoDelay Bright
			stop
	}
}

Actor ZH2KevlarArmor : BasicArmorPickup
{
	Armor.SaveAmount 1
}