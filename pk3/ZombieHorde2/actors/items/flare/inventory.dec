actor ZH2ItemFlare : ZH2CustomInventoryPowerup 12000
{
	Radius 6
	Height 15
	
	Inventory.Amount 1
	Inventory.MaxAmount 2
	
	Inventory.Icon "FLAREI"
	Inventory.PickupMessage "Flare"
	Tag "Flare"
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_Jump(256, 1, 2)
			FLAR A -1
			FLAR B -1
			
		Pickup:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
			fail
			TNT1 A 0 A_RailWait
			stop
		
		Use:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
			stop
			TNT1 A 0 A_FireCustomMissile("ZH2ThrownFlare", 0, false)
			stop
	}
}