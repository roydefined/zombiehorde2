Actor ZH2FlareFlame
{
	RenderStyle Add
	Scale 0.05
	Alpha 0.8
	
	+CLIENTSIDEONLY
	+NOGRAVITY
	+NOBLOCKMAP
	+FORCEXYBILLBOARD
	+NOTIMEFREEZE
	+BRIGHT
	
	States
	{
		Spawn:
			TNT1 "#" 0 NoDelay A_JumpIf(waterlevel != 0, "Spawn.Underwater")
			TNT1 "#" 0 A_JumpIf(args[0] == 0, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 1, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 2, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 3, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 4, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 5, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 6, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 7, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 8, 10)
			TNT1 "#" 0 A_JumpIf(args[0] == 9, 10)
			TNT1 A 0
			goto Spawn.Rest
			TNT1 B 0
			goto Spawn.Rest
			TNT1 C 0
			goto Spawn.Rest
			TNT1 D 0
			goto Spawn.Rest
			TNT1 E 0
			goto Spawn.Rest
			TNT1 F 0
			goto Spawn.Rest
			TNT1 G 0
			goto Spawn.Rest
			TNT1 H 0
			goto Spawn.Rest
			TNT1 I 0
			goto Spawn.Rest
			
		Spawn.Rest:
			FFLM "#" 1 A_FadeOut(0.08)
			TNT1 "#" 0 A_SetScale(ScaleX - FRandom(0.001, 0.005), ScaleY - FRandom(0.001, 0.005))
			loop
		
		Spawn.Underwater:
			TNT1 A 0 A_Jump(80, 1)
			stop
			TNT1 A 0 A_SpawnItem("ZH2FlareBubble")
			stop
	}
}

actor ZH2FlareBubble
{
	Height 0
	Radius 0
	Mass 0
	Alpha 0.6
	Scale 0.5
	
	+MISSILE
	+NOGRAVITY
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+ALLOWPARTICLES
	+NOBLOCKMAP

	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_ChangeVelocity(velx + FRandom(-0.5, 0.5), vely + FRandom(-0.5, 0.5), velZ + FRandom(0.2, 1.5))
			TNT1 A 0 A_Jump(180, 1)
			goto Spawn.Rest
			TNT1 B 0
		
		Spawn.Rest:
			TNT1 "#" 0 A_ChangeVelocity(0, 0, FRandom(0.01, 0.08))
			BUBL "#" 1 A_JumpIf(waterlevel < 1, 1)
			loop
			TNT1 A 0
			stop
	}
}