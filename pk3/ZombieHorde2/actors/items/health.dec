actor ZH2ItemMedikit : ZH2CustomInventoryHealthAndArmor 2133
{
    Radius 20
    Height 16

    Inventory.Amount 1
    Inventory.MaxAmount 1

    Inventory.Icon "HEALTHI"
    inventory.pickupmessage "Medikit"
    tag "Medikit"

    Inventory.PickupSound "items/HEALTH"

    States
    {
        Spawn:
            HELT A 1 NoDelay A_SpawnItemEx("ZH2MedikitFlare", 0, 0, 6)
            loop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_RailWait
            TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_checkautousemedikit", 0)
            Stop

        Use:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "UseSuccess")
            fail
        UseSuccess:
            TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_usemedikit", 0)
            fail
    }
}

Actor ZH2MedikitFlare : ZH2ItemLensFlare
{
    Scale .5
    Alpha .2

    States
    {
        Spawn:
            LFLR B 1 NoDelay Bright
            stop
    }
}

actor ZH2Medikithealth : Health
{
    inventory.Amount 40
    inventory.MaxAmount 100
}