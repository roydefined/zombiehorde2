actor ZH2FireCrystal
{
	scale 0.3
	radius 0
	height 0
	speed 10
	monster
	
	+STANDSTILL
	+FLOORCLIP
	+FORCEXYBILLBOARD
	-SOLID
	+BRIGHT
	
	States
	{
		// Wait until we hit the floor before we start doing anything.
		Spawn:
			TNT1 A 0 NoDelay A_CheckFloor("Spawn.Floor")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			loop

		Spawn.Floor:
			TNT1 A 0 A_Stop
		Spawn.FloorRest:
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfire_area_targetsource", 0, 100, 400, 200)
			
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItemEx("ZH2CrystalFlame", random(-6, 6), random(-6, 6), random(4, 12), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0), random(0, 359))
			
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItemEx("ZH2CrystalFlame", random(-6, 6), random(-6, 6), random(4, 12), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0), random(0, 359))
			
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItemEx("ZH2CrystalFlame", random(-6, 6), random(-6, 6), random(4, 12), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0), random(0, 359))
			
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItemEx("ZH2CrystalFlame", random(-6, 6), random(-6, 6), random(4, 12), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0), random(0, 359))
			
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItem("ZH2CrystalEffect")
			CRST A 1 light("ZH2CrystalLight") A_SpawnItemEx("ZH2CrystalFlare", 0, 0, 6)
			TNT1 A 0 A_SpawnItemEx("ZH2CrystalFlame", random(-6, 6), random(-6, 6), random(4, 12), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0), random(0, 359))
			loop
	}
}

actor ZH2CrystalFlame
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY
	+BRIGHT
	
	Renderstyle Add
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetTranslucent(Frandom(0.2, 0.6))
			TNT1 A 0 A_SetScale(Frandom(0.05, 0.2), Frandom(0.05, 0.2))
			FIR1 ABCDABCDABCDEFGHI 1
			Stop
	}
}