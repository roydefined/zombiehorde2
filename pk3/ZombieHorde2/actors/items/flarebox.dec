actor ZH2ItemFlareBox : ZH2CustomInventoryPowerup 20950
{
    Radius 18
    Height 16

    Inventory.Icon "FLAREBI"
    Inventory.PickupMessage "Box of flares"
    Tag "Box of flares"

    States
    {
        Spawn:
            FLAR C -1

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            fail
            TNT1 A 0 A_RailWait
            stop

        Use:
            TNT1 A 5 ACS_NamedExecuteAlways("zh2_dec_useflarebox", 0)
            fail
    }
}