actor ZH2ItemSuicideBombExplosionFX
{
    Radius 2
    Height 2
    Scale 4
    Renderstyle Add
    Alpha .9

    DeathSound "world/nuke1"

    +NOINTERACTION
    +FORCEXYBILLBOARD
    +FULLVOLDEATH
    +BOSS

    States
    {
        Spawn:
            TNT1 A 0 NoDelay Radius_Quake(10,30,0,256,0)
            TNT1 A 0 A_Scream
            TNT1 A 0 A_RadiusThrust(5000, 256, RTF_NOIMPACTDAMAGE)
            TNT1 A 0 A_SpawnItemEx("ZH2ItemSuicideBombFlare", 0, 0, 128)
            TNT1 A 0 A_SpawnItemEx("ZH2ItemSuicideBombFloorFX")
            NKE1 AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKKLLLMMMNNNOOOPPPQWWRRRSSS 1 bright A_FadeOut(.02)
            stop
    }
}

actor ZH2ItemSuicideBombFloorFX
{
    +CLIENTSIDEONLY
    +NOINTERACTION

    States
    {
        Spawn:
            TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 NoDelay A_SpawnItemEx("ZH2ItemSuicideBombFloorFire", Random(5, 200), Random(5, 200), 4, Random(10, 20), Random(10, 20), 4, Random(0, 359))
            TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2ItemSuicideBombFloorSmoke", Random(20, 200), Random(20, 200), 4, Random(20, 140), Random(20, 140), 4, Random(0, 359))
            TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2ItemSuicideBombFloorFireSlow", Random(20, 200), Random(20, 200), 4, Random(20, 80), Random(20, 80), 1, Random(0, 359))

        Stop
    }
}

actor ZH2ItemSuicideBombFloorFire
{
    Speed 5

    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +DONTSPLASH
    +NOTIMEFREEZE
    +NOBLOCKMAP
    +BRIGHT
    +NOGRAVITY
    +NOBLOCKMAP
    +NOCLIP

    Alpha 0.6
    Scale 4

    States
    {
        Spawn:
            FIR1 ABCDABCDABCDEFGHI 1
            stop
    }
}

actor ZH2ItemSuicideBombFloorFireSlow : ZH2ItemSuicideBombFloorFire
{
    Scale 6
    States
    {
        Spawn:
            FIR1 AAABBBCCCDDDAAABBBCCCDDDAAABBBCCCDDDEEEFFFGGGHHHIII 1
            stop
    }
}

actor ZH2ItemSuicideBombFloorSmoke
{
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +DONTSPLASH
    +NOTIMEFREEZE
    +NOBLOCKMAP
    +NOGRAVITY

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetTranslucent(FRandom(0.2, 0.4))
            TNT1 A 0 A_SetScale(6.0, 4.0)
            SMKD A 1 A_FadeOut(0.003)
            wait
    }
}

actor ZH2ItemSuicideBombFlare
{
    Scale 16
    Radius 8
    Height 10
    Alpha 0.5

    RenderStyle Add

    +CLIENTSIDEONLY
    +NOINTERACTION
    +BRIGHT

    States
    {
        Spawn:
            NFLR A 1 A_FadeOut(0.01)
            wait
    }
}