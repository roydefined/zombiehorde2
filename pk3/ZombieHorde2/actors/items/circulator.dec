actor ZH2ItemCirculator : ZH2CustomInventoryPowerup 24115
{
    Scale 0.7

    Inventory.Amount 1
    Inventory.MaxAmount 1

    Inventory.Icon "CCLIA0"
    Inventory.PickupMessage "Circulator"

    Tag "Circulator"

    States
    {
        Spawn:
            CCLS D 1 NoDelay A_SpawnItemEx("ZH2CirculatorFlare", 0, 0, 18)
            loop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_RailWait
            Stop


        Use:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_SpawnItemEx ("ZH2ItemCirculatorThrown", 56, 0, 8, 0, 0, 0, 0, 1)
            stop
    }
}

actor ZH2ItemCirculatorThrown
{
    Scale 0.7
    Radius 32
    Height 32

    var int user_angle;
    var int user_firecyclecount;
    var int user_firetotalcount;

    States
    {
        Spawn:
            // Remain active for a period and turn it off after.
            TNT1 A 0 NoDelay ACS_NamedExecuteAlways("zh2_dec_set_circulator_time", 0)

        Spawn.Rest:
            CCLN ABCDABCDABCD 4
            TNT1 A 0 A_Playsound("items/CIRCULATORFIRE", 7)
        Spawn.CircularFire:
            CCLN A 1 A_SpawnItemEx("ZH2CirculatorFireBall", 0, 16, 30, 10, 0, 0, user_angle)
            TNT1 A 0 A_SetUserVar("user_angle", user_angle + 30)
            TNT1 A 0 A_JumpIf(user_angle == 360, 1)
            loop
            TNT1 A 0 A_SetUserVar("user_angle", 0)
            TNT1 A 0 A_SetUserVar("user_firecyclecount", user_firecyclecount + 1)
            TNT1 A 0 A_JumpIf(user_firecyclecount == 3, 1)
            goto Spawn.Rest


            TNT1 A 0 A_SetUserVar("user_firetotalcount", user_firetotalcount - 1)
            TNT1 A 0 A_JumpIf(user_firetotalcount == 0, "Spawn.Depleted")

            TNT1 A 0 A_SetUserVar("user_firecyclecount", 0)
            CCLS ABC 2
            CCLS D 20
            TNT1 A 0 A_Playsound("items/CIRCULATORTIC", 6)
            CCLR AB 2
            CCLS D 20
            TNT1 A 0 A_Playsound("items/CIRCULATORTIC", 6)
            CCLR AB 2
            CCLS D 20
            TNT1 A 0 A_Playsound("items/CIRCULATORTIC", 6)
            CCLR AB 2
            CCLS D 20
            CCLS CBA 2
            goto Spawn.Rest

        Spawn.Depleted:
            TNT1 A 0 A_SpawnItem("ZH2ItemCirculatorDepleteExplosion")
            stop

    }
}

actor ZH2CirculatorFireBall
{
    Projectile
    Radius 8
    Height 8
    Speed 33
    Damage 1
    Alpha 0.75

    RenderStyle Add
    DeathSound "items/CIRCULATORFIREHIT"

    DamageType "ZH2SetOnFire"

    States
    {
        Spawn:
            CCLZ ABCD 4
            Loop

        Death:
            CCLX ABC 6 Bright
            Stop
    }
}

actor ZH2ItemCirculatorDepleteExplosion
{
    RenderStyle Translucent
    Alpha 0.6

    +FORCEYBILLBOARD
    +CLIENTSIDEONLY
    +BRIGHT

    states
    {
        spawn:
            TNT1 A 0 NoDelay A_PlaySound("sound/explosion1")
            EXP2 ABCDEFGHIJKLMN 2
            stop
    }
}

Actor ZH2CirculatorFlare : ZH2ItemLensFlare
{
    Scale .6
    Alpha .4

    States
    {
        Spawn:
            LFLR B 1 NoDelay Bright
            stop
    }
}