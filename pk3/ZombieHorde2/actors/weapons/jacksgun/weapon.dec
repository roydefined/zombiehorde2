Actor ZH2WeaponJacksGun : ZH2WeaponSpawn
{
    tag "Jack's gun"

    States
    {
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "CheckSkin")
            fail
        CheckSkin:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getweaponskin", 0, 0, 0) == 1, "GiveLegacy")
            TNT1 A 0 A_GiveInventory("ZH2WeaponJacksGunDefault", 1)
            stop
        GiveLegacy:
            TNT1 A 0 A_GiveInventory("ZH2WeaponJacksGunLegacy", 1)
            stop
    }
}
