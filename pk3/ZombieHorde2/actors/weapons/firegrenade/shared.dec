Actor ZH2WeaponFireGrenadeThrowPower : Ammo
{
    Inventory.MaxAmount 100
}

Actor ZH2WeaponFireGrenadeAmmo : Ammo
{
    inventory.MaxAmount 1
}

Actor ZH2WeaponFireGrenadeThrownPin
{
    Radius 4
    Height 4
    Projectile
    Scale 0.2
    Gravity 0.8

    Bouncefactor 0.5
    WallBounceFactor 0.2
    BounceCount 2
    BounceType Hexen

    DeathSound "weapons/firegrenade/default/PINDROP"
    BounceSound "weapons/firegrenade/default/PINDROP"

    -NOGRAVITY
    +CLIENTSIDEONLY
    +FORCEXYBILLBOARD
    +DONTSPLASH
    +NOTIMEFREEZE
    +NOBLOCKMAP

    States
    {
        Spawn:
            GPIN A 1 NoDelay A_JumpIf(Waterlevel != 0, "Underwater")
            Wait

        Underwater:
            TNT1 A 0 A_ScaleVelocity(0.90)
            GPIN A 1 A_FadeOut(0.02)
            Loop

        Death:
            TNT1 A 0
            Stop
    }
}

Actor ZH2WeaponFireGrenadeThrown
{
    projectile

    radius 8
    height 8
    scale 0.2
    gravity 0.4

    BounceFactor 0.4
    WallBounceFactor 0.2
    Bouncecount 2
    BounceType Hexen
    BounceSound "weapons/firegrenade/default/BOUNCE"

    -NOGRAVITY
    +FORCEXYBILLBOARD
    +DONTSPLASH

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SpawnItemEx("ZH2WeaponFireGrenadeThrownPin", 0, 0, 0, 6, -4, 3)
        Spawn.Rest:
            HGRN AABBCCDDEEFFGGHHIIJJKKLL 1 A_JumpIf(Waterlevel != 0, "Underwater")
            loop

        Underwater:
            HGRN "###################################################" 1 A_ScaleVelocity(0.92)
            TNT1 A 0 A_SpawnItemEx("ZH2WeaponFireGrenadeExplosionUnderwater")
            TNT1 A 0 A_Scream
            TNT1 A 0 A_AlertMonsters
            stop

        Death:
            TNT1 A 0 A_AlertMonsters
            TNT1 A 0 A_SpawnItemEx("ZH2WeaponFireGrenadeExplosion")
            TNT1 A 0 A_SpawnItemEx("ZH2WeaponFireGrenadeDeathFX")
            stop
    }
}

Actor ZH2WeaponFireGrenadeThrown1 : ZH2WeaponFireGrenadeThrown { Speed 15 }
Actor ZH2WeaponFireGrenadeThrown2 : ZH2WeaponFireGrenadeThrown { Speed 20 }
Actor ZH2WeaponFireGrenadeThrown3 : ZH2WeaponFireGrenadeThrown { Speed 25 }
Actor ZH2WeaponFireGrenadeThrown4 : ZH2WeaponFireGrenadeThrown { Speed 30 }
Actor ZH2WeaponFireGrenadeThrown5 : ZH2WeaponFireGrenadeThrown { Speed 35 }
Actor ZH2WeaponFireGrenadeThrown6 : ZH2WeaponFireGrenadeThrown { Speed 40 }
Actor ZH2WeaponFireGrenadeThrown7 : ZH2WeaponFireGrenadeThrown { Speed 45 }
Actor ZH2WeaponFireGrenadeThrown8 : ZH2WeaponFireGrenadeThrown { Speed 50 }
