actor ZH2WeaponFireGrenade : ZH2WeaponSpawn
{
    Tag "Fire grenade"

    States
    {
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_giveweapon", WEAPONTYPE_FIREGRENADE, 0, 0) == true, 1)
            fail
            TNT1 A 0 A_GiveInventory("ZH2WeaponFireGrenadeAmmo", 1)
            stop
    }
}
