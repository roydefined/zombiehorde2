actor ZH2WeaponFireGrenade : ZH2WeaponSpawn
{
    Tag "Fire grenade"

    States
    {
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "CheckSkin")
            fail
        CheckSkin:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getweaponskin", 0, 0, 0) == 1, "GiveLegacy")
            TNT1 A 0 A_GiveInventory("ZH2WeaponFireGrenadeDefault", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponFireGrenadeAmmo", 1)
            stop
        GiveLegacy:
            TNT1 A 0 A_GiveInventory("ZH2WeaponFireGrenadeLegacy", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponFireGrenadeAmmo", 1)
            stop
    }
}
