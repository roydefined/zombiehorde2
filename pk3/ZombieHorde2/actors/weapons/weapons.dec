actor ZH2FakeWeaponSpawn
{
    //$Category "Weapons"
    //$NotAngled
}

actor ZH2WeaponSpawn : CustomInventory
{
    Inventory.PickupSound "weapons/PICKUP"
}

actor ZH2Weapon : Weapon
{
    +NOALERT
    +NOAUTOAIM

    Weapon.BobSpeed 1.6
    Weapon.BobRangeX 0.4
    Weapon.BobRangeY 0.6
    Weapon.BobStyle Alpha

    Decal "zh2puff"
}

// Must stay numerically in sync with Weapon::WeaponTypeT (acs_source/zh2game/weapon/weapon.h.acs).
enum
{
    WEAPONTYPE_CHAINGUN = 0,
    WEAPONTYPE_CLAWS = 1,
    WEAPONTYPE_DOUBLESHOTGUN = 2,
    WEAPONTYPE_FIREGRENADE = 3,
    WEAPONTYPE_HANDGUN = 4,
    WEAPONTYPE_JACKSGUN = 5,
    WEAPONTYPE_RADIO = 6,
    WEAPONTYPE_RIOTGUN = 7,
    WEAPONTYPE_SHOTGUN = 8,
    WEAPONTYPE_SNIPER = 9,
};

