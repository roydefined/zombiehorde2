actor ZH2WeaponShotgun : ZH2WeaponSpawn
{
    Tag "Hunting shotgun"

    States
    {
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "CheckSkin")
            fail
        CheckSkin:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getweaponskin", 0, 0, 0) == 1, "GiveLegacy")
            TNT1 A 0 A_GiveInventory("ZH2WeaponShotgunDefault", 1)
            stop
        GiveLegacy:
            TNT1 A 0 A_GiveInventory("ZH2WeaponShotgunLegacy", 1)
            stop
    }
}
