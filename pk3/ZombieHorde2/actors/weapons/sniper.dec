// If true, the sniper is required to bolt before firing again.
actor ZH2WeaponSniperBolting : Boolean {}

// If true, then the sniper' state zoomed in.
// This wont directly indicate the sniper is in a zoomed state.
// The sniper is really zoomed in if `ZH2WeaponSniperZoomlevel` has a value.
// This big difference occurs when bolting the sniper, for example.
actor ZH2WeaponSniperIsZoomed : Boolean {}

// If true, eject a casing when bolting.
actor ZH2WeaponSniperShouldEjectCase : Boolean {}

// Indicates the zoom level that the sniper is in.
// This is also used to indicate that the sniper is zoomed between reloads.
actor ZH2WeaponSniperZoomlevel : inventory { inventory.MaxAmount 2 }

actor ZH2WeaponSniperSpawn : ZH2WeaponSpawn 11003
{
	inventory.PickupMessage "Sniper rifle"
	tag "Sniper rifle"
	
	states
	{
		Spawn:
			WSNP A -1
			stop
			
		Pickup:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
			stop
		PickupSuccess:
			TNT1 A 0 A_GiveInventory("ZH2WeaponSniper", 1)
			stop
	}
}

actor ZH2WeaponSniper : ZH2Weapon
{
	tag "Sniper rifle"
	weapon.PreferredSkin "Sniperrifle"
	
	weapon.SlotNumber 5
	weapon.KickBack 1
	
	// This is for default huds
	weapon.AmmoUse 0
	weapon.AmmoGive 0
	//weapon.AmmoType "Clip"

	+WEAPON.NOAUTOFIRE
  
	States
	{
		Ready:
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperBolting", 1, "SniperBolt")
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperIsZoomed", 1, "Ready.Zoomed")
		Ready.Rest:
			SNPR A 1 A_WeaponReady(WRF_ALLOWRELOAD)
			wait

		Ready.Zoomed:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getcanfire") == 0, "AltFire.ZoomOut")
			
			TNT1 A 1 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
			loop

		Deselect:
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 1, "Deselect.Zoomed")
			SNPB DCBA 1
			TNT1 A 0 A_Lower
			wait
		
		Select:
			TNT1 A 0 A_Raise
			TNT1 A 0 A_WeaponReady
			SNPB ABCD 1
			goto Ready

		Deselect.Zoomed:
			TNT1 A 0 A_TakeInventory("ZH2WeaponSniperZoomlevel", 2)
			TNT1 A 0 A_TakeInventory("ZH2WeaponSniperIsZoomed", 1)
			TNT1 A 0 A_PlaySoundEx("weapons/sniper/ZOOMOUT", "SoundSlot5")
			TNT1 A 3
			TNT1 A 0 A_ZoomFactor(1.0, ZOOM_INSTANT)
			TNT1 A 0 A_SetCrosshair(0)
			SNTR CBA 1
			goto Deselect
		
		
		// Altfire toggles zoom levels.
		AltFire:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getcanfire") == 0, "Ready")
			
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 2, "AltFire.ZoomOut")
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 1, "AltFire.Zoom2")
		AltFire.Zoom1:
			SNPB D 1 A_ZoomFactor(2.0)
			SNTR ABC 1
			TNT1 A 0 A_SetCrosshair(99999) // Surely nobody has that many crosshairs?
			TNT1 A 0 A_GiveInventory("ZH2WeaponSniperIsZoomed", 1)
			TNT1 A 0 A_GiveInventory("ZH2WeaponSniperZoomlevel", 1)
			TNT1 A 0 A_PlaySoundEx("weapons/sniper/ZOOMIN", "SoundSlot5")
			goto Ready
		AltFire.Zoom2:
			TNT1 A 0 A_GiveInventory("ZH2WeaponSniperZoomlevel", 1)
			TNT1 A 0 A_PlaySoundEx("weapons/sniper/ZOOMIN", "SoundSlot5")
			TNT1 A 0 A_ZoomFactor(6.0)
			goto Ready
		AltFire.ZoomOut:
			TNT1 A 0 A_PlaySoundEx("weapons/sniper/ZOOMOUT", "SoundSlot5")
			TNT1 A 3
			TNT1 A 0 A_TakeInventory("ZH2WeaponSniperZoomlevel", 2)
			TNT1 A 0 A_TakeInventory("ZH2WeaponSniperIsZoomed", 1)
			TNT1 A 0 A_ZoomFactor(1.0, ZOOM_INSTANT)
			TNT1 A 0 A_SetCrosshair(0)
			SNTR CBA 1
			goto Ready
		
		Reload:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getcanfire") == 0, "Ready")
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 1, "AltFire.ZoomOut")
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperShouldEjectCase", 1, "SniperBolt")
			goto Ready
			

		Fire:
			TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getcanfire") == 0, "Ready")
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, true)
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", true)
			
			TNT1 A 0 A_PlaySound("weapons/sniper/FIRE", CHAN_WEAPON)
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 Radius_Quake(2, 6, 0, 1, 0)
			TNT1 A 0 A_GiveInventory("ZH2WeaponSniperBolting", 1)
			TNT1 A 0 A_GiveInventory("ZH2WeaponSniperShouldEjectCase", 1)
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperIsZoomed", 1, "Fire.Zoomed")
			
			// Regular firing. Angled smoke and tracer.
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_tracer_prepare", 12, 0)
			TNT1 A 0 A_FireCustomMissile("ZH2WeaponSniperSmoke", 0, false, 8)
			TNT1 A 0 A_FireBullets(1, 1, 1, 125, "ZH2WeaponBulletPuff", FBF_NORANDOM)
			SNPR B 1 bright
			TNT1 A 0 A_SetPitch(pitch-3.0)
			SNPR C 3
			SNPR DD 1 A_SetPitch(pitch+1.0)
			SNPR E 1 A_SetPitch(pitch+1.0)
			
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, false)
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", false)
			goto SniperBolt
			
		// Firing while currently zoomed in.
		Fire.Zoomed:
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_tracer_prepare", 0, 0)
			TNT1 A 0 A_FireCustomMissile("ZH2WeaponSniperSmoke", 0, false, 0)
			TNT1 A 0 A_FireBullets(1, 1, 1, 125, "ZH2WeaponBulletPuff", FBF_NORANDOM)
			TNT1 A 0 A_SetPitch(pitch-2.0)
			TNT1 A 0 A_SetAngle(angle-1.0)
			LDHR S 3 bright
			LDHR A 0 A_SetAngle(angle+1.0)
			LDHR SS 1 bright A_SetPitch(pitch+1.0)
			LDHR S 1 bright
			TNT1 A 0 A_TakeInventory("ZH2WeaponSniperIsZoomed", 1)
			TNT1 A 0 A_ZoomFactor(1.0, ZOOM_INSTANT)
			
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, false)
			TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", false)
			
			SNTR CBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPB D 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SniperBolt:
			SNPR FGHIJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR K 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR LMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)

			SNPR O 3 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			TNT1 A 0 A_PlaySoundEx("weapons/sniper/UP","SoundSlot5")
			SNPR P 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR Q 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR R 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR ST 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperShouldEjectCase", 1, "SniperBolt.Casing")
			goto SniperBolt.Rest
		SniperBolt.Casing:
			TNT1 A 0 A_TakeInventory("ZH2WeaponSniperShouldEjectCase", 1)
			TNT1 A 0 A_FireCustomMissile("ZH2SniperCase", 5, true, 4, -3)
		SniperBolt.Rest:
			TNT1 A 0 A_TakeInventory("ZH2WeaponSniperBolting", 1)
			TNT1 A 0 A_PlaySoundEx("weapons/sniper/BACK","SoundSlot5")
			SNPR U 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR V 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR W 5 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			TNT1 A 0 A_PlaySoundEx("weapons/sniper/FORWARD","SoundSlot5")
			SNPS ABCDE 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPS F 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPS GHI 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNPR JIHG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 1, "SniperBoltEndZoomed")
			goto Ready
		
		SniperBoltEndZoomed:
			SNPB D 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			SNTR ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
			TNT1 A 0 A_GiveInventory("ZH2WeaponSniperIsZoomed", 1)
			TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 2, "SniperBoltEndZoomedFullZoom")
			TNT1 A 0 A_ZoomFactor(2.0, ZOOM_INSTANT)
			goto Ready
		
		SniperBoltEndZoomedFullZoom:
			TNT1 A 0 A_ZoomFactor(6.0, ZOOM_INSTANT)
			goto Ready
	}
}