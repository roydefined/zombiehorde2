Actor ZH2WeaponDoubleShotgun : ZH2WeaponSpawn
{
    Tag "Double barreled shotgun"

    States
    {
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "CheckSkin")
            fail
        CheckSkin:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getweaponskin", 0, 0, 0) == 1, "GiveLegacy")
            TNT1 A 0 A_GiveInventory("ZH2WeaponDoubleShotgunDefault", 1)
            stop
        GiveLegacy:
            TNT1 A 0 A_GiveInventory("ZH2WeaponDoubleShotgunLegacy", 1)
            stop
    }
}
