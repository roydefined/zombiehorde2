Actor ZH2ChaingunSpawnDefault : ZH2WeaponSpawn
{
    Inventory.pickupmessage "Chaingun"
    Tag "Chaingun"

    Scale 0.8

    states
    {
        Spawn:
            CGGS A -1
            stop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_GiveInventory("ZH2WeaponChaingunDefault", 1)
            stop
    }
}
