actor ZH2WeaponShotgunSpawnDefault : ZH2WeaponSpawn
{
    Inventory.PickupMessage "Hunting shotgun"
    Tag "Hunting shotgun"

    States
    {
        Spawn:
            SHTA A -1

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_GiveInventory("Zh2WeaponShotgunDefault", 1)
            stop
    }
}
