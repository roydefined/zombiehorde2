actor ZH2WeaponHandgunSpawnDefault : ZH2WeaponSpawn
{
    scale 0.8
    inventory.pickupmessage "Handgun"
    tag "Handgun"

    states
    {
        Spawn:
            PS1D A -1

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_GiveInventory("ZH2WeaponHandgunDefault", 1)
            stop
    }
}
