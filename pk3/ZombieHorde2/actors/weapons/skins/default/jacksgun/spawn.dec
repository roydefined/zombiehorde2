Actor ZH2WeaponJacksGunSpawnDefault : ZH2WeaponSpawn
{
    scale .8
    radius 20
    height 16

    inventory.pickupmessage "Jack's gun"
    tag "Jack's gun"

    States
    {
        Spawn:
            JCGF A -1

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_GiveInventory("ZH2WeaponJacksGunDefault", 1)
            stop
    }
}
