Actor ZH2WeaponRadioSpawnDefault : ZH2WeaponSpawn
{
    radius 16
    height 8

    Inventory.PickupMessage "Radio"
    Tag "Radio"

    States
    {
        Spawn:
            RDIA A -1
            Stop
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_GiveInventory("ZH2WeaponRadioDefault", 1)
            stop
    }
}
