Actor ZH2WeaponRadioDefault : ZH2Weapon
{
    weapon.PreferredSkin "Radio"
    Tag "Radio"
    Weapon.SlotNumber 1

    +WEAPON.NOAUTOFIRE

    States
    {
        Ready:
            RDIO A 1 A_WeaponReady(WRF_ALLOWRELOAD)
            wait

        Deselect:
            RDIS FEDCBA 1
            TNT1 A 0 A_Lower
            wait

        Select:
            TNT1 A 0 A_Raise
            TNT1 A 0 A_WeaponReady(WRF_NOFIRE | WRF_NOSWITCH)
            RDIS ABCDEFGHI 1
            goto Ready

        Fire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_radio_cyclemusic", 1)
            goto Ready

        Altfire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_radio_cyclemusic", -1)
            goto Ready

        Reload:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
            RDIW ABCD 1
            RDIX Y 1
            TNT1 A 0 A_PlaySound("weapons/radio/default/EJECT")
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_radio_stopmusic")
            RDIX Y 1
            RDIW EFGHIJKLM 1
            RDIW N 3
            RDIW OPQRSTUVWXYZ 1
            RDIX A 1
            RDIX B 2
            RDIX C 3 A_PlaySound("weapons/radio/default/PLACE")
            TNT1 A 0 A_PlaySound("weapons/radio/default/INSERT")
            RDIX D 2
            RDIX EFGHIJK 1
            RDIX Z 4
            RDIX Z 1 A_PlaySound("weapons/radio/default/CLOSE")
            RDIX L 1
            RDIX M 3 A_ClientsideACSExecute("zh2_dec_radio_setcurrentmusic")
            RDIX N 2
            RDIX OPQ 1
            goto Ready
    }
}
