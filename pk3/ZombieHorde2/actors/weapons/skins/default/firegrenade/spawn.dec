actor ZH2WeaponFireGrenadeSpawnDefault : ZH2WeaponSpawn
{
    Radius 12
    Height 20

    Scale 0.6

    Inventory.Amount 1
    Inventory.MaxAmount 1

    Inventory.PickupMessage "Fire grenade"
    Tag "Fire grenade"

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(256, 1, 2, 3, 4)
            PGRN A -1
            PGRN B -1
            PGRN C -1
            PGRN D -1

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            fail
        PickupSuccess:
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeDefault", 1, 2)
            TNT1 A 0 A_GiveInventory("ZH2WeaponFireGrenadeDefault", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponFireGrenadeAmmo", 1)
            stop
    }
}
