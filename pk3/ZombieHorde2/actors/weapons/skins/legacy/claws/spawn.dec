Actor ZH2WeaponClawsSpawnLegacy : ZH2WeaponSpawn
{
    inventory.pickupmessage "Zombie claws"
    tag "Zombie claws"

    States
    {
        Spawn:
            ZCAA A -1

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getiszombie", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_GiveInventory("ZH2WeaponClawsLegacy", 1)
            stop
    }
}
