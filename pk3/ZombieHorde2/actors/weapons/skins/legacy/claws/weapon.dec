const int CLAW_DAMAGE_LEGACY = 4;

// Tracks which side swung last so the legacy claws can alternate between them.
Actor ZH2WeaponClawsLegacyFirstSwing : Boolean
{
    Inventory.MaxAmount 1
}

Actor ZH2WeaponClawsLegacy : ZH2Weapon
{
    tag "Zombie claws"

    weapon.SlotNumber 1
    weapon.BobSpeed 0.3
    weapon.Kickback 100

    decal ""
    +WEAPON.NOAUTOFIRE

    States
    {
        Ready:
            ZCAA B 2 A_WeaponReady
            TNT1 A 0 A_JumpIfInventory("ZH2DoZombieAbilityIndex", 1, "Fire.Ability")
            loop

        Deselect:
            ZCAA B 1 A_Lower
            wait

        Select:
            ZCAA B 1 A_Raise
            wait

        Fire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponClawsLegacyFirstSwing", 1, "Fire.Left")

            ZCAR AB 1
            TNT1 A 0 A_PlaySound ("weapons/claws/legacy/SWING", CHAN_WEAPON)
            ZCAR C 1

            // TNT1 A 0 A_CustomPunch(CLAW_DAMAGE, true, 0, "ZH2ClawsWallScratchPuff", 72)
            TNT1 A 0 A_CustomPunch(CLAW_DAMAGE_LEGACY, true, 0, "ZH2ClawsWallScratchPuff", 72)

            ZCAR DE 1

            // TNT1 A 0 A_CustomPunch(CLAW_DAMAGE, true, 0, "ZH2ClawsScratchPuff", 72)
            TNT1 A 0 A_CustomPunch(CLAW_DAMAGE_LEGACY, true, 0, "ZH2ClawsScratchPuff", 72)

            ZCAR FGH 1
            TNT1 A 0 A_GiveInventory("ZH2WeaponClawsLegacyFirstSwing", 1)
            ZCAR IJKLM 1
            goto Ready

        Fire.Left:
            ZCAL AB 1
            TNT1 A 0 A_PlaySound ("weapons/claws/legacy/SWING", CHAN_WEAPON)
            ZCAL C 1

            // TNT1 A 0 A_CustomPunch(CLAW_DAMAGE, true, 0, "ZH2ClawsWallScratchPuff", 72)
            TNT1 A 0 A_CustomPunch(CLAW_DAMAGE_LEGACY, true, 0, "ZH2ClawsWallScratchPuff", 72)

            ZCAL DE 1

            // TNT1 A 0 A_CustomPunch(CLAW_DAMAGE, true, 0, "ZH2ClawsScratchPuff", 72)
            TNT1 A 0 A_CustomPunch(CLAW_DAMAGE_LEGACY, true, 0, "ZH2ClawsScratchPuff", 72)

            ZCAL FG 1
            TNT1 A 0 A_TakeInventory("ZH2WeaponClawsLegacyFirstSwing", 1)
            ZCAL HIJKLM 1
            goto Ready

        Altfire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")

            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_dozombieability_client")
            goto Ready

        Fire.Ability:
            TNT1 A 0 A_JumpIfInventory("ZH2DoZombieAbilityIndex", 3, "Fire.AbilityRest")
            TNT1 A 0 A_JumpIfInventory("ZH2DoZombieAbilityIndex", 2, "Fire.AbilitySpit")
            TNT1 A 0 A_JumpIfInventory("ZH2DoZombieAbilityIndex", 1, "Fire.AbilityPush")
            goto Fire.AbilityRest

        Fire.AbilityPush:
            ZCAP ABCDE 2
            TNT1 A 0 A_PlaySound ("weapons/claws/legacy/SWING", CHAN_WEAPON)
            ZCAP F 2
            ZCAP GHI 1

            // TNT1 A 0 A_CustomPunch(70, 0, 0, "ZH2ClawsPushPuff", 72)
            TNT1 A 0 A_CustomPunch(70, true, 0, "ZH2ClawsPushPuff", 72)

            ZCAP JKLMNO 1
            goto Fire.AbilityRest

        Fire.AbilitySpit:
            TNT1 A 0 A_PlaySound("weapons/claws/default/SPIT", CHAN_BODY)
            ZCAS ABC 2
            ZCAS D 13
            TNT1 A 0 A_FireCustomMissile("ZH2ZombieAcidSpitMissile", 0, false, 0, 0)
            ZCAS EFGH 2
            ZCAS I 3
            goto Fire.AbilityRest

        Fire.AbilityRest:
            TNT1 A 0 A_TakeInventory("ZH2DoZombieAbilityIndex", 0x7fffffff)
            goto Ready
    }
}
