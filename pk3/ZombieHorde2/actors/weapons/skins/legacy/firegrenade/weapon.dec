Actor ZH2WeaponFireGrenadeLegacy : ZH2Weapon
{
    tag "Fire Grenade"
    weapon.PreferredSkin "firegrenade"

    weapon.SlotNumber 1
    weapon.AmmoType "ZH2WeaponFireGrenadeThrowPower"

    +WEAPON.NOAUTOAIM

    States
    {
        Ready:
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeAmmo", 1, "Ready.Ammo")
            TNT1 A 1 A_WeaponReady(WRF_NOFIRE)
            loop

        Ready.Ammo:
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeAmmo", 1, 1)
            goto Select.DetermineAmmo
            HNGR A 1 A_WeaponReady(WRF_NOSECONDARY)
            loop

        Select:
            TNT1 A 0 A_TakeInventory("ZH2WeaponFireGrenadeThrowPower", 999)
        Select.DetermineAmmo:
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeAmmo", 1, "Select.Ammo")
        Select.Rest:
            TNT1 A 0 A_Raise
            wait
        Select.Ammo:
            HNGR A 1 A_Raise
            wait

        Deselect:
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeAmmo", 1, "Deselect.Ammo")
            TNT1 A 0 A_Lower
            wait

        Deselect.Ammo:
            HNGR A 1 A_Lower
            wait

        Fire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready.Ammo")

            HNGR BCD 2
            TNT1 A 0 A_PlaySoundEx("weapons/firegrenade/legacy/PINOUT","SoundSlot5")
            HNGR EHIJL 2

        Fire.Hold:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "AltFire")

            //TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 100, "Throw")
            TNT1 A 1 A_GiveInventory("ZH2WeaponFireGrenadeThrowPower", 1)
            TNT1 A 0 A_ReFire("Fire.Hold")

            // Repins with altfire
            TNT1 A 0 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSWITCH)
            goto Throw

        // Repinning. This state can only happen in the Fire.Hold state above.
        AltFire:
            TNT1 A 0 A_TakeInventory("ZH2WeaponFireGrenadeThrowPower", 999)
            HNGR LI 2
            HNGP AB 2
            TNT1 A 0 A_PlaySound("weapons/firegrenade/legacy/REPIN")
            HNGP E 2
            HNGR DCB 2
            goto Ready.Ammo

        Throw:
            HNGR NO 2
            TNT1 A 0 A_PlaySound("weapons/firegrenade/legacy/THROW")
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 100, 7)
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 80,  7)
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 60,  7)
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 40,  7)
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 25,  7)
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 15,  7)
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponFireGrenadeThrowPower", 5,   7)
            goto Throw.Speeds+7
        Throw.Speeds:
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown8")
            goto Throw.Rest
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown7")
            goto Throw.Rest
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown6")
            goto Throw.Rest
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown5")
            goto Throw.Rest
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown4")
            goto Throw.Rest
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown3")
            goto Throw.Rest
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown2")
            goto Throw.Rest
            TNT1 A 0 A_FireCustomMissile("ZH2WeaponFireGrenadeThrown1")
        Throw.Rest:
            TNT1 A 0 A_TakeInventory("ZH2WeaponFireGrenadeThrowPower", 999)
            TNT1 A 0 A_TakeInventory("ZH2WeaponFireGrenadeAmmo", 1)
            HNGR PR 2
            TNT1 A 4
            goto Select.DetermineAmmo
    }
}
