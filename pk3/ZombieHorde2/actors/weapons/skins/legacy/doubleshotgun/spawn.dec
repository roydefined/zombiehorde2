Actor ZH2WeaponDoubleShotgunSpawnLegacy : ZH2WeaponSpawn
{
    Scale 0.8
    radius 20
    height 16

    inventory.pickupmessage "Double barreled shotgun"
    tag "Double barreled shotgun"

    States
    {
        Spawn:
            SG2P A -1

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponDoubleShotgunLegacy", 1, 2)
            TNT1 A 0 A_GiveInventory("ZH2WeaponDoubleShotgunLegacy", 1)
            TNT1 A 0
            stop
    }
}
