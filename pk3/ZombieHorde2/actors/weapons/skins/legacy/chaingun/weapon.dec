Actor ZH2WeaponChaingunLegacy : ZH2Weapon
{
    Tag "Chaingun"
    Weapon.PreferredSkin "Chaingun"

    Scale 0.8
    Weapon.SlotNumber 4
    Weapon.KickBack 120

    // This is for default huds
    Weapon.AmmoUse 0
    Weapon.AmmoGive 0
    Weapon.AmmoType "ZH2Chaingunheat"

    States
    {
        Ready:
            CGS1 A 1 A_WeaponReady
            loop

        Select:
            CGS1 A 1 A_Raise
            wait

        Deselect:
            CGS1 A 1 A_Lower
            wait

        Fire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
            TNT1 A 0 A_JumpIfInventory("ZH2Chaingunheat", 50, "Ready")

            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, true)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", true)

            TNT1 A 0 A_GiveInventory("ZH2Chaingunheat", 1)
            TNT1 A 0 A_PlaySound("weapons/chaingun/legacy/FIRE", CHAN_AUTO)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_tracer_prepare", 0, 0)

            // TNT1 A 0 A_FireBullets(4.0, 4.0, -1, 10 + random(-1, 1) * 2, "ZH2WeaponBulletPuff", FBF_NORANDOM)
            TNT1 A 0 A_FireBullets(6.0, 3.5, 1, 5, "ZH2WeaponBulletPuff", FBF_NORANDOM)

            TNT1 A 0 A_AlertMonsters

            CGS1 F 4 bright

            TNT1 A 0 A_GiveInventory("ZH2Chaingunheat", 1)
            TNT1 A 0 A_PlaySound("weapons/chaingun/legacy/FIRE", CHAN_AUTO)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_tracer_prepare", 0, 0)

            // TNT1 A 0 A_FireBullets(4.0, 4.0, -1, 10 + random(-1, 1) * 2, "ZH2WeaponBulletPuff", FBF_NORANDOM)
            TNT1 A 0 A_FireBullets(6.0, 3.5, 1, 5, "ZH2WeaponBulletPuff", FBF_NORANDOM)

            TNT1 A 0 A_AlertMonsters

            CGS1 H 4 bright

            TNT1 A 0 A_ReFire
            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, false)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", false)
            goto Ready
    }
}
