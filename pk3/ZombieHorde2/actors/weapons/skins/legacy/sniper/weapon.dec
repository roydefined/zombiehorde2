actor ZH2WeaponSniperLegacy : ZH2Weapon
{
    tag "Sniper rifle"
    weapon.PreferredSkin "Sniperrifle"

    weapon.SlotNumber 5

    // Modern variant
    //weapon.KickBack 10

    // legacy variant
    //weapon.KickBack 110

    // Nerfed to accommodate with the damage increase.
    weapon.KickBack 80

    // This is for default huds
    weapon.AmmoUse 0
    weapon.AmmoGive 0

    +WEAPON.NOAUTOFIRE

    States
    {
        Ready:
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperBolting", 1, "SniperBolt")
            SNPR A 1 A_WeaponReady(WRF_ALLOWRELOAD)
            wait

        Deselect:
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 1, "Deselect.Zoomed")
            SNPR A 1 A_Lower
            wait

        Select:
            SNPR A 1 A_Raise
            wait

        Deselect.Zoomed:
            TNT1 A 0 A_TakeInventory("ZH2WeaponSniperZoomlevel", 2)
            TNT1 A 0 A_TakeInventory("ZH2WeaponSniperIsZoomed", 1)
            TNT1 A 0 A_PlaySoundEx("weapons/sniper/legacy/ZOOMOUT", "SoundSlot5")
            TNT1 A 0 A_ZoomFactor(1.0)
            goto Deselect

        // Altfire toggles zoom levels.
        AltFire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")

            TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 2, "AltFire.ZoomOut")
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 1, "AltFire.Zoom2")
        AltFire.Zoom1:
            SNPB D 2 A_ZoomFactor(2.0)
            TNT1 A 0 A_GiveInventory("ZH2WeaponSniperIsZoomed", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponSniperZoomlevel", 1)
            TNT1 A 0 A_PlaySoundEx("weapons/sniper/legacy/ZOOMIN", "SoundSlot5")
            goto Ready
        AltFire.Zoom2:
            TNT1 A 0 A_GiveInventory("ZH2WeaponSniperZoomlevel", 1)
            TNT1 A 0 A_PlaySoundEx("weapons/sniper/legacy/ZOOMIN", "SoundSlot5")
            TNT1 A 0 A_ZoomFactor(6.0)
            goto Ready
        AltFire.ZoomOut:
            TNT1 A 0 A_PlaySoundEx("weapons/sniper/legacy/ZOOMOUT", "SoundSlot5")
            TNT1 A 0 A_TakeInventory("ZH2WeaponSniperZoomlevel", 2)
            TNT1 A 0 A_TakeInventory("ZH2WeaponSniperIsZoomed", 1)
            TNT1 A 0 A_ZoomFactor(1.0)
            goto Ready

        Reload:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
            TNT1 A 0 A_JumpIfInventory("ZH2WeaponSniperZoomlevel", 1, "AltFire.ZoomOut")
            goto Ready

        Fire:
            TNT1 A 0 A_JumpIfInventory("ZH2BlockWeaponFiring", 1, "Ready")
            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, true)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", true)

            TNT1 A 0 A_PlaySound("weapons/sniper/legacy/FIRE", CHAN_WEAPON)
            TNT1 A 0 A_AlertMonsters
            TNT1 A 0 A_GiveInventory("ZH2WeaponSniperBolting", 1)
            TNT1 A 0 A_TakeInventory("ZH2WeaponSniperIsZoomed", 1)
            TNT1 A 0 A_TakeInventory("ZH2WeaponSniperZoomlevel", 2)

		    TNT1 A 0 A_ZoomFactor(1.0, ZOOM_INSTANT)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_tracer_prepare", 12, 0)

            // Modern variant
            //TNT1 A 0 A_FireBullets(1, 1, 1, 200 + random(-1, 1) * 40, "ZH2WeaponBulletPuff", FBF_NORANDOM)
            
            // legacy variant
            //TNT1 A 0 A_FireBullets(1, 1, 1, 125, "ZH2WeaponBulletPuff", FBF_NORANDOM)

            // Flat damage increase to put it more in like with the modern sniper.
            // Slightly higher than normal given it also fires slower than the modern sniper.
            TNT1 A 0 A_FireBullets(1, 1, 1, 260, "ZH2WeaponBulletPuff", FBF_NORANDOM)

            SNPR B 2 bright
            SNPR C 7
            SNPR D 7

            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfiring_server", 0, false)
            TNT1 A 0 A_ClientsideACSExecute("zh2_dec_setfiring_client", false)
            goto SniperBolt

        SniperBolt:
            TNT1 A 0 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
            SNPR E 20
            TNT1 A 0 A_TakeInventory("ZH2WeaponSniperBolting", 1)
            SNPR O 5 A_PlaySoundEx("weapons/sniper/legacy/BOLT","SoundSlot5")
            SNPR Q 5
            SNPR U 5
            SNPS F 5
            SNPR G 5
            goto Ready
    }
}
