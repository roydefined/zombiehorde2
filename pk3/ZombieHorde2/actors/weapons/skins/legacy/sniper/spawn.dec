actor ZH2WeaponSniperSpawnLegacy : ZH2WeaponSpawn
{
    inventory.PickupMessage "Sniper rifle"
    tag "Sniper rifle"

    states
    {
        Spawn:
            WSNP A -1
            stop

        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "PickupSuccess")
            stop
        PickupSuccess:
            TNT1 A 0 A_GiveInventory("ZH2WeaponSniperLegacy", 1)
            stop
    }
}
