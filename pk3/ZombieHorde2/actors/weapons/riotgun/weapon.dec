actor ZH2WeaponRiotGun : ZH2WeaponSpawn
{
    tag "Riot gun"

    states
    {
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, "CheckSkin")
            fail
        CheckSkin:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getweaponskin", 0, 0, 0) == 1, "GiveLegacy")
            TNT1 A 0 A_GiveInventory("ZH2WeaponRiotGunDefault", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponRiotGunAmmoTotal", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponRiotGunAmmoCurrent", 12)
            stop
        GiveLegacy:
            TNT1 A 0 A_GiveInventory("ZH2WeaponRiotGunLegacy", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponRiotGunAmmoTotal", 1)
            TNT1 A 0 A_GiveInventory("ZH2WeaponRiotGunAmmoCurrent", 12)
            stop
    }
}
