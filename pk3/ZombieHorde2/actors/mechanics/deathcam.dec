// ACS spawns this camera on death.
actor ZH2DeathCam
{
    Height 1
    Radius 1
    Mass 1
    CameraHeight 1
    ReactionTime 140 //35 * 4

    -SOLID
    +THRUACTORS
    +NOBLOCKMAP
    +NOGRAVITY
    +DONTSPLASH
    +CLIENTSIDEONLY

    states
    {
        spawn:
            TNT1 A 0 NoDelay A_SetPitch(20)
            TNT1 A 1 A_CountDown
            wait

        death:
            TNT1 A 0 A_Stop
            TNT1 A -1
            stop
    }
}
