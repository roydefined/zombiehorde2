// ACS spawns this when the player joins the game, and removes it when the player leaves or dies.
actor ZH2TeamIndicator
{
    Height 1
    Radius 1
    Alpha 0
	
    -SOLID
    +THRUACTORS
    +NOBLOCKMAP
    +NOGRAVITY
    +DONTSPLASH
	+CLIENTSIDEONLY
	
    states
    {
		spawn:
			TEAM A 1
			wait
		
		spawn.ally:
			TEAM B 1
			wait
		
		spawn.enemy:
			TEAM C 1
			wait
    }
}
