Actor ZH2WeaponRiotGunSmoke : ZH2WeaponSmokeSpawnerInternal
{
    States
    {
        Spawn.Regular:
            TNT1 AAAA 0 A_SpawnItemEx("ZH2WeaponSmokeInternal1", 0, Random(-2, 2), Random(-2, 2),0, Random(-3, 3), Random(-3, 3))
            Stop

        Spawn.Underwater:
            TNT1 AAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2WeaponBubble", 0, 0, 0, 0, FRandom(-0.2, 0.2), FRandom(-0.5, 0.5), FRandom(0, 360.0))
            Stop
    }
}

Actor ZH2WeaponRiotGunReloadSmoke : ZH2WeaponSmokeSpawnerInternal
{
    Scale 0.8
    Alpha 0.1

    States
    {
        Spawn.Regular:
            TNT1 A 0 A_SpawnItemEx("ZH2WeaponSmokeInternal1", 0, Random(-2, 2), Random(-2, 2),0, Random(-3, 3), Random(-3, 3))
            Stop

        Spawn.Underwater:
            TNT1 A 0 A_SpawnItemEx("ZH2WeaponBubble", Random(-4, 4), Random(-4, 4), 0, 0, FRandom(-0.2, 0.2), FRandom(-0.5, 0.5), FRandom(0, 360.0))
            Stop
    }
}

Actor ZH2WeaponRiotGunFlash
{
    +NOINTERACTION
    +CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	+BRIGHT

    Speed 60
    Scale 0.4
    Alpha 0.8

    States
    {
        Spawn:
            TNT1 A 1
            TNT1 A 0 A_Stop
            TNT1 A 0 A_SetScale(ScaleX * FRandom(0.95, 0.99), ScaleY * FRandom(0.95, 0.99))
            TNT1 A 0 A_Jump(256, 1, 2, 3, 4)
			WFLS A 0
            Goto Spawn.Rest
			WFLS B 0
            Goto Spawn.Rest
			WFLS C 0
            Goto Spawn.Rest
			WFLS D 0
            Goto Spawn.Rest
		Spawn.Rest:
			WFLS "#" 1 A_FadeOut(0.2)
			wait
    }
}