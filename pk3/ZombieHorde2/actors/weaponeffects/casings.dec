const int MAXBOUNCECOUNT = 4;

actor ZH2WeaponCaseInternal
{
    speed 20
    +NOCLIP
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
}

actor ZH2ShotgunCase : ZH2WeaponCaseInternal
{
    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_CustomMissile("ZH2ShellCaseParticle", 0, 0, random(-80, -100), CMF_AIMDIRECTION, random(30, 50))
            stop
    }
}

actor ZH2DoubleShotgunCase : ZH2WeaponCaseInternal
{
    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_CustomMissile("ZH2ShellCaseParticle", 0, 0, random(-80,-100), 275, random(60, 90))
            stop
    }
}

actor ZH2ChaingunCase : ZH2WeaponCaseInternal
{
    States
    {
        Spawn:
