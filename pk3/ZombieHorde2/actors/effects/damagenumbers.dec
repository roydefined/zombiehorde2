actor ZH2NumberEffect
{
	radius 0
	height 0
	mass 0
 
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	+MISSILE
	+NOGRAVITY
	+NOTELEPORT
	+NOINTERACTION
	+NOCLIP
	+NOBLOCKMAP
	+NOTIMEFREEZE
	+THRUACTORS
	+DONTSPLASH
}

// The numbers follow the master actor.
actor ZH2DamageNumberMaster : ZH2NumberEffect
{
	states
	{
		spawn:
			TNT1 A 1
			loop
	}
}

// Each number is drawn using this actor.
// Args[0] indicates the number to draw.
actor ZH2DamageNumber : ZH2NumberEffect
{
	scale 0.30
	
	states
	{
		spawn:
			TNT1 A 0 nodelay A_JumpIf(args[0] == 0, "spawn.rest")
			TNT1 B 0 A_JumpIf(args[0] == 1, "spawn.rest")
			TNT1 C 0 A_JumpIf(args[0] == 2, "spawn.rest")
			TNT1 D 0 A_JumpIf(args[0] == 3, "spawn.rest")
			TNT1 E 0 A_JumpIf(args[0] == 4, "spawn.rest")
			TNT1 F 0 A_JumpIf(args[0] == 5, "spawn.rest")
			TNT1 G 0 A_JumpIf(args[0] == 6, "spawn.rest")
			TNT1 H 0 A_JumpIf(args[0] == 7, "spawn.rest")
			TNT1 I 0 A_JumpIf(args[0] == 8, "spawn.rest")
			TNT1 J 0
			
		spawn.rest:
			DNUM "#" 1
			goto spawn
	}
}
