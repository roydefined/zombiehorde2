OptionValue "DamageFeedbackMarkerShowType"
{
    0, "Show none"
    1, "Show hits"
    2, "Show kills"
    3, "Show both"
}

OptionValue "DamageFeedbackCounterShowType"
{
    0, "Show none"
    1, "Show damage"
    2, "Show kills"
    3, "Show both"
}

OptionValue "DamageFeedbackNumberShowType"
{
    0, "Show none"
    1, "Show total damage"
    2, "Show individual damage"
}

OptionValue "IdentifyPlayerSpecieType"
{
    0, "Off"
    1, "All species"
    2, "Only same species"
    3, "Only other species"
}

OptionValue "IdentifyPlayerType"
{
    0, "Show both"
    1, "Show name"
    2, "Show specie"
}

OptionMenu "ZH2PlayerMenu"
{
    Title "Player"
    StaticText " "
    StaticText " "

    StaticText "Inventory - visual", 1
    Slider "Shown items", "cl_zh2_showninventoryitems", 1.0, 11.0, 1.0
    Option "Wrap items", "cl_zh2_wrapinventoryitems", "YesNo"

    StaticText " "

    StaticText "Inventory - auto use", 1
    Option "Auto use medikits", "cl_zh2_autousemedikits", "YesNo"
    Option "Auto use kevlar suits", "cl_zh2_autousekevlars", "YesNo"
    Option "Auto use energy drinks", "cl_zh2_autouseenergydrinks", "YesNo"

    StaticText " "
	
    StaticText "Identify players", 1
    Option "Enable serverside", "sv_zh2_identifyplayers", "YesNo"
    Option "Enable clientside", "cl_zh2_identifyplayers", "IdentifyPlayerSpecieType"
    Option "Identify type", "cl_zh2_identifyplayertype", "IdentifyPlayerType"

    StaticText " "
	
    StaticText "Translucent allies", 1
    Option "Enable globally", "sv_zh2_translucentallies", "YesNo"
    Option "Enable clientside", "cl_zh2_translucentallies", "TranslucentType"
    Slider "Fade distance", "cl_zh2_translucentalliesdistance", 100, 1000, 1
    Slider "Base translucency", "cl_zh2_baseallytranslucency", 30, 100, 1

    StaticText " "

    StaticText "Team indicators", 1
    Option "Enable globally", "sv_zh2_teamindicators", "YesNo"
    Option "Enable clientside", "cl_zh2_teamindicators", "YesNo"
    Slider "Team indicator distance", "cl_zh2_teamindicatordistance", 128, 1000, 1
    Option "Show target team indicators", "cl_zh2_showtargetteamindicator", "YesNo"

    StaticText " "

    StaticText "Damage feedback - global toggle", 1
    Option "Enable globally", "sv_zh2_enabledamagefeedback", "YesNo"
    Option "Enable clientside", "cl_zh2_enabledamagefeedback", "YesNo"

    StaticText " "
	
    StaticText "Damage feedback - sounds", 1
    Option "Play sound on hit/kill", "cl_zh2_enabledamagefeedbacksounds", "YesNo"

    StaticText " "
	
    StaticText "Damage feedback - HUD features", 1
    Option "Show markers clientside", "cl_zh2_enabledamagefeedbackmarkers", "DamageFeedbackMarkerShowType"
    Slider "Hit marker shown tics", "cl_zh2_damagefeedbackhitmarkershowntics", 10, 120, 10
    Slider "Kill marker shown tics", "cl_zh2_damagefeedbackkillmarkershowntics", 10, 120, 10

    Option "Show counters clientside", "cl_zh2_enabledamagefeedbackcounters", "DamageFeedbackCounterShowType"
    Slider "Damage counter shown tics", "cl_zh2_damagefeedbackdamagecountershowntics", 10, 120, 10
    Slider "Kill counter shown tics", "cl_zh2_damagefeedbackkillcountershowntics", 10, 120, 10

    StaticText " "
	
    StaticText "Damage feedback - actor features", 1
    Option "Show damage numbers clientside", "cl_zh2_enabledamagefeedbacknumbers", "DamageFeedbackNumberShowType"
    Slider "Visual damage effect cap", "cl_zh2_damagefeedbackratiodamagecap", 10, 2000, 10
    Slider "Yellow damage numbers threshold", "cl_zh2_damagefeedbackyellowdamagenumberthreshold", 10, 1990, 10
    Slider "Red damage numbers threshold", "cl_zh2_damagefeedbackreddamagenumberthreshold", 20, 2000, 10

    StaticText " "

    StaticText "Music", 1
    Command "Play default map music", "pukename zh2_action_music_playdefault"
    Option "Ignore radio music", "cl_zh2_ignoreradiomusic", "YesNo"
    Option "Ignore full server music", "cl_zh2_ignorefullservermusic", "YesNo"

    StaticText " "

    StaticText "Zombie", 1
    Option "Allow zombie teleports", "sv_zh2_allowzombieteleporting", "YesNo"
    Option "Allow moving when teleporting", "sv_zh2_allowmovingwhenzombieteleporting", "YesNo"
    Slider "Max allowed zombie teleports", "sv_zh2_maxzombieteleports", 1, 10, 1
    Slider "Zombie teleport countdown", "sv_zh2_zombieteleportseconds", 1, 20, 1
    StaticText " "
    Option "Use zombie abilities", "sv_zh2_usezombieabilities", "YesNo"
    Option "Use zombie ability cooldowns", "sv_zh2_usezombieabilitycooldowns", "YesNo"
    StaticText " "
    Option "Drop grenade on infect", "sv_zh2_dropgrenadeoninfect", "DropNadeOnInfect"
    StaticText " "
    Option "Enable random zombie taunting", "sv_zh2_allowrandomzombietaunts", "YesNo"
    StaticText " "
    StaticText "CVar sv_zh2_disabledzombieabilityflags is a bitflag."
    StaticText "Use it to disable individual abilities."

    StaticText " "

    StaticText "Human", 1
    Option "Enable final human heartbeat", "cl_zh2_enablefinalheartbeat", "YesNo"
    Option "Enable hurt heartbeat", "cl_zh2_enablehurtheartbeat", "YesNo"
	StaticText " "
    Option "Flare colour", "cl_zh2_flaretype", "FlareType"
	StaticText " "
    Option "Enable blood", "sv_zh2_enableblood", "YesNo"
    Option "Blood type", "cl_zh2_bloodtype", "ClientLocalityType"
	StaticText " "
    Option "Allow players to sprint", "sv_zh2_allowsprinting", "YesNo"
    Slider "Minimum sprint energy", "sv_zh2_minimumsprintamount", 1, 1000, 1
	StaticText " "
    Option "Allow players to panic", "sv_zh2_allowpanicking", "YesNo"
    Slider "Max. no. of panic", "sv_zh2_maxpaniccount", 1, 10, 1
	
    StaticText " "
	
    StaticText "Features", 1
    Option "Remove software textures", "cl_zh2_removesoftwaretextures", "YesNo"
}