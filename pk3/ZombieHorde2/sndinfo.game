menuopen "sounds/game/menuopen.ogg"
menuclose "sounds/game/menuclose.ogg"
menupress "sounds/game/menupress.ogg"
menunavigate "sounds/game/menunavigate.ogg"

game/MAPPICK "sounds/game/mappick.ogg"

$alias menu/activate menuopen
$alias menu/backup     menunavigate
$alias menu/prompt     menunavigate
$alias menu/cursor     "sound/null"
$alias menu/change     menupress
$alias menu/invalid     "sound/null"
$alias menu/dismiss     menuclose
$alias menu/choose     menunavigate
$alias menu/clear     menuclose
$alias menu/advance  menunavigate

$alias menu/quit1 "sound/null"
$alias menu/quit2 menu/quit1