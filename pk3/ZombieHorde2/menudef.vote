OptionMenu "ZH2CallVoteMenu"
{
    Title "Call a vote"
    NetGameOnly

    StaticText " "

    StaticText "Round", 1
    SubMenu "End the round", "ZH2CallEndRoundVoteMenu"
    SubMenu "Restart the map", "ZH2CallRestartMapVoteMenu"
    SubMenu "Extend the round time", "ZH2CallExtendTimeVoteMenu"

    StaticText " "

    StaticText "Map", 1
    SubMenu "Change the map", "ZA_CallMapVote"
    SubMenu "Go to the next map", "ZA_CallNextMapVote"
    SubMenu "Reset the current map", "ZA_CallResetMapVote"

    StaticText " "

    StaticText "Players", 1
    SubMenu "Kick a player", "ZA_CallKickVote"

    StaticText " "

    StaticText "Server", 1
    SubMenu "Change a limit", "ZA_CallLimitVote"
    SubMenu "Change a flag", "ZA_CallFlagVote"
}

OptionMenu "ZH2CallExtendTimeVoteMenu"
{
    Title "Extend the round time"
    NetGameOnly

    Slider "Seconds to add", "menu_callvotevalue", 30, 300, 10
    StaticText " "
    TextField "Reason", "menu_callvotereason"
    Command "Vote!", "zh2menu_callextendtimevote"
}

OptionMenu "ZH2CallEndRoundVoteMenu"
{
    Title "End the round"
    NetGameOnly

    TextField "Reason", "menu_callvotereason"
    Command "Vote!", "zh2menu_callendroundvote"
}

OptionMenu "ZH2CallRestartMapVoteMenu"
{
    Title "Restart the map"
    NetGameOnly

    TextField "Reason", "menu_callvotereason"
    Command "Vote!", "zh2menu_callrestartmapvote"
}
