OptionMenu "ZH2CallVoteMenu"
{
    Title "Call a vote"
    NetGameOnly

    StaticText " "

    StaticText "Round", 1
    Command "End the round", "callvote endround"
    Command "Restart the map", "callvote restartmap"
    SubMenu "Extend the round time", "ZH2CallExtendTimeVoteMenu"

    StaticText " "

    StaticText "Map", 1
    SubMenu "Change the map", "ZA_CallMapVote"
    SubMenu "Go to the next map", "ZA_CallNextMapVote"
    SubMenu "Reset the current map", "ZA_CallResetMapVote"

    StaticText " "

    StaticText "Players", 1
    SubMenu "Kick a player", "ZA_CallKickVote"

    StaticText " "

    StaticText "Server", 1
    SubMenu "Change a limit", "ZA_CallLimitVote"
    SubMenu "Change a flag", "ZA_CallFlagVote"
}

OptionMenu "ZH2CallExtendTimeVoteMenu"
{
    Title "Extend the round time"
    NetGameOnly

    Slider "Seconds to add", "__client_callvote_extendtime", 30, 300, 10
    StaticText " "
    Command "Vote!", "callvote extendtime $__client_callvote_extendtime"
}
