// The arrow ping (ZH2PingTarget): its wheel graphic, and sprites for the arrow alone and for what it targets.
// The arrow itself comes from the library's ping graphics.

Sprite "PNGTA0", 22, 36
{
	Offset 11, 36
	Patch "GRAPHICS/HUD/PING/HUMAN.PNG", 0, 0
	Patch "GRAPHICS/PING/ARROW.PNG", 3, 19
}

Sprite "PNGTB0", 17, 37
{
	Offset 8, 37
	Patch "GRAPHICS/HUD/PING/ZOMBIE.PNG", 0, 0
	Patch "GRAPHICS/PING/ARROW.PNG", 1, 20
}

Graphic "PINGARRW", 15, 17
{
	Patch "GRAPHICS/PING/ARROW.PNG", 0, 0
}

Sprite "PNGMF0", 15, 17
{
	Offset 7, 17
	Patch "GRAPHICS/PING/ARROW.PNG", 0, 0
}
