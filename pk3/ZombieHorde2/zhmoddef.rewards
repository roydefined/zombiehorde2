// Reward weights are based on Zombie Horde 1's chance between items.

Rewards
{
    // Minor reward items always have a chance to give nothing or something bad.
    Container "OrbMinor"
    {
        // TODO: merge same rewards, just different by specie
        Reward "nothing"
        {
            Weight 5
            HumanOnly,
            LocalMessage "Nothing inside!",
        },
        Reward "nothing"
        {
            Weight 10,
            ZombieOnly,
            LocalMessage "Nothing inside!",
        },
        
        Reward "Fatigue"
        {
            Weight 5,
            HumanOnly,
            CallGive "zh2_internal_reward_givefatigue",
            CallRestrict "zh2_internal_reward_restrictfatigue"
            LocalMessage "\cgTiredness! \cgYou will run slower for 60 seconds!",
            Message "\cjUnlucky %p \cjhas received \cgTiredness!",
        },
        
        Reward "Vulnerability"
        {
            Weight 10,
            ZombieOnly,
            CallGive "zh2_internal_reward_givevulnerability",
            CallRestrict "zh2_internal_reward_restrictvulnerability"
            LocalMessage "\cgVulnerability!",
            Message "\cjUnlucky %p \cjhas received \cgvulnerability!",
        },
    },
    
