    // HACK: Can't use `static str` here due to a compiler bug.
    str weatherTypes[] = { "debug", "debugsky", "debugnosky", "rain", "snow" };
    internal int WeatherTypeToIndex(str weatherType)
    {
        for (int i = 0; i < 5; ++i)
        {
            if (BCSUTILS::StrIEquals(weatherType, weatherTypes[i]))
                return i;
        }

        return -1;
    }

    // HACK: Same as above. Compiler bug.
    str weatherSkyBehaviorTypes[] = { "none", "requiresky", "requirenosky" };
    internal int WeatherSkyBehaviorToIndex(str skyBehavior)
    {
        for (int i = 0; i < 5; ++i)
        {
            if (BCSUTILS::StrIEquals(skyBehavior, weatherSkyBehaviorTypes[i]))
                return i;
        }

        return -1;
    }
}