#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace LibIO
{
    internal bool ParseEmitterWeatherBlock(int handle, str identifyingSymbol, bool setPersisting)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "emitterweather"))
            return false;

        Tokenizer::Next(handle, false);

        if (Tokenizer::GetToken(handle) != Tokenizer::TSTRING)
        {
            Tokenizer::SetErrored(handle, "Invalid symbol for weather type whilst parsing emitter weather: '" + Tokenizer::GetSymbol(handle) + "'. Symbol should be of type string.");
            return false;
        }

        str weatherType = Tokenizer::GetSymbol(handle);
        int index = WeatherTypeToIndex(weatherType);

        if (_parsedEmitterWeatherContext.Index == -1)
        {
            Tokenizer::SetErrored(handle, "Invalid weather type provided whilst parsing emitter weather: '" + Tokenizer::GetSymbol(handle) + "'.");
            return false;
        }

        _parsedEmitterWeatherContext.Index = index;

        // If `setPersisting` is false we want to provide the values that are currently set for the current transient info we have.
        // This is useful for mappers to set only part of the new values.
        if (!setPersisting)
        {
            _parsedEmitterWeatherContext.Enabled = Weather::GetEmitterWeatherEnabled(index);
            _parsedEmitterWeatherContext.SkyBehavior = Weather::GetEmitterWeatherSkyBehavior(index);
            _parsedEmitterWeatherContext.SpawnCount = Weather::GetEmitterWeatherSpawnCount(index);
            _parsedEmitterWeatherContext.SpawnDelay = Weather::GetEmitterWeatherSpawnDelay(index);
            _parsedEmitterWeatherContext.MinRadius = Weather::GetEmitterWeatherMinRadius(index);
            _parsedEmitterWeatherContext.MaxRadius = Weather::GetEmitterWeatherMaxRadius(index);
            _parsedEmitterWeatherContext.MinZpos = Weather::GetEmitterWeatherMinZpos(index);
            _parsedEmitterWeatherContext.MaxZpos = Weather::GetEmitterWeatherMaxZpos(index);
        }
        else
        {
            _parsedEmitterWeatherContext.Enabled = false;
            _parsedEmitterWeatherContext.SkyBehavior = Weather::EMITTERWEATHER_SKYBEHAVIOUR_UNKNOWN;
            _parsedEmitterWeatherContext.SpawnCount = 0;
            _parsedEmitterWeatherContext.SpawnDelay = 0;
            _parsedEmitterWeatherContext.MinRadius = 0;
            _parsedEmitterWeatherContext.MaxRadius = 0;
            _parsedEmitterWeatherContext.MinZpos = 0;
            _parsedEmitterWeatherContext.MaxZpos = 0;
        }

        int braceLevel = Tokenizer::GetBraceLevel(handle);
        if (!Tokenizer::ExpectNextChar(handle, '{'))
            return false;

        Tokenizer::Next(handle);

        // While the brace level does not match the end level, we keep parsing.
        while (Tokenizer::CanRead(handle) && Tokenizer::GetBraceLevel(handle) != braceLevel)
        {
            str symbol = Tokenizer::GetSymbol(handle);
            if (ParseEmitterWeatherBlockEnabled(handle, symbol)
                || ParseEmitterWeatherBlockSkyBehavior(handle, symbol)
                || ParseEmitterWeatherBlockSpawnCount(handle, symbol)
                || ParseEmitterWeatherBlockSpawnDelay(handle, symbol)
                || ParseEmitterWeatherBlockMinRadius(handle, symbol)
                || ParseEmitterWeatherBlockMaxRadius(handle, symbol)
                || ParseEmitterWeatherBlockMinZpos(handle, symbol)
                || ParseEmitterWeatherBlockMaxZpos(handle, symbol))
            {
                // Optional comma.
                Tokenizer::Next(handle, false);
                if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
                    Tokenizer::Next(handle, false);
                continue;
            }

            Tokenizer::SetErrored(handle, "Unknown symbol whilst parsing default weather profiles: '" + symbol + "'.");
            return false;
        }

        // Optional comma.
        Tokenizer::Next(handle, false);
        if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
            Tokenizer::Next(handle, false);

        Logger::LogDebug(LOGSOURCE, "New emitter weather parsed under index \cd" + str(_parsedEmitterWeatherContext.Index) + "\cj.");
        return true;
    }

    internal bool ParseEmitterWeatherBlockEnabled(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "enabled"))
            return false;

        if (!Tokenizer::ExpectNextToken(handle, Tokenizer::TEQ))
            return false;

        Tokenizer::Next(handle);

        if (!Tokenizer::TryParseBooleanOrNumbericValue(handle))
        {
            Tokenizer::SetErrored(handle, "The given value for Enabled is not a correct value. Expected boolean or numeric value within bounds.");
            return false;
        }

        int parsedValue = (int)Tokenizer::GetParsedValue();
        bool value = parsedValue != 0;
        _parsedEmitterWeatherContext.Enabled = value;

        Logger::LogDebug(LOGSOURCE, "Parsed IsEnabled: \cd" + str(value) + "\cj.");
        return true;
    }

    internal bool ParseEmitterWeatherBlockSkyBehavior(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "skybehavior"))
            return false;

        if (!Tokenizer::ExpectNextToken(handle, Tokenizer::TEQ))
            return false;

        Tokenizer::Next(handle);
        str symbol = Tokenizer::GetSymbol(handle);

        int index = WeatherSkyBehaviorToIndex(symbol);

        if (index == -1)
        {
            Tokenizer::SetErrored(handle, "The given value for SkyBehavior is not a correct value. The value " + symbol + " does not map to a known type.");
            return false;
        }

        Weather::EmitterWeatherSkyBehaviorT value = Weather::GetEmitterWeatherSkyBehaviorByIndex(index);
        _parsedEmitterWeatherContext.SkyBehavior = value;

        Logger::LogDebug(LOGSOURCE, "Parsed SkyBehavior: \cd" + str(value) + "\cj.");
        return true;
    }

    internal bool ParseEmitterWeatherBlockSpawnCount(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "spawncount"))
            return false;

        if (!Tokenizer::ExpectNextToken(handle, Tokenizer::TEQ))
            return false;

        Tokenizer::Next(handle);

        if (!Tokenizer::TryParseIntValue(handle))
        {
            Tokenizer::SetErrored(handle, "The given value for SpawnCount is not a correct value. Expected a valid numeric value within bounds.");
            return false;
        }

        int parsedValue = (int)Tokenizer::GetParsedValue();
        _parsedEmitterWeatherContext.SpawnCount = parsedValue;

        Logger::LogDebug(LOGSOURCE, "Parsed SpawnCount: \cd" + str(parsedValue) + "\cj.");
        return true;
    }

