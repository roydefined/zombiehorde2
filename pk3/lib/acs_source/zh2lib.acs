#define LOGSOURCE "ZH2Lib"

strict namespace ZH2Lib
{
    void ResetPlayerLibContext(int id)
    {
        Logger::LogDebug(LOGSOURCE, "Resetting player lib context for player " + str(id) + ".");

        static LibPlayerT emptyPlayerDef;
        if (!Memcpy(LibContext.Players[id], emptyPlayerDef))
            Logger::LogError(LOGSOURCE, "Failed to empty player lib context for player " + str(id) + ".");
    }
}

#undef LOGSOURCE 
