#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Weather
{
    #define AMBIENTWEATHER_RING_BASETID 30000

    #define AMBIENTWEATHER_SPOTCOUNT 10

    #define AMBIENTWEATHER_RING_ACTOR "DebugDropAmbient"
    //#define AMBIENTWEATHER_RING_ACTOR "MapSpot"

    // For debugging, when `true` we change the color of a spot when sheltered.
    // For this we must use the debug drops.
    internal bool _debugColorShelteredSpots = true;

    internal void InitializeAmbientWeatherClient()
    {
        // Near ring
        for (int i = 0; i < AMBIENTWEATHER_SPOTCOUNT; ++i)
        {
            int tid = GetAmbientWeatherNearRingTid(i);
            SpawnForced(AMBIENTWEATHER_RING_ACTOR, 0.0, 0.0, 0.0, tid, 0);
        }

        // Far ring
        for (int i = 0; i < AMBIENTWEATHER_SPOTCOUNT; ++i)
        {
            int tid = GetAmbientWeatherFarRingTid(i);
            SpawnForced(AMBIENTWEATHER_RING_ACTOR, 0.0, 0.0, 0.0, tid, 0);
        }
    }

    // NOTE: This could use performance improvements if we get rid of the debugging.
    internal void TicAmbientWeather(int sourceTid)
    {
        for (int i = 0; i < AMBIENTWEATHER_COUNT; ++i)
        {
            if (!GetTransientAmbientWeatherEnabled(i))
                continue;

            // All of this runs now for the debugging.
            UpdateAmbientWeatherRingPositions(sourceTid, i);

            str sound = GetTransientAmbientWeatherSound(i);
            str shelteredSound = GetTransientAmbientWeatherShelteredSound(i);

            int nearSkyCount = CountRingSkyCeilings(true);
            int farSkyCount  = CountRingSkyCeilings(false);

            // Don't play this tic.
            if (GetTransientAmbientWeatherNextPlayTic(i) > Timer())
                continue;

            if (nearSkyCount > 0 && sound != (raw)0 && sound != "")
            {
                LocalAmbientSound(sound, 255);
            }
            else if (farSkyCount > 0 && shelteredSound != (raw)0 && shelteredSound != "")
            {
                LocalAmbientSound(shelteredSound, 255);
            }

            int delay = GetTransientAmbientWeatherDelay(i);
            SetTransientAmbientWeatherNextPlayTic(i, Timer() + delay);
        }
    }

    internal int GetAmbientWeatherNearRingTid(int spot)
    {
        return AMBIENTWEATHER_RING_BASETID + spot;
    }

    internal int GetAmbientWeatherFarRingTid(int spot)
    {
        return AMBIENTWEATHER_RING_BASETID + AMBIENTWEATHER_SPOTCOUNT + spot;
    }

    internal void UpdateAmbientWeatherRingPositions(int sourceTid, int index)
    {
        fixed sourceX = GetActorX(sourceTid);
        fixed sourceY = GetActorY(sourceTid);
        fixed sourceZ = GetActorZ(sourceTid) + GetActorViewHeight(sourceTid);

        fixed radius = fixed(GetTransientAmbientWeatherRadius(index));
        fixed shelteredRadius = fixed(GetTransientAmbientWeatherShelteredRadius(index));

        // Near ring
        for (int i = 0; i < AMBIENTWEATHER_SPOTCOUNT; ++i)
        {
            int tid = GetAmbientWeatherNearRingTid(i);

            fixed angle = fixed(i) / fixed(AMBIENTWEATHER_SPOTCOUNT);

            fixed x = sourceX + cos(angle) * radius;
            fixed y = sourceY + sin(angle) * radius;

            SetActorPosition(tid, x, y, sourceZ, false);
        }

        // Far ring
        for (int i = 0; i < AMBIENTWEATHER_SPOTCOUNT; ++i)
        {
            int tid = GetAmbientWeatherFarRingTid(i);

            fixed angle = fixed(i) / fixed(AMBIENTWEATHER_SPOTCOUNT);

            fixed x = sourceX + cos(angle) * shelteredRadius;
            fixed y = sourceY + sin(angle) * shelteredRadius;

            SetActorPosition(tid, x, y, sourceZ, false);
        }
    }

    internal int CountRingSkyCeilings(bool near)
    {
        int count = 0;
        for (int i = 0; i < AMBIENTWEATHER_SPOTCOUNT; ++i)
        {
            int tid = near
                ? GetAmbientWeatherNearRingTid(i)
                : GetAmbientWeatherFarRingTid(i);

            bool hasSkyCeiling = CheckActorCeilingTexture(tid, "F_SKY1");
            count += (int)hasSkyCeiling;

            if (_debugColorShelteredSpots)
                SetThingSpecial(tid, 0, hasSkyCeiling);
        }

        return count;
    }

    // Transient context
    internal bool GetTransientAmbientWeatherEnabled(int index) { return ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Enabled; }
    internal void SetTransientAmbientWeatherEnabled(int index, bool value) { ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Enabled = value; }
    internal str GetTransientAmbientWeatherSound(int index) { return ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Sound; }
    internal void SetTransientAmbientWeatherSound(int index, str value) { ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Sound = value; }
    internal str GetTransientAmbientWeatherShelteredSound(int index) { return ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredSound; }
    internal void SetTransientAmbientWeatherShelteredSound(int index, str value) { ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredSound = value; }
    internal int GetTransientAmbientWeatherRadius(int index) { return ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Radius; }
    internal void SetTransientAmbientWeatherRadius(int index, int value) { ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Radius = value; }
    internal int GetTransientAmbientWeatherShelteredRadius(int index) { return ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredRadius; }
    internal void SetTransientAmbientWeatherShelteredRadius(int index, int value) { ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredRadius = value; }
    internal int GetTransientAmbientWeatherDelay(int index) { return ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Delay; }
    internal void SetTransientAmbientWeatherDelay(int index, int value) { ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].Delay = value; }
    internal int GetTransientAmbientWeatherNextPlayTic(int index) { return ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].NextPlayTic; }
    internal void SetTransientAmbientWeatherNextPlayTic(int index, int value) { ZH2Lib::LibContext.WeatherContext.AmbientWeatherCollection[index].NextPlayTic = value; }

    // Persisting context
    internal bool GetPersistingAmbientWeatherEnabled(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Enabled; }
    internal void SetPersistingAmbientWeatherEnabled(int index, bool value) { ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Enabled = value; }
    internal str GetPersistingAmbientWeatherSound(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Sound; }
    internal void SetPersistingAmbientWeatherSound(int index, str value) { ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Sound = value; }
    internal str GetPersistingAmbientWeatherShelteredSound(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredSound; }
    internal void SetPersistingAmbientWeatherShelteredSound(int index, str value) { ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredSound = value; }
    internal int GetPersistingAmbientWeatherRadius(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Radius; }
    internal void SetPersistingAmbientWeatherRadius(int index, int value) { ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Radius = value; }
    internal int GetPersistingAmbientWeatherShelteredRadius(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredRadius; }
    internal void SetPersistingAmbientWeatherShelteredRadius(int index, int value) { ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].ShelteredRadius = value; }
    internal int GetPersistingAmbientWeatherDelay(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Delay; }
    internal void SetPersistingAmbientWeatherDelay(int index, int value) { ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].Delay = value; }
    internal int GetPersistingAmbientWeatherNextPlayTic(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].NextPlayTic; }
    internal void SetPersistingAmbientWeatherNextPlayTic(int index, int value) { ZH2Lib::PersistingLibContext.WeatherContext.AmbientWeatherCollection[index].NextPlayTic = value; }
}