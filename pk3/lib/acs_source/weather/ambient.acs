        return ZH2Lib::LibContext.WeatherContext.TargetShelteredSoundVolume[arrayIndex];
    }

    internal void SetTransientAmbientWeatherTargetShelteredSoundVolume(int index, int spot, fixed value)
    {
        int arrayIndex = GetAmbientWeatherSoundVolumeArrayIndex(index, spot);
        ZH2Lib::LibContext.WeatherContext.TargetShelteredSoundVolume[arrayIndex] = value;
    }

    // Transient context sound active state
    internal bool GetTransientAmbientWeatherSoundActive(int index, int spot)
    {
        int arrayIndex = GetAmbientWeatherSoundVolumeArrayIndex(index, spot);
        return ZH2Lib::LibContext.WeatherContext.SoundActive[arrayIndex];
    }

    internal void SetTransientAmbientWeatherSoundActive(int index, int spot, bool value)
    {
        int arrayIndex = GetAmbientWeatherSoundVolumeArrayIndex(index, spot);
        ZH2Lib::LibContext.WeatherContext.SoundActive[arrayIndex] = value;
    }

    internal bool GetTransientAmbientWeatherShelteredSoundActive(int index, int spot)
    {
        int arrayIndex = GetAmbientWeatherSoundVolumeArrayIndex(index, spot);
        return ZH2Lib::LibContext.WeatherContext.ShelteredSoundActive[arrayIndex];
    }

    internal void SetTransientAmbientWeatherShelteredSoundActive(int index, int spot, bool value)
    {
        int arrayIndex = GetAmbientWeatherSoundVolumeArrayIndex(index, spot);
        ZH2Lib::LibContext.WeatherContext.ShelteredSoundActive[arrayIndex] = value;
    }

    internal int GetAmbientWeatherSoundVolumeArrayIndex(int index, int spot)
    {
        return (index * AMBIENTWEATHER_SPOTCOUNT) + spot;
    }
}