    internal void SetPersistingEmitterWeatherNextSpawnTic(int index, int value) { ZH2Lib::PersistingLibContext.WeatherContext.EmitterWeatherCollection[index].NextSpawnTic = value; }

    internal str GetTransientEmitterWeatherActorByIndex(int index)
    {
        static str actors[] = { "DebugDrop", "DebugDropSky", "DebugDropNoSky", "ZH2WeatherRainDrop", "ZH2WeatherSnowDrop", "ZH2WeatherDustParticle", "ZH2WeatherSparkParticle" };

        if (index < 0 || index >= lengthof(actors))
            return (raw)0;

        return actors[index];
    }

    internal EmitterWeatherSkyBehaviorT GetTransientEmitterWeatherSkyBehaviorByIndex(int index)
    {
        static EmitterWeatherSkyBehaviorT actors[] = { EMITTERWEATHER_SKYBEHAVIOUR_NONE, EMITTERWEATHER_SKYBEHAVIOUR_REQUIRESKY, EMITTERWEATHER_SKYBEHAVIOUR_REQUIRENOSKY, };

        if (index < 0 || index >= lengthof(actors))
            return EMITTERWEATHER_SKYBEHAVIOUR_UNKNOWN;

        return actors[index];
    }
}
