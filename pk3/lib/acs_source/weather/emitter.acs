    internal void SetPersistingEmitterWeatherSkyBehavior(int index, EmitterWeatherSkyBehaviorT value) { ZH2Lib::PersistingLibContext.WeatherContext.EmitterWeatherCollection[index].SkyBehavior = value; }
    internal int GetPersistingEmitterWeatherSpawnCount(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.EmitterWeatherCollection[index].SpawnCount; }
    internal void SetPersistingEmitterWeatherSpawnCount(int index, int value) { ZH2Lib::PersistingLibContext.WeatherContext.EmitterWeatherCollection[index].SpawnCount = value; }
    internal int GetPersistingEmitterWeatherSpawnDelay(int index) { return ZH2Lib::PersistingLibContext.WeatherContext.EmitterWeatherCollection[index].SpawnDelay; }
    internal void SetPersistingEmitterWeatherSpawnDelay(int index, int value) { ZH2Lib::PersistingLibContext.WeatherContext.EmitterWeatherCollection[index].SpawnDelay = value; }
