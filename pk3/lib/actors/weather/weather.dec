actor DebugDropBase
{
    Height 2
    Radius 2
    Scale .5
    Renderstyle Translucent

    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEXYBILLBOARD
    +NOINTERACTION
}

actor DebugDrop : DebugDropBase
{
    States
    {
        Spawn:
            DEBG A 35
            DEBG A 5 A_FadeOut(.08)
            wait
    }
}

actor DebugDropSky : DebugDropBase
{
    States
    {
        Spawn:
            DEBG B 35
            DEBG B 5 A_FadeOut(.08)
            wait
    }
}

actor DebugDropNoSky : DebugDropBase
{
    States
    {
        Spawn:
            DEBG C 35
            DEBG C 5 A_FadeOut(.08)
            wait
    }
}

// Used for ambient weather to debug the position of the spots.
// It changes color depending on if the spot is sheltered.
actor DebugDropAmbient : DebugDropBase
{
    States
    {
        Spawn:
            DEBG A 1 nodelay A_JumpIf(args[0] == true, 1)
            loop
            DEBG B 1
            loop
    }
}

#include "actors/weather/snow.dec"
#include "actors/weather/rain.dec"