actor DebugDropBase
{
	Height 2
	Radius 2
	Scale .5
	Renderstyle Translucent
	
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEXYBILLBOARD
	+NOINTERACTION
}

actor DebugDrop : DebugDropBase 
{
	States
	{
		Spawn:
			DEBG A 35
			DEBG A 5 A_FadeOut(.08)
			wait
	}
}

actor DebugDropSky : DebugDropBase
{
	States
	{
		Spawn:
			DEBG B 35
			DEBG B 5 A_FadeOut(.08)
			wait
	}
}

actor DebugDropNoSky : DebugDropBase
{
	States
	{
		Spawn:
			DEBG C 35
			DEBG C 5 A_FadeOut(.08)
			wait
	}
}

#include "actors/weather/snow.dec"
#include "actors/weather/rain.dec"