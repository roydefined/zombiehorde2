actor ZH2WeaponTracer : FastProjectile
{
	radius 2
	height 2
	
	speed 0 // Handled by acs
	
	MissileType "ZH2WeaponTracerTrail"
	MissileHeight 8
	
	+NOINTERACTION
	+NOTIMEFREEZE
	+DONTSPLASH
	
	states
	{
		Spawn:
			TNT1 A -1
	}
}

actor ZH2WeaponTracerTrail
{
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	
	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_JumpIf(waterlevel > 0, "Spawn.Underwater")
			TNT1 A 0 A_Jump(140, "Spawn.End")
			TNT1 A 0 A_SpawnItem("ZH2TracerSmoke")
			stop
			
		Spawn.Underwater:
			TNT1 A 0 A_Jump(230, "Spawn.End")
			TNT1 A 0 A_SpawnItem("ZH2TracerBubble")
			stop
		
		Spawn.End:
			TNT1 A 0
			stop
	}
}

actor ZH2TracerSmoke
{
	height 1
	radius 1
	
	RenderStyle Add
	
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+ALLOWPARTICLES
	+NOBLOCKMAP
	+NOGRAVITY
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_JumpIf(waterlevel != 0, "Underwater")
			TNT1 A 0 A_SetScale(Frandom(.2, .4), Frandom(.2, .4))
			TNT1 A 0 A_SetTranslucent(FRandom(0.02, 0.05), 1)
			BPUF ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 A_FadeOut(Frandom(.001, .002))
			stop
		
		Underwater:
			TNT1 A 0
			stop
	}
}

actor ZH2TracerBubble
{
	Height 0
	Radius 0
	Mass 0
	Alpha 0.6
	Scale 0.5
	
	+MISSILE
	+NOGRAVITY
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+ALLOWPARTICLES
	+NOBLOCKMAP

	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_ChangeVelocity(velx + FRandom(-0.5, 0.5), vely + FRandom(-0.5, 0.5), velZ + FRandom(0.2, 1.5))
			TNT1 A 0 A_Jump(180, 1)
			goto Spawn.Rest
			TNT1 B 0
		
		Spawn.Rest:
			TNT1 "#" 0 A_ChangeVelocity(0, 0, FRandom(0.01, 0.08))
			BUBL "#" 1 A_JumpIf(waterlevel < 1, 1)
			loop
			TNT1 A 0
			stop
	}
}