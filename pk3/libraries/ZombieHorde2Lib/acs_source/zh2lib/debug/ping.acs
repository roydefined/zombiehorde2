#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Debug
{
    script "zh2_action_debugpingdefinitions" net clientside
    {
        InternalDebugPingDefinitions();
    }

    internal void InternalDebugPingDefinitions()
    {
        Logger::LogActivator(GetPingDefinitionsMessage());
    }

    internal str GetPingDefinitionsMessage()
    {
        int count = Ping::GetPingCount();

        str logMessage;
        buildmsg(logMessage = StrParam())
        {
            Append(s:"Loaded \cd" + str(count) + "\cj pings.");

            for (int i = 0; i < count; ++i)
            {
                str graphic = Ping::GetPingGraphic(i);
                str actor = Ping::GetPingActor(i);

                Append(s:"\n\cd" + Ping::GetPingName(i) + "\cj");
                if ((raw)graphic != 0 && graphic != "") Append(s:", graphic: \cd" + graphic + "\cj");
                if ((raw)actor != 0 && actor != "") Append(s:", actor: \cd" + actor + "\cj");
                Append(s:".");
            }
        }

        return logMessage;
    }
}
