#ifdef __IMPORTED__
    #error This file must be #included.
#endif

#define LOGSOURCE "Ping"

#include "spawn.acs"
#include "cooldown.acs"

strict namespace Ping
{
    void TicServer()
    {
        CooldownTic();
    }

    void TicClient(bool canPing)
    {
        if (!canPing && GetPingWheelOpen())
            SetPingWheelOpen(false);
    }

    // Initializes the ping wheel positions.
    void InitializePingWheelClient()
    {
        // Default all to -1.
        for (int i = 0; i <= PING_WHEEL_SEGMENT_COUNT; ++i)
            SetPingWheelSegmentPingIndex(i, -1);

        // Centered pings go in the center, the last one wins.
        // The rest fill the ring, sides first and then the corners.
        int sideCount = PING_WHEEL_SEGMENT_COUNT / 2;
        int ringCount = 0;
        for (int i = 0; i < GetPingCount(); ++i)
        {
            if (GetPingCentered(i))
            {
                SetPingWheelSegmentPingIndex(PING_WHEEL_CENTER_SEGMENT, i);
                continue;
            }

            // The ring is full.
            if (ringCount == PING_WHEEL_SEGMENT_COUNT)
                continue;

            int segment = ringCount < sideCount
                ? ringCount * 2 + 1
                : (ringCount - sideCount) * 2 + 2;

            SetPingWheelSegmentPingIndex(segment, i);
            ++ringCount;
        }
    }

    void SetPingWheelIsOpen(bool isOpen)
    {
        // Wheel opened and closed quickly.
        // To a ping using the centered ping type.
        if (!isOpen
            && GetPingWheelOpen()
            && Timer() - GetPingWheelOpenTic() <= PING_WHEEL_QUICK_TICS)
        {
            int pingIndex = GetPingWheelSegmentPingIndex(PING_WHEEL_CENTER_SEGMENT);
            if (pingIndex != -1)
                RaymarchPing(pingIndex);
        }

        SetPingWheelOpen(isOpen);

        // Segments are selected with the cursor, so it starts in the center.
        if (isOpen)
        {
            SetPingWheelOpenTic(Timer());
            BCSUtils::CenterCursor();
        }
    }

    // Returns the index of the ping with the normalized key, or -1 if not found.
    internal int GetPingIndexByKey(str key)
    {
        for (int i = 0; i < GetPingCount(); ++i)
        {
            if (GetPingKey(i) == key)
                return i;
        }

        return -1;
    }

    // Persisting context
    internal bool GetPingsParsed() { return ZH2Lib::PersistingLibContext.PingContext.IsParsed; }
    internal void SetPingsParsed(bool value) { ZH2Lib::PersistingLibContext.PingContext.IsParsed = value; }
    internal int GetPingCount() { return ZH2Lib::PersistingLibContext.PingContext.Count; }
    internal void SetPingCount(int value) { ZH2Lib::PersistingLibContext.PingContext.Count = value; }
    internal str GetPingKey(int index) { return ZH2Lib::PersistingLibContext.PingContext.Collection[index].Key; }
    internal void SetPingKey(int index, str value) { ZH2Lib::PersistingLibContext.PingContext.Collection[index].Key = value; }
    internal bool GetPingCentered(int index) { return ZH2Lib::PersistingLibContext.PingContext.Collection[index].Centered; }
    internal void SetPingCentered(int index, bool value) { ZH2Lib::PersistingLibContext.PingContext.Collection[index].Centered = value; }
    internal str GetPingGraphic(int index) { return ZH2Lib::PersistingLibContext.PingContext.Collection[index].Graphic; }
    internal void SetPingGraphic(int index, str value) { ZH2Lib::PersistingLibContext.PingContext.Collection[index].Graphic = value; }
    internal str GetPingActor(int index) { return ZH2Lib::PersistingLibContext.PingContext.Collection[index].Actor; }
    internal void SetPingActor(int index, str value) { ZH2Lib::PersistingLibContext.PingContext.Collection[index].Actor = value; }

    // Transient context
    bool GetPingWheelOpen() { return ZH2Lib::LibContext.PingWheelContext.IsOpen; }
    internal void SetPingWheelOpen(bool value) { ZH2Lib::LibContext.PingWheelContext.IsOpen = value; }
    internal int GetPingWheelOpenTic() { return ZH2Lib::LibContext.PingWheelContext.OpenTic; }
    internal void SetPingWheelOpenTic(int value) { ZH2Lib::LibContext.PingWheelContext.OpenTic = value; }
    internal int GetPingWheelSegmentPingIndex(int segment) { return ZH2Lib::LibContext.PingWheelContext.SegmentPingIndex[segment]; }
    internal void SetPingWheelSegmentPingIndex(int segment, int value) { ZH2Lib::LibContext.PingWheelContext.SegmentPingIndex[segment] = value; }

    // Transient context - cooldown system
    internal int GetStoredPlayerPingCooldown(int playerId) { return ZH2Lib::LibContext.PingCooldownContext.PlayerCooldown[playerId]; }
    internal void SetStoredPlayerPingCooldown(int playerId, int value) { ZH2Lib::LibContext.PingCooldownContext.PlayerCooldown[playerId] = value; }
    internal int GetPlayerPingCooldownTic(int playerId) { return ZH2Lib::LibContext.PingCooldownContext.PlayerCooldownTic[playerId]; }
    internal void SetPlayerPingCooldownTic(int playerId, int value) { ZH2Lib::LibContext.PingCooldownContext.PlayerCooldownTic[playerId] = value; }
    internal int GetStoredGlobalPingCooldown() { return ZH2Lib::LibContext.PingCooldownContext.GlobalCooldown; }
    internal void SetStoredGlobalPingCooldown(int value) { ZH2Lib::LibContext.PingCooldownContext.GlobalCooldown = value; }
    internal int GetGlobalPingCooldownTic() { return ZH2Lib::LibContext.PingCooldownContext.GlobalCooldownTic; }
    internal void SetGlobalPingCooldownTic(int value) { ZH2Lib::LibContext.PingCooldownContext.GlobalCooldownTic = value; }
}

#undef LOGSOURCE
