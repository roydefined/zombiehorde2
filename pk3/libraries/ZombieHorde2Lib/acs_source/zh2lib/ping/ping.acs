#ifdef __IMPORTED__
    #error This file must be #included.
#endif

#define LOGSOURCE "Ping"

#include "spawn.acs"
#include "cooldown.acs"

strict namespace Ping
{
    void TicServer()
    {
        CooldownTic();
    }

    void TicClient(bool canPing)
    {
        if (!canPing && GetPingWheelOpen())
            ZH2Lib::LibContext.PingWheelContext.IsOpen = false;
    }

    // Initializes the ping wheel positions.
    void InitializePingWheelClient()
    {
        // Default all to -1.
        for (int i = 0; i <= PING_WHEEL_SEGMENT_COUNT; ++i)
            ZH2Lib::LibContext.PingWheelContext.SegmentPingIndex[i] = -1;

        // Have the last entry go as the center.
        for (int i = 0; i < ZH2Lib::PersistingLibContext.PingContext.Count; ++i)
        {
            if (ZH2Lib::PersistingLibContext.PingContext.Collection[i].Centered)
                ZH2Lib::LibContext.PingWheelContext.SegmentPingIndex[0] = i;
        }

        // Sides are filled first, then the corners.
        int sideCount = PING_WHEEL_SEGMENT_COUNT / 2;
        int count = BCSUtils::Min(ZH2Lib::PersistingLibContext.PingContext.Count, PING_WHEEL_SEGMENT_COUNT);
        for (int i = 0; i < count; ++i)
        {
            int segment = i < sideCount
                ? i * 2 + 1
                : (i - sideCount) * 2 + 2;

            ZH2Lib::LibContext.PingWheelContext.SegmentPingIndex[segment] = i;
        }
    }

    bool GetPingWheelOpen()
    {
        return ZH2Lib::LibContext.PingWheelContext.IsOpen;
    }

    void SetPingWheelIsOpen(bool isOpen)
    {
        // Wheel opened and closed quickly.
        // To a ping using the centered ping type.
        if (!isOpen
            && GetPingWheelOpen()
            && Timer() - ZH2Lib::LibContext.PingWheelContext.OpenTic <= PING_WHEEL_QUICK_TICS)
        {
            int pingIndex = ZH2Lib::LibContext.PingWheelContext.SegmentPingIndex[PING_WHEEL_CENTER_SEGMENT];
            if (pingIndex != -1)
                RaymarchPing(pingIndex);
        }

        ZH2Lib::LibContext.PingWheelContext.IsOpen = isOpen;

        // Segments are selected with the cursor, so it starts in the center.
        if (isOpen)
        {
            ZH2Lib::LibContext.PingWheelContext.OpenTic = Timer();
            BCSUtils::CenterCursor();
        }
    }
}

#undef LOGSOURCE
