#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace Ping
{
    // The number of segments in the ring, numbered 1 and up. The center is segment 0.
    #define PING_WHEEL_SEGMENT_COUNT 8
    #define PING_WHEEL_CENTER_SEGMENT 0

    // The radius of the center circle. The cursor selects the center while inside it.
    #define PING_WHEEL_CENTER_RADIUS 22.0

    // Helper for ping graphics which defines the distance from the center to the center of a segment.
    #define PING_WHEEL_ICON_RADIUS 52.0

    #define HUD_PING_WHEEL_SEGMENT "PWSEG"
    #define HUD_PING_WHEEL_SEGMENT_SELECTED "PWSEGSEL"
    #define HUD_PING_WHEEL_CENTER "PCIRNORM"
    #define HUD_PING_WHEEL_CENTER_SELECTED "PCIRSELC"

    // The invisible puff that finds the pinged spot.
    #define PING_LOCATOR_ACTOR "ZH2PingLocator"

    // 8 outer ring, the middle is parsed separately.
    #define MAX_PING_DEFINITIONS 9

    struct PingCollectionContextT
    {
        bool IsParsed;

        PingContextT Collection[MAX_PING_DEFINITIONS];
        int Count;
    };

    // A ping as defined in a pingdef lump.
    struct PingContextT
    {
        str Name;

        // Shown on the HUD, such as in the wheel.
        str Graphic;

        // Spawned at the pinged spot.
        str Actor;
    };

    struct PingWheelContextT
    {
        // Clientside. If true, the ping wheel is open.
        bool IsOpen;

        // Clientside. The index of the ping each segment shows, or -1 if it shows none.
        int SegmentPingIndex[PING_WHEEL_SEGMENT_COUNT + 1];
    };

    extern void InitializePingWheelClient();
    extern bool GetPingWheelOpen();
    extern void SetPingWheelIsOpen(bool isOpen);
}
