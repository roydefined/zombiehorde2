strict namespace Hud
{
    // The next HUD message ids to draw with, reset at the start of every HUD draw.
    extern int _debugHudId;
    extern int _drawnHudId;

    // The scale of the HUD part being drawn, used to convert the cursor to the same virtual size.
    extern fixed _hudScale;

    extern void HudSetScaledVirtualSize(fixed width, fixed height, fixed scale);
    extern fixed HudCenterX();
    extern fixed HudCenterY();
    extern fixed GetHudCursorX();
    extern fixed GetHudCursorY();
    extern void DebugDraw(fixed x = 0.0, fixed y = 0.0, int color = CR_WHITE);
}
