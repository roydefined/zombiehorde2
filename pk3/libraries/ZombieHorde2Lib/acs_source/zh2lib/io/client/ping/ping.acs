#ifdef __IMPORTED__
    #error This file must be #included.
#endif

#include "definition.acs"

strict namespace IO
{
    void ParsePingDefsClientside()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION();
        ACS_NamedExecuteWithResult("zh2_internal_parse_ping_defs_client");
    }

    script "zh2_internal_parse_ping_defs_client" clientside
    {
        if (ZH2Lib::PersistingLibContext.PingContext.IsParsed)
            terminate;

        Logger::LogDebug(LOGSOURCE, "Begin parsing ping def lumps.");

        int startIndex = 0;
        while(true)
        {
            startIndex = LumpOpen("pingdef", startIndex);

            if (startIndex == -1)
                break;

            Logger::LogDebug(LOGSOURCE, "Found ping def lump: \cd" + (str)LumpGetInfo(startIndex, LUMP_INFO_NAME) + "\cj.");
            
            if (LumpGetInfo(startIndex, LUMP_INFO_SIZE) == 0)
                continue;

            ParsePingDefLumpClientside(LumpReadString(startIndex, 0));
            LumpClose(startIndex);
        }

        Logger::LogDebug(LOGSOURCE, "Finished parsing ping def lumps.");
        Logger::LogInformation(LOGSOURCE, Debug::GetPingDefinitionsMessage());

        ZH2Lib::PersistingLibContext.PingContext.IsParsed = true;
    }

    internal void ParsePingDefLumpClientside(str buffer)
    {
        int handle = Tokenizer::RentTokenizer(buffer);
        if (handle == -1)
        {
            Logger::LogError(LOGSOURCE, __FUNCTION__ + ": failed to rent a tokenizer.");
            return;
        };

        Tokenizer::Next(handle, false);

        while(Tokenizer::CanRead(handle))
        {
            str symbol = Tokenizer::GetSymbol(handle);
            if (ParsePingDefinition(handle, symbol))
                continue;

            Tokenizer::SetErrored(handle, "Unknown symbol whilst parsing ping definitions: '" + symbol + "'.");
            break;
        }

        Tokenizer::ReturnTokenizer(handle);
    }
}
