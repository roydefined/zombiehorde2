#ifdef __IMPORTED__
    #error This file must be #included.
#endif

strict namespace IO
{
    internal bool ParsePingDefinition(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "ping"))
            return false;

        Tokenizer::Next(handle);

        if (Tokenizer::GetToken(handle) != Tokenizer::TSYMBOL
            && Tokenizer::GetToken(handle) != Tokenizer::TSTRING)
        {
            Tokenizer::SetErrored(handle, "Invalid symbol for ping definition: '" + Tokenizer::GetSymbol(handle) + "'. Symbol should be of type symbol or string.");
            return false;
        }

        str name = Tokenizer::GetSymbol(handle);
        Logger::LogDebug(LOGSOURCE, "Start parsing ping: \cd" + name + "\cj.");

        int braceLevel = Tokenizer::GetBraceLevel(handle);
        if (!Tokenizer::ExpectNextChar(handle, '{'))
            return false;

        Tokenizer::Next(handle);

        // We check for capacity here now that we got to the body.
        // No more room for more definitions. Log a warning and skip the remaining body.
        int count = Ping::GetPingCount();
        if (count >= MAX_PING_DEFINITIONS)
        {
            Logger::LogWarning(LOGSOURCE, "The maximum number of ping definitions was reached (" + str(count) + ").");
            Tokenizer::ParseRemainingBodyAsEmpty(handle);
            return true;
        }

        Ping::SetPingName(count, name);

        // While the brace level does not match the end level, we keep parsing.
        while (Tokenizer::CanRead(handle) && Tokenizer::GetBraceLevel(handle) != braceLevel)
        {
            str symbol = Tokenizer::GetSymbol(handle);
            if (ParsePingGraphic(handle, symbol)
                || ParsePingCentered(handle, symbol)
                || ParsePingActor(handle, symbol))
            {
                // Optional comma.
                Tokenizer::Next(handle, false);
                if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
                    Tokenizer::Next(handle, false);
                continue;
            }

            Tokenizer::SetErrored(handle, "Unknown symbol whilst parsing ping definition " + name + ": '" + symbol + "'.");
            return false;
        }

        // Optional comma.
        Tokenizer::Next(handle, false);
        if (Tokenizer::GetToken(handle) == Tokenizer::TCOMMA)
            Tokenizer::Next(handle, false);

        Ping::SetPingCount(count + 1);

        Logger::LogDebug(LOGSOURCE, "Finished parsing ping: \cd" + name + "\cj.");
        return true;
    }

    internal bool ParsePingGraphic(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "graphic"))
            return false;

        Tokenizer::Next(handle);

        str graphic = Tokenizer::GetSymbol(handle);
        Ping::SetPingGraphic(Ping::GetPingCount(), graphic);

        Logger::LogDebug(LOGSOURCE, "Parsed ping graphic: \cd" + graphic + "\cj.");
        return true;
    }

    internal bool ParsePingCentered(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "centered"))
            return false;

        Ping::SetPingCentered(Ping::GetPingCount(), true);

        Logger::LogDebug(LOGSOURCE, "Parsed ping is centered.");
        return true;
    }

    internal bool ParsePingActor(int handle, str identifyingSymbol)
    {
        if (!BCSUTILS::StrIEquals(identifyingSymbol, "actor"))
            return false;

        Tokenizer::Next(handle);

        str actor = Tokenizer::GetSymbol(handle);
        Ping::SetPingActor(Ping::GetPingCount(), actor);

        Logger::LogDebug(LOGSOURCE, "Parsed ping actor: \cd" + actor + "\cj.");
        return true;
    }
}
