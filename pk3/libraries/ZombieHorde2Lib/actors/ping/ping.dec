actor ZH2PingBase
{
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEXYBILLBOARD
    +NOINTERACTION

    states
    {
        Spawn:
            TNT1 A 0
            goto Show

        Show:
            "####" "#" 35 Bright
            "####" "#" 1 Bright A_FadeOut(0.1)
            wait
    }
}

#include "actors/ping/types.dec"
