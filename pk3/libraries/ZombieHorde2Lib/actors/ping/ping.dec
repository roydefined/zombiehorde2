actor ZH2PingBase
{
    Radius 0

    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEXYBILLBOARD
    +NOINTERACTION

    ActiveSound "ping/default"

    states
    {
        Spawn:
            TNT1 A 0
            goto Show

        Show:
            "####" "#" 0 Bright A_ActiveSound
            "####" "#" 35 Bright
            "####" "#" 1 Bright A_FadeOut(0.1)
            wait
    }
}

#include "actors/ping/types.dec"
