actor ZH2WeatherDustParticle
{
	Height 2
	Radius 2
	Renderstyle Translucent
	Alpha 0
	
	+MISSILE
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+DONTSPLASH
	+NOGRAVITY
	+FORCEXYBILLBOARD
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_ChangeVelocity(Frandom(-0.1, 0.1), Frandom(-0.1, 0.1), Frandom(-0.1, 0.1), CVF_REPLACE)
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Death.Silent")
			TNT1 A 0 A_SetScale(Frandom(0.05, 0.2), Frandom(0.05, 0.2))
			TNT1 A 0 A_Jump(192, 1, 2, 3)
			goto Spawn.FadeIn
			TNT1 B 0
			goto Spawn.FadeIn
			TNT1 C 0
			goto Spawn.FadeIn
			TNT1 D 0
			goto Spawn.FadeIn
			
		Spawn.FadeIn:
			WDST "####" 1 A_FadeIn(.1)
			TNT1 A 0 A_Jump(50, "Spawn.Rest")
			WDST "##" 1 A_FadeIn(.05)
			TNT1 A 0 A_Jump(50, "Spawn.Rest")
			WDST "##" 1 A_FadeIn(.05)
			TNT1 A 0 A_Jump(50, "Spawn.Rest")
			WDST "##" 1 A_FadeIn(.05)
		Spawn.Rest:
			WDST "###########" 5 A_JumpIf(WaterLevel > 0, "Death.Silent")
		
		// Remove the actor manually after a while.
		Spawn.FadeOut:
			WDST "#" 1 A_JumpIf(WaterLevel > 0,"Death.Silent")
			TNT1 "#" 0 A_FadeOut(.02)
			loop
		
		Death.Silent:
			TNT1 A 0
			stop
	}
}