
// Generally used when specifying clientside effects.
OptionValue "ClientLocalityType"
{
	0, "Nobody"
	1, "Only self"
	2, "Everyone"
}

// Configure log severity
OptionValue "LogSeverity"
{
	0, "Unspecified"
	1, "Debug and higher"
	2, "Info and higher"
	3, "Warning and higher"
	4, "Error and higher"
	5, "Log nothing"
}

OptionMenu "ZH2LibraryMenu"
{
	Title "Logging / Tracers / Footsteps / Weather"
	StaticText " "
	StaticText " "
	
	StaticText "Logging - overwrite log severity", 1
	Option "Overwrite globally", "sv_zh2_overridegloballogseverity", "LogSeverity"
	Option "Overwrite on server", "sv_zh2_overridelogseverity", "LogSeverity"
	Option "Overwrite on client", "cl_zh2_overridelogseverity", "LogSeverity"
	
	StaticText " "
	
	StaticText "Tracers", 1
	Option "Enable tracers", "sv_zh2_enabletracers", "YesNo"
	Option "Tracer type", "cl_zh2_tracertype", "ClientLocalityType"
	
	StaticText " "
	
	StaticText "Footsteps", 1
	Option "Footstep type type", "cl_zh2_steptype", "ClientLocalityType"
	Slider "Max audible step distance", "cl_zh2_maxstepdistance", 100.0, 8000.0, 100.0
	
	StaticText " "
	
	StaticText "Weather - global toggle", 1
	Option "Enable globally", "sv_zh2_enableweather", "YesNo"
	Option "Enable clientside", "cl_zh2_enableweather", "YesNo"
	
	StaticText " "
	
	StaticText "Weather - enable individual parts", 1
	Option "Enable emitter weather", "cl_zh2_enableambientweather", "YesNo"
	Option "Enable randomized weather", "cl_zh2_enablerandomizedweather", "YesNo"
	Option "Enable ambient weather", "cl_zh2_enableemitterweather", "YesNo"

	StaticText " "

	StaticText "Sync", 1
	Option "Use buffering", "sv_zh2_usesyncbuffer", "YesNo"
	Slider "Sync delay", "sv_zh2_syncdelay", 0, 35, 1
}