// Logging

// The minimum log severity to show. Overwrites the logdef's configuration.
// Defaults to 0 which means the logdef will be used instead.
// 1 for debug,
// 2 for info,
// 3 for warning,
// 4 for error,
// 5 for nothing.
// Note, `noarchive` is used here as generally you want to specify severities with logdefs.
// These cvars exists as a form of control so we can always fully choose what the logging does.
server noarchive int sv_zh2_overridelogseverity = 0;
user noarchive int cl_zh2_overridelogseverity = 0;

// Same as above, but this is a global forced override for both the server and clients.
// This mostly also exists should there be issues with the existing flow, so we can forcefully disable logs.
server noarchive int sv_zh2_overridegloballogseverity = 0;

// Tracers
server bool sv_zh2_enabletracers = true;
user int cl_zh2_tracertype = 2;

// Footstep
user int cl_zh2_steptype = 2;
user int cl_zh2_maxstepdistance = 2000;

// Weather
user bool sv_zh2_enableweather = true;
user bool cl_zh2_enableweather = true;
user bool cl_zh2_enableemitterweather = true;
user bool cl_zh2_enablerandomizedweather = true;
user bool cl_zh2_enableambientweather = true;

// Sync
server bool sv_zh2_usesyncbuffer = true;
server int sv_zh2_syncdelay = 0;
server int sv_zh2_initialsyncdelay = 5;