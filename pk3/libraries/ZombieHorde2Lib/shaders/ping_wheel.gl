// Rotates the texture clockwise around its centre by 45 degrees per segment.
// The segment is packed into the alpha, because that's the best way to pass a value.

// Must match PING_WHEEL_SEGMENT_COUNT.
#define SEGMENT_COUNT 8.0
#define PI 3.14159265

vec4 Process(vec4 color)
{
    float segment = floor(color.a * SEGMENT_COUNT);
    float angle = segment * (2.0 * PI / SEGMENT_COUNT);

    // To turn the image clockwise, the point we sample from is turned the other way.
    vec2 centered = gl_TexCoord[0].st - 0.5;
    vec2 sample_coord = vec2(
        cos(angle) * centered.x + sin(angle) * centered.y,
        cos(angle) * centered.y - sin(angle) * centered.x) + 0.5;

    // At angles that aren't a multiple of 90 degrees, the corners rotate in from outside the texture.
    if (sample_coord.x < 0.0 || sample_coord.x > 1.0 || sample_coord.y < 0.0 || sample_coord.y > 1.0)
        discard;

    return getTexel(sample_coord);
}
