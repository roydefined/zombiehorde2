actor ZH2LavaSplashSmall
{
    Radius 2
    Height 1

    Alpha 0.5
    Scale 0.5

    RenderStyle shaded
    stencilcolor "fd7900"

    +DONTSPLASH
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEYBILLBOARD

    States
    {
        Spawn:
            TNT1 AAAA 0 NoDelay A_SpawnItemEx("ZH2LavaSplashSpark", random(-8, 8), random(-8, 8), 2, Frandom(-0.4, 0.4), Frandom(-0.4, 0.4), Frandom(1.0, 2.0))
            TNT1 AA 0 A_SpawnItemEx("LavaSplashSmokeSmall", random(-10, 10), random(-10, 10), 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
            SPLS ABCDEFGHIJKLM 2 A_FadeOut(FRandom(0.01, 0.05))
            Stop
    }
}

actor ZH2LavaSplashBig : ZH2LavaSplashSmall
{
    Alpha 0.7
    Scale 0.8

    States
    {
        Spawn:
            TNT1 AAAAAAAAA 0 NoDelay A_SpawnItemEx("ZH2LavaSplashSpark", random(-8, 8), random(-8, 8), 2, Frandom(-0.8, 0.8), Frandom(-0.8, 0.8), Frandom(1.0, 2.0))
            TNT1 AAAA 0 A_SpawnItemEx("LavaSplashSmokeBig", random(-10, 10), random(-10, 10), 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
            SPLB ABCDEFGHIJKLM 2 A_FadeOut(FRandom(0.01, 0.05))
            Stop
    }
}

actor ZH2LavaSplashSpark
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEXYBILLBOARD
    +THRUACTORS
    +BRIGHT
    +MISSILE

    RenderStyle Add

    var int user_Scale;

    alpha 0

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_Scale", random(0, 6))
            TNT1 A 0 A_SetScale(0.01 + 0.005 * user_Scale, 0.01 + 0.005 * user_Scale)
            SPAK CCCCC 1 A_FadeIn(FRandom(.02, .14))
            SPAK CCCCCCCCCCCCCCC 1 A_ChangeVelocity(FRandom(-0.05, 0.05), FRandom(-0.05, 0.05), 0, 0)

        Spawn.FadeOut:
            SPAK C 1 A_ChangeVelocity(FRandom(-0.05, 0.05), FRandom(-0.05, 0.05), 0, 0)
            TNT1 A 0 A_FadeOut(FRandom(.01, .06))
            loop
    }
}

actor LavaSplashSmokeSmall : ZH2TerrainSmoke
{
    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_Tics", 30)
            TNT1 A 0 A_SetScale(Frandom(0.2, 0.6), Frandom(0.2, 0.6))
            goto Spawn.Rest
    }
}

actor LavaSplashSmokeBig : ZH2TerrainSmoke
{
    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_Tics", 50)
            TNT1 A 0 A_SetScale(Frandom(0.4, 0.8), Frandom(0.4, 0.8))
            goto Spawn.Rest
    }
}