actor ZH2NukageSplashSmall
{
    Radius 2
    Height 1

    Alpha 0.5
    Scale 0.5

    RenderStyle shaded
    stencilcolor "40de01"

    +DONTSPLASH
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +FORCEYBILLBOARD

    States
    {
        Spawn:
            TNT1 AA 0 NoDelay A_SpawnItemEx("NukageSplashSmokeSmall", random(-10, 10), random(-10, 10), 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
            SPLS ABCDEFGHIJKLM 2 A_FadeOut(FRandom(0.01, 0.05))
            Stop
    }
}

actor ZH2NukageSplashBig : ZH2NukageSplashSmall
{
    Alpha 0.7
    Scale 0.8

    States
    {
        Spawn:
            TNT1 AAAA 0 NoDelay A_SpawnItemEx("NukageSplashSmokeBig", random(-10, 10), random(-10, 10), 2, Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
            SPLB ABCDEFGHIJKLM 2 A_FadeOut(FRandom(0.01, 0.05))
            Stop
    }
}

actor NukageSplashSmokeSmall : ZH2TerrainSmoke
{
    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_Tics", 30)
            TNT1 A 0 A_SetScale(Frandom(0.2, 0.6), Frandom(0.2, 0.6))
            goto Spawn.Rest
    }
}

actor NukageSplashSmokeBig : ZH2TerrainSmoke
{
    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_Tics", 50)
            TNT1 A 0 A_SetScale(Frandom(0.4, 0.8), Frandom(0.4, 0.8))
            goto Spawn.Rest
    }
}