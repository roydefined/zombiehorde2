actor ZH2ConiferTreeSpawner : ZH2TreeRandomSpawner 20057
{
	//$Sprite CTREA0

	scale .75
	tag "Conifer tree spawner"

	DropItem "ZH2ConiferTreeHuge" 255, 1
	DropItem "ZH2ConiferTreeHugeMirror" 255, 1
	DropItem "ZH2ConiferTreeBig" 255, 1
	DropItem "ZH2ConiferTreeBigMirror" 255, 1
	DropItem "ZH2ConiferTreeMedium" 255, 1
	DropItem "ZH2ConiferTreeMediumMirror" 255, 1
	DropItem "ZH2ConiferTreeSmall" 255, 1
	DropItem "ZH2ConiferTreeSmallMirror" 255, 1
}

/*
** -----------------------------------------------------------------------------
** Tree instances
** -----------------------------------------------------------------------------
*/

actor ZH2ConiferTreeHuge
{
	height 116
	radius 5

	+FORCEYBILLBOARD
    +SOLID

	States
	{
		Spawn:
			CTRE A -1
	}
}

actor ZH2ConiferTreeHugeMirror : ZH2ConiferTreeHuge
{
	xscale -1
}

actor ZH2ConiferTreeBig : ZH2ConiferTreeHuge
{
	scale .9
	height 104
	radius 5
}

actor ZH2ConiferTreeBigMirror : ZH2ConiferTreeBig
{
	xscale -.9
}

actor ZH2ConiferTreeMedium : ZH2ConiferTreeHuge
{
	scale .8
	height 92
	radius 4
}

actor ZH2ConiferTreeMediumMirror : ZH2ConiferTreeMedium
{
	xscale -.8
}

actor ZH2ConiferTreeSmall : ZH2ConiferTreeHuge
{
	scale .7
	height 80
	radius 4
}

actor ZH2ConiferTreeSmallMirror : ZH2ConiferTreeSmall
{
	xscale -.7
}