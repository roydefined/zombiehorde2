** -----------------------------------------------------------------------------
** Tree spawners
** -----------------------------------------------------------------------------
*/

actor ZH2JungleTreeSpawnerAny : RandomSpawner
{
    DropItem "ZH2JungleTreeSpawner1" 255, 1
    DropItem "ZH2JungleTreeSpawner2" 255, 1
    DropItem "ZH2JungleTreeSpawner3" 255, 1
    DropItem "ZH2JungleTreeSpawner4" 255, 1
}

