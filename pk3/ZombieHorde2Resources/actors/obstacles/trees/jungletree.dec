actor ZH2JungleTreeSpawner : ZH2TreeSpawner 20228
{
    //$Sprite JUNGA0

    //$Arg0 Type
    //$Arg0Tooltip Specify the type of tree that should be spawned.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Any"; 1 = "Specific - variant 1"; 2 = "Specific - variant 2"; 3 = "Specific - variant 3"; 4 = "Specific - variant 4"; }

    tag "Jungle tree spawner"

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_JumpIf(args[0] != 0, 2)
            TNT1 A 0 A_SpawnItem("ZH2JungleTreeSpawnerAny")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 1, 2)
            TNT1 A 0 A_SpawnItem("ZH2JungleTreeSpawner1")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 2, 2)
            TNT1 A 0 A_SpawnItem("ZH2JungleTreeSpawner2")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 3, 2)
            TNT1 A 0 A_SpawnItem("ZH2JungleTreeSpawner3")
            stop

            TNT1 A 0 A_SpawnItem("ZH2JungleTreeSpawner4")
            stop
    }
}

