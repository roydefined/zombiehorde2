actor ZH2PalmTreeSpawner : ZH2TreeSpawner 22007
{
    //$Sprite PALMA0

    //$Arg0 Type
    //$Arg0Tooltip Specify the type of tree that should be spawned.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Any"; 1 = "Specific - variant 1"; 2 = "Specific - variant 2"; 3 = "Specific - variant 3"; }

    tag "Palm tree spawner"

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_JumpIf(args[0] != 0, 2)
            TNT1 A 0 A_SpawnItem("ZH2PalmTreeSpawnerAny")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 1, 2)
            TNT1 A 0 A_SpawnItem("ZH2PalmTreeSpawner1")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 2, 2)
            TNT1 A 0 A_SpawnItem("ZH2PalmTreeSpawner2")
            stop

            TNT1 A 0 A_SpawnItem("ZH2PalmTreeSpawner3")
            stop
    }
}

/*
** -----------------------------------------------------------------------------
** Tree spawners
** -----------------------------------------------------------------------------
*/

actor ZH2PalmTreeSpawnerAny : RandomSpawner
{
    DropItem "ZH2PalmTreeSpawner1" 255, 1
    DropItem "ZH2PalmTreeSpawner2" 255, 1
    DropItem "ZH2PalmTreeSpawner3" 255, 1
}

actor ZH2PalmTreeSpawner1 : RandomSpawner
{
    DropItem "ZH2PalmTree1Huge" 255, 1
    DropItem "ZH2PalmTree1Big" 255, 1
    DropItem "ZH2PalmTree1Medium" 255, 1
    DropItem "ZH2PalmTree1Small" 255, 1
}

actor ZH2PalmTreeSpawner2 : RandomSpawner
{
    DropItem "ZH2PalmTree2Huge" 255, 1
    DropItem "ZH2PalmTree2Big" 255, 1
    DropItem "ZH2PalmTree2Medium" 255, 1
    DropItem "ZH2PalmTree2Small" 255, 1
}

actor ZH2PalmTreeSpawner3 : RandomSpawner
{
    DropItem "ZH2PalmTree3Huge" 255, 1
    DropItem "ZH2PalmTree3Big" 255, 1
    DropItem "ZH2PalmTree3Medium" 255, 1
    DropItem "ZH2PalmTree3Small" 255, 1
}

