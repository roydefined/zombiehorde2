actor ZH2PalmTree1Huge
{
    +CLIENTSIDEONLY
    +FORCEYBILLBOARD
    -SOLID

    scale 1.25
    Height 260
    Radius 5
    States
    {
        Spawn:
            PALM A -1
    }
}

