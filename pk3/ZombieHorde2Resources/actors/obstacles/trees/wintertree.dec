actor ZH2WinterTreeSpawner : ZH2TreeSpawner 22008
{
    //$Sprite WINTA0

    //$Arg0 Type
    //$Arg0Tooltip Specify the type of tree that should be spawned.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Any"; 1 = "Specific - variant 1"; 2 = "Specific - variant 2"; 3 = "Specific - variant 3"; 4 = "Specific - variant 4"; 5 = "Specific - variant 5"; 6 = "Specific - variant 6"; 7 = "Specific - variant 7"; 8 = "Specific - variant 8"; }

    tag "Winter tree spawner"

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_JumpIf(args[0] != 0, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawnerAny")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 1, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner1")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 2, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner2")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 3, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner3")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 4, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner4")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 5, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner5")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 6, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner6")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 7, 2)
            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner7")
            stop

            TNT1 A 0 A_SpawnItem("ZH2WinterTreeSpawner8")
            stop
    }
}

/*
** -----------------------------------------------------------------------------
** Tree spawners
** -----------------------------------------------------------------------------
*/

actor ZH2WinterTreeSpawnerAny : RandomSpawner
{
    DropItem "ZH2WinterTreeSpawner1" 255, 1
    DropItem "ZH2WinterTreeSpawner2" 255, 1
    DropItem "ZH2WinterTreeSpawner3" 255, 1
    DropItem "ZH2WinterTreeSpawner4" 255, 1
    DropItem "ZH2WinterTreeSpawner5" 255, 1
    DropItem "ZH2WinterTreeSpawner6" 255, 1
    DropItem "ZH2WinterTreeSpawner7" 255, 1
    DropItem "ZH2WinterTreeSpawner8" 255, 1
}

