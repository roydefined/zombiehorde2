Actor ZH2SolidBranSpawner : ZH2PlantObstacle 22026
{
    //$Sprite BRANA0

    Tag "Bran (solid)"
    height 40
    radius 30

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_Jump(256, 1, 2, 3)
            TNT1 A 0 A_SpawnItem("ZH2SolidBran1")
            stop
            TNT1 A 0 A_SpawnItem("ZH2SolidBran2")
            stop
            TNT1 A 0 A_SpawnItem("ZH2SolidBran3")
            stop
    }
}

actor ZH2SolidBran1
{
    height 40
    radius 30

    +SOLID
    +FORCEYBILLBOARD

    states
    {
        Spawn:
            BRAN A -1
    }
}

actor ZH2SolidBran2 : ZH2SolidBran1
{
    states
    {
        Spawn:
            BRAN B -1
    }
}

actor ZH2SolidBran3 : ZH2SolidBran1
{
    states
    {
        Spawn:
            BRAN C -1
    }
}