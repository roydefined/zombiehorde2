Actor ZH2SolidCactusSpawner : ZH2PlantObstacle 22027
{
    //$Sprite CACTA0

    Tag "Cactus (solid)"
    height 100
    radius 30

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_Jump(256, 1, 2)
            TNT1 A 0 A_SpawnItem("ZH2SolidCactus1")
            stop
            TNT1 A 0 A_SpawnItem("ZH2SolidCactus2")
            stop
    }
}

actor ZH2SolidCactus1
{
    height 110
    radius 30

    +SOLID
    +FORCEYBILLBOARD

    states
    {
        Spawn:
            CACT A -1
    }
}

actor ZH2SolidCactus2 : ZH2SolidCactus1
{
    height 90

    states
    {
        Spawn:
            CACT B -1
    }
}