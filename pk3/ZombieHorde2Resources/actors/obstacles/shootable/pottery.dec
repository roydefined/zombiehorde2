Actor ZH2PotterySpawner : ZH2Shootable 22017
{
    //$Sprite POT1A0

    //$Arg0 Type
    //$Arg0Tooltip Specify the type of pottery to spawn.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Any"; 1 = "Specific - type 1"; 2 = "Specific - type 2"; 3 = "Specific - type 3"; }

    tag "Pottery"

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_JumpIf(args[0] != 0, 2)
            TNT1 A 0 A_SpawnItem("ZH2PotterySpawnerAny")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 1, 2)
            TNT1 A 0 A_SpawnItem("ZH2Pottery1")
            stop

            TNT1 A 0 A_JumpIf(args[0] != 2, 2)
            TNT1 A 0 A_SpawnItem("ZH2Pottery2")
            stop

            TNT1 A 0 A_SpawnItem("ZH2Pottery3")
            stop
    }
}

/*
** -----------------------------------------------------------------------------
** Spawners
** -----------------------------------------------------------------------------
*/

actor ZH2PotterySpawnerAny : RandomSpawner
{
    DropItem "ZH2Pottery1" 255, 1
    DropItem "ZH2Pottery2" 255, 1
    DropItem "ZH2Pottery3" 255, 1
}

/*
** -----------------------------------------------------------------------------
** Instances
** -----------------------------------------------------------------------------
*/

Actor ZH2Pottery1 : ZH2Shootable
{
    health 1
    radius 10
    height 34

    mass 0x7FFFFFFF

    +SOLID
    +SHOOTABLE
    +NOBLOOD

    states
    {
        Spawn:
            POT1 A -1

        Death:
            TNT1 AAAAAAAAAAAAAAAAAA 0 nodelay A_SpawnItemEx("ZH2PotteryPart", random(-8, 8), random(-8, 8), random(1, 26), random(-4, 4), random(-4, 4), random(0, 8), random(0, 365))
            TNT1 A 0 A_PlaySound("ZH2Pottery/break")
            stop
    }
}

Actor ZH2Pottery2 : ZH2Pottery1
{
    radius 10
    height 28

    states
    {
        Spawn:
            POT2 A -1

        Death:
            TNT1 AAAAAAAAAAAAAAAAAA 0 nodelay A_SpawnItemEx("ZH2PotteryPart", random(-8, 8), random(-8, 8), random(1, 22), random(-4, 4), random(-4, 4), random(0, 8), random(0, 365))
            TNT1 A 0 A_PlaySound("ZH2Pottery/break")
            stop
    }
}

Actor ZH2Pottery3 : ZH2Pottery1
{
    radius 10
    height 20

    states
    {
        Spawn:
            POT3 A -1

        Death:
            TNT1 AAAAAAAAAAAAAAAAAA 0 nodelay A_SpawnItemEx("ZH2PotteryPart", random(-8, 8), random(-8, 8), random(1, 18), random(-4, 4), random(-4, 4), random(0, 8), random(0, 365))
            TNT1 A 0 A_PlaySound("ZH2Pottery/break")
            stop
    }
}

Actor ZH2PotteryPart
{
    Radius 1
    Height 1

    +MISSILE
    +NOBLOCKMAP
    +CLIENTSIDEONLY

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_SetScale(Frandom(0.6, 1.0), Frandom(0.6, 1.0))
            TNT1 A 0 A_Jump(256, 0, 1, 2, 3, 4)
            PBIT ABCDE -1

        Death:
            PBIT "#" 35
            PBIT "#" 1 A_FadeOut(0.02)
            wait
    }
}