/*
** -----------------------------------------------------------------------------
** Spawners
** -----------------------------------------------------------------------------
*/

Actor ZH2ToilerSpawnerType1 : ZH2ShootableRandomSpawner 22023
{
    //$Sprite TOLTA0

    tag "Toilet (type 1)"

    DropItem "ZH2ToiletType1" 255, 3
    DropItem "ZH2ToiletType1Broken" 255, 1
}

Actor ZH2ToilerSpawnerType2 : ZH2ShootableRandomSpawner 22024
{
    //$Sprite TOILA0

    tag "Toilet (type 2)"

    DropItem "ZH2ToiletType2" 255, 3
    DropItem "ZH2ToiletType2Broken1" 255, 1
    DropItem "ZH2ToiletType2Broken2" 255, 1
}

/*
** -----------------------------------------------------------------------------
** Instances
** -----------------------------------------------------------------------------
*/

Actor ZH2ToiletType1
{
    health 50
    radius 10
    height 40
	Mass 0x7FFFFFFF

	+SOLID
	+SHOOTABLE
	+NOBLOOD

    states
    {
        Spawn:
            TOLT A -1

        Death:
            TNT1 A 0 A_SpawnItem("ZH2ToiletType1Broken")
            TNT1 A 0 A_SpawnItem("ZH2ToiletBrokenFX")
            TNT1 A 0 A_SpawnItem("ZH2ToiletBrokenWater")
            TNT1 A 0 A_SpawnItem("ZH2ToiletBrokenPieceSpawner", 0, 30)
            stop
    }
}

