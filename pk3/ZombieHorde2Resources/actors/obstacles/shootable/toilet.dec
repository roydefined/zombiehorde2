Actor ZH2ToiletType2Broken2
{
    radius 10
    height 20

    +SOLID

    States
    {
        Spawn:
            TOIL C -1
    }
}

// Seperate because the Actor will disappear when dead.
Actor ZH2ToiletBrokenFX
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_PlaySound("ZH2Toilet/break")
            stop
    }
}

Actor ZH2ToiletBrokenPieceSpawner
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE

    states
    {
        spawn:
            TNT1 AAAAAAAAAAAAAAAAAAAAAA 0 NoDelay A_SpawnItemEx("ZH2BrokenToiletPiece", random(-10, 10), random(-10, 10), random(-10, 10), Frandom(-2.5, 2.5), Frandom(-2.5, 2.5), Frandom(0.5, 2.5), random(0, 359))
            stop
    }
}

Actor ZH2BrokenToiletPiece
{
    +MISSILE
    -NOGRAVITY
    +NOBLOCKMAP
    +THRUActorS
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +DONTSPLASH
    +NOTIMEFREEZE

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetScale(Frandom(0.4, 1.4), Frandom(0.4, 1.4))
            TOIL DEFGHDEFGHDEFGHDEFGHDEFGHDEFGHDEFGHDEFGHDEFGHDEFGH 2 A_JumpIf(WaterLevel > 0, "underwater")
        Spawn.Timeout:
            TOIL DEFGH 2 A_Fadeout(.4)
            loop

        // Underwater Fade out
        Underwater:
            TOIL "########" 2 A_ChangeVelocity(velx/1.4, vely/1.4, velz/1.1, CVF_REPLACE)
        Underwater.End:
            TOIL "########" 2 A_Fadeout(.05)
            wait

        // Death fade out
        Death:
            TNT1 D 0 A_Jump(170, 1, 2)
            goto Death.Rest
            TNT1 E 0
            goto Death.Rest
            TNT1 G 0
        Death.Rest:
            TNT1 "#" 0 A_SetTranslucent(1.0)
            TOIL "#" 0 A_SetTics(random(30, 80))

        // Fade out
            TOIL "#" 1 A_Fadeout(.01)
            wait
    }
}

Actor ZH2ToiletBrokenWater
{
    +NOBLOCKMAP
    +CLIENTSIDEONLY
    +FORCEYBILLBOARD
    +NOTIMEFREEZE

    scale 0.4
    alpha 0.2
    renderstyle Add

    // Holds the current scale of the Actor, and also determines the upwards velocity of the water.
    var int user_var;

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(100, "NoSpawn")
            TNT1 A 0 A_PlaySound("ZH2Toilet/water", CHAN_BODY, 0.8, TRUE, ATTN_STATIC)
            TNT1 A 0 A_SetUserVar("user_var", user_var+1)
            TNT1 A 0 A_JumpIf(user_var >= 50, "NoSpawn")
            TNT1 A 0 A_SetScale(0.4 - 0.005*user_var, 0.4 - 0.005*user_var)
            WFPT A 2
            TNT1 AAA 0 A_SpawnItemEx("ZH2BrokenToiletWaterParticle", random(-5, 5), random(-5, 5), random(0, 20), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(4.0, 12.0) - 0.12*user_var)
            WFPT B 2
            TNT1 AAA 0 A_SpawnItemEx("ZH2BrokenToiletWaterParticle", random(-5, 5), random(-5, 5), random(0, 20), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(4.0, 12.0) - 0.12*user_var)
            WFPT C 2
            TNT1 AAA 0 A_SpawnItemEx("ZH2BrokenToiletWaterParticle", random(-5, 5), random(-5, 5), random(0, 20), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(4.0, 12.0) - 0.12*user_var)
            goto Spawn+2
        NoSpawn:
            TNT1 A 0 A_StopSound(CHAN_BODY)
            stop
    }
}

Actor ZH2BrokenToiletWaterParticle
{
    +MISSILE
    -NOGRAVITY
    +THRUActorS
    +NOBLOCKMAP
    +CLIENTSIDEONLY
    +BOUNCEONWALLS
    +FORCEXYBILLBOARD
    +NOTIMEFREEZE
    Alpha 0.4
    Radius 1
    Height 1
    Renderstyle Add

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetScale(Frandom(0.1, 0.4), Frandom(0.1, 0.4))
            TNT1 A 0 A_Jump(170, 1, 2)
            Goto Spawn.Rest
            TNT1 B 0
            Goto Spawn.Rest
            TNT1 C 0
        Spawn.Rest:
            WSPT "######################################" 1 A_JumpIf(WaterLevel > 0, "Death")

        Death:
            WSPT "#" 1 A_FadeOut(.1)
            loop
    }
}
