	+SOLID
	+SHOOTABLE
	+NOBLOOD

    states
    {
        Spawn:
            TOIL A -1

        Death:
            TNT1 A 0 A_SpawnItem("ZH2ToiletType2Broken1")
            TNT1 A 0 A_SpawnItem("ZH2ToiletBrokenFX")
            TNT1 A 0 A_SpawnItem("ZH2ToiletBrokenPieceSpawner", 0, 40)
