actor ZH2VenusStatueSpawner : ZH2Obstacle 22018
{
    //$Sprite VENUA0

    //$Arg0 Type
    //$Arg0Tooltip Specify the type of tree that should be spawned.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Type 1"; 1 = "Type 2"; 2 = "Type 3"; }

    height 140
    Tag "Venus statue"

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_JumpIf(args[0] != 0, 2)
            TNT1 A 0 A_SpawnItem("ZH2VenusStatue1")
            stop
            TNT1 A 0 A_JumpIf(args[0] != 1, 2)
            TNT1 A 0 A_SpawnItem("ZH2VenusStatue2")
            stop
            TNT1 A 0 A_SpawnItem("ZH2VenusStatue3")
            stop
    }
}

actor ZH2VenusStatue1
{
    height 140

    Mass 0x7ffffff
    Health 0x7FFFFFFF

    +SOLID
    +NOBLOOD
    +SHOOTABLE
    +FORCEYBILLBOARD

    states
    {
        Spawn:
            VENU A -1
    }
}

actor ZH2VenusStatue2 : ZH2VenusStatue1
{
    states
    {
        Spawn:
            VENU B -1
    }
}

actor ZH2VenusStatue3 : ZH2VenusStatue1
{
    states
    {
        Spawn:
            VENU C -1
    }
}