actor ZH2VenusStatue : ZH2Obstacle 22018
{
    //$Sprite VENUA

    //$Arg0 Type
    //$Arg0Tooltip Specify the type of tree that should be spawned.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Type 1"; 1 = "Type 2"; 2 = "Type 3"; }

    height 140
    Tag "Venus statue"

    Mass 0x7ffffff
    Health 0x7FFFFFFF

    +SOLID
    +NOBLOOD
    +SHOOTABLE
    +FORCEYBILLBOARD

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_JumpIf(args[0] != 0, 1)
            goto Spawn.Rest
            TNT1 B 0 A_JumpIf(args[0] != 1, 1)
            goto Spawn.Rest
            TNT1 C 0

        Spawn.Rest:
            VENU "#" -1
    }
}