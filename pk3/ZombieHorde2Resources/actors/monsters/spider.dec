Actor ZH2SpiderSpawner : ZH2Monster 20121
{
	//$Sprite SPIDA1

	//$Arg0 Type
	//$Arg0Tooltip Specify the type of spider that should be spawned.
	//$Arg0Type 11
	//$Arg0Enum { 0 = "Any"; 1 = "Specific - red"; 2 = "Specific - green"; 3 = "Specific - blue"; 4 = "Specific - gray"; 5 = "Specific - black"; }

	Radius 16
	Height 8
	Tag "Spider"

	+FLOORHUGGER
	+NOINTERACTION

	states
	{
		Spawn:
			TNT1 A 0 NoDelay A_JumpIf(args[0] != 0, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2SpiderSpawnerAny", 0, 0, 0, 0, 0, 0, 0, 0, 0, tid)
			stop

			TNT1 A 0 A_JumpIf(args[0] != 1, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2SpiderRed", 0, 0, 0, 0, 0, 0, 0, 0, 0, tid)
			stop

			TNT1 A 0 A_JumpIf(args[0] != 2, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2SpiderGreen", 0, 0, 0, 0, 0, 0, 0, 0, 0, tid)
			stop

			TNT1 A 0 A_JumpIf(args[0] != 3, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2SpiderBlue", 0, 0, 0, 0, 0, 0, 0, 0, 0, tid)
			stop

			TNT1 A 0 A_JumpIf(args[0] != 4, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2SpiderGray", 0, 0, 0, 0, 0, 0, 0, 0, 0, tid)
			stop

			TNT1 A 0 A_SpawnItemEx("ZH2SpiderBlack", 0, 0, 0, 0, 0, 0, 0, 0, 0, tid)
			stop
	}
}

Actor ZH2SpiderSpawnerAny : RandomSpawner
{
	DropItem "ZH2SpiderRed" 255, 5
	DropItem "ZH2SpiderGreen" 255, 5
	DropItem "ZH2SpiderBlue" 255, 5
	DropItem "ZH2SpiderGray" 255, 1
	DropItem "ZH2SpiderBlack" 255, 1
}

Actor ZH2Spider
{
	monster

	Health 5
	Radius 16
	Height 8
	Mass 10
	Speed 5
	PainChance 128
	MeleeRange 80
	scale .35

	Tag "Spider"
	Obituary "%o was killed by a spider."

	painsound "ZH2Spider/pain"
	deathsound "ZH2Spider/death"
	activesound "ZH2Spider/active"

	+USEDAMAGEEVENTSCRIPT
	+FLOORCLIP
	+DONTSPLASH
	+AMBUSH
	+SLIDESONWALLS
	+DROPOFF
	-NODROPOFF
	+SHOOTABLE
	+VULNERABLE
	-NORADIUSDMG
	+LOOKALLAROUND
	+NOINFIGHTING

	States
	{
		Spawn.Clear:
			TNT1 A 0 A_ClearTarget
			SPID AB 10 A_Wander
		Spawn:
			TNT1 A 0 NoDelay A_Look
			SPID AB 10 A_Wander
			TNT1 A 0 A_Look
			SPID CD 10 A_Wander
			TNT1 A 0 A_Look
			SPID EF 10 A_Wander
			loop

		See:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Spawn.Clear")
			TNT1 A 0 A_PlaySound("ZH2Spider/see")
		See.Rest:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Spawn.Clear")
			SPID AAAA 1 A_Chase
			TNT1 A 0 A_JumpIfCloser(200, "Melee.Lunge")
			SPID BBBB 1 A_Chase
			TNT1 A 0 A_JumpIfCloser(200, "Melee.Lunge")
			SPID CCCC 1 A_Chase
			TNT1 A 0 A_JumpIfCloser(200, "Melee.Lunge")
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Spawn.Clear")
			SPID DDDD 1 A_Chase
			TNT1 A 0 A_JumpIfCloser(200, "Melee.Lunge")
			SPID EEEE 1 A_Chase
			TNT1 A 0 A_JumpIfCloser(200, "Melee.Lunge")
			SPID FFFF 1 A_Chase
			loop

		Melee.Lunge:
			TNT1 A 0 ThrustThingZ(0, 30, 0, 0)
			TNT1 A 0 A_FaceTarget
			TNT1 A 0 A_Recoil (-25)
			SPID I 5
			TNT1 A 0 A_FaceTarget
		Melee:
		Missile:
			TNT1 A 0 A_JumpIfCloser(80, 2)
			SPID I 10
			Goto See.Rest
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Spawn.Clear")
			SPID I 8 A_CustomMeleeAttack(5, "ZH2Spider/attack", "", "", true)
			SPID G 8
			Goto See.Rest

		Pain:
			SPID G 3
			SPID G 3 A_Pain
			Goto Spawn

		Death:
		XDeath:
			TNT1 A 0 A_Scream
			SPID IJKLMN 3
			SPID O 350
			SPID O 1 A_FadeOut(0.05)
			wait
	}
}

