actor ZH2LensFlareStatic : ZH2SwitchableLensflare 22020
{
    //$Sprite LFLRA0

    //$Arg0 Color
    //$Arg0Tooltip Specify the color of the flare to show.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Orange"; 1 = "White"; 2 = "Yellow"; 3 = "Blue"; 4 = "Green"; 5 = "Red"; 6 = "MakoGreen"; 7 = "MakoRed"; 8 = "MakoWhite"; }

    +NOINTERACTION
    +NOGRAVITY
    +CLIENTSIDEONLY
    +NOTONAUTOMAP
    +FORCEXYBILLBOARD
    +BRIGHT

    renderstyle Add

    Radius 8
    Height 8

    Tag "Lens flare"

    States
    {
        Spawn:
        Active:
            TNT1 A 0 nodelay A_JumpIf(args[0] == 0, "Spawn.Rest")
            TNT1 B 0 A_JumpIf(args[0] == 1, "Spawn.Rest")
            TNT1 C 0 A_JumpIf(args[0] == 2, "Spawn.Rest")
            TNT1 D 0 A_JumpIf(args[0] == 3, "Spawn.Rest")
            TNT1 E 0 A_JumpIf(args[0] == 4, "Spawn.Rest")
            TNT1 F 0 A_JumpIf(args[0] == 5, "Spawn.Rest")
            TNT1 G 0 A_JumpIf(args[0] == 6, "Spawn.Rest")
            TNT1 H 0 A_JumpIf(args[0] == 7, "Spawn.Rest")
            TNT1 I 0

        Spawn.Rest:
            LFLR "#" 1
            wait

        Inactive:
            TNT1 A 1
            wait
    }
}