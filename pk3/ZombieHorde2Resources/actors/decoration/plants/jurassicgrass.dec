actor ZH2JurassicGrass : ZH2Plant 22004
{
    tag "Jurassic grass"

    +FORCEYBILLBOARD
    +CLIENTSIDEONLY

    var int user_scale;

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_scale", random(0, 4))
            TNT1 A 0 A_SetScale(1.0 - 0.08 * user_scale, 1.0 - 0.08 * user_scale)
            JRAS A -1
    }
}