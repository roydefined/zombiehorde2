Actor ZH2Bran : ZH2Plant 22001
{
    Tag "Bran"

    +FORCEYBILLBOARD
    +CLIENTSIDEONLY

    var int user_scale;

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_scale", random(1, 5))
            TNT1 A 0 A_SetScale(1.0 - 0.08 * user_scale, 1.0 - 0.08 * user_scale)
            TNT1 A 0 A_Jump(256, 1, 2, 3)
            BRAN ABC -1
    }
}