actor ZH2DukeBush : ZH2Plant 22003
{
    tag "Duke bush"

    +FORCEYBILLBOARD
    +CLIENTSIDEONLY

    var int user_scale;

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_scale", random(1, 5))
            TNT1 A 0 A_SetScale(1.0 - 0.08*user_scale, 1.0 - 0.08*user_scale)
            DUKE A -1
    }
}