actor ZH2UnderwaterPlant : ZH2Plant 22005
{
    tag "Underwater plant"

    +FORCEYBILLBOARD
    +CLIENTSIDEONLY

    var int user_scale;

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_scale", random(1, 5))
            TNT1 A 0 A_SetScale(0.6 - 0.08 * user_scale, 0.6 - 0.08 * user_scale)
            TNT1 A 0 A_Jump(256, 1, 2, 3)
            UPLN ABC -1
    }
}