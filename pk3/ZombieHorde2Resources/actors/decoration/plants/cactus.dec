Actor ZH2Cactus : ZH2Plant 22002
{
    +FORCEYBILLBOARD
    +CLIENTSIDEONLY

    //$Sprite CACTA0

    //$Arg0 Type
    //$Arg0Tooltip Specifies the type of cactus to spawn.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Variant 1"; 1 = "Variant 2"; }

    Tag "Cactus"

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_JumpIf(args[0] == 1, 1)
            goto Spawn.Rest
            TNT1 B 0
        Spawn.Rest:
            CACT "#" -1
    }
}