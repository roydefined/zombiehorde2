Actor ZH2UnderwaterRock : ZH2Plant 22006
{
    Tag "Underwater rock"

    +FORCEYBILLBOARD
    +CLIENTSIDEONLY

    var int user_scale;

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_scale", random(1, 5))
            TNT1 A 0 A_SetScale(0.6 - 0.08 * user_scale, 0.6 - 0.08 * user_scale)
            TNT1 A 0 A_Jump(256, 1, 2)
            URCK AB -1
    }
}