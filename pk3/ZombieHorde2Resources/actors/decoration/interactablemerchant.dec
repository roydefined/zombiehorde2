actor ZH2InteractableMerchant : ZH2Decoration 20104
{
	Radius 25
	Height 25

    Tag "Merchant"

	-SHOOTABLE

	States
	{
		Spawn:
			SMER A 0 NoDelay A_SetTics(Random(35 * 3, 35 * 10))
			TNT1 A 0 A_Jump(100, "Spawn.Tap")
			SMER BCD 5
			SMER E 35
			SMER DCB 5
			loop

		Spawn.Tap:
			SMER F 10
			SMER A 10
			SMER F 10
			SMER A 10
			SMER F 10
			SMER A 10
			goto Spawn

		// Custom states, to be called by ACS.
		Talking:
			SMER GHIJLMN 5
			SMER O 35
			SMER NM 5
			goto Spawn

		NoSale:
			SMER PQ 4
			SMER R 6
			SMER QP 4
			goto Spawn
	}
}