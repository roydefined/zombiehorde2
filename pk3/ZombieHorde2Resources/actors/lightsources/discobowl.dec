actor ZH2DiscoBowl : ZH2LightSource 22025
{
    height 25
    radius 16

    scale .5

    +BRIGHT
    +SOLID
    +NOGRAVITY
    +SPAWNCEILING
    +FORCEYBILLBOARD

    tag "Disco bowl"

    states
    {
        Spawn:
            DISC A 1 nodelay light("ZH2DiscoLight") A_SpawnItemEx("ZH2DiscoBowlFlare", 0, 0, -10)
            loop
    }
}

actor ZH2DiscoBowlFlare : ZH2LightSourceLensFlare
{
    Scale 2
    Alpha .6

    States
    {
        Spawn:
            LFLR B 1 nodelay bright
            stop
    }
}
