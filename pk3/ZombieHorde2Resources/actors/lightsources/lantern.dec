actor ZH2Lantern : ZH2LightSource 22021
{
	tag "Lantern"
	Radius 10
	Height 40
	mass 0x7FFFFFFF

	+SOLID
	+NOBLOOD
	+SHOOTABLE
	+NOGRAVITY
	+SPAWNCEILING

	States
	{
		Spawn:
            LANT A 1 nodelay bright light("ZH2LanternLight") A_SpawnItemEx("ZH2LanternFlare", 0, 0, 15)
			loop
	}
}

actor ZH2LanternFlare : ZH2LightSourceLensFlare
{
	Scale .8

	States
	{
		Spawn:
			LFLR B 1 NoDelay Bright
			stop
	}
}