const int PYRECONEHEIGHT = 34;

actor ZH2PyreCone : ZH2SwitchableLightSource 20221
{
	//$Sprite "SCONA0"

	tag "Pyre cone"

	Radius 10
	Height 32
	Health 0x7FFFFFFF

	PainChance 255

	+FORCEYBILLBOARD
	+SOLID
	+SHOOTABLE
	+NOBLOOD

	States
	{
		Spawn:
        Active:
			TNT1 A 0 nodelay A_PlaySound("ZH2PyreCone/flameloop", CHAN_BODY, 0.4, TRUE, ATTN_STATIC)
			TNT1 A 0 A_ChangeFlag("NOPAIN", 0)

		Active.Rest:
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON A 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON A 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON B 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON B 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON C 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON C 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON D 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON D 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON E 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Underwater")
			TNT1 A 0 A_SpawnItemEx("ZH2PyreFlare", 0, 0, PYRECONEHEIGHT)
			SCON E 2 bright light("ZH2PyreLight") A_SpawnItem("ZH2PyreEffect")
			loop

		Inactive:
			TNT1 A 0 A_StopSound(CHAN_BODY)
			TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
			SCON F 1
			wait

		Death:
		Pain:
			TNT1 A 0 A_StopSound(CHAN_BODY)
			TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
			TNT1 A 0 A_PlaySound("ZH2PyreCone/explode")
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfire_area", 0, 150, 300, 300)
			TNT1 A 0 A_SpawnItem("ZH2PyreDeathFX")
			SCON F 1
			wait

		Underwater:
			TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
			TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
			TNT1 A 0 A_StopSound(CHAN_BODY)
			TNT1 AAAAA 0 A_SpawnItemEx("ZH2PyreDeathSmoke", random(-3, 3), random(-3, 3), random(10, 20), Frandom(-0.8, 0.8), Frandom(-0.8, 0.8), Frandom(0.6, 1.5), random(0, 359))
			SCON F 1
			wait
	}
}

actor ZH2PyreFlare : ZH2LightSourceLensFlare
{
	Scale .8
	Alpha .6

	States
	{
		Spawn:
			LFLR A 2 nodelay Bright
			stop
	}
}


actor ZH2PyreEffect
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE

	states
	{
		Spawn:
			TNT1 A 0 nodelay A_Jump(120, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2PyreSpark", random(-8, 8), random(-8, 8), random(25, 30), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0))
			TNT1 A 0 A_Jump(160, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2PyreSmoke", random(-10, 10), random(-10, 10), random(30, 45), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.6, 1.4))
			TNT1 A 0
			stop
	}
}

actor ZH2PyreSmoke : ZH2LightSourceSmoke
{
	states
	{
		Spawn:
			TNT1 A 0 nodelay A_SetUserVar("user_Tics", 25)
			TNT1 A 0 A_SetScale(Frandom(0.2, 0.4), Frandom(0.2, 0.4))
			goto Spawn.Rest
	}
}

actor ZH2PyreDeathFX
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY
	+BRIGHT

	RenderStyle Add
	scale 1.5

	States
	{
		Spawn:
			TNT1 A 0 nodelay Radius_Quake(4, 30, 0, 9, 0)
			EXP1 AB 1 light("PyreExplodeLight1")
			TNT1 AAAAAAA 0 A_SpawnItemEx("ZH2PyreFlamePuff", Random(-3, 3), Random(-3, 3), Random(-3, 3), Frandom(-2.0, 2.0), Frandom(-2.0, 2.0), Frandom(1.0, 4.0), random(0, 359))
			EXP1 CD 1 light("PyreExplodeLight1")
			TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("ZH2PyreSpark", Frandom(-5.5, 5.5), Frandom(-5.5, 5.5), random(15, 30), Frandom(-2.0, 2.0), Frandom(-2.0, 2.0), Frandom(1.0, 3.0))
			EXP1 EFG 1 light("PyreExplodeLight2")
			TNT1 AAAAAA 0 A_SpawnItemEx("ZH2PyreDeathSmoke", random(-3, 3), random(-3, 3), random(10, 20), Frandom(-0.8, 0.8), Frandom(-0.8, 0.8), Frandom(1.0, 2.5), random(0, 359))
			EXP1 HIJ 1 light("PyreExplodeLight3")
			stop
	}
}

actor ZH2PyreDeathSmoke
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY

	RenderStyle Translucent

	States
	{
		Spawn:
			TNT1 A 0 nodelay A_SetScale(Frandom(0.5, 1.0), Frandom(0.5, 1.0))
		Spawn.Rest:
			SMKD A 1 A_FadeOut(0.02)
			loop
	}
}

actor ZH2PyreFlamePuff
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY

	States
	{
		Spawn:
			FIR1 ABCDABCDABCDEFGHI 1 A_ChangeVelocity (0, 0, Frandom(0.1, 0.3))
			stop
	}
}

actor ZH2PyreSpark : ZH2LightSourceSpark
{
}