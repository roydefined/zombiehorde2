actor ZH2Candle : ZH2LightSource 22016
{
    radius 8
    height 14
    scale .75

    +FORCEYBILLBOARD

    //$Arg0 Type
    //$Arg0Tooltip Specifies the type of candle to show.
    //$Arg0Type 11
    //$Arg0Enum { 0 = "Stuck"; 1 = "Loose"; }

    states
    {
        Spawn:
            CAN1 A 0 nodelay A_JumpIf(args[0] == 1, 1)
            goto Spawn.Rest
            CAN2 A 0
        Spawn.Rest:
            "####" A 0 A_SpawnItemEx("ZH2CandleLensFlare", 0, 0, 16)
            "####" A 0 A_SpawnItem("ZH2CandleEffect")
            "####" A 4 bright light("ZH2CandleLight")
            "####" A 0 A_SpawnItemEx("ZH2CandleLensFlare", 0, 0, 16)
            "####" B 4 bright light("ZH2CandleLight")
            "####" A 0 A_SpawnItemEx("ZH2CandleLensFlare", 0, 0, 16)
            "####" C 4 bright light("ZH2CandleLight")
            "####" A 0 A_SpawnItemEx("ZH2CandleLensFlare", 0, 0, 16)
            "####" D 4 bright light("ZH2CandleLight")
            "####" A 0 A_SpawnItemEx("ZH2CandleLensFlare", 0, 0, 16)
            "####" E 4 bright light("ZH2CandleLight")
            loop
    }
}

actor ZH2CandleLensFlare : ZH2LightSourceLensFlare
{
    scale .3
    alpha .6

    States
    {
        Spawn:
            LFLR A 4 nodelay Bright
            stop
    }
}

actor ZH2CandleEffect
{
    +CLIENTSIDEONLY
    states
    {
        Spawn:
            TNT1 A 0 nodelay A_Jump(120, 2)
            TNT1 A 0 A_SpawnItemEx("ZH2CandleSpark", random(-2, 2), random(-2, 2), random(18, 24), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0))
            TNT1 A 0
            stop
    }
}

actor ZH2CandleSpark : ZH2LightSourceSpark
{
}
