actor ZH2Hexbull : ZH2LightSource 22012
{
    //$Sprite "FBULA0"

    Radius 20
    Height 80

    mass 0x7fffffff
    health 0x7FFFFFFF

    tag "Hexbull"

    +FORCEYBILLBOARD
    +SHOOTABLE
    +SOLID
    +NOBLOOD

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_PlaySound("ZH2Hexbull/flameloop", CHAN_BODY, 0.4, TRUE, ATTN_STATIC)
        Spawn.Rest:
            TNT1 A 0 A_CheckSight("Spawn.NoSight")
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullFlare", 0, 0, 34)
            FBUL AA 2 bright light("ZH2HexbullLight") A_SpawnItem("ZH2HexbullFX")
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullFlare", 0, 0, 34)
            FBUL BB 2 bright light("ZH2HexbullLight") A_SpawnItem("ZH2HexbullFX")
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullFlare", 0, 0, 34)
            FBUL CC 2 bright light("ZH2HexbullLight") A_SpawnItem("ZH2HexbullFX")
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullFlare", 0, 0, 34)
            FBUL DD 2 bright light("ZH2HexbullLight") A_SpawnItem("ZH2HexbullFX")
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullFlare", 0, 0, 34)
            FBUL EE 2 bright light("ZH2HexbullLight") A_SpawnItem("ZH2HexbullFX")
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullFlare", 0, 0, 34)
            FBUL FF 2 bright light("ZH2HexbullLight") A_SpawnItem("ZH2HexbullFX")
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullFlare", 0, 0, 34)
            FBUL GG 2 bright light("ZH2HexbullLight") A_SpawnItem("ZH2HexbullFX")
            loop

        Spawn.NoSight:
            FBUL A 1 bright light("ZH2HexbullLight")
            goto Spawn.Rest
    }
}

actor ZH2HexbullFlare : ZH2LightSourceLensFlare
{
    Scale 0.8
    Alpha 0.5

    States
    {
        Spawn:
            LFLR A 4 NoDelay Bright
            stop
    }
}

actor ZH2HexbullFX
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(120, 3)
            TNT1 AA 0 A_SpawnItemEx("ZH2HexbullSpark", random(-8, 8), random(-8, 8), random(25, 30), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0))
            TNT1 A 0 A_Jump(180, 2)
            TNT1 A 0 A_SpawnItemEx("ZH2HexbullSmoke", random(-10, 10), random(-10, 10), random(30, 50), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.8, 1.8))
            TNT1 A 0
            stop
    }
}

actor ZH2HexbullSmoke : ZH2LightSourceSmoke
{
    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_Tics", 60)
            TNT1 A 0 A_SetScale(Frandom(0.2, 0.4), Frandom(0.2, 0.4))
            goto Spawn.Rest
    }
}

actor ZH2HexbullSpark : ZH2LightSourceSpark
{
}