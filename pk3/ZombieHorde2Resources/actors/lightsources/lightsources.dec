actor ZH2FlareLight : ZH2ThrownFlare
{
    //$Category "Light sources"
    //$NotAngled
}

actor ZH2LightSourceLensFlare
{
    +NOINTERACTION
    +NOGRAVITY
    +CLIENTSIDEONLY
    +NOTONAUTOMAP
    +FORCEXYBILLBOARD
    +BRIGHT

    renderstyle Add
}

actor ZH2LightSourceSmoke
{
	+MISSILE
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEXYBILLBOARD
	+THRUACTORS

	Alpha 0

	RenderStyle Translucent
	var int user_Tics;

	States
	{
		Spawn.Rest:
			TNT1 A 0 A_SetUserVar("user_Tics", user_Tics-1)
			TNT1 A 0 A_JumpIf(user_Tics < 0, "Spawn.Ending")
			TNT1 A 0 A_ScaleVelocity(Frandom(0.88, 0.99))
			SMKD A 2 A_FadeIn(0.01)
			loop
		Spawn.Ending:
			SMKD A 4 A_FadeOut(0.05)
			loop
	}
}

actor ZH2LightSourceSpark
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+FORCEXYBILLBOARD
	+THRUACTORS
	+BRIGHT
	+MISSILE

	RenderStyle Add

	var int user_Tics;
	var int user_Scale;

	alpha 0

	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_JumpIf(WaterLevel > 0, "Death")
			TNT1 A 0 A_SetUserVar("user_Scale", random(0, 6))
			TNT1 A 0 A_SetScale(0.01 + 0.005 * user_Scale, 0.01 + 0.005 * user_Scale)

		Spawn.FadeIn:
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Death")
			TNT1 A 0 A_JumpIf(user_Tics == 10, "Spawn.Velocity")
			TNT1 A 0 A_Jump(30, "Spawn.Velocity")
			SPAK C 1 A_FadeIn(.05)
			TNT1 A 0 A_SetUserVar("user_Tics", user_Tics + 1)
			loop

		Spawn.Velocity:
			TNT1 A 0 A_SetUserVar("user_Tics", 0)
		Spawn.VelocityRest:
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Death")
			TNT1 A 0 A_JumpIf(user_Tics == 30, "Spawn.Depleted")
			TNT1 A 0 A_Jump(10, "Spawn.Depleted")
			SPAK C 1 A_ChangeVelocity(FRandom(-0.05, 0.05), FRandom(-0.05, 0.05), 0, 0)
			TNT1 A 0 A_SetUserVar("user_Tics", user_Tics + 1)
			loop

		Spawn.Depleted:
			TNT1 A 0 A_JumpIf(WaterLevel > 0, "Death")
			SPAK C 1 A_ChangeVelocity(FRandom(-0.05, 0.05), FRandom(-0.05, 0.05), 0, 0)
			TNT1 A 0 A_FadeOut(.051)
			loop

		Death:
			TNT1 A 0
			Stop
	}
}

