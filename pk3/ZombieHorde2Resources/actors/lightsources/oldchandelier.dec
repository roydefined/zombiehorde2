actor ZH2OldChandelier : ZH2LightSource 22013
{
	//$Sprite CDLRA0

	radius 20
	height 60
	health 1
	mass 0x7fffffff

	tag "Old chandelier"

	+SHOOTABLE
	+NOGRAVITY
	+SOLID
	+NOBLOOD
	+SPAWNCEILING
	+FORCEYBILLBOARD

	States
	{
		Spawn:
			TNT1 A 0 nodelay A_SpawnItemEx("ZH2ChandelierLensFlare", 0, 0, 15)
			CDLR A 4 bright light("ZH2ChandelierLight") A_SpawnItem("ZH2ChandelierFX")
			TNT1 A 0 A_SpawnItemEx("ZH2ChandelierLensFlare", 0, 0, 15)
			CDLR B 4 bright light("ZH2ChandelierLight") A_SpawnItem("ZH2ChandelierFX")
			TNT1 A 0 A_SpawnItemEx("ZH2ChandelierLensFlare", 0, 0, 15)
			CDLR C 4 bright light("ZH2ChandelierLight") A_SpawnItem("ZH2ChandelierFX")
			loop

		// Callable state
		Fall:
			// Failsafe in case the chandelier has already died.
			TNT1 A 0 A_JumpIf(health == 0, "Death.FlooredRest")
			TNT1 A 0 A_Die

		Death:
			TNT1 A 0 A_SpawnItem("ZH2BrokenChandelier")
			TNT1 A 0 A_ChangeFlag("FORCEYBILLBOARD", false)
			TNT1 A 0 A_PlaySound("zh2oldchandelier/crash")
			TNT1 A 0 A_SpawnItem("ZH2ChandelierFallingLensFlare")

			// This is required in order to get the momentum going.
			CDLR E 1 bright light("ZH2ChandelierLight")
		Death.Falling:
			TNT1 A 0 A_JumpIf(WaterLevel > 2, "Death.FlooredRest")
			TNT1 AA 0 A_SpawnItemEx("ZH2ChandelierSpark", random(-16, 16), random(-16, 16), random(20, 22), Frandom(-0.1, 0.1), Frandom(-0.1, 0.1), Frandom(0.4, 1.2))
			TNT1 A 0 A_SpawnItemEx("ZH2ChandelierFallingLensFlare", 0, 0, 15)
			CDLR E 1 bright light("ZH2ChandelierLight") A_JumpIf(momz == 0, "Death.Floored")
			loop
		Death.Floored:
			TNT1 A 0 A_SpawnItem("ZH2ChandelierDeathFX")
			TNT1 A 0 A_PlaySound("zh2oldchandelier/explode")
			TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_setfire_area", 0, 150, 300, 300)
		Death.FlooredRest:
			CDLR F 1
			wait
	}
}

actor ZH2ChandelierLensFlare : ZH2LightSourceLensFlare
{
	Alpha 0.4
	Scale .8

	States
	{
		Spawn:
			LFLR A 4 nodelay bright
			stop
	}
}

actor ZH2ChandelierFallingLensFlare : ZH2LightSourceLensFlare
{
	Alpha 0.4
	Scale .8

	States
	{
		Spawn:
			LFLR A 1 nodelay bright
			stop
	}
}

// The hook of the chandelier
actor ZH2BrokenChandelier
{
	Radius 20
	Height 60

	+NOGRAVITY
	-SOLID
	+FORCEYBILLBOARD

	States
	{
		Spawn:
			CDLR D -1
	}
}

actor ZH2ChandelierFX
{
	+CLIENTSIDEONLY
	+NOTIMEFREEZE
	+NOBLOCKMAP

	States
	{
		Spawn:
			TNT1 A 0 nodelay A_Jump(150, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2ChandelierSpark", random(-16, 16), random(-16, 16), random(20, 22), Frandom(-0.1, 0.1), Frandom(-0.1, 0.1), Frandom(0.4, 1.2))
			TNT1 A 0
			stop
	}
}

actor ZH2ChandelierDeathFX
{
	RenderStyle Add

	+bright
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY

	scale 1.5

	States
	{
		Spawn:
			TNT1 A 0 nodelay Radius_Quake(4, 30, 0, 9, 0)
			EXP1 AB 1
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2ChandelierSpark", random(-5, 5), random(-5, 5), random(25, 30), Frandom(-1.0, 1.0), Frandom(-1.0, 1.0), Frandom(1.0, 4.0))
			EXP1 CDEFG 1
			TNT1 AAAAAA 0 A_SpawnItemEx("ZH2ChandelierSmoke", random(-3, 3), random(-3, 3), random(10, 20), Frandom(-0.8, 0.8), Frandom(-0.8, 0.8), Frandom(1.0, 2.5), random(0, 359))
			TNT1 AAAAAA 0 A_SpawnItemEx("ZH2ChandelierSmoke", random(-3, 3), random(-3, 3), random(10, 20), Frandom(-0.8, 0.8), Frandom(-0.8, 0.8), Frandom(0.1, 1.0), random(0, 359))
			EXP1 HIJ 1
			stop
	}
}

actor ZH2ChandelierSmoke
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY

	renderStyle Translucent

	States
	{
		Spawn:
			TNT1 A 0 nodelay A_SetScale(Frandom(0.4, 0.8), Frandom(0.4, 0.8))
			SMKD A 1 A_FadeOut(0.01)
			wait
	}
}

actor ZH2ChandelierSpark : ZH2LightSourceSpark
{
}