actor ZH2CandleStick : ZH2SwitchableLightSource 22014
{
    //$sprite "CNNBA0"

    radius 10
    height 68

    health 0x7FFFFFFF
    tag "Candles on a stick"

    +SOLID
    +SHOOTABLE
    +NOBLOOD
    +FORCEYBILLBOARD

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_JumpIf(WaterLevel > 2, "Underwater")
        Active:
            TNT1 A 0 A_SpawnItemEx("ZH2CandleStickLensFlare", 0, 0, 71)
            CNNB A 2 bright light("ZH2CandleStickLight") A_SpawnItem("ZH2CandleStickEffect")
            TNT1 A 0 A_JumpIf(WaterLevel > 2, "Underwater")
            TNT1 A 0 A_SpawnItemEx("ZH2CandleStickLensFlare", 0, 0, 71)
            CNNB A 2 bright light("ZH2CandleStickLight") A_SpawnItem("ZH2CandleStickEffect")
            TNT1 A 0 A_JumpIf(WaterLevel > 2, "Underwater")
            TNT1 A 0 A_SpawnItemEx("ZH2CandleStickLensFlare", 0, 0, 71)
            CNNB B 2 bright light("ZH2CandleStickLight") A_SpawnItem("ZH2CandleStickEffect")
            TNT1 A 0 A_JumpIf(WaterLevel > 2, "Underwater")
            TNT1 A 0 A_SpawnItemEx("ZH2CandleStickLensFlare", 0, 0, 71)
            CNNB B 2 bright light("ZH2CandleStickLight") A_SpawnItem("ZH2CandleStickEffect")
            TNT1 A 0 A_JumpIf(WaterLevel > 2, "Underwater")
            TNT1 A 0 A_SpawnItemEx("ZH2CandleStickLensFlare", 0, 0, 71)
            CNNB C 2 bright light("ZH2CandleStickLight") A_SpawnItem("ZH2CandleStickEffect")
            TNT1 A 0 A_JumpIf(WaterLevel > 2, "Underwater")
            TNT1 A 0 A_SpawnItemEx("ZH2CandleStickLensFlare", 0, 0, 71)
            CNNB C 2 bright light("ZH2CandleStickLight") A_SpawnItem("ZH2CandleStickEffect")
            TNT1 A 0 A_JumpIf(WaterLevel > 2, "Underwater")
            loop

        Inactive:
        Underwater:
            CNNB D 1
            wait
    }
}

actor ZH2CandleStickLensFlare : ZH2LightSourceLensFlare
{
    Scale .4
    Alpha .4

    States
    {
        Spawn:
            LFLR A 2 NoDelay Bright
            stop
    }
}

actor ZH2CandleStickEffect
{
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTIMEFREEZE

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(220, 2)
            TNT1 A 0 A_SpawnItemEx("ZH2CandleStickSpark", random(-6, 6), random(-6, 6), random(70, 74), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0))
            TNT1 A 0
            stop
    }
}

actor ZH2CandleStickSpark : ZH2LightSourceSpark
{
}