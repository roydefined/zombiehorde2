actor ZH2OldTorch : ZH2LightSource 22015
{
	//$Sprite "TRC1A0"

	Radius 8
	Height 14

	tag "Old Torch"

	scale .75

	+NOGRAVITY
	+BRIGHT
	+FORCEYBILLBOARD

	states
	{
		Spawn:
			TNT1 A 0 nodelay A_SpawnItemEx("ZH2OldTorchFlare", 0, 0, 18)
			TRC1 AA 2 bright light("ZH2OldTorchLight") A_SpawnItem("ZH2OldTorchFX")
			TNT1 A 0 A_SpawnItemEx("ZH2OldTorchFlare", 0, 0, 18)
			TRC1 BB 2 bright light("ZH2OldTorchLight") A_SpawnItem("ZH2OldTorchFX")
			TNT1 A 0 A_SpawnItemEx("ZH2OldTorchFlare", 0, 0, 18)
			TRC1 CC 2 bright light("ZH2OldTorchLight") A_SpawnItem("ZH2OldTorchFX")
			loop

		Spawn.NoSight:
			TRC1 A 1 bright light("ZH2OldTorchLight")
			goto Spawn
	}
}


actor ZH2OldTorchFlare : ZH2LightSourceLensFlare
{
	Scale 0.4
	Alpha 0.5

	States
	{
		Spawn:
			LFLR A 4 nodelay Bright
			stop
	}
}

actor ZH2OldTorchFX
{
	+CLIENTSIDEONLY
	states
	{
		Spawn:
			TNT1 A 0 nodelay A_Jump(100, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2OldTorchSpark", random(-2, 2), random(-2, 2), random(18, 24), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0))
			TNT1 A 0 A_Jump(200, 2)
			TNT1 A 0 A_SpawnItemEx("ZH2OldTorchSmoke", random(-2, 2), random(-2, 2), random(18, 24), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.6, 1.4))
			TNT1 A 0
			stop
	}
}

actor ZH2OldTorchSmoke : ZH2LightSourceSmoke
{
	states
	{
		Spawn:
			TNT1 A 0 nodelay A_SetUserVar("user_Tics", 15)
			TNT1 A 0 A_SetScale(.10, .10)
			goto Spawn.Rest
	}
}

actor ZH2OldTorchSpark : ZH2LightSourceSpark
{
}