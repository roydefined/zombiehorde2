Actor ZH2DecorativeFire : ZH2SwitchableLightSource 20000
{
    //$Sprite FIR1A0

    Tag "Fire (decorative)"

    +NOCLIP
    +NOINTERACTION

    States
    {
        Spawn:
        Active:
            TNT1 A 0 nodelay A_PlaySound("ZH2DecorativeFire/flameloop", CHAN_7, 255, true, ATTN_STATIC)
        Active.Loop:

            TNT1 A 0 A_SpawnItemEx("ZH2DecorativeFireLensFlare", 0, 0, 10)
            TNT1 A 3 light("ZH2DecorativeFireLight") A_SpawnItem("ZH2DecorativeFireEffect")
            TNT1 A 0 A_SpawnItemEx("ZH2DecorativeFireLensFlare", 0, 0, 10)
            TNT1 A 3 light("ZH2DecorativeFireLight") A_SpawnItem("ZH2DecorativeFireEffect")
            TNT1 A 0 A_SpawnItemEx("ZH2DecorativeFireLensFlare", 0, 0, 10)
            TNT1 A 3 light("ZH2DecorativeFireLight") A_SpawnItem("ZH2DecorativeFireEffect")
            TNT1 A 0 A_SpawnItemEx("ZH2DecorativeFireLensFlare", 0, 0, 10)
            TNT1 A 3 light("ZH2DecorativeFireLight") A_SpawnItem("ZH2DecorativeFireEffect")
            loop

        Inactive:
            TNT1 A 0 A_StopSound(CHAN_7)
            TNT1 A 1
            wait
    }
}

actor ZH2DecorativeFireLensFlare : ZH2LightSourceLensFlare
{
    xscale 0.8
    yscale 1.2
    alpha 0.8

    States
    {
        Spawn:
            LFLR A 3 nodelay Bright
            stop
    }
}

Actor ZH2DecorativeFireEffect
{
    +CLIENTSIDEONLY
    +NOTIMEFREEZE
    +NOBLOCKMAP
    +NOGRAVITY

    states
    {
        Spawn:
            TNT1 A 0 nodelay A_SpawnItemEx("ZH2DecorativeFireFlame", random(-4, 4), random(-4, 4), random(2, 8), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.2, 3.0), random(0, 359))
            TNT1 A 0 A_Jump(150, 2)
            TNT1 A 0 A_SpawnItemEx("ZH2DecorativeFireSpark", random(-18, 18), random(-18, 18), random(50, 80), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(1.0, 2.0))
            TNT1 A 0 A_Jump(100, 2)
            TNT1 A 0 A_SpawnItemEx("ZH2DecorativeFireSmoke", random(-15, 15), random(-15, 15), random(50, 80), Frandom(-0.5, 0.5), Frandom(-0.5, 0.5), Frandom(0.6, 1.4))
            TNT1 A 0
            stop
    }
}

Actor ZH2DecorativeFireFlame
{
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +DONTSPLASH
    +NOTIMEFREEZE
    +NOBLOCKMAP
    +NOGRAVITY
    +BRIGHT

    Renderstyle Add
    States
    {
        Spawn:
            TNT1 A 0 nodelay A_SetTranslucent(FRandom(0.3, 0.8))
            TNT1 A 0 A_SetScale(Frandom(0.8, 1.2), FRandom(0.8, 1.2))
            FIR1 ABCDEFGHI 2 A_FadeOut(.05)
            stop
    }
}

Actor ZH2DecorativeFireSmoke : ZH2LightSourceSmoke
{
    states
    {
        Spawn:
            TNT1 A 0 nodelay A_SetUserVar("user_Tics", 25)
            TNT1 A 0 A_SetScale(Frandom(0.2, 0.4), Frandom(0.2, 0.4))
            goto Spawn.Rest
    }
}

actor ZH2DecorativeFireSpark : ZH2LightSourceSpark
{
}