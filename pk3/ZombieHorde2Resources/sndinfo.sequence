// Sector movement
seq/SECTORSTART "sounds/sequence/sectorstart.ogg"
seq/SECTORMOVE "sounds/sequence/sectormove.ogg"
seq/SECTORSTOP "sounds/sequence/sectorstop.ogg"

// Doors
seq/DOORCLOSE "sounds/sequence/doorclose.ogg"
seq/DOORCLOSESTOP "sounds/sequence/doorclosestop.ogg"
seq/DOORFASTCLOSE "sounds/sequence/doorfastclose.ogg"
seq/DOORFASTCLOSESTOP "sounds/sequence/doorfastclosestop.ogg"
seq/DOORFASTOPEN "sounds/sequence/doorfastopen.ogg"
seq/DOORFASTOPENSTOP "sounds/sequence/doorfastopenstop.ogg"
seq/DOORLOOP "sounds/sequence/doorloop.ogg"
seq/DOOROPEN "sounds/sequence/dooropen.ogg"
seq/DOOROPENSTOP "sounds/sequence/dooropenstop.ogg"

// Switches
seq/SWITCHMAIN "sounds/sequence/switchmain.ogg"

// Replaces the build in sounds with one main sound.
$alias switches/normbutn seq/SWITCHMAIN
$alias switches/exitbutn seq/SWITCHMAIN

// Lift doors
sequence/liftdoor1 "sounds/sequence/liftdoor1.ogg"
sequence/liftdoor1end "sounds/sequence/liftdoor1end.ogg"