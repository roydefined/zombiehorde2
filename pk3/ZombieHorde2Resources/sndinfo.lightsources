$alias ZH2CeilingLamp/break shared/glassbreak
$alias ZH2CeilingLight/break shared/glassbreak
$alias ZH2LightBulb/break shared/glassbreak

$alias ZH2Hexbull/flameloop shared/flameloop2
$alias ZH2PyreCone/flameloop shared/flameloop3
$alias ZH2PyreCone/explode weapons/firegrenade/EXPLODE

$alias ZH2DecorativeFire/flameloop shared/flameloop1

// Legacy Map
$alias ZH2OldChandelier/crash decorate/chandelier
$alias ZH2OldChandelier/explode weapons/firegrenade/EXPLODE

ambient/wind3 "sounds/ambient/wind3.ogg"
$ambient 102 ambient/wind3 point continuous 1.0