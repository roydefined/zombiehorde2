
ambient/nukewind "sounds/ambient/nukewind.ogg"

$alias ambient/waterfall shared/waterfall
ambient/waterflow "sounds/ambient/waterflow.ogg"
ambient/sea "sounds/ambient/sea.mp3"
ambient/dripping "sounds/ambient/dripping.lmp"
ambient/lavaboil "sounds/ambient/lavaboil.ogg"

ambient/portal "sounds/ambient/portal.ogg"
ambient/reactor "sounds/ambient/reactor.ogg"

ambient/quicksand "sounds/ambient/quicksand.ogg"
ambient/rumble "sounds/ambient/rumble.ogg"

$ambient 102 ambient/nukewind point continuous 1.0

$ambient 200 ambient/waterfall point continuous 1.0
$ambient 201 ambient/waterflow point continuous 1.0
$ambient 202 ambient/sea point continuous 1.0
$ambient 203 ambient/dripping point continuous 1.0
$ambient 205 ambient/lavaboil point continuous 1.0

$ambient 404 ambient/portal point continuous 1.0
$ambient 405 ambient/reactor point continuous 1.0

$ambient 601 ambient/quicksand point continuous 1.0
$ambient 602 ambient/rumble point continuous 1.0