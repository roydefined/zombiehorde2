Map ZE15
{
    Properties
    {
        GameMode "Escape",
        IsLegacyMap true,
        Graphic "IMGZE15",
    },

    Resist
    {
        GlobalPreResistScript "pre_resist_handler",
        GlobalPostResistScript "post_resist_handler",

        Definitions
        [
            {
                Length 17,
                TopReasonLabel "Wait for the gate to lower...",
                TimeReasonLabel "\cqResist for \cj%t \cqsecond%p",
            },
            {
                Length 28,
                TopReasonLabel "Hacking the door...",
                TimeReasonLabel "\cqResist for \cj%t \cqsecond%p",
            },
            {
                Length 44,
                TopReasonLabel "Survive",
                TimeReasonLabel "\cqResist for \cj%t \cqsecond%p",
            },
            {
                Length 30,
                TopReasonLabel "Nyanyanyanyanya!",
                TimeReasonLabel "\cqNyanyanyanyanya in \cj%t \cqnya!",
            },
            {
                Length 30,
                TopReasonLabel "Preparing Toxins...",
                TimeReasonLabel "\cqDoor seals in \cj%t \cqsecond%p",
            },
            {
                Length 8,
                TimeReasonLabel "\cqReleasing Toxins in \cj%t \cqsecond%p",
            },
            {
                Length 42,
                TopReasonLabel "Runaway",
                TimeReasonLabel "\cqSingularity Matrix activating in \cj%t \cqsecond%p",
            },
        ]
    },

    // Slot 0: Normal safezone
    // Slot 1: Secret ending safezone
    // Slot 2: Normal safezone, but hidden (used when secret ending started)
    // Slot 3: Toxic shutdown
    Safety
    [
        Slot 2 { Hidden true },
        Slot 3 { Hidden true },
    ]
},

