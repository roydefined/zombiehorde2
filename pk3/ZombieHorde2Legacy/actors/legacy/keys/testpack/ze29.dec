actor ZH2LegacyZe29KeycardWhiteSpawn : ZH2CustomInventoryKey 20110
{
    inventory.pickupmessage "Picked up a white keycard."
    inventory.pickupsound "item/keycard"
    tag "Keycard (white, no zombies)"
    states
    {
        Spawn:
            CRDW A -1
            Stop
        Pickup:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_getishuman", 0, 0, 0) == true, 1)
            stop
            TNT1 A 0 A_Jump(256, "Pickup.Rest")
            stop
        Pickup.Rest:
            TNT1 A 0 A_GiveInventory("ZH2LegacyZe29KeycardWhite", 1)
            Stop
    }
}

