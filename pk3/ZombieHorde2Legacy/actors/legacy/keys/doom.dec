Actor ZH2BlueKeyCard : ZH2LegacyKey replaces BlueCard
{
    //$Sprite "BLCKA0"

    Radius 20
    Height 16

    Inventory.PickupMessage "Blue keycard"
    Inventory.PickupSound "items/KEYCARD"
    Inventory.Icon "KCBLUEI"

    Tag "Blue keycard"

    states
    {
        Spawn:
            TNT1 A 0 NoDelay A_CheckSight("Spawn.NoSight")
            BLCK AAAAABBBBBCCCCCDDDDDEEEEEDDDDDCCCCCBBBBB 1 A_SpawnItemEx("ZH2BlueKeycardFlare", 0, 0, 4)
            loop

        Spawn.NoSight:
            BLCK A 1
            goto Spawn
    }
}

