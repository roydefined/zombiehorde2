Actor ZH2BlueKeycardFlare : ZH2KeyLensFlare
{
    Scale .3
    Alpha .2

    States
    {
        Spawn:
            LFLR D 1 NoDelay Bright
            stop
    }
}

Actor ZH2RedKeycardFlare : ZH2KeyLensFlare
