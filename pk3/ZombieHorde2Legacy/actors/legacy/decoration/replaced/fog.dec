// Likely to be part of the weather system.
actor ZH2LegacyReplacedVolumetricFogSprite : ZH2LegacyReplacedDecoration 20081
{
    yscale 0.25
    xscale 0.75
    renderstyle Add
    alpha 0.5

    +NOGRAVITY
    +FORCEXYBILLBOARD
    +ALLOWCLIENTSPAWN // +CLIENTSIDEONLY ?
    +NOINTERACTION
    +FLOATBOB

    states
    {
        Spawn:
            FOG2 A -1
            stop
    }
}