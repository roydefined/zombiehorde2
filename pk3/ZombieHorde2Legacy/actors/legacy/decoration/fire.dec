actor ZH2LegacySwitchableFireClient : ZH2LegacySwitchableDecoration 20900
{
    //$Sprite FFLGM0

    RenderStyle Translucent
    Alpha 0.4

    tag "Fire"

    +NOINTERACTION
    +NOCLIP
    +RANDOMIZE
    +FORCEYBILLBOARD
    +CLIENTSIDEONLY

    states
    {
        spawn:
        active:
            FFLG F 1 A_PlaySound("decoration/fire")
        activeloop:
            FFLG FGHIJKLMNOPQ 3
            TNT1 A 0 A_Jump(20, "Random")
            loop

        random:
            FFLG F 3
            goto activeloop

        inactive:
            TNT1 A 1
            loop
    }
}

actor ZH2LegacySwitchableFireLargeClient : ZH2LegacySwitchableFireClient 20901
{
    scale 1.5
    tag "Fire (large)"
}

actor ZH2LegacySwitchableFireHugeClient : ZH2LegacySwitchableFireClient 20907
{
    scale 3.0
    tag "Fire (huge)"
}