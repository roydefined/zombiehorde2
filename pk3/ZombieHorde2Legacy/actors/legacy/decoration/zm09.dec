Actor RaindropBig2 32767
 {
    //$Category Ibm Stuff
	+MISSILE
	+CLIENTSIDEONLY
	+SPAWNCEILING
	+ALLOWPARTICLES
	+DONTSPLASH
	Scale 0.3
	Height 0
/*	Alpha 0.3
	scale 0.1	
	Height 0
*/	Alpha 0.8
	Radius 54
	Height 4
 	States
	{
	Spawn: 
		IBWA B 9 A_JumpIf(waterlevel > 0, "Death")
		Loop
	Death:
		RAIN B 1  A_PlaySound ("RAIN_SOUND",6,1,0,1)
 		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", 0, 0, random (0, 20), 2, random(0,120))
		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", 0, 0, random (0, 20), 2, random(0,120))
		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", 0, 0, random (0, 20), 2, random(0,120))
		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", 0, 0, random (0, 20), 2, random(0,120))
		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", random(0, 20), random(0, 20), random (0, 20), 2, random(0,120))
		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", random(0, 20), random(0, 20), random (0, 20), 2, random(0,120))
		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", random(0, 20), random(0, 20), random (0, 20), 2, random(0,120))
		TNT1 A 0 A_CustomMissile ("IBMRAINPARTICLETHATFusedShouldNotReplaceAgain", random(0, 20), random(0, 20), random (0, 20), 2, random(0,120))
		RAIN B 1
 		Stop
 	}
}

