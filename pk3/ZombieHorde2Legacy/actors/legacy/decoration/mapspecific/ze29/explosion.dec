// Note, also used in ze17 and ZE08M
actor ZH2LegacyZE29Explosion : ZH2LegacyDecoration 20039
{
    scale 1.4
    States
    {
        Spawn:
            EXPN AA 0 A_PlaySound("sound/explosion2")
            TNT1 A 0 A_Explode(20, 128)
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle", 0, 0, 0, Random(-30, 30), Random(-30, 30), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle", 0, 0, 0, Random(-30, 30), Random(-30, 30), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle", 0, 0, 0, Random(-30, 30), Random(-30, 30), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle", 0, 0, 0, Random(-30, 30), Random(-30, 30), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle", 0, 0, 0, Random(-30, 30), Random(-30, 30), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle", 0, 0, 0, Random(-30, 30), Random(-30, 30), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle", 0, 0, 0, Random(-30, 30), Random(-30, 30), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle2", 0, 0, 0, Random(-15, 15), Random(-15, 15), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle2", 0, 0, 0, Random(-15, 15), Random(-15, 15), Random(0, 15))
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyZE29ExplosionParticle2", 0, 0, 0, Random(-15, 15), Random(-15, 15), Random(0, 15))
            EXPN ABCDEFGHIJKLMN 3
            Stop
    }
}

Actor ZH2LegacyZE29ExplosionParticle
{
    Height 0
    Radius 0
    Mass 0
    +Missile
    +NoBlockMap
    +DontSplash
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +THRUACTORS
    RenderStyle Add
    Scale 0.08
    States
    {
        Spawn:
            SPKO A 1 Bright A_FadeOut(0.005)
            Loop
    }
}

Actor ZH2LegacyZE29ExplosionParticle2
{
    Height 0
    Radius 0
    Mass 0
    +Missile
    +NoBlockMap
    +DontSplash
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +THRUACTORS
    RenderStyle Add
    Scale 1
    States
    {
        Spawn:
            COMT ABCDEFGHI 2 Bright
            Stop
    }
}