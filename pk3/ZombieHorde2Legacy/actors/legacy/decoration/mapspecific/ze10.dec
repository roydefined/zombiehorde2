actor ZH2LegacyMapSpecificDolletFire: ZH2LegacySwitchableFireClient 20908
{
	//$Category "Decoration/Legacy/Map specific"
	//$Sprite FFLGM0
	//$NotAngled
	
	-CLIENTSIDEONLY
	
	tag "Dollet fire (map specific)"
	
	states
	{
		active:
			TNT1 A 0 A_Jump(256, "activeloop")
			stop
	}
}

actor ZH2LegacyMapSpecificDolletFireHuge : ZH2LegacyMapSpecificDolletFire 20909
{
	//$Category "Decoration/Legacy/Map specific"
