// Note, this was initially doomednum 21007, but this one is already occupied by ZE20's map marker.
// I also increased the delay between explosions, as zombies are on fire for a very long time otherwise.
actor ZH2LegacyBurningFireDamage : ZH2LegacyDecoration 21042
{
    //$Sprite TNT2A0
    //$NotAngled

    Radius 64
    Height 128
    DamageType "ZH2SetOnFire"

    -NOGRAVITY
    -NOBLOCKMAP
    +DONTSPLASH
    +NODAMAGETHRUST

    states
    {
        spawn:
            TNT1 A 0 NoDelay A_PlaySound("decoration/fire")
            TNT1 A 15 A_Explode(4, 128)
            loop
    }
}