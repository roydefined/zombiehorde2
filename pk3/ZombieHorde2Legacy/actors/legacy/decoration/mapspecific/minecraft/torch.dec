actor ZH2LegacyMinecraftTorchSpawner : ZH2LegacyDecoration 20055
{
    +NOGRAVITY
    States
    {
        Spawn:
            TNT1 AA 0 A_SpawnitemEx("ZH2LegacyMinecraftTorchParticleSmoke", 0, 0, 0, 0, 0, 3)
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyMinecraftTorchParticleFlame", 0, 0, 0, 0, 0, 0)
            TNT1 A 50
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyMinecraftTorchParticleSmoke", 0, 0, 0, 0, 0, 3)
            TNT1 A 50
            TNT1 A 0 A_SpawnitemEx("ZH2LegacyMinecraftTorchParticleSmoke", 0, 0, 0, 0, 0, 3)
            TNT1 A 50
            loop
    }
}

Actor ZH2LegacyMinecraftTorchParticleSmoke
{
    Translation "0:255=[0,0,0]:[0,0,0]"
    Height 0
    Radius 0
    Mass 0
    +NOGRAVITY
    +Missile
    +NoBlockMap
    +DontSplash
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +THRUACTORS
    Scale 0.3
    States
    {
        Spawn:
            MCPF ABCDEFGH 2
            Stop
    }
}

Actor ZH2LegacyMinecraftTorchParticleFlame
{
    Height 0
    Radius 0
    Mass 0
    +NOGRAVITY
    +Missile
    +NoBlockMap
    +DontSplash
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +THRUACTORS
