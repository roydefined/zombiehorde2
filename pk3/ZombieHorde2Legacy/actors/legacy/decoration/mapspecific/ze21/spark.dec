ACTOR ZH2LegacyZe21SparkSpawn
{
  +NOGRAVITY
  -SOLID

  States
  {
  Spawn:
        TNT1 AA 0 A_SpawnitemEx("ZH2LegacyZe21SparkSmall", 0, random(-20, 20), random(-10, 10), random(2, 20), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkSmall", 0, random(-20, 20), random(-10, 10), random(2, 20), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkSmall", 0, random(-20, 20), random(-10, 10), random(2, 20), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkSmall", 0, random(-20, 20), random(-10, 10), random(2, 20), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkSmall", 0, random(-20, 20), random(-10, 10), random(2, 20), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkSmall", 0, random(-20, 20), random(-10, 10), random(2, 20), random(-10, 10), random(-5, 10), 0, 0, 0)

        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkMedium", 0, random(-20, 20), random(-10, 10), random(2, 10), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkMedium", 0, random(-20, 20), random(-10, 10), random(2, 10), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkMedium", 0, random(-20, 20), random(-10, 10), random(2, 10), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkMedium", 0, random(-20, 20), random(-10, 10), random(2, 10), random(-10, 10), random(-5, 10), 0, 0, 0)

        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkBig", 0, random(-20, 20), random(-10, 10), random(2, 10), random(-10, 10), random(-5, 10), 0, 0, 0)
        TNT1 A 0 A_SpawnitemEx("ZH2LegacyZe21SparkBig", 0, random(-20, 20), random(-10, 10), random(2, 10), random(-10, 10), random(-5, 10), 0, 0, 0)
        stop
  }
}


//--------------

actor ZH2LegacyZe21SparkSmall
{
  RenderStyle Add
  scale 0.05

  -SOLID
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD
  +MISSILE

   States
    {
       Spawn:
        TNT1 AA 0 A_Jump (256, "fade1", "fade2", "fade3")

        fade1:
          SPRK A 1 A_Fadeout(0.025)
        goto Spawn

        fade2:
          SPRK A 1 A_Fadeout(0.05)
        goto Spawn

        fade3:
          SPRK A 1 A_Fadeout(0.075)
        goto Spawn
    }
}

actor ZH2LegacyZe21SparkMedium : ZH2LegacyZe21SparkSmall
{scale 0.2}
actor ZH2LegacyZe21SparkBig : ZH2LegacyZe21SparkSmall
{scale 0.5}