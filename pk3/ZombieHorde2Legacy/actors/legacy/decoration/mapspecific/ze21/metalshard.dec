//--------------

actor ZH2LegacyZe21MetalShards
{
  RenderStyle Add
  scale 0.15

  -SOLID
  +CLIENTSIDEONLY
  +FORCEXYBILLBOARD

   States
    {
       Spawn:
        TNT1 AA 0 A_Jump (256, "fade1", "fade2", "fade3")

        fade1:
          SHRD ABCD 1 A_Fadeout(0.05)
        goto Spawn

        fade2:
          SHRD ABCD 1 A_Fadeout(0.15)
        goto Spawn

        fade3:
          SHRD ABCD 1 A_Fadeout(0.25)
        goto Spawn
    }
}