actor ZH2LegacyZM25DiscoThunderWhite : SwitchableDecoration
{
	+NoBlockMap
	+NoGravity
	+NoInteraction
	+NoClip
	-Solid 
	+CLIENTSIDEONLY
	Obituary "%o seen the light with a light Thunder."
	-COUNTKILL
	+FRIENDLY
	-SHOOTABLE
	Renderstyle Add
	Height 32
	Radius 16
	Alpha 0.2
	Scale 4.0
	states
	{
		Spawn:
		Active:
			TNT1 A 1 
			THND AAAA 1 Bright A_FadeIn(0.2)
			THND AAAA 4 Bright A_FadeOut(0.2)
			Goto Inactive
		Inactive:
			TNT1 A 1
			Stop
	}  
}

