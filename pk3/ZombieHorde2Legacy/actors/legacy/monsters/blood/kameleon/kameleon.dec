// Actor used in ZM16, ZM18 and ZM25

// TODO: This actor uses hardcoded content like script execution.
actor ZH2LegacyZM18Kameleon : ZH2LegacyMonster 28585
{
    Health 0x7fffffff
    radius 32
    height 64
    Speed 16
    Painsound ""
    Deathsound ""
    Activesound ""
    mass 0x7fffffff
    Obituary "%o was bluffed and assassinated by the Kameleon."
    tag "Kameleon"
    MONSTER
    +FLOORCLIP
    +FASTER
    +FASTMELEE
    +QUICKTORETALIATE
    +LOOKALLAROUND
    +FLOORCLIP
    +NODROPOFF
    +NOBLOCKMONST
    MaxDropOffHeight 64
    meleedamage 30
    meleerange 168
    PainChance 10
    States
    {
        Spawn:
            PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabScriptUsed",1,4)
            PLA3 A 0 ACS_ExecuteAlways(80,0,0,0,0)
            PLA3 A 0 ACS_ExecuteAlways(82,0,0,0,0)
            PLA3 A 0 A_GiveInventory("ZH2LegacyZM18LabScriptUsed",1)
            PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1,"Spawn2")
            PLA3 A 1 A_Look
            loop
        Spawn2:
            PLA3 A 1 A_Look
            loop
        See:
            PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabScriptUsed",1,4)
            PLA3 A 0 ACS_ExecuteAlways(80,0,0,0,0)
            PLA3 A 0 ACS_ExecuteAlways(82,0,0,0,0)
            PLA3 A 0 A_GiveInventory("ZH2LegacyZM18LabScriptUsed",1)
            PLA3 A 0 ACS_ExecuteAlways(83,0,0,0,0)
            PLA3 A 0 A_ChangeFlag("FRIGHTENED", 0)
            PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1,"See2")
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Seee")
            PLA3 AABBCCDD 2 A_Chase
            Goto See
        Seee:
            PLA3 A 0 A_ChangeFlag("FRIGHTENED", 1)
            PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1,"See2")
            PLA3 AABBCCDD 2 A_Chase
            Goto See
        See2:
            INCA A 0 A_ChangeFlag("FRIGHTENED", 0)
            INCA AABBCCDD 2 A_Chase
            Goto See
        Melee:
            PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1,"Melee2")
            PLA3 A 0 A_PlaySound("monster/kameleon/melee")
            PLA3 E 5 A_MeleeAttack
            goto see
        Melee2:
            INCA A 0 A_PlaySound("monster/kameleon/melee")
            INCA E 5 A_MeleeAttack
            goto see
        Pain:
            PLA3 A 0 A_JumpIfInventory("ZH2LegacyZM18LabYouCanSeeMe",1,"Pain2")
            PLA3 A 5 ACS_ExecuteAlways(84,0,0,0,0)
            goto see
        Pain2:
            INCA A 5 ACS_ExecuteAlways(84,0,0,0,0)
            goto see
        Death:
            stop
    }
}