actor ZH2LegacyZM20GhoulCat : ZH2LegacyMonster
{
    Obituary "%o got owned by the Ghoul Cat."
    tag "Ghoul Cat"
    Health 0x7fffffff
    PainChance 180
    Speed 20
    Radius 16
    Height 56
    Mass 0x7fffffff
    scale 1.25
    meleedamage 9999
    meleerange 64
    Monster
    +FLOORCLIP
    +FASTER
    +FASTMELEE
    +QUICKTORETALIATE
    +LOOKALLAROUND
    States
    {
        Spawn:
            GCAT A 10 bright
        Spawn.Rest:
            GCAT A 10 bright A_Look
            Loop

        See:
            TNT1 A 0 A_JumpIf(CallACS("zh2_dec_gettargetiszombie") == true, "Spawn")
            GCAT A 1 bright A_Chase
            Loop

        Melee:
            GCAT A 1 bright A_FaceTarget
            GCAT A 2 bright A_MeleeAttack
            Goto See

        Paint:
            GCAT A 2 bright A_Pain
            Goto See

        Death:
            GCAT A 8
            GCAT A 8 A_Scream
            GCAT A 4
            GCAT A 4 A_NoBlocking
            GCAT AAAAAAAAAAAAAAA 4 A_fadeout(0.2)
            Stop
    }
}