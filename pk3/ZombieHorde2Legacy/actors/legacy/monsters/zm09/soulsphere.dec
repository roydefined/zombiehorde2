//Ghoul Demon, Aka SoulSphere. CREATED BY IBM5155


actor ghouldemon 31197
{
  //$Category Ibm Stuff
  MONSTER
  Radius 31
  Height 56
  Tag "Soul Sphere"
  CameraHeight 56
  Health 100000
  Mass 400
  Speed 24
  PainChance 180
  SeeSound "start"
  PainSound ""
  DeathSound "gdde"
  ActiveSound "gdsee"
  AttackSound "gdmel"
  MeleeSound "gdmel"
  MeleeDamage  2 
  +GHOST +NOCLIP +NOGRAVITY +FLOAT +LOOKALLAROUND
  Obituary "%o was killed by the soulsphere."
  States 
  {
  Spawn:
    ghol A 1 A_Look
    Loop
  See:
	ghol AAAAAAAAAAAA 2 A_Chase
    ghol A 0 a_jump(10,1)
	Goto See+1
	ghol A 1 A_SetTranslucent(0.90)
    ghol A 1 A_SetTranslucent(0.80)
    ghol A 1 A_SetTranslucent(0.70)
    ghol A 1 A_SetTranslucent(0.60)
    ghol A 1 A_SetTranslucent(0.50)
    ghol A 1 A_SetTranslucent(0.40)
    ghol A 1 A_SetTranslucent(0.30)
    ghol A 1 A_SetTranslucent(0.20)
    ghol A 1 A_SetTranslucent(0.00)
	ghol AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	ghol AAAAAAAAAAAAAAAA 0 A_Wander
	ghol AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	ghol AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	ghol AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	ghol AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	ghol AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	ghol AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 A_Chase
	ghol A 1 A_SetTranslucent(0.10)
    ghol A 1 A_SetTranslucent(0.20)
    ghol A 1 A_SetTranslucent(0.30)
    ghol A 1 A_SetTranslucent(0.40)
    ghol A 1 A_SetTranslucent(0.50)
    ghol A 1 A_SetTranslucent(0.60)
    ghol A 1 A_SetTranslucent(0.70)
    ghol A 1 A_SetTranslucent(0.80)
    ghol A 1 A_SetTranslucent(0.90)
    ghol A 1 A_SetTranslucent(1.0)
	Goto see
  Melee:
    ghol A 0 A_SetTranslucent(1.0)
	ghol B 0 A_FaceTarget
	ghol BC 2 A_CustomMeleeAttack(ACS_ExecuteWithResult(18))
    Goto See
  Death:
    ghol EGH 4 
    ghol IJ 0 A_Scream
	ghol IJ 4
    ghol KL 4
    ghol MNO 4 A_SetTranslucent(1.0,0)
    ghol PQS 4 A_Fall
    ghol S -1 A_SetFloorClip
    Stop
  Raise:
    ghol L 8 A_UnSetFloorClip
    ghol KJIHG 8
    Goto See
  }
}

actor KILLghouldemon : ghouldemon 30768
{
	health 1600
	+SOLID
}