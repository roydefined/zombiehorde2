	TNT1 A 0 A_JumpIf(user_RavishingInvisibleCounter>40,"GHOULALPHAOUT")
	//START THE ACTIVE SOUND CODE
	TNT1 A 0 A_Jump(256,"GHOULSND")
    Loop
  Melee:
 	TNT1 A 0 A_SetUserVar("user_RavishingStuckcnt",0)
    ghou A 0 A_ChangeFlag("INVULNERABLE",false)
 	ghuu A 0 ACS_ExecuteAlways(46,0,tid,4)
	ghou A 1 A_SetTranslucent (1.0,0) 
	ghou G 0 A_Playsound("EFF8")
    ghou G 1 A_FaceTarget
    ghou G 1 A_MeleeAttack
    ghou HIJKJIH 1
	ghou A 0 A_ChangeFlag("NOCLIP",0) 
	ghou A 0 A_ChangeFlag("NOGRAVITY",0)
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",0)//reset counter
	ghou A 0 A_SetUserVar("user_RavishingIsInvisible",0)//Force Ravishing to be visible
	ghou A 0 A_SetUserVar("user_RavishingInvisibleCounter",0)// reset invisible counter
