/*
RAVISHING, CREATED BY IBM5155
*/




actor ravishing 31198
{
  //$Category Ibm Stuff
  MONSTER
  Radius 20//31
  Height 66
  CameraHeight 66
  Health 5000000
  Mass 10000
  Speed 16
  Vspeed 16
  scale 0.16
  PainChance 180
   +FLOORCLIP +DONTHURTSPECIES +NOTARGET +BOSS +INVULNERABLE +LOOKALLAROUND
  SeeSound "EFF6"
  PainSound "EFF9"
  DeathSound "EFF7"
  ActiveSound ""
  AttackSound ""
  MeleeSound ""
  MeleeDamage  15
  Obituary "%o was killed by the ravishing"
  states
  {
  Spawn:
    ghou A 1
	ghou A 0 ACS_Execute(10,0)
	ghou A 0 A_ChangeFlag("NOCLIP",0) 
	ghou A 0 A_ChangeFlag("NOGRAVITY",0)
	ghou A 0 A_UnsetFloat
    ghou A 1 A_Look
    Loop
  See:
    ghou A 4 A_Chase
	ghou B 4 A_Chase
	ghou C 4 A_Chase
	ghou D 4 A_Chase
	ghou E 4 A_Chase
	TNT1 A 0 A_JumpIf(ACS_ExecuteWithResult(9,0)==1,"GHOULALPHAIN")
	TNT1 A 0 A_JumpIf(ACS_ExecuteWithResult(9,0)==2,"GHOULALPHAOUT")
    Loop
  Melee:
    TNT1 A 0 ACS_Execute(8,0)
	ghou A 1 A_SetTranslucent (1.0,0)
	ghou G 0 A_Playsound("EFF8")
    ghou G 1 A_FaceTarget
    ghou G 1 A_MeleeAttack
    ghou HIJKJIH 1
	ghou A 0 A_ChangeFlag("NOCLIP",0) 
	ghou A 0 A_ChangeFlag("NOGRAVITY",0)
	ghou A 0 A_UnsetFloat
	Goto See
  Pain:
    ghou a 2 A_Pain
	Goto See

  GHOULALPHAIN:
    ghou A 0 A_ChangeFlag("NOCLIP",1)
	ghou A 0 A_ChangeFlag("NOGRAVITY",1)
	ghou A 0 A_SetFloat
    ghou A 1 A_SetTranslucent (1.0,0)
	ghou A 1 A_SetTranslucent (0.9,0)
	ghou A 1 A_SetTranslucent (0.8,0)
	ghou A 1 A_SetTranslucent (0.7,0)
	ghou A 1 A_SetTranslucent (0.6,0)
	ghou A 1 A_SetTranslucent (0.5,0)
	ghou A 1 A_SetTranslucent (0.4,0)
	ghou A 1 A_SetTranslucent (0.3,0)
	ghou A 1 A_SetTranslucent (0.2,0)
	ghou A 1 A_SetTranslucent (0.1,0)
	ghou A 1 A_SetTranslucent (0.02,0)
	Goto see
  GHOULALPHAOUT:
    ghou A 1 A_SetTranslucent (0.0,0)
	ghou A 1 A_SetTranslucent (0.1,0)
	ghou A 1 A_SetTranslucent (0.2,0)
	ghou A 1 A_SetTranslucent (0.3,0)
	ghou A 1 A_SetTranslucent (0.4,0)
	ghou A 1 A_SetTranslucent (0.5,0)
	ghou A 1 A_SetTranslucent (0.6,0)
	ghou A 1 A_SetTranslucent (0.7,0)
	ghou A 1 A_SetTranslucent (0.8,0)
	ghou A 1 A_SetTranslucent (0.9,0)
	ghou A 1 A_SetTranslucent (1.0,0)
    ghou A 0 A_ChangeFlag("NOCLIP",0)
	ghou A 0 A_ChangeFlag("NOGRAVITY",0)
	ghou A 0 A_UnsetFloat
	Goto see
  Death:
	ghou A 8 
    ghou B 8 A_Scream
    ghou C 8
    ghou D 8 A_SetTranslucent(1.0,0)
    ghou E 8 A_Fall
	ghou D 8
	ghou E 8
    tnt1 A -1 A_SetFloorClip
    Stop
  Raise:
    SCPG A 8 A_UnSetFloorClip
    SCPG A 8
    Goto See
  }
}

actor ravishingBETA 30765
{
  //$Category Ibm Stuff
  MONSTER
  Radius 20//31
  Height 66
  CameraHeight 66
  Health 5000000
  Mass 10000
  Speed 4
  Vspeed 4
  scale 0.16
  PainChance 180
   +FLOORCLIP +DONTHURTSPECIES +NOTARGET +BOSS +INVULNERABLE +LOOKALLAROUND +SOLID
  SeeSound "EFF6"
  PainSound "EFF9"
  DeathSound "EFF7"
  ActiveSound ""
  AttackSound ""
  MeleeSound ""
  MeleeDamage  15
  Obituary "%o was killed by the ravishing"
  
  var int user_RavishingStuckcnt;
  var int user_RavishingStuckTest;
  var int user_RavishingIsInvisible;//: 0 = not invisible, 1 = is invisible
  var int user_RavishingSoundCounter;//A counter to helps ravishing to know the time to play the next sound
  var int user_RavishingInvisibleCounter;//count the amount of loop/time the ravishing is invisible/visible
  //GHOULSND OK | MELEE OK | DEATH OK SPAWN +- | PAIN OK | GHOULALPHAIN OK | GHOULALPHAOUT OK 
  states
  {
  Spawn:
    ghou A 1
//	ghou A 0 ACS_Execute(10,0)
	ghou A 0 A_ChangeFlag("NOCLIP",0) 
	ghou A 0 A_ChangeFlag("NOGRAVITY",0)
	ghou A 0 A_UnsetFloat
	ghou A 0 A_SetUserVar("user_RavishingStuckcnt",0)
	ghou A 0 A_SetUserVar("user_RavishingStuckTest",0)
	ghou A 0 A_SetUserVar("user_RavishingIsInvisible",0)//reset counter
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",0)//reset visibility atribute
	ghou A 0 A_SetUserVar("user_RavishingInvisibleCounter",0)//reset visibility atribute
    ghou A 1 A_Look
    Loop
  See:

	TNT1 A 0 A_SetUserVar("user_RavishingStuckTest",x+y+Z)
	ghou A 0 A_FaceTarget
    ghou A 1 A_Chase
	ghou A 0 A_FaceTarget
    ghou A 1 A_Chase
	ghou A 0 A_FaceTarget
    ghou A 1 A_Chase
	ghou A 0 A_FaceTarget
    ghou A 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou B 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou B 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou B 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou B 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou C 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou C 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou C 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou C 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou D 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou D 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou D 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou D 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou E 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou E 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou E 1 A_Chase
	ghou A 0 A_FaceTarget
	ghou E 1 A_Chase
	TNT1 A 0 A_Jumpif(user_RavishingStuckTest>=x+y+z -2 && user_RavishingStuckTest<=x+y+z +2,3)
//  {
		TNT1 A 0 A_SetUserVar("user_RavishingStuckcnt",0)
		TNT1 A 0 A_Jump(256,3)
//	}
//	else{
		TNT1 A 0 A_SetUserVar("user_RavishingStuckcnt",user_RavishingStuckcnt+1)
		TNT1 A 0 A_Jumpif(user_RavishingStuckcnt == 5,"GHOULALPHAIN")
//	}

	
	ghou A 0 A_SetUserVar("user_RavishingInvisibleCounter",user_RavishingInvisibleCounter+1)
	//TEST IF RAVISHING NEEDS TO BE INVISIBLE
	TNT1 A 0 A_JumpIf(user_RavishingIsInvisible==1,3)// if it's invisible, jump the visible counter
	TNT1 A 0 A_JumpIf(user_RavishingInvisibleCounter>30,"GHOULALPHAIN")
	TNT1 A 0 A_Jump(256,2)
	//TEST IF RAVISHING NEEDS TO BE VISIBLE
	TNT1 A 0 A_JumpIf(user_RavishingInvisibleCounter>40,"GHOULALPHAOUT")
	//START THE ACTIVE SOUND CODE
	TNT1 A 0 A_Jump(256,"GHOULSND")
    Loop
  Melee:
	TNT1 A 0 A_SetUserVar("user_RavishingStuckcnt",0)
 	ghou A 0 ACS_ExecuteAlways(46,0,tid,4)
	ghou A 1 A_SetTranslucent (1.0,0) 
	ghou G 0 A_Playsound("EFF8")
    ghou G 1 A_FaceTarget
    ghou G 1 A_MeleeAttack
    ghou HIJKJIH 1
	ghou A 0 A_ChangeFlag("NOCLIP",0) 
	ghou A 0 A_ChangeFlag("NOGRAVITY",0)
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",0)//reset counter
	ghou A 0 A_SetUserVar("user_RavishingIsInvisible",0)//Force Ravishing to be visible
	ghou A 0 A_SetUserVar("user_RavishingInvisibleCounter",0)// reset invisible counter
	ghou A 0 A_UnsetFloat
	Goto See
  Pain:
    ghou a 2 A_Pain
	Goto See
  GHOULSND: //Part of decorate that take care of the active sound part
    //VISIBLE
	ghou A 0 A_JumpIf(user_RavishingIsInvisible==1,5)//If he's invisible, goto the invisible area
	ghou A 0 A_JumpIf(user_RavishingSoundCounter<=3,8)// if it's not ready to play the music, jump to the incremental part
	ghou A 0 A_Playsound("EFF10")//invisible active sound
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",0)//reset counter
	ghou A 0 A_Jump(256,6)
	//INVISIBLE
	ghou A 0 A_JumpIf(user_RavishingSoundCounter<=2,4)// if it's not ready to play the music, jump to the incremental part
    ghou A 0 A_Playsound("EFF5")// visible active sound
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",0)//reset counter
	ghou A 0 A_Jump(256,2)
	//INCREMENT AREA
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",user_RavishingSoundCounter + 1)//increment counter
	//END
	ghou A 0 //nothing here
	Goto see
  GHOULALPHAIN:
	TNT1 A 0 A_SetUserVar("user_RavishingStuckcnt",0)
    ghou A 0 A_ChangeFlag("NOCLIP",1)
	ghou A 0 A_ChangeFlag("NOGRAVITY",1)
	ghou A 0 A_SetFloat
    ghou A 1 A_SetTranslucent (1.0,0)
	ghou A 1 A_SetTranslucent (0.9,0)
	ghou A 1 A_SetTranslucent (0.8,0)
	ghou A 1 A_SetTranslucent (0.7,0)
	ghou A 1 A_SetTranslucent (0.6,0)
	ghou A 1 A_SetTranslucent (0.5,0)
	ghou A 1 A_SetTranslucent (0.4,0)
	ghou A 1 A_SetTranslucent (0.3,0)
	ghou A 1 A_SetTranslucent (0.2,0)
	ghou A 1 A_SetTranslucent (0.1,0)
	ghou A 1 A_SetTranslucent (0.02,0)
	ghou A 0 A_SetUserVar("user_RavishingIsInvisible",1)
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",0)
	ghou A 0 A_SetUserVar("user_RavishingInvisibleCounter",0)// reset invisible counter
 	gouu A 0 ACS_ExecuteAlways(46,0,tid,6)
	Goto see
  GHOULALPHAOUT:
    ghou A 1 A_SetTranslucent (0.0,0)
	ghou A 1 A_SetTranslucent (0.1,0)
	ghou A 1 A_SetTranslucent (0.2,0)
	ghou A 1 A_SetTranslucent (0.3,0)
	ghou A 1 A_SetTranslucent (0.4,0)
	ghou A 1 A_SetTranslucent (0.5,0)
	ghou A 1 A_SetTranslucent (0.6,0)
	ghou A 1 A_SetTranslucent (0.7,0)
	ghou A 1 A_SetTranslucent (0.8,0)
	ghou A 1 A_SetTranslucent (0.9,0)
	ghou A 1 A_SetTranslucent (1.0,0)
    ghou A 0 A_ChangeFlag("NOCLIP",0)
	ghou A 0 A_ChangeFlag("NOGRAVITY",0)
	ghou A 0 A_UnsetFloat
	ghou A 0 A_SetUserVar("user_RavishingIsInvisible",0)
	ghou A 0 A_SetUserVar("user_RavishingSoundCounter",0)
	ghou A 0 A_SetUserVar("user_RavishingInvisibleCounter",0)// reset invisible counter
 	gouu A 0 ACS_ExecuteAlways(46,0,tid,4)
	Goto see
  Death:
	ghou A 8 
    ghou B 8 A_Scream
    ghou C 8
    ghou D 8 A_SetTranslucent(1.0,0)
    ghou E 8 A_Fall
	ghou D 8
	ghou E 8
    tnt1 A -1 A_SetFloorClip
    Stop
  Raise:
    ghou A 8 A_UnSetFloorClip
    ghou A 8
    Goto See
  }
}

