		TNT1 A 0 A_SetUserVar("user_RavishingStuckcnt",user_RavishingStuckcnt+1)
		TNT1 A 0 A_Jumpif(user_RavishingStuckcnt == 5,"GHOULALPHAIN")
//	}
	ghou A 0 A_SetUserVar("user_RavishingInvisibleCounter",user_RavishingInvisibleCounter+1)
	//TEST IF RAVISHING NEEDS TO BE INVISIBLE
	TNT1 A 0 A_JumpIf(user_RavishingIsInvisible==1,3)// if it's invisible, jump the visible counter
	TNT1 A 0 A_JumpIf(user_RavishingInvisibleCounter>30,"GHOULALPHAIN")
	TNT1 A 0 A_Jump(256,2)
