// Note, uses a lot of native functions.
// Also note: This monster doesn't care about zombies because its native inherited actor interferes with this a ton.

Actor ZH2LegacyZe24KoraxAndDSparil : Heresiarch 31999
{
    // TODO: Have this added as a constant value like the rest.
    //$Category "Monsters/Legacy"

    Health 16000
    Painchance 10
    Speed 18
    Radius 62
    Height 133
    Mass 800
    MaxStepHeight 32
    Damage 15
    MinMissileChance 192

    MONSTER
    +BOSS
    +FLOORCLIP
    +DONTMORPH
    +NOTARGET
    +NOICEDEATH
    +TELESTOMP
    +QUICKTORETALIATE

    BloodColor "grey55"
    SeeSound "KoraxDSparil/Sight"
    ActiveSound "KoraxDSparil/Active"
    PainSound "KoraxDSparil/Pain"
    DeathSound "KoraxDeath"

    Obituary "%o was removed from the game by Korax and DSparil."
    tag "Korax and D'Sparil"

    States
    {
        Spawn:
            KOSR A 3
            KOSR A 2 A_SorcSpinBalls

        Idle:
            KOSR A 10 A_Look
            Wait

        See:
            KOSR A 9
            KOSR B 0 A_Jump(220,3)
            KOSR B 3 A_FastChase
            KOSR B 0 A_Jump(256,2)
            KOSR B 3 A_Chase
            KOSR B 9
            KOSR C 0 A_PlaySound("KoraxStep")
            KOSR C 0 A_Jump(220,3)
            KOSR C 3 A_FastChase
            KOSR C 0 A_Jump(256,2)
            KOSR C 3 A_Chase
            KOSR C 9
            KOSR D 0 A_Jump(220,3)
            KOSR D 3 A_FastChase
            KOSR D 0 A_Jump(256,2)
            KOSR D 3 A_Chase
            KOSR D 9
            KOSR A 0 A_PlaySound("KoraxStep")
            KOSR A 0 A_Jump(220,3)
            KOSR A 3 A_FastChase
            KOSR A 0 A_Jump(256,2)
            KOSR A 3 A_Chase
            Loop

        Pain:
            KOSR H 5 A_Pain
            KOSR H 5
            Goto See

        Missile:
            TNT1 A 0 A_Jump(5,"Teleport")
            KOSR I 6 Bright A_FaceTarget
            KOSR I 6 Bright A_SpeedBalls
            KOSR I 6 Bright A_FaceTarget
            Wait

        DSparilAttack:
        Attack1:
            KOSR H 9
            KOSR I 9
            KOSR J 9 A_FaceTarget
            KOSR K 0 A_PlaySound("dsparil/attack")
            KOSR K 3 A_CustomMissile("Sorcerer2FX1",100)
            KOSR K 6 A_SpawnFizzle
            KOSR K 5 A_FaceTarget
            Goto Attack1+5

        KoraxAttack:
        Attack2:
            KOSR E 8 Bright A_FaceTarget
            KOSR E 0 A_PlaySound("KoraxAttack")
            KOSR E 0 A_Jump(128,7)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilComet",54,-52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilComet",53,52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilComet",82,-52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilComet",86,52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilComet",108,-35,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilComet",104,35,0,4,0)
            Goto EndKoraxAttack
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilFX1",54,-52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilFX1",53,52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilFX1",82,-52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilFX1",86,52,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilFX1",108,-35,0,4,0)
            KOSR E 0 A_CustomMissile ("ZH2LegacyZe24KoraxAndDSparilFX1",104,35,0,4,0)
            Goto EndKoraxAttack

        EndKoraxAttack:
            KOSR F 8 Bright A_SorcBossAttack
            KOSR E 5 Bright
            Goto See

        Teleport:
            KOSR A 0 A_PlaySound("misc/teleportRaven")
            KOSR A 0 A_SpawnItem("ZH2LegacyZe24KoraxAndDSparilTeleportFade")
            KOSR A 0 A_UnSetSolid
            KOSR A 0 A_SetInvulnerable
            KOSR AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_Wander
            KOSR A 0 A_UnSetInvulnerable
            KOSR A 0 A_SetSolid
            EndTeleport:
            KOSR TSRQPONML 6
            Goto See

        Death:
            KOSR UVWXY 5
            KORX H 0 A_SetAngle(90+Angle)
            KORX H 0 A_SpawnItem("ZH2LegacyZe24DSparilDeathAnimation",50)
            KORX H 0 A_SetAngle(Angle-90)
            KORX HI 5
            KORX J 5 A_FaceTarget
            KORX K 5 A_Scream
            KORX LMNOP 5
            KORX Q 10
            KORX R 5
            KORX S 5 A_NoBlocking
            KORX TU 5
            KORX V -1
            Stop
    }
}

actor ZH2LegacyZe24DSparilDeathAnimation
{
    Radius 16
    Height 70
    Mass 300
    +SOLID
    States
    {
        Spawn:
            SDTH A 8
            SDTH B 8
            SDTH C 8 A_PlaySoundEx("dsparil/scream","Body",0,0.0)
            SDTH DEFDEFDEFDEFDEFDEFDEF 7
            SDTH G 6 A_PlaySoundEx("dsparil/explode","Body",0,0.0)
            SDTH H 6
            SDTH I 18
            SDTH J 6 A_UnSetSolid
            SDTH K 6 A_PlaySoundEx("dsparil/bones","Body",0,0.0)
            SDTH LMN 6
            SDTH O -1
            Stop
    }
}

actor ZH2LegacyZe24KoraxAndDSparilTeleportFade
{
    +NOBLOCKMAP
    States
    {
        Spawn:
            KOSR LMNOPQRST 6
            Stop
    }
}

actor ZH2LegacyZe24KoraxAndDSparilFX1
{
    Speed 25
    Radius 5
    Height 5
    Damage 10
    Projectile
    States
    {
        Spawn:
            SBS1 A 2 Bright
            SBS1 BCD 3 Bright
            Loop
        Death:
            FHFX S 2 Bright A_Explode(30,128)
            FHFX SS 6 Bright
            Stop
    }
}

actor ZH2LegacyZe24KoraxAndDSparilFX2 : Sorcerer2FX1 replaces SorcFX3 {}

actor ZH2LegacyZe24KoraxAndDSparilComet
{
    Radius 6
    Height 8
    Speed 20
