            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilFireSpark",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilBoulder",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilBoulder",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilBoulder",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
            TNT1 A 0 Bright A_SpawnItemEx("ZH2LegacyZe24KoraxAndDSparilBoulder",Random(-5,5),Random(-5,5),Random(0,10),Random(-5,5),Random(-5,5),Random(0,10),Random(90,270),128)
