actor ZH2LegacyZe24KoraxAndDSparilCometTail
{
    PROJECTILE
    RENDERSTYLE ADD
    +NOCLIP
    ALPHA 0.4
    States
    {
        Spawn:
            AF03 ABCDEFGHI 1 Bright
            Stop
    }
}

Actor ZH2LegacyZe24KoraxAndDSparilFireSpark
{
    Projectile
    Speed 5
    Scale 0.1
    Gravity 0.5
    +HexenBounce
    +ForceXYBillboard
    -NoGravity
    +NoTeleport
    +DontSplash
    +NOCLIP
    RenderStyle Add
    States
    {
        Spawn:
            ORPA A 10 Bright
            ORPA A 1 Bright A_FadeOut(0.1)
            Wait
    }
}

actor ZH2LegacyZe24KoraxAndDSparilBoulder
{
    PROJECTILE
    -NOGRAVITY
    +DOOMBOUNCE
    +CANBOUNCEWATER
    +BOUNCEONACTORS
    Radius 6
    Height 6
    Speed 20
    VSpeed 3
    Scale 0.2
    States
    {
        Spawn:
            SE01 ABCDEFGH 3
            Loop
        Death:
            SE01 H 100
            SE01 H 5 A_SetTranslucent(0.9,0)
            SE01 H 5 A_SetTranslucent(0.8,0)
            SE01 H 5 A_SetTranslucent(0.7,0)
            SE01 H 5 A_SetTranslucent(0.6,0)
            SE01 H 5 A_SetTranslucent(0.5,0)
            SE01 H 5 A_SetTranslucent(0.4,0)
            SE01 H 5 A_SetTranslucent(0.3,0)
            SE01 H 5 A_SetTranslucent(0.2,0)
            SE01 H 5 A_SetTranslucent(0.1,0)
            SE01 H 5 A_SetTranslucent(0.0,0)
            Stop
    }
}
