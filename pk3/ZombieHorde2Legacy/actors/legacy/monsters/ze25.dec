actor ZH2LegacyZE25Weegee
{
    monster

    health 1500
    radius 100
    height 256
    mass 0x7FFFFFFF
    speed 0

    -NOGRAVITY
    +STANDSTILL

    states
    {
        Spawn:
            WEGE A 10 A_Look
            loop

        See:
            WEGE A 10 A_Chase
            loop

        Death:
            WEGE ABCDEABCDE 5
            WEGE ABCDEABCDE 4
            WEGE ABCDEABCDE 3
            WEGE ABCDEABCDE 2
            WEGE ABCDEABCDEABCDEABCDEABCDEABCDE 1
            TNT1 A 0 ACS_NamedExecuteAlways("zh2_dec_ze25_weegee_ondeath", 0)
            TNT1 A 0 A_PlaySound("world/nuke1")
            stop
    }
}