// These will also trigger an error in UDB because `TNT1A0` is a sprite it can't visualize.
actor ZH2LegacyRemovedActor
{
	//$Category "Legacy removed actors"
	//$Obsolete
	
	+NOINTERACTION
	
	tag "Removed actor"
	
	states
	{
		spawn:
			TNT1 A -1
			stop
	}
}

actor ZH2LegacyTodoActor
{
	//$Category "Todo"
	
	+NOINTERACTION
	
	tag "Actor not yet added"
	
	states
	{
		spawn:
			TNT1 A -1
			stop
	}
}

#include "actors/legacy/todo.dec"
#include "actors/legacy/removed.dec"
#include "actors/legacy/replaced/replaced.dec"

#include "actors/legacy/items/items.dec"
#include "actors/legacy/keys/keys.dec"
#include "actors/legacy/decoration/decoration.dec"
#include "actors/legacy/monsters/monsters.dec"
#include "actors/legacy/lightsources/lightsources.dec"
#include "actors/legacy/obstacles/obstacles.dec"
#include "actors/legacy/weapons/weapons.dec"