actor ZH2LegacyReplacedChandelier : ZH2LegacyReplacedLightSource 20204
{
    Health 10
    Radius 20
    Height 60
    Mass 0x7fffffff

    +SHOOTABLE
    +NOGRAVITY
    +SOLID
    +NOBLOOD

    States
    {
        Spawn:
            CDLR ABC 4
            Loop

        Death:
            TNT1 A 0 A_SpawnItemEx("ZH2LegacyReplacedBrokenChandelier", 0, 0, 0, 0, 0, 0, 0, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2LegacyReplacedFallingChandelier", 0, 0, -5, 0, 0, -10, 0, 0)
            TNT1 A 1
            stop
    }
}

actor ZH2LegacyReplacedBrokenChandelier
{
  Radius 20
  Height 60

  +NOGRAVITY
  -SOLID

  States
  {
    Spawn:
        CDLR D -1
        stop
  }
}

actor ZH2LegacyReplacedFallingChandelier
{
    PROJECTILE
    Radius 20
    Height 60

    +Ripper

    DeathSound "decorate/chandelier"

    States
    {
        Spawn:
            CDLR E 0 A_JumpIf(momz == 0,"Death")
            CDLR E 1
            loop

        Death:
            CDLR F 0 A_XScream
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, 0, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, 30, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, 60, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, 90, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, 120, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, 150, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, 180, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, -30, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, -60, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, -90, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, -120, 2)
            CDLR F 0 Bright A_CustomMissile("ZH2LegacyChandelierBurningFire", 0, 0, -150, 2)
            CDLR F 8 Bright ACS_NamedExecuteAlways("zh2_dec_setfire_area", 0, 150, 300, 300)
            CDLR F -1
            loop
    }
}

actor ZH2LegacyChandelierBurningFire
{
    Speed 5

    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +DONTSPLASH
    +NOTIMEFREEZE
    +NOBLOCKMAP
    +BRIGHT
    +NOGRAVITY
    +NOBLOCKMAP
    +NOCLIP

    RenderStyle Translucent
    Alpha 0.6

    States
    {
        Spawn:
            FIR1 ABCDABCDABCDEFGHI 1
            stop
    }
}