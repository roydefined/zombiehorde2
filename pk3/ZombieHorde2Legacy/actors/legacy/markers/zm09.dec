actor TOP_SKY{
    //$Category Ibm Stuff
	+NOINTERACTION
	+CEILINGHUGGER
    Radius 0
    Height 0
	States
	{
	Spawn: 
		IBWA A 12 A_SpawnItemEx("Raindrop3", random(-128, 128), random(-128, 128), random(-128, 128), 0, 0, 0, 0, 0, 0)
		Stop
	}
}

actor NedmMarker : MapMarker 31301
{
//$Category Ibm Stuff
	States {
		Spawn:
			NEDM A -1
		stop
	}
}

