Map ZE20
{
    Properties
    {
        GameMode "Escape",
        IsLegacyMap true,
        Graphic "IMGZE20",
    },

    Resist
    {
        GlobalPreResistScript "pre_resist_handler",
        GlobalPostResistScript "post_resist_handler",

        // Time reasons are drawn through a hook, which colors the countdown number based on time left.
        Definitions
        [
            {
                Length 35,
                TopReasonLabel "Power generator starting",
                TimeReasonLabel "Resist: %t",

                Flags
                {
                    HideTopReason,
                    HideTimeReason,
                    NoFade,
                }
            },
            {
                Length 10,
                TopReasonLabel "Dynamite set, prepare for explosion.",
                TimeReasonLabel "Resist: %t",

                Flags
                {
                    HideTopReason,
                    HideTimeReason,
                    NoFade,
                }
            },
            {
                Length 55,
                TopReasonLabel "Cataclism is coming!",
                TimeReasonLabel "Resist: %t",

                Flags
                {
                    HideTopReason,
                    HideTimeReason,
                    NoFade,
                }
            },
        ]
    },
},

