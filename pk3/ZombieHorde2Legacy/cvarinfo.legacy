// If `true`, falling off the map will freeze humans.
server bool sv_zh2_ze11_enablefrozenteleporting = true;

// If `true`, the map will show dynamic lights
user bool cl_zh2_ze14_enabledynamiclights = true;

// Manage ZE26's flow.
// 0 - Randomized.
// 1 - Force right gate
// 2 - Force left gate
server int sv_zh2_ze26flow = 0;

// If `true`, the map will show dynamic lights
user bool cl_zh2_zm14_enabledynamiclights = true;