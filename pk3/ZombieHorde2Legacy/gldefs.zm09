
pointlight IBMLIGHT1
{
    color 0.2 0.2 0.2//50
    size 256
    offset 0 16 0
}

pointlight IBMLIGHT2
{
    color 0.3 0.3 0.3
    size 256
    offset 0 16 0
}


pointlight IBMLIGHT3
{
    color 1.0 1.0 1.0
    size 128
    offset 0 16 0
}

pointlight IBMSCARELIGHT
{
	color 0.3 0.3 0.3
    size 512
	subtractive 1
	dontlightself 1 

}

flickerlight WhiteFlare
{
	color 1.0 1.0 1.0
	size 160
	secondarySize 96
	chance 0.9999
}

object phaselight1 {
	frame IBMA {light IBMLIGHT1}
}
object phaselight2 {
	frame IBMA {light IBMLIGHT2}
}
object phaselight3 {
	frame IBMA {light IBMLIGHT3}
}
object IMSCARED2{
	frame SCAR {light IBMSCARELIGHT}
}

