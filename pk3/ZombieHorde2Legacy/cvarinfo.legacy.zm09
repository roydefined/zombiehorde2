// ZM09 - Map Settings
// Packed integer encoding all per-client map settings.
// Format: (music_quality+1)*10000 + (rain_detail+2)*1000 + (rain_sound+2)*100 + (weather_quality+2)*10 + (nedm_desactive+2 + reflection_actived*2)
// Written by zm09_save_settings() / read by zm09_update_settings() on map open.
user int x_zh_zm09 = 0;

// ZM09 - Play Statistics

// How many times the map was loaded/played (incremented on map open, script 1).
server int x_zh_zm09_cn = 0;

// How many times humans won (all zombies eliminated at round end, script 1).
server int x_zh_zm09_hw = 0;

// How many times zombies won (last human was turned at round end, script 1).
server int x_zh_zm09_ww = 0;

// Clientside mirror of zombie wins, synced from server via script 65/66.
server int x_zh_zm09_zw = 0;

// Cumulative total of human players who participated across all sessions (script 22).
server int x_zh_zm09_to = 0;

// Total number of player disconnects recorded on this map (script 64, DISCONNECT).
server int x_zh_zm09_di = 0;

// ZM09 - Boss Spawn Statistics

// How many times Ravishing was summoned (script 13).
server int x_zh_zm09_ra = 0;

// How many times the Ghoul Demon (Soul Sphere event) was spawned (script 22).
server int x_zh_zm09_sf = 0;

// How many times White Face was spawned (triggered by 0% correct terminal code, test_secret).
server int x_zh_zm09_wf = 0;

// ZM09 - Boss Kill Statistics

// How many times Ravishing killed the targeted player (script 63, DEATH).
server int x_zh_zm09_rk = 0;

// How many times White Face killed the targeted player (script 63, DEATH).
server int x_zh_zm09_wk = 0;

// How many times the Ghoul Demon killed the targeted player (script 63, DEATH).
server int x_zh_zm09_sk = 0;

// ZM09 - Terminal Code Statistics

// How many times the terminal code was 100% correct.
server int x_zh_zm09_100 = 0;

// How many times the terminal code was 50% correct.
server int x_zh_zm09_50 = 0;

// How many times the terminal code was 25% correct.
server int x_zh_zm09_25 = 0;

// How many times the terminal code was 0% correct.
server int x_zh_zm09_0 = 0;

// How many times the 0% correct code.
server int x_zh_zm09_zp = 0;
