Map ZE17
{
    Properties
    {
        GameMode "Escape",
        IsLegacyMap true,
        Graphic "IMGZE17",
    },

    Resist
    {
        GlobalPreResistScript "pre_resist_handler",
        GlobalPostResistScript "post_resist_handler",

        Definitions
        [
            {
                Length 5,
                TimeReasonLabel "\ckOpening the Cave in \cc%t",
            },
            {
                Length 20,
                TopReasonLabel "Lowering pillars",
                TimeReasonLabel "\ckResist for \cc%t \cksecond%p",
            },
            {
                Length 10,
                TopReasonLabel "Opening the village gates",
                TimeReasonLabel "\ckResist for \cc%t \cksecond%p",
            },
            {
                Length 8,
                TopReasonLabel "Opening the second gates",

                // The default draw is hidden; a hook draws this label with a display offset instead.
                TimeReasonLabel "\ckResist for \cc%t \cksecond%p",

                Flags
                {
                    HideTimeReason,
                }
            },
            {
                Length 45,
                TopReasonLabel "Closing the hiding room",
                TimeReasonLabel "\ckResist for \cc%t \cksecond%p",
            },
            {
                Length 30,
                TopReasonLabel "Opening the second cave",
                TimeReasonLabel "\ckResist for \cc%t \cksecond%p",
            },
        ]
    },
},

