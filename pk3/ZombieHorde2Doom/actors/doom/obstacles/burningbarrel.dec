actor ZH2DoomBurningBarrel : ZH2DoomObstacle replaces BurningBarrel
{
	//$Sprite BBARA0
	
	Radius 16
	Height 32
	ProjectilePassHeight -16
	
	Tag "Burning barrel"
	
	+SOLID
	+BRIGHT
	
    states
    {
        Spawn:
			TNT1 A 0 NoDelay Thing_ChangeTid(0, FACEPLAYER_TID)
			TNT1 A 0 A_PlaySound("decorate/burningbarrel", CHAN_7, 255, true, ATTN_STATIC)
		Spawn.Rest:
			TNT1 A 0 A_CheckSight("Spawn.NoSight")
			TNT1 A 0 A_SpawnItemEx("ZH2DoomFireBarrelFlame", 1, random(-6, 6), random(22, 28), 0, 0, Frandom(0.1, 1.0), 0)
            BBAR A 1 bright Light("ZH2DoomBurningBarrelLight") A_SpawnItemEx("ZH2DoomFireBarrelLensFlare", 0, 0, 32)
			Loop
		
		Spawn.NoSight:
			BBAR A 1 bright Light("ZH2DoomBurningBarrelLight")
			Goto Spawn.Rest
    }
}

Actor ZH2DoomFireBarrelLensFlare : ZH2DoomObstacleLensFlare
{
	Alpha .4
	
	States
	{
		Spawn:
			LFLR A 1 NoDelay Bright
			Stop
	}
}

Actor ZH2DoomFireBarrelFlame
{
	// The flames don't look great otherwise.
	//+FORCEXYBILLBOARD
	+FORCEYBILLBOARD
	
	+CLIENTSIDEONLY
	+DONTSPLASH
	+NOTIMEFREEZE
	+NOBLOCKMAP
	+NOGRAVITY
	
	+BRIGHT
	
	-SOLID
	
	Renderstyle Add
	
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetTranslucent(FRandom(0.1, 0.8))
			TNT1 A 0 A_SetScale(Frandom(0.2, 0.4), FRandom(0.2, 0.4))
			FIR1 ABCDEFGHI 2 A_FadeOut(.05)
			stop
	}
}