actor ZH2DoomCandelaBra : ZH2DoomLightSource replaces Candelabra
{
    //$Sprite CBR1A0

    Radius 16
    Height 60
    Scale .5
    ProjectilePassHeight -16

    Tag "Candelabra"

    +SOLID

    states
    {
        Spawn:
            TNT1 A 0 NoDelay Thing_ChangeTid(0, FACEPLAYER_TID)
        Spawn.Rest:
            CBR1 A 0 A_CheckSight("Spawn.NoSight")
            CBR1 A 0 A_SpawnItemEx("ZH2DoomCandelaBraLensFlareSpawner", 0, 0, 57)
            CBR1 A 4 bright light("ZH2DoomCandelaBraLight")
            CBR1 A 0 A_SpawnItemEx("ZH2DoomCandelaBraLensFlareSpawner", 0, 0, 57)
            CBR1 B 4 bright light("ZH2DoomCandelaBraLight")
            loop

        Spawn.NoSight:
            CBR1 A 1 bright light("ZH2DoomCandelaBraLight")
            goto Spawn.Rest
    }
}

actor ZH2DoomCandelaBraLensFlareSpawner
{
    +NOINTERACTION
    +CLIENTSIDEONLY

    States
    {
        Spawn:

            // Moved 1 pixel forward to avoid flickering.
            TNT1 A 0 NoDelay A_SpawnItemEx("ZH2DoomCandelaBraLensFlare", -1, -10, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2DoomCandelaBraLensFlare", -1, 0, 3)
            TNT1 A 0 A_SpawnItemEx("ZH2DoomCandelaBraLensFlare", -1, 10, 0)
            stop
    }
}

actor ZH2DoomCandelaBraLensFlare : ZH2DoomLightSourceLensFlare
{
    Scale .4
    Alpha .4

    States
    {
        Spawn:
            LFLR A 4 NoDelay Bright
            stop
    }
}
