actor ZH2DoomShortTechLamp : ZH2DoomLightSource replaces TechLamp2
{
    //$Sprite TLA2A0

    Radius 16
    Height 60
    ProjectilePassHeight -16

    Tag "Short tech lamp"

    +SOLID

    states
    {
        Spawn:
            TNT1 A 0 NoDelay Thing_ChangeTid(0, FACEPLAYER_TID)
        Spawn.Rest:
            TLA2 AAAABBBBCCCCDDDD 1 bright light("ZH2DoomShortTechLampLight") A_SpawnItemEx("ZH2DoomShortTechLampLensFlareSpawner", 0, 0, 48)
            loop
    }
}

actor ZH2DoomShortTechLampLensFlareSpawner
{
    +NOINTERACTION
    +CLIENTSIDEONLY

    States
    {
        Spawn:

            // Moved 1 pixel forward to avoid flickering.
            TNT1 A 0 NoDelay A_SpawnItemEx("ZH2DoomShortTechLampLensFlare", -1, -4, 0)
            TNT1 A 0 A_SpawnItemEx("ZH2DoomShortTechLampLensFlare", -1, 4, 0)
            stop
    }
}

actor ZH2DoomShortTechLampLensFlare : ZH2DoomLightSourceLensFlare
{
    YScale .4
    XScale .2
    Alpha .8

    States
    {
        Spawn:
            LFLR B 1 NoDelay Bright
            stop
    }
}