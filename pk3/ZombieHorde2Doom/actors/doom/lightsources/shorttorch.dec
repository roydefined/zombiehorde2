const int DOOMSHORTTORCHEFFECTHEIGHT = 40;

actor ZH2DoomShortTorchRed : ZH2DoomLightSource replaces ShortRedTorch
{
    Radius 16
    Height 37
    ProjectilePassHeight -16

    +SOLID

    states
    {
        Spawn:
            STRR AAABBBCCCDDDEEEFFFGGGHHHIIIJJJ 1 NoDelay bright light("ZH2DoomShortTorchRedLight") A_SpawnItemEx("ZH2DoomShortTorchRedFlare", 0, 0, DOOMSHORTTORCHEFFECTHEIGHT)
            loop
    }
}

