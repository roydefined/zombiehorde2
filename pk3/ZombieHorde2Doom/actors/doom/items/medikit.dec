// This is a bit confusing, but Zombie Horde also has a fake medikit.
// So to keep things simple, we prioritize the existing fake medikit.
// This actor therefore simply spawns that medikit.

actor ZH2DoomMedikit : ZH2DoomCustomInventoryHealthAndArmor replaces Medikit
{
    //$Sprite HELTA0

    States
    {
        Spawn:
            TNT1 A 0 NoDelay A_SpawnItem("ZH2ItemMedikit")
            stop
    }
}