actor ZH2ZM31MNuke
{
	Renderstyle Add

	+NOGRAVITY
	+NOBLOCKMAP
	+FORCEYBILLBOARD
	+BRIGHT
	
	States
	{
		Spawn:
			NUKB A 1 A_SpawnItemEx("ZH2ZM31NukeLensFlare", 0, 0, 64)
			wait
	}
}

actor ZH2ZM31NukeLensFlare : ZH2LightSourceLensFlare
{
	Scale 3
	
	States
	{
		Spawn:
			LFLR A 1 nodelay bright
			stop
	}
}

actor ZH2ZM31MNukeSmoke
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	
	States
	{
		Spawn:
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 NoDelay A_SpawnItemEx("ZH2ZM31MNukeSmokeParticle", Frandom(-200.0, 200.0), Frandom(-200.0, 200.0), Frandom(-5.0, 20.0), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(0, 1.5))
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx(" ZH2ZM31MNukeSmokeParticle", Frandom(-200.0, 200.0), Frandom(-200.0, 200.0), Frandom(-5.0, 20.0), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(0, 1.5))
			Stop
			
		NoSpawn:
			TNT1 A 0
			Stop
	}
}

actor ZH2ZM31MNukeSmokeBunker
{
	+NOINTERACTION
	+CLIENTSIDEONLY
	
	States
	{
		Spawn:
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 NoDelay A_SpawnItemEx("ZH2ZM31MNukeSmokeParticle", 0, 0, Frandom(0, 50.0), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(-5.0, 0))
			TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 0 A_SpawnItemEx("ZH2ZM31MNukeSmokeParticle", 0, 0, Frandom(0, 50.0), Frandom(-0.2, 0.2), Frandom(-0.2, 0.2), Frandom(-5.0, 0))
			Stop
			
		NoSpawn:
			TNT1 A 0
			Stop
	}
}

actor ZH2ZM31MNukeSmokeParticle
{
	+Missile
	+NOGRAVITY
	+NOCLIP
	+CLIENTSIDEONLY
	+FORCEXYBILLBOARD
	
	RenderStyle Translucent
	var int user_Tics;
			
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_SetScale(Frandom(0.8, 1.5), Frandom(0.8, 1.5))
			TNT1 A 0 A_SetUserVar("user_Tics", 18*random(5, 15))
			TNT1 A 0 A_SetTranslucent(Frandom(0.4, 0.8))
			TNT1 A 0 A_SetUserVar("user_Tics", user_Tics-1)
			TNT1 A 0 A_JumpIf(user_Tics < 0, "Depleted")
			TNT1 A 0 A_ScaleVelocity(Frandom(0.88, 0.99))
			SMKV A 2
			Goto Spawn+3
		Depleted:
			SMKV A 4 A_FadeOut(0.02)
			wait
	}
}