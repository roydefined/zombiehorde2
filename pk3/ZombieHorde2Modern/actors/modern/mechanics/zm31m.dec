// Indicates if the player is outside and has their temperature reducing.
actor ZH2ZM31MIsCold : Boolean {}

// Indicates the player's temperature.
actor ZH2ZM31MTemperature : Integer {}

// Indicates the next tic where the player's temperature is checked.
actor ZH2ZM31MNextTemperatureTic : Integer {}

// Indicates if the player is in the bunker.
actor ZH2ZM31MIsInBunker : Boolean {}

// For the elevator. Marked with the elevator id to understand which elevator we mean.
actor ZH2ZM31MAtElevatorDoors : Integer {}
actor ZH2ZM31MInElevator : Integer {}