Map ZE12M
{
    Properties
    {
        GameMode "Escape",
        Graphic "IMGZE12M",
    },
	
	Resist
	{
		GlobalPreResistScript "pre_resist_handler",
		GlobalPostResistScript "post_resist_handler",
		
		// Time reasons have been removed as we have custom coloring.
		Definitions
		[
			{
				Length 20,
				TopReasonLabel "\cjActivating eastern Beacon",

				Flags
				{
					HideTopReason,
					HideTimeReason,
					NoFade
				}
			},
			{
				Length 20,
				TopReasonLabel "\cjActivating northern Beacon",

				Flags
				{
					HideTopReason,
					HideTimeReason,
					NoFade
				}
			},
			{
				Length 20,
				TopReasonLabel "\cjActivating western Beacon",

				Flags
				{
					HideTopReason,
					HideTimeReason,
					NoFade
				}
			},
			{
				Length 20,t
				TopReasonLabel "\cjActivating southern Beacon",

				Flags
				{
					HideTopReason,
					HideTimeReason,
					NoFade
				}
			},
			{
				Length 30,
				TopReasonLabel "\cjOpening pyramid",
				TimeReasonLabel "\ccResist for \cd%t \ccsecond%p",
			}
			{
				Length 40,
				TopReasonLabel "\cjReach the burial chamber",
				TimeReasonLabel "%t \cisecond%p left",
			}
		]
	},

	Game
	{
		ZombieTeleportEnabled false,
		OverrideMaxZombieTeleports 1,
	}
},

