model ZombiePlayer
{
    model 0 "models/BagelHorde/Bagel/Bagel.md3"
    skin 0 "models/BagelHorde/Bagel/bagel_d.png"

    AngleOFfset -90
    scale 3.5 3.5 3.5

    // Walk
    FrameIndex BAG0 A 0 0
    FrameIndex BAG0 B 0 1
    FrameIndex BAG0 C 0 2
    FrameIndex BAG0 D 0 3
    FrameIndex BAG0 E 0 4
    FrameIndex BAG0 F 0 5
    FrameIndex BAG0 G 0 6
    FrameIndex BAG0 H 0 7

    FrameIndex BAG0 I 0 8 // Dummy frame

    // Pain
    FrameIndex BAG0 J 0 9
    FrameIndex BAG0 K 0 10
    FrameIndex BAG0 L 0 11
    FrameIndex BAG0 M 0 12

    // Death
    FrameIndex BAG0 N 0 13 // Initial shoot off
    FrameIndex BAG0 O 0 14
    FrameIndex BAG0 P 0 15
    FrameIndex BAG0 Q 0 16
    FrameIndex BAG0 R 0 17
    FrameIndex BAG0 S 0 18
    FrameIndex BAG0 T 0 19
    FrameIndex BAG0 U 0 20
    FrameIndex BAG0 V 0 21
    FrameIndex BAG0 W 0 22
    FrameIndex BAG0 X 0 23

    FrameIndex BAG0 Y 0 24 // Falling down
    FrameIndex BAG0 Z 0 25
    FrameIndex BAG1 A 0 26
    FrameIndex BAG1 B 0 27
    FrameIndex BAG1 C 0 28
    FrameIndex BAG1 D 0 29
    FrameIndex BAG1 E 0 30
    FrameIndex BAG1 F 0 31
    FrameIndex BAG1 G 0 32
    FrameIndex BAG1 H 0 33
    FrameIndex BAG1 I 0 34
    FrameIndex BAG1 J 0 35
    FrameIndex BAG1 K 0 36
    FrameIndex BAG1 L 0 37
    FrameIndex BAG1 M 0 38
    FrameIndex BAG1 N 0 39
    FrameIndex BAG1 O 0 40
    FrameIndex BAG1 P 0 41
    FrameIndex BAG1 Q 0 42
    FrameIndex BAG1 R 0 43
    FrameIndex BAG1 S 0 44
    FrameIndex BAG1 T 0 45
    FrameIndex BAG1 U 0 46
    FrameIndex BAG1 V 0 47
    FrameIndex BAG1 W 0 48
    FrameIndex BAG1 X 0 49
    FrameIndex BAG1 Y 0 50
    FrameIndex BAG1 Z 0 51
    FrameIndex BAG2 A 0 52
    FrameIndex BAG2 B 0 53
    FrameIndex BAG2 C 0 54
    FrameIndex BAG2 D 0 55
    FrameIndex BAG2 E 0 56
    FrameIndex BAG2 F 0 57
    FrameIndex BAG2 G 0 58
    FrameIndex BAG2 H 0 59
    FrameIndex BAG2 I 0 60
    FrameIndex BAG2 J 0 61
    FrameIndex BAG2 K 0 62

    FrameIndex BAG2 L 0 63 // Bagel is now a flat pizza dough
}

