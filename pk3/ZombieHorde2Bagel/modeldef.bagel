model FallingDeadBagel
{
    model 0 "models/BagelHorde/Bagel/Bagel.md3"
    skin 0 "models/BagelHorde/Bagel/bagel_d.png"

    AngleOFfset -90
    scale 3.5 3.5 3.5

    //
    // Bagel Regular
    //

    // Falling
    FrameIndex BGL0 Y 0 24 // Falling down
    FrameIndex BGL0 Z 0 25
    FrameIndex BGL1 A 0 26
    FrameIndex BGL1 B 0 27
    FrameIndex BGL1 C 0 28
    FrameIndex BGL1 D 0 29
    FrameIndex BGL1 E 0 30
    FrameIndex BGL1 F 0 31
    FrameIndex BGL1 G 0 32
    FrameIndex BGL1 H 0 33
    FrameIndex BGL1 I 0 34
    FrameIndex BGL1 J 0 35
    FrameIndex BGL1 K 0 36
    FrameIndex BGL1 L 0 37
    FrameIndex BGL1 M 0 38
    FrameIndex BGL1 N 0 39
    FrameIndex BGL1 O 0 40
    FrameIndex BGL1 P 0 41
    FrameIndex BGL1 Q 0 42
    FrameIndex BGL1 R 0 43
    FrameIndex BGL1 S 0 44
    FrameIndex BGL1 T 0 45
    FrameIndex BGL1 U 0 46
    FrameIndex BGL1 V 0 47
    FrameIndex BGL1 W 0 48
    FrameIndex BGL1 X 0 49
    FrameIndex BGL1 Y 0 50
    FrameIndex BGL1 Z 0 51
    FrameIndex BGL2 A 0 52
    FrameIndex BGL2 B 0 53
    FrameIndex BGL2 C 0 54
    FrameIndex BGL2 D 0 55
    FrameIndex BGL2 E 0 56
    FrameIndex BGL2 F 0 57
    FrameIndex BGL2 G 0 58
    FrameIndex BGL2 H 0 59
    FrameIndex BGL2 I 0 60
    FrameIndex BGL2 J 0 61
    FrameIndex BGL2 K 0 62

    FrameIndex BGL2 L 0 63 // Bagel is now a flat pizza dough
}

