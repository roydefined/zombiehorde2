//
// Bagel Regular
//

model ZombiePlayer
{
    Path "Models/BagelHorde/Bagel"
    model 0 "Bagel.md3"
    skin 0 "bagel_d_normal.png"

    AngleOFfset -90
    scale 3.5 3.5 3.5

    INTERPOLATEDOUBLEDFRAMES

    // Walk
    FrameIndex BGL0 A 0 0
    FrameIndex BGL0 B 0 1
    FrameIndex BGL0 C 0 2 // top
    FrameIndex BGL0 D 0 3
    FrameIndex BGL0 E 0 4
    FrameIndex BGL0 F 0 5
    FrameIndex BGL0 G 0 6 // squish
    FrameIndex BGL0 H 0 7

    FrameIndex BGL0 I 0 8 // Dummy frame

    // Pain
    FrameIndex BGL0 J 0 9
    FrameIndex BGL0 K 0 10
    FrameIndex BGL0 L 0 11
    FrameIndex BGL0 M 0 12

    // Death
    FrameIndex BGL0 N 0 13 // Initial shoot off
    FrameIndex BGL0 O 0 14
    FrameIndex BGL0 P 0 15
    FrameIndex BGL0 Q 0 16
    FrameIndex BGL0 R 0 17
    FrameIndex BGL0 S 0 18
    FrameIndex BGL0 T 0 19
    FrameIndex BGL0 U 0 20
    FrameIndex BGL0 V 0 21
    FrameIndex BGL0 W 0 22
    FrameIndex BGL0 X 0 23
}

