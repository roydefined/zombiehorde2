//
// Bagel Regular
//

model BagelStatue_Regular
{
    Path "models/BagelHorde/Bagel"
    model 0 "Bagel.md3"
    skin 0 "bagel_d_normal.png"

    AngleOFfset -90
    scale 3.5 3.5 3.5

    INTERPOLATEDOUBLEDFRAMES

    // Walk
    FrameIndex AAAA A 0 0
    FrameIndex AAAA B 0 1
    FrameIndex AAAA C 0 2 // top
    FrameIndex AAAA D 0 3
    FrameIndex AAAA E 0 4
    FrameIndex AAAA F 0 5
    FrameIndex AAAA G 0 6 // squish
    FrameIndex AAAA H 0 7

    FrameIndex AAAA I 0 8 // Dummy frame

    // Pain
    FrameIndex AAAA J 0 9
    FrameIndex AAAA K 0 10
    FrameIndex AAAA L 0 11
    FrameIndex AAAA M 0 12

    // Death
    FrameIndex AAAA N 0 13 // Initial shoot off
    FrameIndex AAAA O 0 14
    FrameIndex AAAA P 0 15
    FrameIndex AAAA Q 0 16
    FrameIndex AAAA R 0 17
    FrameIndex AAAA S 0 18
    FrameIndex AAAA T 0 19
    FrameIndex AAAA U 0 20
    FrameIndex AAAA V 0 21
    FrameIndex AAAA W 0 22
    FrameIndex AAAA X 0 23
}

