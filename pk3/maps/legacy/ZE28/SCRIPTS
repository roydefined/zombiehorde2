internal void ResistMessage3 (int restime, str whyresist)
{
	SetFont("BIGFONT");
	HudMessageBold(s:"\cGResist for \cJ", d:restime, s:" \cGseconds"; HUDMSG_FADEOUT, 999, CR_RED, 0.5, 0.2, 0.5, 0.5);
