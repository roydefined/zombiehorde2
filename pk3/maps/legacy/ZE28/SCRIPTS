    Script 100 (int iLine)
    {
        For(int i = 100; i >= 0; i -= 5)
        {
            TranslucentLine(iLine, i);
            Delay(1);
        }
        SetLineBlocking(iLine, BLOCK_NOTHING);
        hudmessagebold(s:"Shield Disabled"; 2 , 0, CR_WHITE, 0.5, 0.9, 2.0);
    }

