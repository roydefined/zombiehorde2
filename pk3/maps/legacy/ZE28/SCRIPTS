    /* [ZH2] RESISTS START */

    script "pre_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            // waiting for tree being burned...
            case 1:
            {
                Thing_Activate(72);
                break;
            }

            // Curse of God incoming ...
            case 3:
            {
                Floor_LowertoLowest(31, 70);
                tagwait(31);
                light_fade(16, 128, 100);
                light_fade(13, 128, 100);
                light_fade(88, 128, 100);
                light_fade(17, 128, 100);
                light_fade(7, 128, 100);
                delay(35*2);
                Floor_LowerByValue(7, 5, 240);
                SetFont("CONFONT");
                HudMessageBold(n:0, s:" has reached the maya's lord place, \nThe Curse of God is coming in the forest !";HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 5.0, 2.0);
                Delay(35*5);
                Thing_Activate(1);
                break;
            }
        }
    }

    script "post_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            // Opening the door...
            case 0:
            {
                Door_Open(20, 90);
                break;
            }

            // waiting for tree being burned...
            case 1:
            {
                ACS_ExecuteAlways(100, 0, 4, 0, 0);
                Thing_Remove(50);
                delay(35*3);
                Thing_Remove(72);
                break;
            }

            // lowering pillars...
            case 2:
            {
                Floor_LowertoLowest(27, 256);
                break;
            }

            // Curse of God incoming ...
            case 3:
            {
                Generic_Ceiling(7, 20, 256, 5, 16);
                Generic_Ceiling(17, 20, 256, 5, 16);
                Radius_Quake(9, 35*15, 0, 50, 8);
                Delay(35*8);
                SetFont("BIGFONT");
                HudMessageBold(s:"\cGWarning : \cKThe Curse of God is in forest !"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
                Delay(35*3);
                AmbientSound("world/volcano1", 127);
                Delay(35);

                Game::KillUnsafePlayers();
                break;
            }
        }
    }

    /* [ZH2] RESISTS END */
}
