Script 1 (void) // First resist, opening the big door
{
	SetActivator(-1);
	for(int i = resist1; i > 0; i--)
	{
		ResistMessage3(i, "Opening the door...");
		Delay(35);
	}
	Door_Open(20, 90);
}

Script 2 (void) // Second resist, burning tree
{
    Thing_Activate(72);
    SetActivator(-1);
    for(int i = resist2; i > 0; i--)
    {
        ResistMessage3(i, "waiting for tree being burned...");
        Delay(35);
    }
    ACS_ExecuteAlways(100, 0, 4, 0, 0);
    Thing_Remove(50);
    delay(35*3);
    Thing_Remove(72);
}

Script 3 (void) // Third resist, lowering pillars
{
	SetActivator(-1);
	for(int i = resist3; i > 0; i--)
    {
		ResistMessage3(i, "lowering pillars...");
		Delay(35);
    }
    Floor_LowertoLowest(27, 256);
}

script 4 (void)
{
    Floor_LowertoLowest(31, 70);
    tagwait(31);
    light_fade(16, 128, 100);
    light_fade(13, 128, 100);
    light_fade(88, 128, 100);
    light_fade(17, 128, 100);
    light_fade(7, 128, 100);
    delay(35*2);
    Floor_LowerByValue(7, 5, 240);
    SetFont("CONFONT");
    HudMessageBold(n:0, s:" has reached the maya's lord place, \nThe Curse of God is coming in the forest !";HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 5.0, 2.0);
    SetActivator(-1);
    Delay(35*5);
    Thing_Activate(1);

    for(int i = resist4; i > 0; i--)
    {
        ResistMessage3(i, "Curse of God incoming ...");
        Delay(35);
    }

    Generic_Ceiling(7, 20, 256, 5, 16);
    Generic_Ceiling(17, 20, 256, 5, 16);
    Radius_Quake(9, 35*15, 0, 50, 8);
    Delay(35*8);
    SetFont("BIGFONT");
    HudMessageBold(s:"\cGWarning : \cKThe Curse of God is in forest !"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
    Delay(35*3);
    AmbientSound("world/volcano1", 127);
    Delay(35);

    Game::KillUnsafePlayers();
}

Script 100 (int iLine)
{
    For(int i = 100; i >= 0; i -= 5)
    {
        TranslucentLine(iLine, i);
        Delay(1);
    }
    SetLineBlocking(iLine, BLOCK_NOTHING);
    hudmessagebold(s:"Shield Disabled"; 2 , 0, CR_WHITE, 0.5, 0.9, 2.0);
}

