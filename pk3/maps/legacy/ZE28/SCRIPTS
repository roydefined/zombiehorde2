Script 20 (void) // 1st Pillars
{
	PrintBold(n:0, s:" has raised the first pillars!\n\nThey will automatically lower in 25 seconds.");
	SetActivator(-1);
	Floor_RaiseByValue(2, 16, 256);
	Delay(35*27);
	Floor_LowerByValue(2, 16, 256);
	PrintBold(s:"First Pillars lowered!");
}

Script 21 (void) // 2nd Pillars
{
	PrintBold(n:0, s:" has raised the second pillars!\n\nThey will automatically lower in 15 seconds.");
	SetActivator(-1);
	Floor_RaiseByValue(3, 16, 256);
	Delay(35*17);
	Floor_LowerByValue(3, 16, 256);
