	/* RESIST EVENT */
	script "ze08_internal_event_resistelapsed" (raw packetRaw)
	{
		Event::ReceiveTimerElapsed((str)packetRaw);
		int index = Event::GetReceiveData(0);
		
		switch(index)
		{
			case 0:
				Door_Open(55, 96);
				Delay(35*5);
				Floor_LowerByValue(57, 32, 248);
				TagWait(57);
				PrintBold(s:"The secondary path has been opened");
				break;
			case 1:
				Door_Open(25, 96);
				break;
			case 2:
				TranslucentLine(1, 0, 0);
				SetLineBlocking(1, BLOCK_NOTHING);
				break;
		}
	}

