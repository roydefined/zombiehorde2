	Script 8 (void) // third resist
	{
		SetActivator(-1);
		Delay(Resist::StartResistByIndex(3));
		door_Open(43, 16);
		delay(35);
		while(choppatime>0)
		{
			choppatime--;
			SetFont("SMALLFONT");
			HudMessageBold(s:"The rescue Helicopter is leaving"; HUDMSG_FADEOUT, 998, CR_RED, 0.5, 0.17, 1.5, 0.5);
			SetFont("BIGFONT");
			HudMessageBold( d:choppatime, s:" \cGseconds"; HUDMSG_FADEOUT, 999, Cr_WHITE, 0.5, 0.2, 0.5, 0.5);
			Delay(35);
		}
		Floor_RaiseByValue(46, 16, 512);
		Ceiling_RaiseByValue(46, 16, 512);
		Delay(35*2);
		Radius_Quake(10, 350, 0, 64, 47);
		AmbientSound("world/rocket1", 100);
		Delay(35*2);
		SetFont("BIGFONT");
		HudMessageBold(s:"\cGWarning : \cKRocket Launching!!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
		Delay(35*5);
		Game::KillUnsafePlayers();
	}

