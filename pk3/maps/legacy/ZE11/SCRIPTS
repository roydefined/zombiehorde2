	#define FROZEN_TIME  5

	#define LOGSOURCE "ZE11"

	bool forcefield_active = false;

	Script "ze11_open" OPEN
	{
	    // Level setups
	    CreateTranslation(1, 0:255=192:207);    // Frozen in ice
	    TranslucentLine(4, 0, 0);
		TranslucentLine(8, 160, 0);
	    TranslucentLine(101, 0, 0);     // invis blocking lines
	    TranslucentLine(150, 0, 0);     // invis blocking lines
	    Sector_SetRotation(67, 45, 0);
	    Sector_SetRotation(68, -45, 0);

	    //  Start here
	    delay(35*5);
	    AmbientSound("world/readyvoice", 127);
	    delay(35*2);

	    // Make the walls disappear
	    SetLineBlocking(1, BLOCK_NOTHING);
	    Acs_ExecuteAlways(4, 0, 1, 0, 0);   // Translucy fadeout
	    delay(10);

	    // Music change
	    AmbientSound("world/varietystart", 100);
	    delay(36);
	    Music::PlayMusic("Variety");

	    // Making sure of this for spectators
	    delay(35*5);
	    TranslucentLine(1, 0, 0);
	}

