strict namespace
{
	Script "zm11_open" // Level Setups
	{
		Sector_setcolor(17, 0, 200, 0);
		//SetLineSpecial(26, 80, 4, 0, 26); //ZH2 AQW Issue #29
		//TranslucentLine(26, 96, 0); //ZH2 AQW Issue #29

		if(random(0,1))
			Acs_Execute(6, 0);
	}

	Script 2 (void) // Pillars
	{
		Floor_RaiseByValue(6, 26, 128);
		Delay(35*27);
		Floor_LowerByValue(6, 26, 128);
	}

	script 4 (int id) // glassbreak
	{
		SetLineBlocking(id, BLOCK_NOTHING);
		SetLineTexture(id, SIDE_FRONT, TEXTURE_MIDDLE, "-");
		SetLineTexture(id, SIDE_BACK, TEXTURE_MIDDLE, "-");
		Thing_Activate(id);
	}

	Script 5 (void) // Door
	{
	    Floor_RaiseByValue(33, 24, 96);
	    Delay(35*27);
	    Floor_LowerByValue(33, 24, 96);
	}

	Script 6 (void)
	{
		// Night mode activated
		for(int i = 0; i < 120; i++)
			Light_LowerByValue(i, 16);

		ReplaceTextures("SKYR_N", "SKYB_N");
		ReplaceTextures("SKYR_S", "SKYB_S");
		ReplaceTextures("SKYR_W", "SKYB_W");
		ReplaceTextures("SKYR_E", "SKYB_E");
		ReplaceTextures("SKYR_T", "SKYB_T");
	}
	Script 7 (void)
	{
		Teleport(46, 0, 1);

		Door_Open(47, 100);

		PrintBold(n:0, s:" \cFhas activated the secret!");

		Music::PlayMusic("D_WMMS", 0);
	}

	Script 8 (void)
	{
		PrintBold(s:"\cFNow comes the best part!");
	}

	Script 9 (void)
	{
		Delay(3);
		Print(s:"won't open");
	}

	Script 10 (void)
	{
		Delay(3);
		Print(s:"This door is sealed.");
	}

	Script 11 (void)
	{
		Delay(3);
		Print(s:"Snacks? Now?");
	}
