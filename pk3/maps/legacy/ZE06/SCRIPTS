// [ZH2] This exists to push off players that are on the lift ledges.
// It will do this constantly until terminated.
Script "ze06_lift_ledge_pusher" (raw index, raw angle)
{
	while(!terminateLiftPushScripts)
	{
		for(int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
		{
			int tid = Identity::GetTid(i);

			if (!BCSUtils::ActorIsAlive(tid))
				continue;

			// Not in the lift the script is for.
			if (!Game::GetPlayerIsSafe(i, index))
				continue;

			// Actor is not on the ledge (-168 is the hardcoded z position of the ledge)
			if (GetActorZ(tid) < -168.0)
				continue;

			ThrustThing(angle, 40, 1, tid);
		}


		Delay(const: 1);
	}
}

