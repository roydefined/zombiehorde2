Script 12 (void) /* 2nd teleport */
{
	SetActivator(-1);
	Floor_LowerByValue(41, 20, 1780);
	Ceiling_LowerByValue(41, 20, 1780);

	// Depending on which lift you took (north set or south set), and based on specie, we teleport the player.
	for(int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
	{
		int tid = Identity::GetTid(i);

		// Prevent dead bodies from being teleported.
		if (!BCSUtils::ActorIsAlive(tid))
			continue;

		// Determine their lift index. 1 and 2 are the south ones.
		int teleportTid = Game::GetPlayerIsSafe(i, 1) || Game::GetPlayerIsSafe(i, 2)
			// South
			? 200
			// North
			: 300;

		// And if a human, we add 50 so they are moved to the side.
		if (Player::GetPlayerIsHuman(i))
			teleportTid += 50;

		TeleportOther(tid, teleportTid, 0);
	}

	TagWait(41);
	Acs_Terminate(5, 0);
	Acs_Terminate(6, 0);
	Acs_Terminate(7, 0);
	Polyobj_Move(8, 20, 128, 56);
	Polyobj_Move(16, 20, 128, 56);
	ThingSound(42, "sound/ding1", 127);
	Delay(35*12);
	Polyobj_Move(6, 20, 128, 56);
	Polyobj_Move(18, 20, 128, 56);
	ThingSound(45, "sound/ding1", 127);
}

