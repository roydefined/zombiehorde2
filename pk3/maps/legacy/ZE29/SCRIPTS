    function raw sqrt2 (raw x){
        int r;
        x = x + 1 >> 1;
        while (x > r)
            x -= r++;
        return r;
    }

    function raw ibm_distance (int tid1, int tid2){
        fixed x, y, z, d;
        x = (GetActorX(tid1) - GetActorX(tid2)) / 65536.0;
        y = (GetActorY(tid1) - GetActorY(tid2)) / 65536.0;
        z = (GetActorZ(tid1) - GetActorZ(tid2)) / 65536.0;
        d = sqrt2(x*x + y*y + z*z );
        return d;
    }

