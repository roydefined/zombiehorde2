    Script 23 (int Minutes, int Seconds) //timer for final resist
    {
            Int NewMinutes = Minutes;
            Int NewSeconds = Seconds;
            Int Milliseconds = 35;
            Bool CounterDone = False;
            Str StrMin;
            Str StrSec;
            Str StrMil;
            Str Reason1 = "Canyon + cave system collapsion!";

                    For(Milliseconds=35; CounterDone == False; Milliseconds--)
                    {
                                If(NewMinutes <= 0)
                                {
                                    If(NewSeconds <= 0)
                                    {
                                        If(Milliseconds <= 0)
                                        {
                                            CounterDone = True;
                                            NewMinutes = 0;
                                            NewSeconds = 0;
                                            Milliseconds = 0;
                                            StrMin = "00";
                                            StrSec = "00";

                                            Str ReturnValue2;

                                            ReturnValue2 = StrParam(s:StrMin, s:" : ", s:StrSec, s:" : 0", d:(Milliseconds*29)/10);
                                            ResistMSG(ReturnValue2, Reason1);
                                            Terminate;
                                        }
                                    }
                                }

                        If(Milliseconds <= 0)
                        {
                            NewSeconds --;
                                If(NewSeconds < 0)
                                {
                                    NewSeconds = 59;
                                    NewMinutes --;
                                }

                            Milliseconds = 35;
                        }


                                If(NewMinutes < 10)
                                {
                                    StrMin = StrParam(s:"0", d:NewMinutes);
                                }
                                Else
                                {
                                    StrMin = StrParam(d:NewMinutes);
                                }

                            If(NewSeconds < 10)
                            {
                                StrSec = StrParam(s:"0", d:NewSeconds);
                            }
                            Else
                            {
                                StrSec = StrParam(d:NewSeconds);
                            }

                            If((Milliseconds*29)/10 < 10)
                            {
                                StrMil = StrParam(s:"0", d:(Milliseconds*29)/10);
                            }
                            Else
                            {
                                StrMil = StrParam(d:(Milliseconds*29)/10);
                            }

                        Str ReturnValue;

                        ReturnValue = StrParam(s:StrMin, s:" : ", s:StrSec, s:" : ", s:StrMil);
                        ResistMSG(ReturnValue, Reason1);
                        Delay(1);
                    }
    }

    function void MrResist (int restime, str whyresist, int color){ //custom resist
    SetFont("BIGFONT");
    if (restime < 31){
    HudMessageBold(s:"Resist for \cj", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
    }
    if (restime < 20){
    HudMessageBold(s:"Resist for \cq", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
    }
    if (restime < 15){
    HudMessageBold(s:"Resist for \ck", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
    }
    if (restime < 10){
    HudMessageBold(s:"Resist for \ci", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
    }
    if (restime < 5){
    HudMessageBold(s:"Resist for \cg", d:restime, s:"\cd seconds"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 0.5, 0.5);
    }
    if (restime < 2){
    HudMessageBold(s:"Resist for \cm", d:restime, s:"\cd second"; HUDMSG_FADEOUT, 999, CR_GREEN, 0.5, 0.2, 1.0, 1.0); //this is prettier
    }
    SetFont("SMALLFONT");
    HudMessageBold(s:whyresist; HUDMSG_FADEOUT, 998, color, 0.5, 0.17, 1.5, 0.5);}

