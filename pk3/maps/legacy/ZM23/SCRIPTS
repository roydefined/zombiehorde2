Function void ZH_notelefrag_Teleport(Int DestTag_Min, Int DestTag_Max, Bool UseDestinationsAngle, Bool Telefog, Bool RaiseZ)
{
Int x, y, z, a, Rnd, Tries;
Bool TerminateFor = False;

    For(Int TP=DestTag_Min; TP<(DestTag_Max + 1) && TerminateFor == False; TP++)
    {
        x = GetActorX(TP);
        y = GetActorY(TP);
        z = GetActorZ(TP);
        a = GetActorAngle(TP);

            If(RaiseZ == True)
            {
                If(Tries >= 10)
                {
                    z = z + 64.0;
                }
                Else If(Tries >= 20)
                {
                    z = z + 128.0;
                }
            }

        If(SetActorPosition(600+PlayerNumber(), x, y, z, Telefog) == True)
        {
            Tries = 0;
                If(UseDestinationsAngle == True)
                {
                    SetActorAngle(600+PlayerNumber(), a);
                }
            TerminateFor = True;
        }
        Else If(SetActorPosition(600+PlayerNumber(), x, y, z, Telefog) == False)
        {
            Tries ++;
            If(Tries >= 1000)
            {
                TerminateFor = True;
            }
        }
    }
}