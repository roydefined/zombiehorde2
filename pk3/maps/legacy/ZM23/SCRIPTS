	function void ZH_notelefrag_Teleport(Int DestTag_Min, Int DestTag_Max, Bool UseDestinationsAngle, Bool Telefog, Bool RaiseZ)
	{
	    Int x, y, z, a, Rnd, Tries;
	    Bool TerminateFor = False;

	    for(Int TP = DestTag_Min; TP < (DestTag_Max + 1) && TerminateFor == False; TP++)
	    {
	        x = GetActorX(TP);
	        y = GetActorY(TP);
	        z = GetActorZ(TP);
	        a = GetActorAngle(TP);

	        if(RaiseZ == true)
	        {
	            if(Tries >= 10)
	            {
	                z = z + 64.0;
	            }
	            else if(Tries >= 20)
	            {
	                z = z + 128.0;
	            }
	        }

	        if(SetActorPosition(ActivatorTid(), x, y, z, Telefog) == true)
	        {
	            Tries = 0;
	            if(UseDestinationsAngle == true)
	            {
	                SetActorAngle(ActivatorTid(), a);
	            }
	            TerminateFor = true;
	        }
	        else if(SetActorPosition(ActivatorTid(), x, y, z, Telefog) == false)
	        {
	            Tries ++;
	            if(Tries >= 1000)
	            {
	                TerminateFor = true;
	            }
	        }
	    }
	}
