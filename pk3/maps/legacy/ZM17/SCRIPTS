#pragma raw include on
#pragma raw define on

#import "zcommon.bcs"
#import "acs_source/bcsutils.acs"

#include "acs_source/zh2lib.h.acs"
#include "acs_source/zh2game.h.acs"

strict namespace
{
    Int core = 0; //Number of cores destroyed
    //Q: Why dont you use a while and ThingCount() instead of a constant?
    //A: Because a while can break itself if too much time pass, so a constant is safer

    Script 1 Open //Init
    {
        SetLineBlocking(17,BLOCK_EVERYTHING);
        TranslucentLine(17,180,1);
        SpawnSpotFacing("ZH2LegacyLargeCoupling", 26, 27);
        Thing_SetSpecial(27,80,2,0,0);

    }

    Script 2 (void) //Cores control script
    {
        SetActivator(-1);
        core++; //Increase the number of cores destroyed
        if(core==4) //Do the magic
        {
            for(int i = 180;i >= 0;i = i-5)
            {
                TranslucentLine(17,i,1);
                delay(3);
            }
            SetLineBlocking(17,BLOCK_NOTHING);
            SetLineTexture(17,SIDE_FRONT,TEXTURE_MIDDLE,"-");
            SetLineTexture(17,SIDE_BACK,TEXTURE_MIDDLE,"-");
            Delay(35*3);
            AmbientSound("sound/poweroutage1",255);
            SetLineTexture(22,SIDE_FRONT,TEXTURE_MIDDLE,"-");
            SetLineTexture(22,SIDE_BACK,TEXTURE_MIDDLE,"-");

            //Quick method to lower the light in the whole map
            for(int j=1; i<=25; i++)
            {
                Light_fade(i,104,35*3);
            }

            Thing_remove(12);
            delay(35*3);
            AmbientSound("sound/systemsdown1",255);
            Delay(35*5);
            ACS_Execute(3,0,0,0,0);
        }
    }

    Script 3 (void) //Emergency power only
    {
        AmbientSound("sound/emergency1",255);
        Delay(35*30);
        Restart;
    }

    Script 4 (void)
    {
        Floor_LowerByValue(5,10,64);
        Ceiling_RaiseByValue(5,10,64);
    }
}
