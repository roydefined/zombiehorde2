	script 5 (void) //Elevator
	{
		SetActivator(-1);
		radius_quake(100,100,0,50,25);
		{
			int time;
			for(time=11;time>0;time--)
			{
				SetFont("BIGFONT");
				Hudmessage(s:"\cqResist for \cj",d:time,s:" \cqseconds"; HUDMSG_FADEOUT, 999, CR_RED, 0.5, 0.2, 0.5, 0.5);
				SetFont("SmallFONT");
				HudmessageBold(s:"Get into the elevator!"; HUDMSG_FADEOUT, 998, CR_White, 0.5, 0.17, 1.5, 0.5);
				delay(35);
			}
			Door_close(10,20);
			ceiling_lowerandcrush(12,21,100,2); //ZH2 [AQW] hexen crushmode
			TagWait(12);
			Ceiling_LowerByValueTimes8(12,16,1);
			FloorAndCeiling_LowerByValue(11,20,8*25);
			FloorAndCeiling_LowerByValue(43,24,8*99);
			tagwait(11);
			radius_quake(50,25,0,50,25);
			delay(38*3);
			FloorAndCeiling_LowerByValue(11,70,8*76);
			tagwait(11);
			radius_quake(50,5,0,50,25);
			delay(38*2);
			{
				SetFont("SmallFONT");
				HudmessageBold(s:"Vent path opened!"; HUDMSG_FADEOUT, 998, CR_White, 0.5, 0.17, 1.5, 0.6);
				delay(38);
			}
			floor_LowerByValue(13,20,8*6);
			Ceiling_RaiseByValue(18,255,26*8);
			Light_ChangeToValue(17,255);
			Light_ChangeToValue(19,255);
		}
	}

