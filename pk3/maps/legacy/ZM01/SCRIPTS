#pragma raw include on
#pragma raw define on

#import "zcommon.bcs"
#import "acs_source/bcsutils.acs"

#include "acs_source/zh2lib.h.acs"
#include "acs_source/zh2game.h.acs"

strict namespace
{
	Int forcefield2 = 0;
	Int forcefield3 = 0;

	script "zm01_open" open //level setups
	{
		//water
		Sector_SetColor(5, 0, 48, 160);
		Sector_SetFade(5, 0, 48, 160);
		//mud
		Sector_SetColor(9, 32, 32, 32);
		Sector_SetFade(9, 32, 32, 32);

		TranslucentLine(1, 96, 0);
		Scroll_Texture_Both(1, 0, 0, 0, 200);
		Scroll_Texture_Both(-1, 0, 0, 0, 200);
		Scroll_Texture_Both(2, 0, 0, 0, 200);
		Scroll_Texture_Both(-2, 0, 0, 0, 200);
		Scroll_Texture_Both(3, 0, 0, 0, 200);
		Scroll_Texture_Both(-3, 0, 0, 0, 200);
		SetLineBlocking(3, BLOCK_CREATURES);
		TranslucentLine(2, 0, 0);
		TranslucentLine(3, 96, 0);
		Sector_SetRotation(7, 90, 90);
		Sector_SetRotation(11, 0, 90);
		Sector_SetCeilingPanning(11, 32, 0, 32, 0);
		TranslucentLine(4, 0, 0);
		Scroll_Texture_Both(4, 0, 0, 0, 200);
		Scroll_Texture_Both(-4, 0, 0, 0, 200);
		Sector_SetRotation(22, 90, 0);
		TranslucentLine(66, 0, 0);

		Sector_SetDamage(71, 10000, MOD_FALLING);
	}

	Script 2 (void) /* Forcefield */
	{
		if(!forcefield2)
		{
			SetLineBlocking(2, BLOCK_CREATURES);
			SetLineBlocking(3, BLOCK_NOTHING);
			TranslucentLine(2, 96, 0);
			TranslucentLine(3, 0, 0);
			forcefield2 = 1;
		}
		Else
		{
			SetLineBlocking(3, BLOCK_CREATURES);
			SetLineBlocking(2, BLOCK_NOTHING);
			TranslucentLine(3, 96, 0);
			TranslucentLine(2, 0, 0);
			forcefield2 = 0;
		}
		delay(20); // No spamming
	}

	Script 3 Enter
	{
		GiveInventory(FLARE_ITEM, 1);
	}

	Script 4 (void) // Door is locked
	{
		ActivatorSound("sound/locked1", 127);
		delay(15);
	}

	Script 5 (void)
	{
		Delay(15);
		Print(s:"It's not working.");
	}

	Script 6 (void)
	{
		Delay(15);
		Print(s:"This isn't working.");
	}

	Script 7 (void) /* Forcefield 2 */
	{
		if(!forcefield3)
		{
			SetLineBlocking(4, BLOCK_CREATURES);
			TranslucentLine(4, 96, 0);
			forcefield3 = 1;
		}
		Else
		{
			SetLineBlocking(4, BLOCK_NOTHING);
			TranslucentLine(4, 0, 0);
			forcefield3 = 0;
		}
		delay(20); // No spamming
	}
}
