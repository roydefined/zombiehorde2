    //2th resist for tram

    Script 2 (void)
    {
        SetActivator(-1);
        for(int i = resist2; i > 0; i--)
        {
            ResistMessage1(i,"\chTram \cfopens in... ");
            Delay(35);
        }
        floor_lowertolowest(28,255);
        delay(35*5);
        //Floor_raiseAndCrush(167,255,255555555555555555555555555555);
        ceiling_lowertoFloor(26,100);
        ceiling_lowertoFloor(27,100);
        floor_raisebyvalue(28,100,96);
        Door_open(111,255);
        Acs_terminate(12,0);
        Acs_Execute(91,0);
        SetLineSpecial(154,ThrustThing,64,255,0,0);
        TagWait(28);

        for(int j = 0; j < BCSUtils::MAX_PLAYERS; j++)
        {
            int tid = Identity::GetTid(j);
            if(InTram[j])
                SetActorPosition(tid,GetActorX(tid)+3424.0,GetActorY(tid)-8.0,GetActorZ(tid)+8.0,0);
        }

        delay(70);
        for(i = 20;i < 1280;i+=20)
        {
            Scroll_Ceiling(29,-i/2,-10,0);
            Scroll_Texture_Both(29,i,0,0,0);
            delay(5);
        }
        delay(70);
        for(i = 1260;i > 20;i-=10)
        {
            Scroll_Ceiling(29,-i/2,-10,0);
            Scroll_Texture_Both(29,i,0,0,0);
            delay(5);
        }
        Scroll_Ceiling(29,0,0,0);
        Scroll_Texture_Both(29,0,0,0,0);
        delay(70);
        SetLineSpecial(154,ThrustThing,0,0,0,0);
        floor_lowertolowest(35,100);
        Acs_Terminate(91,0);
        PrintBold(s:"The tram has arrived");
        delay(35*20);
        printbold(s:" \cfSewer doors opened!");
        Door_open(224,255);
        }

