    //4th resist, when boat leaves

    script 5 (void)
    {
        Thing_Remove(48);
        Floor_Lowertolowest(128,2);
        Floor_Lowertolowest(94,2);
        activatorsound("STIFFT04",127);
        SetFont("CONFONT");
        HudMessageBold(n:0, s:" \cfhas reached the \cgboat! \cfGet on it before the nuke \cgexplode!!!"; HUDMSG_FADEOUT, 0, CR_WHITE, 0.05, 0.85, 3.0, 2.0);
        SetActivator(-1);
        delay(175);
        {
            for(int i = resist4; i > 0; i--)
            {
                ResistMessage1(i,"\cgNuke\cf in... ");
                Delay(35);
            }
            SetFont("BIGFONT");
            printbold(s:"\cgNUKE!!!");
            delay(35);
            //SetActivator(-1);
            Delay(70);
            Game::KillUnsafePlayers();
            Ceiling_LowerToFloor(170, 99999);
            Radius_quake(255,100,0,255, no);
            ActivatorSound("world/nuke1",127);
            {
                for(int g = 0; g < BCSUtils::MAX_PLAYERS; g++)
                {
                    int tid = Identity::GetTid(g);
                    if(Game::GetPlayerIsSafe(g))
                        SetActorPosition(tid, GetActorX(tid)+ BoatX ,GetActorY(tid)+ BoatY ,GetActorZ(tid)+ BoatZ ,0);
                }
                Acs_executeAlways(44,0);
            }
        }
    }






