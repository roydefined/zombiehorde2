	if(GoodPresent == TRUE)HudMessageBold(s:"The good: " ,n:Good,s:""; HUDMSG_FADEOUT, 2, CR_BLUE, 0.08, 0.09, 1.0, 1.0);
	if(BadPresent == TRUE)HudMessageBold(s:"The bad: " ,n:Bad,s:""; HUDMSG_FADEOUT, 3, CR_RED, 0.08, 0.12, 1.0, 1.0);
	if(UglyPresent == TRUE)HudMessageBold(s:"The ugly: " ,n:Ugly,s:""; HUDMSG_FADEOUT, 4, CR_YELLOW, 0.08, 0.15, 1.0, 1.0);
	if(GoodPresent == TRUE && BadPresent == TRUE && UglyPresent == TRUE && GoodBadUgly == FALSE){GoodBadUgly = TRUE; ACS_ExecuteAlways(8,0,0,0,0);}
	Delay(1);
	Restart;
}

