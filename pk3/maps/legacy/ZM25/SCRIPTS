script 2 (int Typ)
{ //Weather
	if( Typ == 1)//  mist
	{
		changesky("ICESKY","ICESKY");

		for (int i = 0; i < 500; ++i)
			Sector_setfade(i, 127, 127, 127);
		Light_fade(7,110,35);
		Light_fade(8,110,35);
		Light_fade(9,110,35);
		Light_fade(48,110,35);
		Light_fade(55,110,35);

		ACS_ExecuteAlways(3,0,0,0,0);// Incoming Misty 80% of chance to spawn
		SetFont("BIGFONT");
		HudMessageBold(s:"Here comes some mist."; HUDMSG_FADEOUT, 998, CR_GREY, 5.5, 0.2, 5.5, 0.5);
	}
	else if( Typ == 2)// thunder
	{
		Thing_SetSpecial(1550, 0, 255, 0, 0);
		changesky("ICESKY","ICESKY");
		SpawnSpotFacing("ZH2LegacyZm25ThunderZone",79,0);
		ACS_ExecuteAlways(4,0,0,0,0);// Random thunder spawner
		SetFont("BIGFONT");
		HudMessageBold(s:"Here comes thunder!"; HUDMSG_FADEOUT, 998, CR_BLUE, 5.5, 0.2, 5.5, 0.5);
	}
	else if( Typ == 3)// cataclism
	{
		changesky("TSKYA","TSKYA");
		ACS_Execute(5,0,0,0,0);// Random meteor spawner
		SetFont("BIGFONT");
		HudMessageBold(s:"Watchout, it's a cataclism !"; HUDMSG_FADEOUT, 998, CR_RED, 5.5, 0.2, 5.5, 0.5);
	}
	else if( Typ == 4)// night
	{
		changesky("STSKY8","STSKY8");
		SetFont("BIGFONT");
		HudMessageBold(s:"\cmIt's already night !"; HUDMSG_FADEOUT, 998, CR_GOLD, 5.5, 0.2, 5.5, 0.5);
		Thing_Activate(86);

		for (i = 0; i < 500; ++i)
			Sector_Setcolor(i, 100, 100, 100);
	}
	else if( Typ == 5)// nothing
	{
		SetFont("BIGFONT");
		HudMessageBold(s:"The weather stays calm."; HUDMSG_FADEOUT, 998, CR_GOLD, 5.5, 0.2, 5.5, 0.5);
	}
}

script 3 (void)
{
	// Incoming Misty 80% of chance to spawn
	Delay(35*random(45,120));
	switch(random(1,5))
	{
		case 1:
		case 2:
		case 3:
		case 4:
			Thing_Activate(69);
			SetFont("BIGFONT");
			HudMessageBold(s:"Misty has been spoted !"; HUDMSG_FADEOUT, 998, CR_WHITE, 0.5, 0.2, 2.5, 0.5);
			SpawnSpotFacing("ZH2LegacyZm25Misty",260,250);
			SpawnSpotFacing("ZH2LegacyZm25Misty",261,251);
			TakeActorInventory(250,"ZH2LegacyZM18LabYouCanSeeMe",1);
			GiveActorInventory(251,"ZH2LegacyZM18LabYouCanSeeMe",1);
			Music::PlayMusic("D_MYST");
			delay(35*5);
			SETFONT("SmallFont");
			HudMessageBold(s:"Misty can't go in buildings."; HUDMSG_FADEOUT, 0, CR_YELLOW, 0.5, 0.24, 8.0, 4.0);
			break;
		case 5:
			break;
	}
}

