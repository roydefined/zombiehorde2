Script 6 (int Typ)
{// Good/Bad/Ugly
	GiveInventory("Clip",1);
	ACS_Execute(7,0,0,0,0);
	if (Typ == 1){PrintBold(n:0, s:" is the good, he found the jacksgun !"); Good = PlayerNumber() + 1; GoodPresent = TRUE;}
	else if (Typ == 2){PrintBold(n:0, s:" is the bad, he found the double shotgun !"); Bad = PlayerNumber() + 1; BadPresent = TRUE;}
	else if (Typ == 3){PrintBold(n:0, s:" is the ugly, he found the dynamite !"); Ugly = PlayerNumber() + 1; UglyPresent = TRUE;}
}

Script 7 (void)
{// Map information
