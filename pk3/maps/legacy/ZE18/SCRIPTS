    /* [ZH2] RESISTS START */

    script "pre_resist_handler" (int resistIndex)
    {
        switch (resistIndex)
        {
            // Get in the safe zone!
            case 3:
            {
                SetFont ("CONFONT");
                HudMessageBold(s:"\cgThe building will self-destruct!\nGet into the \cfsafe zone \cgbefore it's too late!"; HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 3.0, 2.0);
                Delay (105);
                break;
            }
        }
    }

    script "post_resist_handler" (int resistIndex)
    {
        switch (resistIndex)
        {
            // Opening back doors...
            case 0:
            {
                Door_Open (2,20);
                break;
            }

            // Deactivating security systems...
            case 1:
            {
                SetLineBlocking (1,OFF);
                SetLineTexture (1,SIDE_BACK,TEXTURE_MIDDLE,"TRANS");
                SetLineTexture (2,SIDE_FRONT, TEXTURE_MIDDLE, "LITEBLU4");
                Door_Open (23, 20);
                break;
            }

            // Lowering wall...
            case 2:
            {
                Floor_MoveToValue (10,20,8,0);
                Door_Open (11,20);
                SetLineBlocking (3, OFF);
                break;
            }

            // Get in the safe zone!
            case 3:
            {
                ceiling_LowerAndCrush(14,10,5,2);
                TagWait(14);
                Ceiling_LowerByValueTimes8(14,16,1);

                Delay(35*3);
                SetFont ("BigFont");
                HudMessageBold (s: "\cgWarning: \cjBuilding self-destruction!"; HUDMSG_FADEOUT,999,CR_GREEN,0.5,0.2, 2.0);
                Delay(35*3);
                AmbientSound ("world/nuke1", 127);
                Game::KillUnsafePlayers();
                break;
            }
        }
    }

    // This resist message is just like KGSWS' resist message but the color is reversed:
    // the surrounding text stays green and only the countdown number itself changes color.
    // TODO: Get time reason from resist data.
    internal raw OnDrawResistHud(void[]* data)
    {
        if (data == null)
            return 0;

        _resistHookDataRef = data;

        int resistIndex = _resistHookDataRef.Index;
        int left = (Resist::GetTicsLeftByIndex(resistIndex) / 35) + 1;

        str numColor = "\cj";

        if (left < 20)
            numColor = "\cq";

        if (left < 15)
            numColor = "\ck";

        if (left < 10)
            numColor = "\ci";

        if (left < 5)
            numColor = "\cg";

        if (left < 2)
            numColor = "\cm";

        Hud::SetRelativePoint(0.0, 12.0);
        BCSUtils::HudSetFont("BigFont");
        BCSUtils::HudDrawText(
            500,
            StrParam(
                s:"\cdResist for ",
                s:numColor,
                d:left,
                s:"\cd second",
                s:left == 1 ? "" : "s"
            ));

        return 0;
    }

