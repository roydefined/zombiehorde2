	script 10 OPEN clientside //software support
	{
	    if(getplayerrender()!=SOFTWARE_PLAYER) Terminate;
	    {
	        Log(s:"Software mode has been detected.");
	        Log(s:"Map brightness increased and all water textures + colors have been improved to support software rendering.");

	        delay(35*3);

	        //if i find a software-friendly texture i will use that here.

	        for(int area=0;area<=999;area++) //random tag because i'm too damn lazy to check how many tags are used...
	        {
	            Light_fade(area,192,35);
	        }
	    }
	}

