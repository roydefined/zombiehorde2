Script 3 (void) // Secret for Crazy weather part 3
{
    if(CrazyWeatherPart3)
    {
        if(SwitchesFound == 4)
        {
            Print(s:"\crLast switch activated !");
            SwitchesFound++;
            delay(35*3);
            Print(s:"\cnA new switch is available in the yellow room.");
            Floor_LowerByValue(100, 50, 64);
        }
        if(SwitchesFound == 3)
        {
            Print(s:"\crFourth switch activated !");
            SwitchesFound++;
        }
        if(SwitchesFound == 2)
        {
            Print(s:"\crThird switch activated !");
            SwitchesFound++;
        }
        if(SwitchesFound == 1)
        {
            Print(s:"\crSecond switch activated !");
            SwitchesFound++;
        }
        if(SwitchesFound == 0)
        {
            Print(s:"\crFirst switch activated !");
            SwitchesFound++;
        }
    }
}

