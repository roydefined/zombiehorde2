    script 17 (int Typ) // weather
    {
        if(Typ == 1) // mist
        {
            Thing_SetSpecial(1550, 0, 255, 0, 0);
            changesky("ICESKY", "ICESKY");
            Thing_Activate(62);

            for (int i = 0; i < 500; ++i)
                Sector_setfade(i, 127, 127, 127);

            ACS_Execute(35, 0, 0, 0, 0);
            Thing_Remove(48);
            SetFont("BIGFONT");
            HudMessageBold(s:"Here comes some mist."; HUDMSG_FADEOUT, 998, CR_GREY, 5.5, 0.2, 5.5, 0.5);
        }
        if(Typ == 2) // thunder
        {
            Thing_SetSpecial(1550, 0, 255, 0, 0);
            changesky("ICESKY", "ICESKY");
            Thing_Activate(62);
            ACS_Execute(31, 0, 0, 0, 0);
            ACS_Execute(32, 0, 0, 0, 0);
            SetFont("BIGFONT");
            HudMessageBold(s:"Here comes thunder!"; HUDMSG_FADEOUT, 998, CR_BLUE, 5.5, 0.2, 5.5, 0.5);
            Thing_Remove(48);
            SpawnSpotFacing("ZH2LegacyZm25ThunderZone", 79, 0);
        }
        if(Typ == 3) // cataclism
        {
            changesky("TSKYA", "TSKYA");
            ACS_Execute(30, 0, 0, 0, 0);
            ACS_Execute(33, 0, 0, 0, 0);
            SetFont("BIGFONT");
            HudMessageBold(s:"Watch out, it's a cataclism!"; HUDMSG_FADEOUT, 998, CR_RED, 5.5, 0.2, 5.5, 0.5);
            Thing_Remove(48);
        }
        if(Typ == 4) // night
        {
            changesky("STSKY8", "STSKY8");
            Thing_Activate(65);
            SetFont("BIGFONT");
            HudMessageBold(s:"\cmIt's already night. Nobody has ever survived a night here."; HUDMSG_FADEOUT, 998, CR_GOLD, 5.5, 0.2, 5.5, 0.5);
            ACS_Execute(36, 0, 0, 0, 0);
            Thing_Activate(354);

            for (int i = 0; i < 500; ++i)
                Sector_Setcolor(i, 100, 100, 100);

            Thing_Remove(48);
        }
        if(Typ == 5) // nothing
        {
            SetFont("BIGFONT");
            HudMessageBold(s:"The weather stays calm."; HUDMSG_FADEOUT, 998, CR_GOLD, 5.5, 0.2, 5.5, 0.5);
            ACS_Execute(41, 0, 0, 0, 0);
        }
    }

