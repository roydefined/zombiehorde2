Script 13 (void)
{
    if(ArmoryAmmount == 0)
    {
        SetFont("BIGFONT");
        HudMessage(s:"The teleporter is off."; HUDMSG_FADEOUT, 640+PlayerNumber(), CR_GOLD, 5.5, 0.5, 2.0, 0.5);
    }
    if(ArmoryAmmount >= 1)
    {
        if(AManintheRoom)
        {
            SetFont("BIGFONT");
            HudMessage(s:"There is already someone in the armory's room ..."; HUDMSG_FADEOUT, 640+PlayerNumber(), CR_GOLD, 5.5, 0.5, 2.0, 0.5);
            Thing_Move(0, 63, 0);
        }
        if(!AManintheRoom)
        {
            if(CheckInventory("ZH2LegacyZM16WentIntoArmory") == 1)
            {
                SetFont("BIGFONT");
                HudMessage(s:"You already went into the armory's room !"; HUDMSG_FADEOUT, 640+PlayerNumber(), CR_GOLD, 5.5, 0.5, 2.0, 0.5);
                Thing_Move(0, 63, 0);
            }
            if(CheckInventory("ZH2LegacyZM16WentIntoArmory") == 0)
            {
                if(Player::GetIsZombie())
                {
                    SetFont("BIGFONT");
                    HudMessage(s:"There are weapons in it, not brains !"; HUDMSG_FADEOUT, 640+PlayerNumber(), CR_GOLD, 5.5, 0.5, 2.0, 0.5);
                    Thing_Move(0, 63, 0);
                }
                if(!Player::GetIsZombie())
                {
                    AManintheRoom = true;
                    GiveInventory("ZH2LegacyZM16WentIntoArmory", 1);
                    Thing_Move(0, 61, 0);
                    SpawnSpotfacing(WEAPON_JACKSGUN_SPAWN_NAME, 59, 18444);
                    SpawnSpotfacing(WEAPON_DOUBLESHOTGUN_SPAWN_NAME, 58, 18444);
                    SpawnSpotfacing(KEVLAR_ITEM, 60, 18444);
                    Thing_SetSpecial(18444, 226, 14, 0, 0);
                    ACS_Execute(15, 0, 0, 0, 0);
                }
            }
        }
    }
}

Script 14 (void) // armory's room cooldown
{
    ACS_Terminate(15, 0);
    Print(s:"Item selected, returning to the map ...");
    Thing_Remove(18444);
    delay(35);
    ArmoryAmmount--;
    Thing_Move(0, random(90, 94), 0);
    AManintheRoom = false;
}

Script 15 (void) // Armory activated !
{
    Print(s:"You have 15 Secondes to select your item !");
    delay(35*15);
    Thing_Remove(18444);
    Thing_Move(0, random(90, 94), 0);
    ArmoryAmmount--;
    Print(s:"Sorry but you are moved to don't block the armory's room");
    AManintheRoom = false;
}

