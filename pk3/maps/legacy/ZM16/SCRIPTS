    Script 9 (void) // Opening Armory
    {
        if(CheckInventory("ZH2RedSkullKey") == 0 && !ArmoryOpen)
        {
            Print(s:"You don't have the red skull key to open the armory.");
        }

        if(CheckInventory("ZH2RedSkullKey") == 1 && !ArmoryOpen)
        {
            ArmoryOpen = true;
            Print(s:"Red skull key used, the armory is now open.");
            Floor_LowerbyValue(23, 40, 118);
            delay(35*2);
            delay(35*3);
            SetFont("BIGFONT");
            HudMessageBold(s:"The armory is now open!"; HUDMSG_FADEOUT, 998, CR_GOLD, 5.5, 0.2, 2.0, 0.5);
            AmbientSound("world/reveal1", 127);
            delay(35*5);
            PrintBold(s:"Turn on the generator to activate the teleporter.");
        }
    }

    Script 10 (void) // Activing Generator
    {
        if(!ArmoryOpen)
        {
            Print(s:"Open the armory  first.");
        }
        if(CheckInventory("ZH2RedSkullKey") == 0 && !GeneratorActivated && ArmoryOpen)
        {
            Print(s:"You don't have the red skull key to turn on the generator.");
        }
        if(CheckInventory("ZH2RedSkullKey") == 1 && !GeneratorActivated && ArmoryOpen)
        {
            GeneratorActivated = true;
            Print(s:"Red skull key used, the generator is now activated.");
            Floor_LowerbyValue(23, 40, 118);
            delay(35*2);
            Thing_Move(0, 56, 0);
            ACS_ExecuteAlways(11, 0, 0, 0, 0);
        }
    }

