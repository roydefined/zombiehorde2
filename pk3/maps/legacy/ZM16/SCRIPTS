script 7 (int Typ)
{
    if(Typ == 0) // Not accessible anymore
    {
        Print(s:"This door is locked.");
        ActivatorSound("sound/locked2", 127);
        delay(15);
    }
    if(Typ == 1) // Speaking with Uboa ( 50 Speak == Secret for Crazy weather part 1 ).
    {
        if(CrazyWeatherPart1)
        {
            switch(random(1, 4))
            {
                case 1:
                    Print(s:"Oh yes, my food is back.");
                    break;
                case 2:
                    Print(s:"Come in my house if you can I've a surprise for you.");
                    break;
                case 3:
                    Print(s:"Hellow, it's me who ate all thats men, if you want be the next come in. ");
                    break;
                case 4:
                    Print(s:"Hum, normally I don't speak with my food.");
                    break;
            }
            if(SpeakingwithUboa == 50)
            {
                Print(s:"\cnIt looks like we became friends, so I will tell you something interresting.\n\cnReturn in the hotel, the key for lara's room has spawned at upstairs. \n\cnwhere humans like camping.");
                SpawnSpot("ZH2LegacyLaraRoomKey", 47, 466, 0);
                ACS_Execute(8, 0, 0, 0, 0);
            }
            SpeakingwithUboa++;
            delay(15);
        }
    }
    if(!CrazyWeatherPart1)
    {
        Print(s:"Nothing interesting here ...");
    }
    if(Typ == 2) // The rampage of the uboa ( it begins the crazy weather secret ).
    {
        if(!CrazyWeatherPart0)
        {
            ACS_Execute(83, 0, 0, 0, 0);
            CrazyWeatherPart0 = true;
        }
        Print(s:"Damn it, there were a real rampage here.\n Who did that ?");
        delay(15);
    }
    if(Typ == 3) // Not accessible anymore
    {
        Print(s:"This door is sealed.");
        ActivatorSound("sound/locked2", 127);
        delay(15);
    }
    if(Typ == 4) // If you fall in the hole when you are a zombie
    {
        if(Player::GetIsZombie())
        {
		    switch(_warnCount[PlayerNumber()])
            {
                case 0:
                    Print(s:"How did you managed to come here ?");
                    delay(35*2);
                    Print(s:"I save your life for this time, but don't come here again !");
                    Thing_Move(0, random(90, 94), 0);
                    break;
                case 1:
                    Print(s:"You ? Again ?");
                    delay(35*2);
                    Print(s:"This is the last warning, if you come again you will die !");
                    Thing_Move(0, random(90, 94), 0);
                    break;
                case 2:
                    Print(s:"OK ...");
                    delay(35*2);
                    Print(s:"You Searched it !");
                    DamageThing(0, MOD_UNKNOWN);
                    break;
            }
            
		    _warnCount[PlayerNumber()]++;
        }
    }
}

