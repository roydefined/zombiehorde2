    //[AQW] Added this teleport script to disallow Zombies to kill themselves in the Laser.
    Script 9 (void)
    {
        if(Player::GetIsZombie())
        {
            Teleport(12,0,0);
            if(teleporter2 == false)
            {
                teleporter2 = true;
                Door_Open(15,15,0);
            }
        }
        else
        {
            DamageThing(6000, MOD_UNKNOWN);
        }
    }


    /* [ZH2] RESISTS START */

    script "pre_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            case 3:
            {
                SetFont("CONFONT");
                HudMessageBold(n:0, s:" has reached the subterrain bunker!\n\cCEscape from the lab before thatlaron generator explodes!"; HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 3.0, 2.0);
                Delay(35*2);
                SetActivator(-1);
                break;
            }
        }
    }

    script "post_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            case 0:
            {
                polyobj_move(1,10,64,112);
                break;
            }

            case 1:
            {
                door_open(7,20);
                break;
            }

            case 2:
            {
                polyobj_move(3,10,64,56);
                door_open(5,20);
                break;
            }

            case 3:
            {
                //Generic_Ceiling(8,15,96,0,16); //ZH2 [AQW]
                Ceiling_LowerAndCrush(8,15,20,2); //ZH2 [AQW]
                tagwait(8);
                Ceiling_LowerByValueTimes8(8,16,1);
                Delay(50);
                SetFont("BIGFONT");
                HudMessageBold(s:"\cGWarning : \cFThalaron laser overheat!!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
                delay(50);
                Radius_Quake(100,35*5,0,100,0);
                AmbientSound("world/thalarbeam",100);
                Game::KillUnsafePlayers();
                break;
            }
        }
    }

    /* [ZH2] RESISTS END */
}
