    bool teleporter = false;
    bool teleporter2 = false; //[AQW] Anti Zombie Suicide.

    Script 2 Open
    {
        SetLineBlocking(13,BLOCK_EVERYTHING);
        delay(35*9);
        Music::PlayMusic("lam_fina", 0);
        delay(35*5);
        SetLineTexture(13,SIDE_FRONT,TEXTURE_MIDDLE,"-");
        SetLineTexture(13,SIDE_BACK,TEXTURE_MIDDLE,"-");
        SetLineBlocking(13,BLOCK_NOTHING);
        Polyobj_move(7,15,128,56);
    }

    script 5 (void)
    {
        Teleport(9,0,0);
        if(teleporter == false)
        {
            teleporter = true;
            polyobj_move(5,15,64,56);
        }
    }

    Script 6 (void)
    {
        SetActivator(-1);
        Printbold(s:"Forcefields activated\nSystem will collapse in 15 seconds");
        SetLineTexture(10,SIDE_FRONT,TEXTURE_MIDDLE,"FIREBLU1");
        SetLineTexture(10,SIDE_BACK,TEXTURE_MIDDLE,"FIREBLU1");
        SetLineBlocking(10,BLOCK_CREATURES);
        delay(35*15);
        SetLineTexture(10,SIDE_FRONT,TEXTURE_MIDDLE,"-");
        SetLineTexture(10,SIDE_BACK,TEXTURE_MIDDLE,"-");
        SetLineBlocking(10,BLOCK_NOTHING);
        printbold(s:"Forcefields disabled");
    }

    Script 7 (void)
    {
        SetActivator(-1);
        //Ceiling_LowerByvalue(11,30,112); - causes no crushing damage
        //Generic_ceiling(11, 30, 112, 0, 16); //ZH2 [AQW]
        Ceiling_LowerAndCrush(11,30,10,2); //ZH2 [AQW]
        Printbold(s:"Sewer access closed\nSearching for problems");
        tagwait(11);
        Ceiling_LowerByValueTimes8(11,30,1); //ZH2 [AQW]
        SetLineBlocking(12,BLOCK_CREATURES);
        delay(35*15);
        Ceiling_raiseByValue(11,20,112);
        SetLineBlocking(12,BLOCK_NOTHING);
        printbold(s:"No problems found\nRe-opening the sewer acces");
    }

    Script 8 (void)
    {
        SetActivator(-1);
