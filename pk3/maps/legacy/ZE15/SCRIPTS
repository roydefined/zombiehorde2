    Script 30 (void)
    {
        if (Secret_Activated == 0)
        {
            // Aww yea, you can stack cases :3
            switch(random(1,10))
            {
                case 1:
                case 3:
                case 4:
                case 5:
                case 6:
                case 7:
                case 8:
                case 9:
                case 10:
                {
                    Secret_Activated = 1;
                    SetLineSpecial(3,0,0,0,0,0,0);
                    Music::PlayMusic("RUNAWAY");
                    SetFont("BIGFONT");
                    HudmessageBold(s:"Secret Ending ACTIVATED"; HUDMSG_FADEOUT, 998, CR_White, 0.5, 0.30, 3.5, 0.5);
                    Log(s:"Secret Ending has been Activated!");

                    // [ZH2] Move all current safe players to slot 2
                    for (int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
                    {
                        if (Game::GetPlayerIsSafe(i, 0))
                        {
                            Game::SetPlayerIsSafe(i, false, 0, false);
                            Game::SetPlayerIsSafe(i, true, 2, false);
                        }
                    }

                    // Bit of a hack but we don't have a good way to sync the game again if we never broadcast changes.
                    // So just call SetPlayerIsSafe one more time.
                    Game::SetPlayerIsSafe(0, false, 0, false);

                    delay(5*35);
                    acs_execute(17,0,0,0,0);
                    break;
                }

                // Nyan, rare
                case 2:
                {
                    Acs_execute(33,0,0,0,0);
                    break;
                }
            }
        }
    }

