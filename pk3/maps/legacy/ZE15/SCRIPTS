    //---------------------------------------- [ZH2] Special safety script

    // The script marks the player as safe using either slot 0 or 2 depending on map state.
    // Slot 2 is hidden and will be used instead if the secret ending has started.
    // Reason being is that at this point the safezone is no longer safe, and player must move.
    script "enter_safezone"
    {
        if (Secret_Activated)
            Game::SetIsSafe(Lineside() == LINE_FRONT, 2);
        else
            Game::SetIsSafe(Lineside() == LINE_FRONT, 0);
    }

