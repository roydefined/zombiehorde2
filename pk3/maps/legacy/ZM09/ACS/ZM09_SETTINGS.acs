    SETFONT("IBMSETED");
    HudMessageBold(s:"A";HUDMSG_PLAIN,490,0,men_pX[men_selected[4]],men_pY[4],0,0,0);
    SETFONT("IBMSELEC");
//    HudMessageBold(s:"A";HUDMSG_PLAIN,men_selected_tid[selected_menu],0,men_pX[men_selected[selected_menu]],men_pY[selected_menu],0,0,0);

}

function void zm09_menu_close(void){
 for(int i=488;i<506;i++){
    setfont("normalfont");
    HudMessageBold(s:" ";HUDMSG_PLAIN,i,0,men_pX[men_selected[0]],men_pY[0],0,0,0);
 } 
 HudMessageBold(s:" ";HUDMSG_PLAIN,543,0,0.5,0.5,0,0,0);
}

function void zm09_save_settings(void){
    int x;
//Funcion adapts the old save data to the new menu system
    weather_quality=men_selected[0]-1;
    if(men_selected[1]==1)
        rain_sound=false;
    else
        rain_sound=true;
    if(rain_sound==false) 
        thing_deactivate(144);
    else if(rainfall_actived==true)
        thing_activate(144);
    rain_detail=men_selected[2]-1;
    if(men_selected[3]==1)
        nedm_desactive=0;
    else
        nedm_desactive=1;
    if(men_selected[4]==1){
        reflection_actived=false;
		Sector_SetPlaneReflection (149, 0, 0);
		Sector_SetPlaneReflection (3, 0, 0);
		Sector_SetPlaneReflection (153, 0, 0);
		AmbientSound("menu/change",127);	
	}
    else{
        reflection_actived=1;
		Sector_SetPlaneReflection (149, 66, 0);
		Sector_SetPlaneReflection (3, 44, 0);
		Sector_SetPlaneReflection (153, 44, 0);
		AmbientSound("menu/change",127);
	}
    x = (music_quality+1)*10000+(rain_detail+2)*1000+(rain_sound+2)*100+(weather_quality+2)*10+(nedm_desactive+2+reflection_actived*2);
    SetCvar("x_zh_zm09",x);
}

function void zm09_consolemenu_set_option(int value, int option, int min)
{
    if ( value < min || value > men_max_opt[option])
    {
        printbold(s:"invalid parameter, it should be between ", d: min, s:" and ", d: men_max_opt[option]);
        return;
    }
    men_selected[option] = value;

    zm09_save_settings();
}