int zm09_menu_options[5];
#define MENU_ACTIVE 1
#define MENU_CLOSE  0

#define RAIN_DISTANCE_IND 0 // 0 - 4
#define RAIN_SOUND_IND 1 // 1 = disable
#define RAIN_DETAILS_IND 2 // X // 0 - 4
#define NEDM_ALLOW  3 // 0 enable
#define REFLECTION_ALLOW 4 // 1 = disable

int men_pX[5]={483.0  ,563.0  ,643.0  ,723.0 ,803.0};//fixed positons of the menu
int men_pY[5]={241.0,331.0,421.0,511.0,591.0};//fixed positions of the menu
int men_selected[5]={2,0,2,0,0};//can be changed
int men_max_opt[5]={4,1,4,1,1};//fixed information
int men_selected_tid[5]={505,499,496,493,490};//fixed information
int men_size = 4;//fixed information

int zm09_strsettings[8]={"ULTRA LOW","LOW","MEDIUM","HIGH","ULTRA","EXTREME","ON","OFF"};//CHECK IF CAN BE DELETED
int menu_zm09;//CHECK IF CAN BE DELETED

