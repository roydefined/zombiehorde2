script 69 (int code) NET{
	if(code==1414325){
		int back_wf_script=-1;
		int back_rav_script=-1; //there's no -1 situation
		int script_cnt=0;
		int tic_cnt=0;
		while(true){
			SETFONT("SMALLFONT");
			HudMessage(s:"TICS:",d:tic_cnt; HUDMSG_PLAIN, 544, CR_RED, 0, 0.2, 9.8, 0);
			tic_cnt+=3;
		/*
		Ravishing script:offline/online/disconnected
		Ravishing situation:visible/invisible/Stucked
		Ravishing target:!ghoul_hate
		Ravishing last script called:!ravishing_script
		*/			
		    SETFONT("SMALLFONT");
			HudMessage(s:"Ravishing script:"; HUDMSG_PLAIN, 545, CR_RED, 0, 0.22, 9.8, 0);
			if(ravishing_script==0){
				HudMessage(s:"offline"; HUDMSG_PLAIN, 546, CR_WHITE, 0.15, 0.22, 9.8, 0);
			}else if(ravishing_script==back_rav_script){
				script_cnt++;
				if(script_cnt>=50){
					HudMessage(s:"Disconnected"; HUDMSG_PLAIN, 546, CR_YELLOW, 0.2, 0.22, 9.8, 0);
				}else{
					HudMessage(s:"online"; HUDMSG_PLAIN, 546, CR_GREEN, 0.15, 0.22, 9.8, 0);
				}
			}else{
				HudMessage(s:"online"; HUDMSG_PLAIN, 546, CR_GREEN, 0.15, 0.22, 9.8, 0);
				script_cnt=0;
			}


			HudMessage(s:"Ravishing situation:"; HUDMSG_PLAIN, 547, CR_RED, 0, 0.24, 9.8, 0);
			if(user_invisible==true){
				HudMessage(s:"Invisible"; HUDMSG_PLAIN, 548, CR_WHITE, 0.15, 0.24, 9.8, 0);
			}else if(stuck_test>=20){
				HudMessage(s:"Stucked"; HUDMSG_PLAIN, 548, CR_YELLOW, 0.15, 0.24, 9.8, 0);
			}else{
				HudMessage(s:"Visible"; HUDMSG_PLAIN, 549, CR_RED, 0.15, 0.24, 9.8, 0);
			}

			HudMessage(s:"Ravishing target:"; HUDMSG_PLAIN, 550, CR_RED, 0, 0.26, 9.8, 0);
				HudMessage(n:ghoul_target-601, s:" ...number:",d:ghoul_target; HUDMSG_PLAIN, 551, CR_WHITE, 0.2, 0.26, 9.8, 0);
			HudMessage(s:"Ravishing last script:"; HUDMSG_PLAIN, 552, CR_RED, 0, 0.28, 9.8, 0);
				HudMessage(d:ravishing_script; HUDMSG_PLAIN, 553, CR_WHITE, 0.15, 0.28, 9.8, 0);
		/*
		White Face script:offline/online/disconnected/starting (debug_wf_scrpt_stck:0-2:3:4:5-else-1)
		White Face situation:visible/invisible (debug_wf_vsble)
		White Face speed:slow/fast (debug_wf_speed)
		White Face target:!ghoul_hate
		*/
		    SETFONT("SMALLFONT");
			HudMessage(s:"White Face script:"; HUDMSG_PLAIN, 554, CR_WHITE, 0, 0.3, 9.8, 0);
			if(debug_wf_scrpt_stck==0){
				HudMessage(s:"OFFLINE"; HUDMSG_PLAIN, 555, CR_WHITE, 0.15, 0.3, 9.8, 0);	
			}else if(debug_wf_scrpt_stck==1)
				HudMessage(s:"STARTING"; HUDMSG_PLAIN, 555, CR_BLUE, 0.15, 0.3, 9.8, 0);
			else if(debug_wf_scrpt_stck==back_wf_script){
				if(script_cnt>=50){
					HudMessage(s:"DISCONNECTED"; HUDMSG_PLAIN, 555, CR_YELLOW, 0.15, 0.3, 9.8, 0);	
				}else{
					script_cnt++;
					HudMessage(s:"ONLINE"; HUDMSG_PLAIN, 555, CR_GREEN, 0.15, 0.3, 9.8, 0);	
				}
			}else{
				HudMessage(s:"ONLINE"; HUDMSG_PLAIN, 555, CR_GREEN, 0.15, 0.3, 9.8, 0);
				script_cnt=0;
			}			
			
			HudMessage(s:"White Face situation:"; HUDMSG_PLAIN, 556, CR_WHITE, 0, 0.32, 9.8, 0);
			switch(debug_wf_vsble){
				case true:
				HudMessage(s:"VISIBLE"; HUDMSG_PLAIN, 557, CR_WHITE, 0.15, 0.32, 9.8, 0);	
				break;
				case false:
				HudMessage(s:"INVISIBLE"; HUDMSG_PLAIN, 557, CR_RED, 0.15, 0.32, 9.8, 0);
				break;
			}
			
			HudMessage(s:"White Face speed:"; HUDMSG_PLAIN, 558, CR_WHITE, 0, 0.34, 9.8, 0);
			if(debug_wf_speed==false){
				HudMessage(s:"SLOW"; HUDMSG_PLAIN, 559, CR_GREEN, 0.15, 0.34, 9.8, 0);
			}else{
				HudMessage(s:"FAST"; HUDMSG_PLAIN, 560, CR_RED, 0.15, 0.34, 9.8, 0);
			}
		
			HudMessage(s:"White Face target:"; HUDMSG_PLAIN, 561, CR_WHITE, 0, 0.36, 9.8, 0);
				HudMessage(n:ghoul_target-601, s:" ...number:",d:ghoul_target; HUDMSG_PLAIN, 562, CR_WHITE, 0.2, 0.36, 9.8, 0);
			delay(3);
		}
	}else{
		log(s:"\ck<white face> ", n:ActivatorTID(), s:"\cd stop cheating... thanks from ibm :) ");
	}
}

function void zm09_update_settings(void){
int i=0;
int j=0;
int input=GetCvar("x_zh_zm09");
    if(input!=0){//input=22260
        i=input/10;//2226
        i=i*10;//22260
        i=input-i;//0
        switch(i){
            case 2: nedm_desactive=false; reflection_actived=false; break;
            case 3: nedm_desactive=true;  reflection_actived=false;break;
            case 4: nedm_desactive=false; reflection_actived=true; break;
            default: nedm_desactive=true;  reflection_actived=true; break;
        }
        //22260
        i=input/100;//222
        i=i*10;//2220
        j=input/10;//2226
        i=j-i;//2226-2220=6
        if(i<1 || i>6) weather_quality=0;
        else weather_quality=i-2;
        //22260
        i=input/1000;//22
        i=i*10;//220
        j=input/100;//222
        i=j-i;//222-220=2
        if(i<2 || i>3) rain_sound=0;
        else rain_sound=i-2;
        //22260
        i=input/10000;//2
        i=i*10;//20
        j=input/1000;//22
        i=j-i;//22-20=2
        if(i<1 || i>6) rain_detail=0;
        else rain_detail=i-2;
        i=input/10000;//2
        if(i==1)music_quality=false;
        else music_quality=true;
		
		//Adapt the old menu values to the new menu
		//Funcion adapts the old save data to the new menu system
		men_selected[0]=weather_quality+1;
		if(rain_sound==1)
			men_selected[1]=false;
		else
			men_selected[1]=true;
		men_selected[2]=rain_detail+1;
		if(nedm_desactive==1)
			men_selected[3]=0;
		else
			men_selected[3]=1;
		if(reflection_actived==1)
			men_selected[4]=0;
		else
			men_selected[4]=1;
    }
    if(reflection_actived==true){
        Sector_SetPlaneReflection (153, 44, 0);
        Sector_SetPlaneReflection (149, 66, 0);
        Sector_SetPlaneReflection (3, 44, 0);
    }
	
	
    play_zm09_music();
}␀␀