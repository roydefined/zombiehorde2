    Script 6 (void) // EPITAPH - Rubydoor
    {
        if(CheckInventory(KEY_BLOODRUBY_NAME))
        {
            ClearLineSpecial();

            //do other things here
            Print(s:"\c- A Blood Ruby has been placed!");
            SetLineTexture(2, SIDE_FRONT, TEXTURE_BOTTOM, "EPITAPH2");
            ruby = 1;

            if(sapphire==1)
                acs_execute(8,0,0,0,0);
        }
        else Print(s:"A Blood Ruby is needed!");
    }


    Script 7 (void) // EPITAPH - Sapphiredoor
    {
        if(CheckInventory(KEY_NIGHTSAPPHIRE_NAME))
        {
            ClearLineSpecial();

            //do other things here
            Print(s:"\c- A Night Sapphire has been placed!");
            SetLineTexture(3, SIDE_FRONT, TEXTURE_BOTTOM, "EPITAPH2");
            sapphire = 1;
            if(ruby==1)
                acs_execute(8,0,0,0,0);
        }
        else Print(s:"A Night Sapphire is needed!");
    }


    Script 8  (void)// EPITAPH - Open
    {
        if(sapphire==1 && ruby==1)
        {
            acs_execute(53,0,0,0,0);
