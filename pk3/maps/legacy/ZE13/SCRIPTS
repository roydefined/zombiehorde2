    Script "ze13_open" open
    {
        scroll_wall(5,0,-5,0,2);
        scroll_wall(5,0,-5,1,2);
        delay(70);
        SetFont("ze13logo");
        HudMessageBold(s:"A"; HUDMSG_FADEINOUT, 1, 0, 0.5, 0.2, 3, 3.0, 2.0, 2.0);
        SetFont("CONFONT");
        HudMessageBold(s:"By Dr. Doctor"; HUDMSG_FADEINOUT, 2, 0, 0.8, 0.38, 3, 3.0, 2.0, 2.0);
    }

    /* RESIST EVENT */
    script "ze13_internal_event_resistelapsed" (raw packetRaw)
    {
        Event::ReceiveTimerElapsed((str)packetRaw);
        int index = Event::GetReceiveData(0);

        switch(index)
        {
            case 0:
                floor_Raisetonearest(29,128);
                ceiling_Raisetonearest(36,128);
                break;

            case 1:
                floor_Raisetonearest(32,128);
                ceiling_Raisetonearest(37,128);
                break;

            case 2:
                Ceiling_raisetonearest(16,32);
                thing_destroy(35);
                thing_activate(36);
                thing_activate(37);
                break;

            case 3:
                Ceiling_raisetonearest(30,32);
                break;
        }
    }

    script 2 (void)
    {
        PrintBold(n:0, s:"\c- has raised the gate! It will lower in \ca20 \c-seconds");
        SetActivator(-1);
        floor_raisebyvalue(5,32, 128);
        delay(35*20);
        floor_lowerbyvalue(5,32, 128);
        PrintBold(s:"Gate lowered!");
    }

    script 4 (void) //2nd door
    {
        if(GetActorZ(0) >= 592.0 && !switchactivated)
        {
            PrintBold(s:"The secondary door has been opened!");
            ceiling_raisetonearest(8,128);
            thing_destroy(37);
            switchactivated=true;
        }
    }

    script 5 (void) //start music
    {
        Music::PlayMusic("CASTLE1", 0);
        SetFont("CONFONT");
        HudMessageBold(s:"\ccYou need a \cgBlood Ruby \ccand a \chNight Sapphire \n\ccto proceed deeper into the castle"; HUDMSG_PLAIN, 1, CR_GOLD, 0.5, 0.25, 5.0);
    }

