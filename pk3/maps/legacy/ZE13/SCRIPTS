    Script 13 (void) // final -death approches
    {
        SetFont("CONFONT");
        HudMessageBold(s:"\cgDeath is seeking out intruders!\n\ccGet to the catacombs before it's too late!"; HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 3.0, 2.0);
        SetActivator(-1);
        Delay(35*3);
        Delay(Resist::StartResistByIndex(4));

        // Changed in ZH2: The door no longer inflicts instant death, instead delayed damage using hexen's crushing style.
        // 2 is Hexen crushing mode.
        Ceiling_LowerAndCrush(31, 16, 500, 2);
        Tagwait(31);
        Ceiling_LowerByValueTimes8(31, 16, 1);

        Delay(35*3);
        SetFont("BIGFONT");
        HudMessageBold(s:"\cGWarning : \cKDeath is Here!!!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
        Delay(35*5);
        Game::KillUnsafePlayers();
    }

    Script 40 (void) //Shop=============================
    {
        if (Player::GetIsHuman())
        {
            if(CheckInventory(CURRENCY_CASH_NAME) < 50)
            {
                print(s:"You don't have enough gold.");
                terminate;
            }

            else if(CheckInventory(LEAPSTONE_ITEM))
            {
                print(s:"You already have a Leap Stone.");
                terminate;
            }

            else
            {
                print(s:"Here's your Leap Stone. Use it wisely.");
                SpawnSpot (LEAPSTONE_ITEM, 34, 0);
                TakeInventory(CURRENCY_CASH_NAME, 50);
                activatorsound("item/cash",128);
            }
        }
        else if(Player::GetIsZombie())
            print(s:"I don't sell to zombie scum!");

    }

