Script 25 ENTER // If you are a monster killer
{
    if(CheckInventory("ZH2LegacyZM20KilledHunter") == 1)
    {
        PrintBold(n:0, s:" \cFHas killed the Hunter, he is rewarded with an item.");

        GiveInventory("ZH2ItemRewardOrbMinor", 1);
        TakeInventory("ZH2LegacyZM20KilledHunter", 1);
    }

    if(CheckInventory("ZH2LegacyZM20KilledDog") == 10)
    {
        PrintBold(n:0, s:" \cFHas killed 10 Hunter'dogs, he is rewarded with an item.");

        GiveInventory("ZH2ItemRewardOrbMinor", 1);
        TakeInventory("ZH2LegacyZM20KilledDog", 10);
    }

    delay(1);
    restart;
}

