Script 10 (void) // Picking up Double shotgun and activing big secret
{
    delay(2);
    PrintBold(n:0, s:" \cFEntered in Hunter's room to stole his double shotgun !");
    delay(35*5);
    PrintBold(s:"The Hunter is coming !");
    Delay(35*8);
    switch(random(1, 5))
    {
        case 1: // The Hunter and his dogs
        case 2: // The Hunter and his dogs
        case 3: // The Hunter and his dogs
            PrintBold(s:"The Hunter is here with his dogs !");
            Spawnspotfacing("ZH2LegacyZM20HunterGuy", 400, 14444);
            Spawnspotfacing("ZH2LegacyZM20Hunterdog", 401, 14445);
            ACS_Execute(30, 0, 0);
            ACS_Execute(26, 0, 0);
            break;

        case 4: // The Hunter don't come.
            PrintBold(s:"Oh my God ! The Hunter is Dead !");
            Delay(35*5);
            PrintBold(s:"He missed the bus, and was run over ! :p");
            delay(35*8);
            PrintBold(s:"The hotel's armory are now open to kill intruders !");
            Door_Open(47, 80);
            break;

        case 5:
            PrintBold(s:"Oh my God ! The Hunter is Dead !");
            Delay(35*5);
            PrintBold(s:"He was killed by the \cm Ghoul Cat ! D:");
            Music::SetMusic("D_GCAT");
            Spawnspotfacing("ZH2LegacyZM20GhoulCat", 400, 14446);
            ACS_Execute(31, 0, 0);
            Spawnspotfacing("ZH2LegacyZM20GhoulCat", 404, 14447);
            ACS_Execute(32, 0, 0);
            Spawnspotfacing("ZH2LegacyZM20GhoulCat", 405, 14448);
            ACS_Execute(33, 0, 0);
            Sector_Setcolor(52, 32, 32, 32);
            Sector_Setcolor(330, 32, 32, 32);
            Sector_Setcolor(149, 32, 32, 32);
            Sector_Setcolor(26, 32, 32, 32);
            Sector_Setcolor(27, 32, 32, 32);
            Sector_Setcolor(28, 32, 32, 32);
            Sector_Setcolor(29, 32, 32, 32);
            Sector_Setcolor(108, 32, 32, 32);
            Sector_Setcolor(108, 32, 32, 32);
            delay(35*5);
            PrintBold(s:"\cmDamn it, he is not alone !");
            break;
    }
}

