    script 02 (int id) // glassbreak
    {
        SetLineBlocking(id, BLOCK_NOTHING);
        SetLineTexture(id, SIDE_FRONT, TEXTURE_MIDDLE, "-");
        SetLineTexture(id, SIDE_BACK, TEXTURE_MIDDLE, "-");
        Thing_Activate(id);
    }

    script 03 (void) //Phantasm
    {
        PrintBold(n:0, s:" \cFhas released phantasm from the deepness of the hell");
        SetThingSpecial(26, 0, 192, 0, 0, 160, 0);
        ReplaceTextures("FNEW4", "WSFLR6_4");
        ReplaceTextures("PWFLAT14", "PWFLAT19");
        ReplaceTextures("PWFLAT15", "PWFLAT20");
        ActivatorSound("monster/phantasm/wake", 127);
        delay(60);
        SetThingSpecial(26, 0, 192, 0, 0, 160, 0);
        Music::PlayMusic("D_WCMS", 0);
        SpawnSpotFacing("ZH2LegacyZM21Phantasm", 85, 0);
    }

