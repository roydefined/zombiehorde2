// [ZH2] Handle conditionally enabling/disabling dynamic lights based on the cvar.
script "open_client" open clientside
{
	_dynamicLightsEnabled = GetUserCVar(ConsolePlayerNumber(), "cl_zh2_zm14_enabledynamiclights");
	SetDynamicLights(_dynamicLightsEnabled, false);
	while (true)
	{
		if (_dynamicLightsEnabled != GetUserCVar(ConsolePlayerNumber(), "cl_zh2_zm14_enabledynamiclights"))
		{
			SetDynamicLights(!_dynamicLightsEnabled, true);
			_dynamicLightsEnabled = !_dynamicLightsEnabled;
		}

		delay(const: 1);
	}
}

