void SetDynamicLights(bool enable, bool message)
{
	if (!enable)
	{
		Thing_DeActivate(400);
		Thing_DeActivate(401);
		Thing_DeActivate(402);
		Thing_DeActivate(403);
		Thing_DeActivate(404);
		Thing_DeActivate(405);
		Thing_DeActivate(406);
		Thing_DeActivate(407);
		Thing_DeActivate(408);
		Acs_Terminate(1,0);
		Acs_Terminate(3,0);

		if (message)
			Log(s:"1046 Map Dynamic Lights Deactivated.");
	}
	else
	{
		Thing_Activate(400);
		Thing_Activate(401);
		Thing_Activate(402);
		Thing_Activate(403);
		Thing_Activate(404);
		Thing_Activate(405);
		Thing_Activate(406);
		Thing_Activate(407);
		Thing_Activate(408);
		Acs_Execute(1,0);
		Acs_Execute(3,0);

		if (message)
			Log(s:"1046 Map Dynamic Lights Activated.");
	}
}

