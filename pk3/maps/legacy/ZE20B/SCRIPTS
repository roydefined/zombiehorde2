    internal raw OnDrawResistHud(void[]* data)
    {
        if (data == null)
            return 0;

        _resistHookDataRef = data;

        int resistIndex = _resistHookDataRef.Index;

        if (resistIndex != 0 && resistIndex != 1 && resistIndex != 2)
            return 0;

        int ticsLeft = Resist::GetTicsLeftByIndex(resistIndex);
        int left = (ticsLeft / 35) + 1;

        str numColor;
        if (left < 5)
            numColor = "\cd";
        else if (left < 10)
            numColor = "\ck";
        else if (left < 15)
            numColor = "\ci";
        else
            numColor = "\cg";

        str timeLabel = Resist::GetTimeReasonLabelByIndex(resistIndex);
        int timeTokenIndex = Resist::GetTimeTokenIndex(timeLabel);
        if (timeTokenIndex != -1)
            timeLabel = StrMid(timeLabel, 0, timeTokenIndex) + numColor + StrMid(timeLabel, timeTokenIndex, StrLen(timeLabel) - timeTokenIndex);

        timeLabel = Resist::FormatLabel(timeLabel, ticsLeft);

        Hud::SetRelativePoint();
        BCSUtils::HudSetFont("BigFont");
        BCSUtils::HudDrawText(0, Resist::GetTopReasonLabelByIndex(resistIndex));

        Hud::SetRelativePoint(0.0, fixed(RESIST_HUD_BIGFONT_LINE_HEIGHT));
        BCSUtils::HudSetFont("BigFont");
        BCSUtils::HudDrawText(0, timeLabel);

        return RESIST_HUD_BIGFONT_LINE_HEIGHT * 2;
    }

