    script "pre_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            case 0:
            {
                SetLineSpecial(10, 0, 0, 0, 0);
                SetLineTexture(10, SIDE_FRONT, TEXTURE_BOTTOM, "SW2GRAY");

                ACS_NamedExecute("ze20b_generator_comets", 0);
                break;
            }

            case 1:
            {
                Thing_Activate(201); // power
                Thing_Activate(202); // dynamite
                Thing_Deactivate(203); // explosion
                State = 2;
                SpawnSpot("zh2legacydynamite", 8, 7);
                SpawnComet(random(0, 3));
                break;
            }
        }
    }

