    // Added in ZH2. Triggered at the lava pool. Instead of instantly killing humans/zombies, hurt and teleport them instead.
    script "Lava_Teleport"
    {
        if(Player::GetIsHuman())
            Thing_Damage2(0, 40, "Lava");
        else
            Thing_Damage2(0, 150, "Lava");

        Teleport(22, 0, 1);
    }

    script 4 (void)    // Generator script - first resist
    {
        if(GetActorZ(0) > -40.0)
        {
            SetFont("CONFONT");
            switch(_warnCount[PlayerNumber()])
            {
                case 0:
                    HudMessage(s:"No cheating!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
                    break;

                case 1:
                    HudMessage(s:"Hey, stop it!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
                    break;

                case 2:
                    HudMessage(s:"This is your last warning!"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
                    break;

                default:
                    HudMessage(s:"As you wish ..."; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.5, 1.0, 1.0);
                    DamageThing(0, MOD_UNKNOWN);
                    break;
            }
            _warnCount[PlayerNumber()]++;
            delay(70);
            terminate;
        }

        Resist::StartResistByIndex(0);
    }

    // Runs alongside resist 0's countdown purely to spawn a comet at the same
    // tick the old manual loop did. Kept as a separate server script since the
    // resist HUD hook runs clientside and can't do server-authoritative spawns.
    script "ze20b_generator_comets"
    {
        for(int i = 25; i > 0; i--)
        {
            if(i == 15)
                SpawnComet(random(0, 3));

            Delay(35);
        }
    }

