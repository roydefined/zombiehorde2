    // Runs alongside resist 2's (cataclysm) countdown purely to spawn comets at the
    // same ticks the old manual loop did. See ze20b_generator_comets for why this
    // isn't done from the (clientside) resist HUD hook.
    script "ze20b_cataclysm_comets"
    {
        for(int i = 55; i > 0; i--)
        {
            if(i == 45 || i == 30 || i == 15)
                SpawnComet(random(0, 3));

