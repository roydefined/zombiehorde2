    script 53 (int check)
    {
        if(check && GetActorZ(0) > 0.0) terminate;
        if(shield)
        {
            SetFont("CONFONT");
            HudMessage(s:"broken"; HUDMSG_FADEOUT, 0, CR_DARKRED, 0.5, 0.5, 1.0, 1.0);
            terminate;
        }
        if(Player::GetIsZombie()) {
            SetFont("CONFONT");
            HudMessage(s:"dis not brainsssss"; HUDMSG_FADEOUT, 0, CR_DARKRED, 0.5, 0.5, 1.0, 1.0);
            terminate;
        }
        SetFont("BIGFONT");
        HudMessageBold(n:0, s:"\c- activated the anti-zombie shield."; HUDMSG_PLAIN, 500, CR_GREEN, 0.5, 0.3, 0.0);
        for(int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
        {
            if(ZombieIn[i])
            {
                SetActivator(Identity::GetTid(i));

                if(Player::GetIsZombie())
                    DamageThing(0, MOD_UNKNOWN);
            }
        }
        SetActivator(-1);
        shield = 1;
        Floor_lowerbyvaluetimes8(82,55,9);
        SetLineTexture(11, SIDE_FRONT, TEXTURE_MIDDLE, "LASER1");
        SetLineTexture(11, SIDE_BACK, TEXTURE_MIDDLE, "LASER1");
        delay(35);
        for(int i = 25; i > 0; i--)
        {
            SetFont("CONFONT");
            HudMessageBold(s:"\cdanti-zombie shield\c- collapses in ", d:i; HUDMSG_PLAIN, 500, CR_RED, 0.5, 0.25, 0.0);
            delay(35);
        }
        SetLineTexture(11, SIDE_FRONT, TEXTURE_MIDDLE, "-");
        SetLineTexture(11, SIDE_BACK, TEXTURE_MIDDLE, "-");
        shield = 2;
        SetFont("CONFONT");
        HudMessageBold(s:"\cdanti-zombie shield\c- collapsed! "; HUDMSG_PLAIN, 500, CR_RED, 0.5, 0.25, 1.0);
    }

