Script 14 (void)
{
    Print(s:"Begining experience CZR-332 !");
    //SpawnSpotFacing("ZombieMan",37,14030);
	SpawnSpotFacing("ZH2LegacyZM20HunterDog",37,14030);
	SpawnSpotFacing("ZH2LegacyUboa",38,14031);
    SetActorProperty(14030, APROP_Friendly, 1);
    delay(35*1);
    Floor_LowerbyValue(39,10,118);
    tagwait(39);
    Thing_SetGoal(14030,41,0,1);
    delay(35*7);
    Floor_LowerbyValue(40,10,118);
    tagwait(40);
    Thing_Hate(14031,14030,6);
    while (thingcount(t_none, 14030)) delay(1);
    delay(35*3);
    SpawnSpotFacing("TeleportFog",14030,0);
    SpawnSpotFacing("TeleportFog",14031,0);
    Thing_Remove(14030);
    Thing_Remove(14031);
    delay(35*4);
    Floor_RaisebyValue(40,10,118);
    Floor_RaisebyValue(39,10,118);
    tagwait(39);
    delay(35*2);
    Print(s:"The experience CZR-332 is finished !");
}

