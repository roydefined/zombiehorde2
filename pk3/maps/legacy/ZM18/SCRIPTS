// ZH2 - Locked doors that should always be openable after they have been opened once.

script "lock_door_once_red"
{
	static bool opened;
	if (!opened && !CheckInventory(KEY_RED_KEYCARD))
	{
		print(s:"This door requires a red keycard.");
		terminate;
	}

	opened = true;
	Door_Open(30, 128, 0);
	TagWait(32);
	Delay(const: 35 * 2);
	Door_Close(30, 128, 0);
	TagWait(32);
}

