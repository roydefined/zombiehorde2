Script 3 (void) // Activing secrets switches, and opening some secrets rooms
{
	If( Switches == 4 )
	{
		PrintBold(s:"Fifth switch activated !");
		Switches++;
		delay(35*3);
		PrintBold(s:"All switches are activated !");
		delay(35*2);
		switch(random(1,3))
		{
			case 1:
			case 2:
				SetFont("BIGFONT");
				HudmessageBold(s:"A door has been opened !"; HUDMSG_FADEOUT, 1, CR_White, 0.5, 0.1, 3.0, 2.5);
				Door_Open(random(75,77),75);
				AmbientSound("world/reveal1",127);
				break;
			case 3:
				SetFont("BIGFONT");
				HudmessageBold(s:"All yellow doors have been opened !"; HUDMSG_FADEOUT, 1, CR_White, 0.5, 0.1, 3.0, 2.5);
				Door_Open(65,75);
				Door_Open(66,75);
				Door_Open(75,75);
				Door_Open(76,75);
				Door_Open(77,75);
				AmbientSound("world/reveal1",127);
				break;
		}
	}
	If( Switches == 3 )
	{
		PrintBold(s:"Fourth switch activated, 1 left.");
		Switches++;
	}
	If( Switches == 2 )
	{
		PrintBold(s:"Third switch activated, 2 left.");
		Switches++;
	}
	If( Switches == 1 )
	{
		PrintBold(s:"Second switch activated, 3 left.");
		Switches++;
	}
	If( Switches == 0 )
	{
		PrintBold(s:"First switch activated, 4 left.");
		Switches++;
	}
}

