    Script 2 (void) //Basement Flare locker=============================
    {
        if(!Player::GetIsZombie()) // Zombies can't pick-up flares
        {
            if(CheckInventory(FLARE_ITEM) < 2 && baseflarecheck < 10)
            {
                HudMessage(s:"You got a flare."; HUDMSG_FADEOUT, 1, CR_GOLD, 0.5, 0.2, 3.0, 1.0, 1.0);
                GiveInventory(FLARE_ITEM, 1);
                LocalAmbientSound("sound/itemget1",128);
                baseflarecheck += 1;
            }
            else if(CheckInventory(FLARE_ITEM) == 2 && baseflarecheck < 10)
            {
                delay(10);
                HudMessage(s:"You have enough flares."; HUDMSG_FADEOUT, 1, CR_GOLD, 0.5, 0.2, 3.0, 1.0, 1.0);
                LocalAmbientSound("sound/itemfail1",128);
            }
            else if(baseflarecheck > 9)
            {
                delay(10);
                HudMessage(s:"\caThere are no more flares."; HUDMSG_FADEOUT, 1, CR_GOLD, 0.5, 0.2, 3.0, 1.0, 1.0);
                LocalAmbientSound("sound/itemfail1",128);
            }
        }
    }

