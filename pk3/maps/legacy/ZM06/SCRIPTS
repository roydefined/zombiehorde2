    //generator
    Script 8
    {
        if(_powerBoxUsed)
        {
            HudMessage(s:"It no longer works."; HUDMSG_FADEOUT, 1, CR_GOLD, 0.5, 0.2, 3.0, 1.0, 1.0);
            terminate;
        }

        int eventIndex = GetCVar("sv_zh2_zm06event");

        if(eventIndex == 0)
        {
            switch(random(1, 5))
            {
                case 1:
                    eventIndex = 1;
                    break;

                case 2:
                case 3:
                    eventIndex = 2;
                    break;

                case 4:
                case 5:
                    eventIndex = 3;
                    break;
            }
        }

        switch(eventIndex)
        {
            case 1: ACS_NamedExecute("Event_Disco", 0); break;
            case 2: ACS_NamedExecute("Event_Uboa", 0); break;
            case 3: ACS_NamedExecute("Event_Decay", 0); break;
        }
    }

