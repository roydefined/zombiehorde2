		ActivatorSound("sound/locked1", 127);
		delay(15);
	}

	Script 10 (void) // No handle OMFG
	{
		Print(s:"This door has no handle.");
		delay(15);
	}

	Script 11 (void) // Secret switch that requires teamwork...
	{
		Floor_LowerByValue(42, 32, 128);
		TagWait(42);
		ChangeFloor(42, "RFLAT20");
		PrintBold(s:"A secret has been opened...");
	}

	Script 12 (void) // Secret switch in the winery
	{
		ActivatorSound("sound/lighton1", 127);
		Floor_LowerByValue(28, 32, 56);
		TagWait(28);
		PrintBold(s:"A secret has been opened...");
	}

	Script 13 (void) // Door is locked
