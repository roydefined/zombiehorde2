/* RESIST EVENT */
script "ze05_internal_event_resistelapsed" (int index)
{
	switch(index)
	{
		case 0:
			Floor_LowerByValue(107, 21, 88);
			break;
		case 1:
			SetLineBlocking(2, BLOCK_NOTHING);
			TranslucentLine(2, 0, 0);
			break;
	}
}

Script 2 (void) // Lift
{
	SetActivator(-1);
	if(liftposition==0)
	{
		ThingSound(20, "sound/ding1", 127);
		if(firstActivation==0)
		{
			SetFont("BIGFONT");
			HudMessageBold(s:"The lift is leaving in 10 seconds"; HUDMSG_FADEOUT, 0, CR_RED, 0.5, 0.2, 2.0, 1.0);
			Polyobj_DoorSlide(2, 20, 128, 56, 350);
			delay(405);
			firstActivation=1;
		}
		else
		{
			Polyobj_DoorSlide(2, 20, 128, 56, 140);
			delay(195);
		}
		TeleportInSector(22, 23, 22, 0, 0);
		delay(5);
		ThingSound(21, "sound/lift1", 127);
		delay(35*4);
		Polyobj_DoorSlide(4, 20, 128, 56, 140);
		ThingSound(22, "sound/ding1", 127);
		liftposition = 1;
	}
	else
	{
		ThingSound(24, "sound/ding1", 127);
		Polyobj_DoorSlide(4, 20, 128, 56, 140);
		delay(195);
		TeleportInSector(23, 22, 23, 0, 0);
		delay(5);
		ThingSound(21, "sound/lift1", 127);
		delay(35*4);
		Polyobj_DoorSlide(2, 20, 128, 56, 140);
		ThingSound(20, "sound/ding1", 127);
		liftposition = 0;
	}
}

Script 3 (void) // ALERT sound
{
	while(AlertStopped==0)
    {
		AmbientSound("sound/alert1", 127);
		delay(36);
		restart;
    }
}

Script 6 (void) // Anti zombie shield
{
    PrintBold(n:0, s:" \cFhas activated the shield.\nIt will shut down in 10 seconds.");
    SetActivator(-1);
    TranslucentLine(3, 96, 0);
    shieldactive = true;
    delay(35*10);
    shieldactive = false;
    TranslucentLine(3, 0, 0);
}

Script 7 (void) // Bomb has been planted
{
	SetActivator(-1);
	Delay(Resist::StartResistByIndex(2));
	SetLineBlocking(4, BLOCK_NOTHING);
	TranslucentLine(4, 0, 0);
	Delay(35);
	Acs_Execute(3, 0, 0, 0, 0);
	Polyobj_DoorSlide(6, 20, 128, 56, 35 * timeleft);
	bombplanted++;
	Delay(35);
	SetFont("CONFONT");
	HudMessageBold(s:"The bomb has been planted!\nGet out of here before it blows up!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.05, 0.85, 3.0, 2.0);

	Delay(Resist::StartResistByIndex(3));

	AlertStopped = 1;
	Delay(40);

	AmbientSound("world/nuke1", 127);
	Radius_Quake(10, 500, 0, 200, 110);

	Game::KillUnsafePlayers();
}

