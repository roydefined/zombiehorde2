Script 10 (void)    // Shield script
{
    if(!shieldactive)
        terminate;

    if(Player::GetIsZombie())
        ThrustThing(192, 20, 0, 0);
}

Script 11 (void)    // Bomb area lift
{
	SetActivator(-1);
    delay(70);

    if(!final_lift_pos)
	{
        final_lift_pos = true;
        SetLineBlocking(9, BLOCK_CREATURES);
        TranslucentLine(9, 96, 0);
        Floor_LowerByValue(115, 36, 676);
        Ceiling_LowerByValue(115, 36, 676);
        ThingSound(116, "sound/lift1", 127);
        TagWait(115);
    }
    else
	{
        final_lift_pos = false;
        Floor_RaiseByValue(115, 36, 676);
        Ceiling_RaiseByValue(115, 36, 676);
        ThingSound(116, "sound/lift1", 127);
        TagWait(115);
        SetLineBlocking(9, BLOCK_NOTHING);
        TranslucentLine(9, 0, 0);
    }
}

Script 12 (void)  // Falling too far
{
    if(Player::GetIsHuman())
        Thing_Damage2(0, 10, "Falling");
    else
        Thing_Damage2(0, 100, "Falling");

	Teleport(8, 0, true);
}

Script 13 (void)  // Falling in slime
{
    if(Player::GetIsHuman())
        Thing_Damage2(0, 10, "Slime");
    else
        Thing_Damage2(0, 100, "Slime");

	Teleport(106, 0, true);
}