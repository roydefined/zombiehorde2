    //improved localambientsound function
    Function void PlayLocalSound(Int PlayerID, Str Sound, Int Volume)
    {
        SetActivator(Identity::GetTid(PlayerID));
        LocalAmbientSound(Sound, Volume);
    }

    Function Bool CheckZombie(Int PlayerID)
    {
        Bool IsZombie = False;
        If(OXYGEN_NOZOMBIE == True)
        {
            If(Player::GetPlayerIsZombie(PlayerID))
            {
                OxygenLevel[PlayerID] = 100;
                IsZombie = True;
            }
        }

        Return IsZombie;
    }

    Function void CheckPlayerOxygenLevel(bool Line)
    {
        If(!CheckZombie(PlayerNumber()))
        {
            If(Line)
            {
                InSpace[PlayerNumber()] = True;
            }
            Else
            {
                InSpace[PlayerNumber()] = False;
            }

            ACS_ExecuteAlways(500, 0, 1, 0, 0);
        }
    }

    Function void DisplayOxygenMessage(void)
    {
            MsgConsistent[PlayerNumber()] = False;
            int o = OxygenLevel[PlayerNumber()];
            str CurColor = "\cQ";
            fixed DisplayTime = 1.0;
            If(o >= 80)
            {
                CurColor = "\cQ";
            }
            Else If(o < 80 && o >= 60)
            {
                CurColor = "\cD";
            }
            Else If(o < 60 && o >= 40)
            {
                CurColor = "\cF";
            }
            Else If(o < 40 && o >= 20)
            {
                CurColor = "\cI";
            }
            Else If(o < 20)
            {
                CurColor = "\cG";
            }

            If(o < 20)
            {
                DisplayTime = 0.2;
            }

            SetFont("CONFONT");
            HudMessage(s:"\cJOxygen left: ", s:CurColor, d:o, s:"%"; HUDMSG_FADEOUT, 4554, CR_WHITE, 0.1, 0.95, DisplayTime);
    }

    Function void ToggleOxygenMessage(void)
    {
            If(CheckZombie(PlayerNumber()) == False)
            {
                If(MsgConsistent[PlayerNumber()] == False)
                {
                    MsgConsistent[PlayerNumber()] = True;
                }
                Else If(MsgConsistent[PlayerNumber()] == True)
                {
                    MsgConsistent[PlayerNumber()] = False;
                }


                Int o = OxygenLevel[PlayerNumber()];
                If(o > 100)
                {
                    o = 100;
                }

                Str CurColor = "\cQ";
                fixed DisplayTime = 0.0;
                If(o >= 80)
                {
                    CurColor = "\cQ";
                }
                Else If(o < 80 && o >= 60)
                {
                    CurColor = "\cD";
                }
                Else If(o < 60 && o >= 40)
                {
                    CurColor = "\cF";
                }
                Else If(o < 40 && o >= 20)
                {
                    CurColor = "\cI";
                }
                Else If(o < 20)
                {
                    CurColor = "\cG";
                }

                Int HudOptions;

                If(MsgConsistent[PlayerNumber()] == False)
                {
                    DisplayTime = 0.2;
                    HudOptions = HUDMSG_FADEOUT;
                }
                Else If(MsgConsistent[PlayerNumber()] == True)
                {
                    DisplayTime = 0.0;
                    HudOptions = HUDMSG_PLAIN;
                }

                SetFont("CONFONT");
                HudMessage(s:"\cJOxygen left: ", s:CurColor, d:o, s:"%"; HudOptions, 4554, CR_WHITE, 0.1, 0.95, DisplayTime);
            }
    }

    Script 500 (Int x, Int y)
    {
        Switch(x)
        {
            Case 0:
                CheckPlayerOxygenLevel(LineSide() == LINE_BACK);
            Break;

            Case 1:
                    If(InSpace[PlayerNumber()] == True)
                    {
                        If(OxygenLevel[PlayerNumber()] >= 101)
                        {
                            OxygenLevel[PlayerNumber()] = 100;
                        }

                        For(OxygenLevel[PlayerNumber()] = OxygenLevel[PlayerNumber()]; OxygenLevel[PlayerNumber()]>=0 && InSpace[PlayerNumber()] == True && CheckZombie(PlayerNumber()) == False; OxygenLevel[PlayerNumber()]--)
                        {
                            Int o = OxygenLevel[PlayerNumber()];
                            DisplayOxygenMessage();

                            If(o < 20)
                            {
                                PlayLocalSound(PlayerNumber(), "sound/airdeplete", 127);
                            }

                            If(o == 0)
                            {
                                Int totaldelay = 0;
                                While(OxygenLevel[PlayerNUmber()] <= 0 && InSpace[PlayerNumber()] == True && GetActorProperty(ActivatorTid(), APROP_Health) > 0)
                                {
                                    If(totaldelay >= OXYGEN_DECREASETICS)
                                    {
                                        totaldelay = 0;
                                        PlayLocalSound(PlayerNumber(), "sound/airdeplete", 127);
                                    }
                                    DisplayOxygenMessage();
                                    Thing_Damage(ActivatorTid(), 3, MOD_UNKNOWN);
                                    Delay(OXYGEN_DAMAGETICS);
                                    totaldelay += OXYGEN_DAMAGETICS;
                                }
                            }

                            Delay(OXYGEN_DECREASETICS);
                        }

                    }
                    Else
                    {
                        Bool LevelChanged = False;
                        For(OxygenLevel[PlayerNumber()] = OxygenLevel[PlayerNumber()]; OxygenLevel[PlayerNumber()]<101 && InSpace[PlayerNumber()] == False && CheckZombie(PlayerNumber()) == False; OxygenLevel[PlayerNumber()]++)
                        {
                            If(OxygenLevel[PlayerNumber()] >= 100) { LevelChanged = True; }

                            Int o2 = OxygenLevel[PlayerNumber()];
                            DisplayOxygenMessage();

                            Delay(OXYGEN_INCREASETICS);
                        }

                        If(LevelChanged == True)
                        {
                            PlayLocalSound(PlayerNumber(), "sound/airback", 127);
                        }

                    }
            Break;
        }
    }

