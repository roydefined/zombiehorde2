script 13 (void)
{
    int rewardHumans=1;
    ACS_ExecuteAlways(15, 0, 0, 0, 0);

    int killerId = -1;
    while(ThingCountName("ZH2LegacyZe24KoraxAndDsparil", 100)) // Korax and D'Sparil is alive
    {
        SetFont("SMALLFONT");
        HudMessageBold(s:"\cmKorax\c- and \clD'Sparil\c- health: ", d:GetActorProperty(100, APROP_Health), s:""; HUDMSG_FADEOUT, 997, CR_WHITE, 0.05, 0.85, 10.0, 2.0); // Display health
        
        // The last target will be the killer.
        if (SetActivatorToTarget(100))
        {
            killerId = PlayerNumber();
            SetActivator(-1);
        }

        delay(1);
    }

    if (killerId == -1)
        terminate;

    SetFont("BIGFONT");
    if (Player::GetPlayerIsZombie(killerId)) // Killer is a zombie
    {
        HudMessageBold(s:"\cmKorax\c- and \clD'Sparil\c- have been defeated by ", s:BCSUtils::PlayerName(killerId), s:".\nAll zombies have been awarded with a bonus item !"; HUDMSG_FADEOUT, 998, CR_WHITE, 0.5, 0.17, 7.0, 0.5);
        rewardHumans--; // Reward zombies
    }
    else // if killer is a human
        HudMessageBold(s:"\cmKorax\c- and \clD'Sparil\c- have been defeated by ", s:BCSUtils::PlayerName(killerId), s:".\nAll humans have been awarded with a bonus item !"; HUDMSG_FADEOUT, 998, CR_WHITE, 0.5, 0.17, 7.0, 0.5);

    for(int j = 0; j < BCSUtils::MAX_PLAYERS; j++)
    {
        int tid = Identity::GetTid(j);
        if(PlayerInGame(j)) // There is a player
        {
            if(rewardHumans && !Player::GetPlayerIsZombie(j)) // This player is a human and humans are rewarded
                GiveActorInventory(tid, "ZH2ItemRewardOrbMinor", 1);

            else if(!rewardHumans && Player::GetPlayerIsZombie(j)) // This player is a zombie and zombies are rewarded
                GiveActorInventory(tid, "ZH2ItemRewardOrbMinor", 1);
        }
        delay(1);
    }
}

script 15 (void)
{
    int KMessage = 0;

    while(ThingCountName("ZH2LegacyZe24KoraxAndDsparil", 100)) // Korax and D'Sparil is living
    {
        switch(KMessage)
        {
            case 0:
                Logger::LogBold("\cmKorax\cd: Greetings, mortal are you ready to die ?");
                AmbientSound("KoraxVoiceGreetings", 127);
                Delay(70);
                AmbientSound("KoraxVoiceReady", 127);
                break;
            case 1:
                Logger::LogBold("\cmKorax\cd: My servants can smell your blood human.");
                AmbientSound("KoraxVoiceBlood", 127);
                break;
            case 2:
                Logger::LogBold("\cmKorax\cd: You have play this game too long mortal. I think i shall remove you from the board.");
                AmbientSound("KoraxVoiceGame", 127);
                Delay(140);
                AmbientSound("KoraxVoiceBoard", 127);
                break;
            case 3:
                Logger::LogBold("\cmKorax\cd: Worship me, and may be merciful. Then again maybe not");
                AmbientSound("KoraxVoiceWorship", 127);
                Delay(175);
                AmbientSound("KoraxVoiceMaybe", 127);
                break;
            case 4:
                Logger::LogBold("\cmKorax\cd: Are you strong enough to face your own master ?");
                AmbientSound("KoraxVoiceStrong", 127);
                Delay(70);
                AmbientSound("KoraxVoiceFace", 127);
                break;
        }
        Delay(1000); // 1000 ticks after the last message
        KMessage = random(1, 4);
    }
}

