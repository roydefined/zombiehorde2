script 10 (void) // Secret
{
    if (CheckInventory("BlueCard") && !secretSwitch2)
    {
        secretSwitch2++;
        SetFont("CONFONT");
        HudMessageBold(n:0, s:"\c- has deactivated the generator."; HUDMSG_FADEOUT, 997, CR_WHITE, 0.05, 0.85, 10.0, 2.0);
        AmbientSound("sound/poweroff1", 127);
        Ceiling_MoveToValue(97, 12, 1, 1);
        Floor_MoveToValue(97, 12, 2, 1);

        SetActivator(-1);

        delay(5*35);
        Light_ChangeToValue(58, 144);
        Light_ChangeToValue(96, 144);
        Light_ChangeToValue(104, 144);
        Sector_SetGravity(96, 1, 0);
        Thing_Activate(100);
        delay(3*35);
        Ceiling_MoveToValue(82, 65535, 1, 1);
        Floor_MoveToValue(82, 65535, 2, 1);
        ACS_ExecuteAlways(13, 0, 0, 0, 0);
        Music::SetMusic("D_DARKER");
        SetFont("SMALLFONT");
        PrintBold(s: "Something bad happened...");

        while(resists[4] < 2)
            delay(1);

        SetActivator(0);
        delay(5*35);
        AmbientSound("world/ULTIMA1", 127);
        Fadeto(100, 100, 100, 1.0, 6.0);
        delay(8*35);

        int HumanSpot = 133;
        int ZombieSpot = 149;

        for(int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
        {
            int tid = Identity::GetTid(i);
            if(PlayerInGame(i)) // There is a player
            {
                if(Player::GetPlayerIsZombie(i)) // This player is a zombie
                {
                    TeleportOther(tid, ZombieSpot, 0); // Teleport the player
                    ZombieSpot++; // Next spot

                    If (ZombieSpot > 164)
                        ZombieSpot = 149; // Reset spot
                }
                else // This player is a human
                {
                    TeleportOther(tid, HumanSpot, 0); // Teleport the player
                    HumanSpot++; // Next spot

                    If (HumanSpot > 148)
                        HumanSpot = 133; // Reset spot
                }
            }
            delay(1);
        }

        TeleportOther(100, 132, 0); // Teleport Korax and D'Sparil

        Fadeto(100, 100, 100, 0.0, 1.0);
        delay(35);
        Music::SetMusic("FF9BOSS");
    }
    else
    {
        SetFont("SMALLFONT");
        Print(s:"Access denied !");
    }
}

