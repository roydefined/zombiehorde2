function void ResistMessage2_2 (int restime, str whyresist, str color)
{
   SetFont("SMALLFONT");
    HudMessageBold(s:whyresist; HUDMSG_FADEOUT, 998, CR_WHITE, 0.5, 0.17, 1.5, 0.5);
    SetFont("BIGFONT");

    if(restime>1)
        HudMessageBold(s:"Resist for \cJ", d:restime, s:" \c-seconds"; HUDMSG_FADEOUT, 999, color, 0.5, 0.2, 1.1, 0.5);
    else
        HudMessageBold(s:"Resist for \cJ", d:restime, s:" \c-second"; HUDMSG_FADEOUT, 999, color, 0.5, 0.2, 1.1, 0.5);
}
