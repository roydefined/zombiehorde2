    Script "ZM07_open" OPEN
    {
        TranslucentLine(1, 0, 0);
        TranslucentLine(2, 0, 0);
        TranslucentLine(4, 96, 0);
        SetLineBlocking(4, BLOCK_CREATURES);
        Sector_SetRotation(67, 45, 0);
        Sector_SetRotation(68, -45, 0);
        Sector_SetRotation(69, 180, 0);

        for(int i = 0; i < 120; i ++)
            Sector_ChangeFlags(i, SECF_NOFALLINGDAMAGE, 0);

        // Night mode (12.5 % chance)
        if(random(0,255) < 32)
        {
            for(int i = 0; i < 120; i++)
                Light_LowerByValue(i, 128);

            delay(35);
            Music::PlayMusic("SNEAKING");
        }
        else
        {
            delay(35);
            Music::PlayMusic("VARIETY");
        }
    }

    Script "ZM07_open_client" OPEN CLIENTSIDE
    {
        int i;
        for(i=0; i<20; i++)
        {
            TranslucentLine(3, 10*i, 0);
            Delay(1);
        }
        for(i=0; i<20; i++)
        {
            TranslucentLine(3, 200-10*i, 0);
            Delay(1);
        }
        restart;    // loop!!!
    }

    Script 2 (void) // Forcefield
    {
        if(!forcefield2)
        {
            SetLineBlocking(1, BLOCK_CREATURES);
            TranslucentLine(1, 96, 0);
            forcefield2 = true;
        }
        else
        {
            SetLineBlocking(1, BLOCK_NOTHING);
            TranslucentLine(1, 0, 0);
            forcefield2 = false;
        }

        delay(20);
    }

    Script 3 (void) // Forcefield 2
    {
        if(!forcefield3)
        {
            SetLineBlocking(2, BLOCK_CREATURES);
            TranslucentLine(2, 96, 0);
            forcefield3 = true;
        }
        else
        {
            SetLineBlocking(2, BLOCK_NOTHING);
            TranslucentLine(2, 0, 0);
            forcefield3 = false;
        }
        delay(20);
    }

    Script 6 (void)
    {
        ThrustThing(127, 10, 0, 0);
        print(s:realWorld[random(0,3)]);
    }

