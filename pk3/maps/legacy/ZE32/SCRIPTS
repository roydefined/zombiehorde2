    Script 6 (void) // final resist
    {
        SetActivator(-1);

        int time;
        for(time = 50; time > 0; time--)
        {
            SetFont("BIGFONT");
            Hudmessage(s:"\cqResist for \cj", d:time, s:" \cqseconds"; HUDMSG_FADEOUT, 999, CR_RED, 0.5, 0.2, 0.5, 0.5);
            SetFont("SmallFont");
            HudMessageBold(s:"The darkness is coming in..."; HUDMSG_FADEOUT, 998, CR_White, 0.5, 0.17, 1.5, 0.5);
            delay(35);
        }

        Generic_Ceiling(44, 6, 0, 5, 16);
        tagwait(44);
        printbold(s:"The darkness is here");
        delay(35*5);

        for(int k = 0; k < BCSUtils::MAX_PLAYERS; k++)
        {
            if(PlayerInGame(k) && !Game::GetPlayerIsSafe(k))
            {
                int tid = Identity::GetTid(k);
                SetActivator(tid);
                FadeTo(1, 1, 1, 1.0, 1.0);
            }
        }

        SetActivator(-1);
        delay(35*5);

        Game::KillUnsafePlayers();
    }

    Script 8 (void) // Checks if a human has reached the house
    {
        if(Player::GetIsHuman() && housereached == 0)
        {
            housereached = 1;

            SetActivator(-1);
            for(int i = flextime; i > 0; i--)
            {
                SetFont("BIGFONT");
                HudMessageBold(d:i; HUDMSG_PLAIN, 47, CR_YELLOW, 0.5, 0.7, 1.5);
                Delay(35);
            }

            housereached = 2;
        }
    }

