    Script 8 (void) // Checks if a human has reached the house
    {
        if(Player::GetIsHuman() && housereached == 0)
        {
            housereached = 1;

            SetActivator(-1);
            for(int i = flextime; i > 0; i--)
            {
                SetFont("BIGFONT");
                HudMessageBold(d:i; HUDMSG_PLAIN, 47, CR_YELLOW, 0.5, 0.7, 1.5);
                Delay(35);
            }

            housereached = 2;
        }
    }

