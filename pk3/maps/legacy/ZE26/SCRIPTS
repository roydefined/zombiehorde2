    script "pre_resist_handler" (int resistIndex)
    {
        switch (resistIndex)
        {
            // Unlocking the way to the area
            case 2:
            {
                ACS_Execute(70,0,20,0,0);
                break;
            }

            // Curse of God incoming (left)
            case 3:
            {
                SetFont("CONFONT");
                HudMessageBold(n:0,s:" has reached the safe place, \nThe Curse of God is coming to the castle!";HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 5.0, 2.0);
                break;
            }

            // Curse of God incoming (right)
            case 6:
            {
                SetFont("CONFONT");
                HudMessageBold(n:0,s:" has reached the safe place, \nThe Curse of God is coming in the castle!";HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 5.0, 2.0);
                break;
            }

            // The curse of god is spreading
            case 7:
            {
                SetFont("CONFONT");
                HudMessageBold(s:"This hidding room isn't secure, you need to find an another room !";HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 5.0, 2.0);
                delay(35*3);
                break;
            }
        }
    }

    script "post_resist_handler" (int resistIndex)
    {
        switch (resistIndex)
        {
            // Lowering the wall
            case 0:
            {
                ACS_Execute(26,0,0,0,0);
                Radius_Quake(2, 210, 0, 10, 700);
                Floor_Lowerbyvalue(1,60,752);
                break;
            }

            // Opening the door
            case 1:
            {
                Door_Open(85,75);
                delay(35);
                Door_Open(15,75);
                PrintBold(s:"The teleporter in the jail is now available!");
                break;
            }

            // Unlocking the way to the area
            case 2:
            {
                Floor_LowerbyValue(24,75,250);
                break;
            }

            // Curse of God incoming (left)
            case 3:
            {
                ItsToLateForSecret = TRUE;
                //Generic_Ceiling(27, 20, 128, 5, 16); //ZH2 [AQW]
                Ceiling_LowerAndCrush(27,20,20,2);
                TagWait(27); //ZH2 [AQW]
