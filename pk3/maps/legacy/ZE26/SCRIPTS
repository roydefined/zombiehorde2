                Delay(35*3);
                AmbientSound("world/volcano1", 127);
                Delay(35);
                Game::KillUnsafePlayers();
                break;
            }

            // Opening the door to the hall
            case 4:
            {
                Door_Open(31,75);
                Floor_LowerbyValue(62,75,128);
                Delay(35*5);
                PrintBold(s:"A new way has been opened for the unlucky.");
                Floor_Lowerbyvalue(67,200,768);
                break;
            }

            // Lowering the gate
            case 5:
            {
                Floor_LowerbyValue(35,125,250);
                delay(35*10);
                Door_Open(36,75);
                break;
            }

            // Curse of God incoming (right)
            case 6:
            {
                ItsToLateForSecret = TRUE;
                //Generic_Ceiling(42, 20, 128, 5, 16); //ZH2 [AQW] crusher fix
                Ceiling_LowerAndCrush(42,20,20,2); //ZH2 [AQW]
                TagWait(42); //ZH2 [AQW]
                Ceiling_LowerByValueTimes8(42,20,1); //ZH2 [AQW]
                Radius_Quake(9, 35*6, 0, 50, 703);
                Delay(35*8);
                SetFont("BIGFONT");
                HudMessageBold(s:"\cGWarning : \cKThe Curse of God is in the castle!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
                Delay(35*3);
                AmbientSound("world/volcano1", 127);
                Delay(35);
                Game::KillUnsafePlayers();
                break;
            }

            // The curse of god is spreading
            case 7:
            {
                //Generic_Ceiling(78, 20, 128, 5, 16); //ZH2 [AQW]
                Ceiling_LowerAndCrush(78,20,20,2); //ZH2 [AQW]
                TagWait(78); //ZH2 [AQW]
                Ceiling_LowerByValueTimes8(78,20,1); //ZH2 [AQW]
                Radius_Quake(9, 35*6, 0, 50, 704);
                Delay(35*8);
                SetFont("BIGFONT");
                HudMessageBold(s:"\cGWarning : \cKThe Curse of God is everywhere !"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
                Delay(35*3);
                AmbientSound("world/volcano1", 127);
                Delay(35);
                Game::KillUnsafePlayers(1);
                break;
            }

            // Barney will kill all the zombies in the world!
            case 8:
