    Script 65 ( int Typ ) // Secret End At left and at Right
    {
        If (SecretDone  == TRUE && ItsToLateForSecret == FALSE  )
        {
            Print(s:"The Secret is already activated !");
        }
        If (SecretDone  == FALSE && ItsToLateForSecret == TRUE  )
        {
            Print(s:"It's too late !");
        }
        If (SecretDone  == FALSE && ItsToLateForSecret == FALSE )
        {
            If ( typ == 1 )
            {
                If(GetActorZ(0) <= -416.0)
                {
                    If (CheckInventory(KEY_YELLOW_SKULL) == 1 && CheckInventory(KEY_BLUE_SKULL) == 1  )
                    {
                        SecretDone = TRUE;
                        Music::PlayMusic("D_CSEC");
                        Resist::StopResistByIndex(6);
                        if(Player::GetIsHuman())
                        {
                            Thing_Move(0,77,0);
                        }
                        if(Player::GetIsZombie())
                        {
                            Thing_Move(0,82,0);
                        }
                        Floor_LowerbyValue(73,30,128);
                        Floor_LowerbyValue(80,200,1024);
                        ACS_Suspend(30,0);
                        Thing_Remove(8666);
                        setlinespecial(25,0,0,0,0,0,0);
                        SetFont("BIGFONT");
                        HudmessageBold(s:"Secret Ending ACTIVATED"; HUDMSG_FADEOUT, 998, CR_GREEN, 0.5, 0.30, 3.5, 0.5);
                        delay(35*3);
                        SETFONT("SmallFont");
                        HudMessageBold(s:"Don't waste your time with others, rush to the end !"; HUDMSG_FADEOUT, 0, CR_Green, 0.5, 0.20, 4.0, 1.0);
                        Resist::StartResistByIndex(7);
                        delay(35);
                        PrintBold(n:0, s:" \cdhas activated the secret end !");
                        delay(35*3);
                        if(Player::GetIsHuman())
                        {
                            Print(s:"\cdBe ready they are coming !");
                        }
                    }
                    If (CheckInventory(KEY_YELLOW_SKULL) != 1 && CheckInventory(KEY_BLUE_SKULL) == 1  )
                    {
                        Print(s:"You need the blue and yellow skull to active the secret end !");
                    }
                    If (CheckInventory(KEY_YELLOW_SKULL) == 1 && CheckInventory(KEY_BLUE_SKULL) != 1  )
                    {
                        Print(s:"You need the blue and yellow skull to active the secret end !");
                    }
                    If (CheckInventory(KEY_YELLOW_SKULL) != 1 && CheckInventory(KEY_BLUE_SKULL) != 1  )
                    {
                        Print(s:"You need the blue and yellow skull to active the secret end !");
                    }
                }
            }
            If ( typ == 2 )
            {
                SecretDone = TRUE;
                Music::PlayMusic("D_BARNEY");
                SetFont("BARNA0");
                HudMessageBold(s:"A"; HUDMSG_FADEINOUT, 0, 0, 0.5, 0.6, 3.0, 3.0, 2.0, 2.0);
                Resist::StopResistByIndex(3);
                SetFont("BIGFONT");
                HudmessageBold(s:"Secret Ending ACTIVATED"; HUDMSG_FADEOUT, 998, CR_PURPLE, 0.5, 0.30, 3.5, 0.5);
                delay(35*3);
                SETFONT("SmallFont");
                HudMessageBold(s:"Protect barney, he will kill zombies for you !"; HUDMSG_FADEOUT, 0, CR_purple, 0.5, 0.40, 4.0, 1.0);
                SpawnSpot("ZH2LegacyZe26Barney",258,456);
                SetThingSpecial(456,Acs_execute,82,0,0,0,0);
                Resist::StartResistByIndex(8);
            }
        }
    }

