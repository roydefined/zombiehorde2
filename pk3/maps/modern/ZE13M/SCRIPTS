// Marks the player as being inside the shop area.
Script "SetInShopArea"
{
	Logger::LogDebug(LOGSOURCE, StrParam(s:BCSUtils::PlayerName(PlayerNumber()), s:" in shop area: ", s:BCSUtils::cond(LineSide()== LINE_FRONT, "true", "false"), s:"."));
	_playerInShopArea[PlayerNumber()] = (LineSide()== LINE_FRONT);
}

script "ShopGuyChat" (int index) clientside
{
	static bool confirmShopItem[4];

	static str shopGuyZombieLines[] =
	{
		"Piss off, zombie scum!",
		"Go catch someone else, stupid zombie!",
		"I have nothing of value for you, Go away!"
	};

	static str shopGuyDuplicateLines[] =
	{
		"You already have a %s!",
		"You have a %s, why would you need more?",
		"I'm not going to give you another %s!"
	};

	static str shopGuyPriceLines[] =
	{
		"That %s? I'd like %d for it.",
		"I'm looking for %d gold pieces if you want that %s.",
		"About %d gold pieces should cover that %s."
	};

	static str shopGuyNoMoneyLines[] =
	{
		"I would like to see some money before giving you a %s!",
		"I'm afraid You're gonna need some more money than that for a %s.",
		"I aint giving you a %s with that few gold!"
	};

	static str shopGuyGiveLines[] =
	{
		"Here's that %s you asked for.",
		"Alright, here's your %s. Have fun with it.",
		"I guess you know how to use a %s, right? Here ya go."
	};

	str line;

	if (ConsolePlayerNumber() != PlayerNumber())
		terminate;

	// This guy does not serve zombies.
	if (Player::GetIsZombie())
	{
		NamedRequestScriptPuke("ShopGuyChat_Animation", 1);
		line = shopGuyZombieLines[Random(0, lengthof(shopGuyZombieLines) - 1)];
		ShopGuyChat(line);
		terminate;
	}

	str label = _shopGuyStuff[index][0];
	str entry = _shopGuyStuff[index][1];
	int value = _shopGuyStuff[index][2];

	// Player already has this item
	if (CheckInventory(entry))
	{
		line = BCSUtils::StrReplace(shopGuyDuplicateLines[Random(0, lengthof(shopGuyDuplicateLines) - 1)], "%s", label);
		ShopGuyChat(line);
		terminate;
	}

	// Confirm buying this item.
	if (!confirmShopItem[index])
	{
		NamedRequestScriptPuke("ShopGuyChat_Animation", 0);

		line = BCSUtils::StrReplace(shopGuyPriceLines[Random(0, lengthof(shopGuyPriceLines) - 1)], "%s", label);
		line = BCSUtils::StrReplace(line, "%d", StrParam(d:value));
		ShopGuyChat(line);

		Logger::LogActivator(StrParam(s:"Press the ", s:label, s:" a second time to buy it."));
		confirmShopItem[index] = true;
		delay(35*2);
		confirmShopItem[index] = false;
		terminate;
	}

	// Does the player have enough for this item?
	if (CheckInventory(CURRENCY_CASH_NAME) < value)
	{
		NamedRequestScriptPuke("ShopGuyChat_Animation", 1);

		line = BCSUtils::StrReplace(shopGuyNoMoneyLines[Random(0, lengthof(shopGuyNoMoneyLines) - 1)], "%s", label);
		ShopGuyChat(line);
		terminate;
	}

	line = BCSUtils::StrReplace(shopGuyGiveLines[Random(0, lengthof(shopGuyGiveLines) - 1)], "%s", label);
	ShopGuyChat(line);

	NamedRequestScriptPuke("ShopGuyChat_Server", index);
}

// Called from the client in the event an animation is to be played.
script "ShopGuyChat_Animation" (int type) net
{
	// Not in the shop area
	if (!_playerInShopArea[PlayerNumber()])
	{
		Logger::LogDebug(LOGSOURCE, "Shop animation failed: player not in shop area.");
		terminate;
	}

	// 0 is talking, 1 is no sale.
	switch(type)
	{
		case 0:
			SetActorState(SHOPGUY_TID, "talking");
			break;

		case 1:
			SetActorState(SHOPGUY_TID, "nosale");
			break;

		default:
			Logger::LogWarning(LOGSOURCE, StrParam(s:"Unknown animation type: ", d:type, s:"."));
	}
}

// Called from the client after the initial conversation passed.
script "ShopGuyChat_Server" (int index) net
{
	// Not in the shop area
	if (!_playerInShopArea[PlayerNumber()])
	{
		Logger::LogDebug(LOGSOURCE, "Shop failed: player not in shop area.");
		terminate;
	}

	if (Player::GetIsZombie())
	{
		Logger::LogDebug(LOGSOURCE, "Shop failed: player is a zombie.");
		terminate;
	}

	str entry = _shopGuyStuff[index][1];
	int value = _shopGuyStuff[index][2];

	if (CheckInventory(entry))
	{
		Logger::LogDebug(LOGSOURCE, "Shop failed: player already has this item.");
		terminate;
	}

	if (CheckInventory(CURRENCY_CASH_NAME) < value)
	{
		Logger::LogDebug(LOGSOURCE, "Shop failed: player does not have enough coins.");
		terminate;
	}

	TakeInventory(CURRENCY_CASH_NAME, value);
	GiveInventory(entry, 1);
}

internal void ShopGuyChat (str string)
{
	VALIDATE_IS_CLIENTSIDE_FUNCTION();
	Chat::SendActor(SHOPGUY_TID, string);
}

