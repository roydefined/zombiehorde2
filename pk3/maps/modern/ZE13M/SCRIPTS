// Main loop that is called when entering the castle.
script "CastleJewelContext" (void) CLIENTSIDE
{
	// TODO: Support parameters?
	Music::SetDefaultMusic(BCSUtils::cond(Player::GetIsHuman(), "CASTLE2", "CASTLE3"));//, MAPMUSICSETDEFAULT | MAPMUSICREPLACERADIO);

	if (Player::GetIsHuman() && (blueJewelAlreadyPlaced || redJewelAlreadyPlaced))
	{
		// TODO: LogBuilder
		str message;
		if (blueJewelAlreadyPlaced && redJewelAlreadyPlaced)
		{
			message = "You're in luck! It appears that both jewels have already been inserted into the door! No need to collect them.";
		}
		else if (blueJewelAlreadyPlaced)
		{
			message = "You're in luck! It appears the Night Sapphire has already been inserted. You don't have to collect it.";
		}
		else if (redJewelAlreadyPlaced)
		{
			message = "You're in luck! It appears the Blood Ruby has already been inserted. You don't have to collect it.";
		}

		Logger::LogBold(message);
	}

	if (redJewelState == JEWELSTATE_PLACED && blueJewelState == JEWELSTATE_PLACED)
	{
		terminate;
	}

	SetHudSize(640, 480, FALSE);

    SetFont("smallfont");
    HudMessage(s:"You require the following keys"; HUDMSG_FADEINOUT, 0, CR_WHITE, KEYTEXTDISPLAYX + 10.9, KEYTEXTDISPLAYY - 28.0, 4.0, 1.0, 0.5);

	delay(9);
	HudMessage(s:"in order to traverse deeper into the castle"; HUDMSG_FADEINOUT, 0, CR_WHITE, KEYTEXTDISPLAYX + 10.9, KEYTEXTDISPLAYY - 18.0, 3.75, 1.0, 0.5);

	delay(35*2);

	// Red jewel
	if (redJewelState != JEWELSTATE_PLACED)
	{
		if (!ACS_NamedExecute("CastleRedJewelContext", 0))
		{
			Logger::LogError(LOGSOURCE, "Failed to invoke CastleRedJewelContext");
		}
	}

	// Blue jewel
	if (blueJewelState != JEWELSTATE_PLACED)
	{
		if (!ACS_NamedExecute("CastleBlueJewelContext", 0))
		{
			Logger::LogError(LOGSOURCE, "Failed to invoke CastleBlueJewelContext");
		}
	}
}

script "CastleRedJewelContext" (void) CLIENTSIDE
{
	int iconId = KEYDISPLAYID,
		textId = KEYDISPLAYID + 1;

	int iconX = KEYICONDISPLAYX,
		iconY = KEYTEXTDISPLAYY,
		textX = KEYTEXTDISPLAYX,
		textY = KEYTEXTDISPLAYY;

	SetHudSize(640, 480, false);

	SetFont("REDJEWLI");
	HudMessage(s:"a"; HUDMSG_FADEINOUT, KEYDISPLAYID, CR_UNTRANSLATED, iconX, iconY, 5.0, 1.0, 0);

	SetFont("smallfont");
	HudMessage(s:"\cgBlood Ruby"; HUDMSG_TYPEON, KEYDISPLAYID + 1, CR_WHITE, textX, textY, 4.0, 0.05, 0.5);

	delay(35*5+18);

	while (redJewelState != JEWELSTATE_PLACED)
	{
		str message;
		if (redJewelSynthesizeTimestamp != 0 && redJewelSynthesizeTimestamp > Timer())
		{
			int timeLeft = redJewelSynthesizeTimestamp - Timer();
			message = StrParam(s:"\ccSynthesizing \cgBlood Ruby \cc", s:Utils::FormatTics(timeLeft, true));
		}
		else if (redJewelState == JEWELSTATE_NONE)
		{
			message = "Unacquired";
		}
		else
		{
			message = BCSUtils::cond(CheckInventory("BloodRubyJewel"), "Acquired!", "Acquirable");
		}

		SetFont("REDJEWLI");
		HudMessage(s:"a"; HUDMSG_PLAIN, KEYDISPLAYID, CR_UNTRANSLATED, iconX, iconY, 0.0);

		SetFont("smallfont");
		HudMessage(s:message; HUDMSG_PLAIN, KEYDISPLAYID + 1, CR_WHITE, textX, textY, 0.0);
		Delay(const: 1);
	}

	SetFont("REDJEWLI");
	HudMessage(s:"a"; HUDMSG_FADEOUT, KEYDISPLAYID, CR_UNTRANSLATED, iconX, iconY, 2.0, 0.5);

	SetFont("smallfont");
	HudMessage(s:"Placed!"; HUDMSG_FADEOUT, KEYDISPLAYID + 1, CR_WHITE, textX, textY, 2.0, 0.5);
}

