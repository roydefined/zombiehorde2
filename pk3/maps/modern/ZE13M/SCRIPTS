function void SyncMapState()
{
	VALIDATE_IS_SERVERSIDE_FUNCTION();

	if (!IsNetworkGame())
		return;

	BCSUtils::SyncVariable(SYNC_MAPSTATE, _mapState);
	ACS_NamedExecuteAlways("SyncMapState_Client", 0);
}

script "SyncMapState_Client" (void) clientside
{
	ClientSyncMapState();
}

// Called clientside to fetch the synced state.
function void ClientSyncMapState(void)
{
	VALIDATE_IS_CLIENTSIDE_FUNCTION();

