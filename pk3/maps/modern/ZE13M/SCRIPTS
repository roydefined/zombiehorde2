// -----------------------------------------------------------------------------------------------------------------------------------
//
// JEWEL ALREADY PLACED SYSTEM
//
// -----------------------------------------------------------------------------------------------------------------------------------

function void SyncJewelAlreadySet(bool blueSet, bool redSet)
{
	if (!BCSUtils::IsServer()) {
		Logger::LogError(LOGSOURCE, "SyncJewelState was called clientside.");
		return;
	}

	blueJewelAlreadyPlaced = blueSet;
	redJewelAlreadyPlaced = redSet;

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int pack = BCSUtils::PackShorts(blueSet, redSet);
	BCSUtils::SyncVariable(SYNC_JEWELALREADYPLACED, pack);

	// Receive on all clients.
	if (!ACS_NamedExecuteAlways("SyncJewelAlreadySet_Client", 0)) {
		Logger::LogError(LOGSOURCE, "Failed to execute SyncJewelAlreadySet_Client.");
	}
}

script "SyncJewelAlreadySet_Client" (void) clientside
{
	ClientSyncJewelAlreadySet();
}

// Called clientside to fetch the synced state.
function void ClientSyncJewelAlreadySet(void)
{
	if (!BCSUtils::IsClient()) {
		Logger::LogError(LOGSOURCE, "ClientSyncJewelAlreadySet was called serverside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int pack = BCSUtils::GetSyncVarDefault(SYNC_JEWELALREADYPLACED, 0);
	blueJewelAlreadyPlaced = BCSUtils::UnpackShort1(pack);
	redJewelAlreadyPlaced = BCSUtils::UnpackShort2(pack);

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced jewel already set state to client. Blue: ", d:blueJewelAlreadyPlaced, s:", red: ", d:redJewelAlreadyPlaced, s:"."));
}


