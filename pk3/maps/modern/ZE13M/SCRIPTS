	HudMessage(s:"Placed!"; HUDMSG_FADEOUT, textId, CR_WHITE, textX, textY, 2.0, 0.5);
}

function void SyncJewelState(int which, int state)
{
	if (!BCSUtils::IsServer()) {
		Logger::LogError(LOGSOURCE, "SyncJewelState was called clientside.");
		return;
	}

	if (which == SYNCWHICH_BLUEJEWEL)
	{
		blueJewelState = state;
	}
	else
	{
		redJewelState = state;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int pack = BCSUtils::PackShorts(blueJewelState, redJewelState);
	BCSUtils::SyncVariable(SYNC_JEWELSTATE, pack);

	// Receive on all clients.
	if (!ACS_NamedExecuteAlways("SyncJewelState_Client", 0)) {
		Logger::LogError(LOGSOURCE, "Failed to execute SyncJewelState_Client.");
	}
}

script "SyncJewelState_Client" (void) clientside
{
	ClientSyncJewelState();
}

// Called clientside to fetch the synced state.
function void ClientSyncJewelState(void)
{
	if (!BCSUtils::IsClient()) {
		Logger::LogError(LOGSOURCE, "ClientSyncJewelState was called serverside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int pack = BCSUtils::GetSyncVarDefault(SYNC_JEWELSTATE, 0);
	blueJewelState = BCSUtils::UnpackShort1(pack);
	redJewelState = BCSUtils::UnpackShort2(pack);

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced jewel state to client. Blue: ", d:blueJewelState, s:", red: ", d:redJewelState, s:"."));
}

function void SyncJewelSynthesizeTimestamp(int which, int timestamp)
{
	if (!BCSUtils::IsServer()) {
		Logger::LogError(LOGSOURCE, "SyncJewelState was called clientside.");
		return;
	}


	if (which == SYNCWHICH_BLUEJEWEL)
	{
		blueJewelSynthesizeTimestamp = timestamp;
	}
	else
	{
		redJewelSynthesizeTimestamp = timestamp;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int packId = BCSUtils::cond(which == SYNCWHICH_BLUEJEWEL, SYNC_SYNTHESIZE_BLUEJEWEL, SYNC_SYNTHESIZE_REDJEWEL);
	BCSUtils::SyncVariable(packId, timestamp);

	// Receive on all clients.
	if (!ACS_NamedExecuteAlways("SyncJewelSynthesizeTimestamp_Client", 0, which)) {
		Logger::LogError(LOGSOURCE, "Failed to execute SyncJewelSynthesizeTimestamp_Client.");
	}
}

script "SyncJewelSynthesizeTimestamp_Client" (int which) clientside
{
	ClientSyncJewelSynthTimestamp(which);
}

// Called clientside to fetch the synced state.
function void ClientSyncJewelSynthTimestamp(int which)
{
	if (!BCSUtils::IsClient()) {
		Logger::LogError(LOGSOURCE, "ClientSyncJewelSynthTimestamp was called serverside.");
