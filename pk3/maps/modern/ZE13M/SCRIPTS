// If `true`, the ruby is being placed.
Script "PlaceGem" (int ruby)
{
	SetHudSize(640, 480, false);

	if (ruby)
	{
		if (_redJewelState == JEWELSTATE_PLACED)
			terminate;

		if (!CheckInventory(KEY_BLOODRUBY_NAME))
		{
			Logger::LogActivator("You are missing the blood ruby!");
			terminate;
		}

		ClearLineSpecial();
		SetLineTexture(2, SIDE_FRONT, TEXTURE_BOTTOM, "EPITAPH2");
		TakeInventory(KEY_BLOODRUBY_NAME, 1);

		_redJewelState = JEWELSTATE_PLACED;
		SyncJewelState();
	}


	// Night Sapphire part
	else
	{
		if (_blueJewelState == JEWELSTATE_PLACED)
			terminate;

		if (!CheckInventory(KEY_NIGHTSAPPHIRE_NAME))
		{
			Logger::LogActivator("You are missing the night sapphire!");
			terminate;
		}

		ClearLineSpecial();
		SetLineTexture(3, SIDE_FRONT, TEXTURE_BOTTOM, "EPITAPH2");
		TakeInventory(KEY_NIGHTSAPPHIRE_NAME, 1);

		_blueJewelState = JEWELSTATE_PLACED;
		SyncJewelState();
	}

	if (_blueJewelState != JEWELSTATE_PLACED
		|| _redJewelState != JEWELSTATE_PLACED)
	{
		terminate;
	}

	// Both gems placed. Door opens.
	HudMessageBold(s:"The way to the castle center has been opened!"; HUDMSG_FADEOUT, 0, CR_WHITE, HEADERTEXTX, HEADERTEXTY, 2.0, 0.5);
	Floor_LowerByValue(11, 16, 120);
	Delay(35*5);

	// Sideways
	if (!_redJewelAlreadyPlaced)
		Door_Open(38, 64);

	if (!_blueJewelAlreadyPlaced)
		Door_Open(56, 64);
}

