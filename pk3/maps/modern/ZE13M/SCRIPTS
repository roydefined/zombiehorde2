// Final resist
Script "Resist3" (void)
{
	SetActivator(-1);
	SetHudSize(640, 480, FALSE);
	SetFont("BIGFONT");

	HudMessageBold(s:"Death is seeking out intruders."; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, 40.0, 0.5, 0.5);
	HudMessageBold(s:"Get to the catacombs before it's too late!"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, 55.0, 0.5, 0.5);

	delay(18);

	HudMessageBold(s:"Death is seeking out intruders."; HUDMSG_FADEINOUT, 0, CR_RED, 320.0, 40.0, 0.0, 0.5, 0.5);
	HudMessageBold(s:"Get to the catacombs before it's too late!"; HUDMSG_FADEINOUT, 0, CR_RED, 320.0, 55.0, 0.0, 0.5, 0.5);

	delay(18);

	HudMessageBold(s:"Death is seeking out intruders."; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 40.0, 2.0, 0.5, 0.5);
	HudMessageBold(s:"Get to the catacombs before it's too late!"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 55.0, 2.0, 0.5, 0.5);

	Delay(35*3);
	Delay(Resist::StartResistByIndex(2));
	//Generic_Ceiling(31, 16, 128, 5, 16);

	// 2 is Hexen crushing mode.
	Ceiling_LowerAndCrush(31, 16, 500, 2);
	Tagwait(31);
	Ceiling_LowerByValueTimes8(31, 16, 1);

	Delay(35*3);
	SetFont("BIGFONT");
	HudMessageBold(s:"Death is here"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, 40.0, 5.0, 3.0);
	Delay(35);
	for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
	{
		if (Game::GetPlayerIsSafe(i) || !PlayerInGame(i)) {
			continue;
		}

		SetActivatorToPlayer(i);
		ACS_NamedExecuteAlways("DeathQuake", 0);
	}

	delay(35*4+18);
	Game::KillUnsafePlayers();
}

script "DeathQuake" (void)
{
	FadeTo(0, 0, 0, 1.0, 4.0);
	for (int i = 1; i < 4; i++)
	{
		Radius_Quake2(ActivatorTID(), i, 35, 0, 1, "");
		delay(35);
	}

	Radius_Quake2(ActivatorTID(), i, 35, 0, 1, "");
	delay(35*2);
	FadeTo(0, 0, 0, 0.0, 1.0);
}

