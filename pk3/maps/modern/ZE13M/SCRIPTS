// The ward that pushes out zombies.
Script "Ward"
{
	if (Player::GetIsZombie())
	{
		Logger::LogActivator("Why would you make things tougher for yourself?");
		terminate;
	}

	ClearLineSpecial();
	Logger::LogBold(StrParam(s:BCSUtils::PlayerName(PlayerNumber()), s:" \cjhas placed a holy ward in the main room.\nIt will shut down in 15 seconds."));

	SetActivator(-1);

	int wardTimeLeft = 15;
	_wardActive = true;

	TranslucentLine(90, 96, 0);

	while(wardTimeLeft)
	{
		SetFont("ConFONT");
		HudMessageBold(s:"\cjward will fall in \ck",d:wardTimeLeft--,s:" \cjseconds"; HUDMSG_FADEOUT, 0, CR_UNTRANSLATED, 0.04, 0.86, 0.5);
		delay(35);
	}

	TranslucentLine(2, 0, 0);
	setlinetexture(90,SIDE_FRONT,TEXTURE_MIDDLE,"-");
	setlinetexture(90,SIDE_back,TEXTURE_MIDDLE,"-");
	TranslucentLine(90, 0, 0);

	_wardActive = false;
}

// Runs for the ward as soon as the map starts.
Script "WardLoop"
{
	while(true)
	{
		if (!_wardActive)
		{
			Delay(const: 1);
			continue;
		}

		for(int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
		{
			if (!PlayerInGame(i)) {
				continue;
			}

			if (!Player::GetPlayerIsZombie(i) || !_playerInWard[i]) {
				continue;
			}

			SetActivatorToPlayer(i);
			ThrustThing(192, 12, 0, 0);
		}

		delay(const: 4);
	}
}


