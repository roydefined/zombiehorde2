// Main loop that is called when entering the castle.
script "CastleJewelContext" clientside
{
	Music::SetDefaultMusic(Player::GetIsHuman() ? "CASTLE1" : "CASTLE3");
	Music::PlayDefaultMusic();

	// We only need to invoke this script if players haven't advanced further already.
	if (_mapState == MAPSTATE_CASTLEREMAINDER)
		terminate;

	bool redPlaced = _redJewelState == JEWELSTATE_PLACED;
	bool bluePlaced = _blueJewelState == JEWELSTATE_PLACED;

	if (Player::GetIsHuman() && (redPlaced || bluePlaced))
	{
		str message;
		buildmsg(message = StrParam())
		{
			if (redPlaced && bluePlaced) Append(s: "You're in luck! It appears that both jewels have already been inserted into the door! No need to collect them.");
			else if (redPlaced) 		 Append(s: "You're in luck! It appears the Blood Ruby has already been inserted. You don't have to collect it.");
			else 						 Append(s: "You're in luck! It appears the Night Sapphire has already been inserted. You don't have to collect it.");
		}

		Logger::LogConsolePlayer(message);
	}

	if (redPlaced && bluePlaced)
		terminate;

	SetHudSize(640, 480, FALSE);

	SetFont("smallfont");
	HudMessage(s:"You require the following keys"; HUDMSG_FADEINOUT, 0, CR_WHITE, HEADERTEXTX, HEADERTEXTY, 4.0, 1.0, 0.5);

	delay(9);
	HudMessage(s:"in order to traverse deeper into the castle"; HUDMSG_FADEINOUT, 0, CR_WHITE, HEADERTEXTX, HEADERTEXTY + 10.0, 3.75, 1.0, 0.5);

	delay(35*2);

	ACS_NamedExecute("CastleRedJewelContext", 0);
	ACS_NamedExecute("CastleBlueJewelContext", 0);
}

script "CastleRedJewelContext" clientside
{
	int iconId = KEYDISPLAYID,
		textId = KEYDISPLAYID + 1;

	int iconX = KEYICONDISPLAYX,
		iconY = KEYICONDISPLAYY,
		textX = KEYTEXTDISPLAYX + 0.1,
		textY = KEYTEXTDISPLAYY;

	SetHudSize(640, 480, false);

	SetFont("MAPCK01I");
	HudMessage(s:"a"; HUDMSG_FADEINOUT, KEYDISPLAYID, CR_UNTRANSLATED, iconX, iconY, 5.0, 1.0, 0);

	SetFont("smallfont");
	HudMessage(s:"\cgBlood Ruby"; HUDMSG_TYPEON, KEYDISPLAYID + 1, CR_WHITE, textX, textY, 4.0, 0.05, 0.5);

	delay(35*5+18);

	while (_redJewelState != JEWELSTATE_PLACED)
	{
		str message;
		if (_redJewelSynthesizeTimestamp != 0 && _redJewelSynthesizeTimestamp > Utils::GetSynchronizedTimer())
		{
			int timeLeft = _redJewelSynthesizeTimestamp - Utils::GetSynchronizedTimer();
			message = StrParam(s:"\ccSynthesizing \cgBlood Ruby \cc", s:Utils::FormatTics(timeLeft, true));
		}
		else if (_redJewelState == JEWELSTATE_NONE)
		{
			message = "Unacquired";
		}
		else
		{
			message = BCSUtils::cond(CheckInventory(KEY_BLOODRUBY_NAME), "Acquired!", "Acquirable");
		}

		SetFont("MAPCK01I");
		HudMessage(s:"a"; HUDMSG_PLAIN, KEYDISPLAYID, CR_UNTRANSLATED, iconX, iconY, 0.0);

		SetFont("smallfont");
		HudMessage(s:message; HUDMSG_PLAIN, KEYDISPLAYID + 1, CR_WHITE, textX, textY, 0.0);
		Delay(const: 1);
	}

	SetFont("MAPCK01I");
	HudMessage(s:"a"; HUDMSG_FADEOUT, KEYDISPLAYID, CR_UNTRANSLATED, iconX, iconY, 2.0, 0.5);

	SetFont("smallfont");
	HudMessage(s:"Placed!"; HUDMSG_FADEOUT, KEYDISPLAYID + 1, CR_WHITE, textX, textY, 2.0, 0.5);
}

