// If `true`, the ruby is being placed.
Script "PlaceGem" (int ruby)
{
	SetHudSize(640, 480, false);

    if (ruby)
    {
		if (redJewelState == JEWELSTATE_PLACED)
		{
			terminate;
		}

        if (!CheckInventory("BloodrubyJewel"))
		{
			Logger::LogActivator("You are missing the blood ruby!");
            terminate;
        }

        ClearLineSpecial();
        SetLineTexture(2, SIDE_FRONT, TEXTURE_BOTTOM, "GOTHDOR2");
		TakeInventory("BloodRuby", 1);
		SyncJewelState(SYNCWHICH_REDJEWEL, JEWELSTATE_PLACED);
    }


    //Night Sapphire part
    else
    {
		if (blueJewelState == JEWELSTATE_PLACED)
		{
			terminate;
		}

        if (!CheckInventory("NightsapphireJewel"))
		{
			Logger::LogActivator("You are missing the night sapphire!");
            terminate;
        }

        ClearLineSpecial();
        SetLineTexture(3, SIDE_FRONT, TEXTURE_BOTTOM, "GOTHDOR2");
		TakeInventory("NightSapphire", 1);
		SyncJewelState(SYNCWHICH_BLUEJEWEL, JEWELSTATE_PLACED);
    }

	if (blueJewelState != JEWELSTATE_PLACED
		|| redJewelState != JEWELSTATE_PLACED)
	{
		terminate;
	}

    // Both gems placed. Door opens.
    HudMessageBold(s:"The way to the castle center has been opened!"; HUDMSG_FADEOUT, 0, CR_WHITE, KEYTEXTDISPLAYX + 10.9, KEYTEXTDISPLAYY - 18.0, 2.0, 0.5);
	Floor_LowerByValue(11, 16, 120);
	Delay(35*5);

	// Sideways
    Door_Open(38, 64);
}

