script "OnOpen" open
{
	// Resists
	// TODO: Support third parameter?
	Resist::CreateResist(20, "", "\cgResist for \cj%t \cgseconds"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(20, "", "\cgResist for \cj%t \cgseconds"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(80, "", "\cgYou have %t \cgseconds to reach safety!"); //, RESISTTYPEPLAIN);

	// Skybox
	scroll_floor(42, 1, 10, 0);
	scroll_floor(47, 3, 5, 0);

	scroll_wall(5,0,-5,0,2);
	scroll_wall(5,0,-5,1,2);
	SetLineBlocking(90, BLOCK_NOTHING);
	TranslucentLine(90, 0, 0);

	ACS_NamedExecute("WardLoop",0,0,0,0);

	// Determine if the blue/red jewels should already be set.
	// Randomize if 0. Otherwise set based on the flow value.
	int flow = GetCVar("sv_zh2_ze13mflow");
	if (flow == 0)
	{
		_redJewelAlreadyPlaced = Random(0, 10) == 10;
		_blueJewelAlreadyPlaced = Random(0, 10) == 10;
	}
	else
	{
		_redJewelAlreadyPlaced = (flow & 1 << 0) != 0;
		_blueJewelAlreadyPlaced = (flow & 1 << 1) != 0;
	}

	if (_redJewelAlreadyPlaced)
	{
		Door_Close(26, 10);
		SetLineTexture(2, SIDE_FRONT, TEXTURE_BOTTOM, "EPITAPH2");
		_redJewelState = JEWELSTATE_PLACED;
	}

	if (_blueJewelAlreadyPlaced)
	{
		Door_Close(45, 10);
		SetLineTexture(3, SIDE_FRONT, TEXTURE_BOTTOM, "EPITAPH2");
		_blueJewelState = JEWELSTATE_PLACED;
	}

	SyncJewelState();

	// Middle door
	if (_blueJewelAlreadyPlaced && _redJewelAlreadyPlaced)
		Floor_LowerByValue(11, 16, 120);

	// Zombie spawn
	Floor_RaiseByValue(49, 999, 96);
	Floor_RaiseByValue(55, 999, 96);
	Delay(35 * 15);
	Floor_LowerByValue(49, 6, 96);
	Floor_LowerByValue(55, 3, 96);
}

