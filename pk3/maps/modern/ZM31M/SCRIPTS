function void DrawTemperatureValue(int amount, int x, int y, int id)
{
	if (consoleClientIsInBunker)
	{
		return;
	}

	if (amount == TEMPERATURE_MIN && Timer() % 10 >= 5)
	{
		return;
	}

	int color = cond(amount > 32, CR_WHITE,
		cond(amount > 30, CR_YELLOW, CR_RED));

	SetFont("smallfont");
	HudMessage(d:amount; HUDMSG_PLAIN, id, color, x, y, 0.03);
}

