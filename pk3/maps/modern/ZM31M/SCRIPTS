// Main elevator logic. Parameters indicate pressed elevator id, target elevator id, and wether the button inside the elevator was pressed.
script "ElevatorLogic" (int elevatorId, int targetElevatorId, int pressedInside)
{
	int playerId = PlayerNumber();

	// Checks when the elevator may not be used
    if (eventState == EVENTSTATE_NUKE
		|| !labUnlocked
		|| (Player::GetIsZombie() && !pressedInside)
		|| elevatorInUse[elevatorId])
	{
		NamedExecuteClientScript("Elevator_client", playerId);
        terminate;
    }

	SetActivator(-1);

	// Elevator is now in use
	elevatorInUse[elevatorId] = true;
	elevatorInUse[targetElevatorId] = true;

	// Elevator sound.
	int dingSoundTag = elevatorTags[elevatorId][2];
	ThingSound(dingSoundTag, "sound/ding1", 127);
	Delay(35);

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Start elevator logic. Elevator id: ", d:elevatorId, s:", target elevatorId", d:targetElevatorId));

	// Open doors.
	int polyRightTag = elevatorTags[elevatorId][0];
	int polyLeftTag = polyRightTag++;
	int polyRightAngle = elevatorTags[elevatorId][1];
	int polyLeftAngle = polyRightAngle + 128;
	Polyobj_OR_Move(polyRightTag, 5, polyRightAngle, 32);
	Polyobj_OR_Move(polyLeftTag, 5, polyLeftAngle, 32);
	PolyWait(polyRightTag);
	PolyWait(polyLeftTag);

	Delay(35*4);

	Polyobj_OR_Move(polyRightTag, 5, polyLeftAngle, 32);
	Polyobj_OR_Move(polyLeftTag, 5, polyRightAngle, 32);
	PolyWait(polyRightTag);
	PolyWait(polyLeftTag);

	// Stop here if a zombie called from the inside.
	if (Player::GetPlayerIsZombie(playerId) && pressedInside) {
		terminate;
	}

	// Check if elevator or target elevator have occupands.
	if (!AnybodyInElevator(elevatorId) && !AnybodyInElevator(targetElevatorId)) {
		terminate;
	}

	// Rest of the logic happends on both sides.
	ACS_NamedExecuteAlways("ElevatorLogic2", 0, elevatorId, targetElevatorId);
	ACS_NamedExecuteAlways("ElevatorLogic2", 0, targetElevatorId, elevatorId);
}

script "ElevatorLogic2" (int elevatorId, int targetElevatorId)
{
	// Move to a temporary room.
	int sourceTag = elevatorTags[elevatorId][2];
	int sourceSectorTag = elevatorTags[elevatorId][3];
	int tempDestTag = elevatorTags[elevatorId][4];
	int tempDestSectorTag = elevatorTags[elevatorId][5];
	int destTag = elevatorTags[elevatorId][6];
	delay(35*2);
	TeleportInSector(sourceSectorTag, sourceTag, tempDestTag, 0);
	PlaySound(tempDestTag, "sound/lift1", CHAN_AUTO, 1.0);
	delay(35*5);
	TeleportInSector(tempDestSectorTag, tempDestTag, destTag, 0);
	ThingSound(destTag, "sound/ding1", 127);

	// Open doors.
	int polyRightTag = elevatorTags[targetElevatorId][0];
	int polyLeftTag = polyRightTag++;
	int polyRightAngle = elevatorTags[targetElevatorId][1];
	int polyLeftAngle = polyRightAngle + 128;
	Polyobj_OR_Move(polyRightTag, 5, polyRightAngle, 32);
	Polyobj_OR_Move(polyLeftTag, 5, polyLeftAngle, 32);
	PolyWait(polyRightTag);
	PolyWait(polyLeftTag);

	Delay(35*4);

	Polyobj_OR_Move(polyRightTag, 5, polyLeftAngle, 32);
	Polyobj_OR_Move(polyLeftTag, 5, polyRightAngle, 32);
	PolyWait(polyRightTag);
	PolyWait(polyLeftTag);

	// Elevators no longer in use.
	elevatorInUse[elevatorId] = false;
	elevatorInUse[targetElevatorId] = false;
}

function bool AnybodyInElevator(int elevatorId)
{
	// Check if anybody has entered the elevator.
	for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i) {
		if (!PlayerInGame(i) || inElevator[i] != elevatorId) {
			continue;
		}

		return true;
	}

	return false;
}

