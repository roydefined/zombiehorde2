/*
** -----------------------------------------------------------------------------
** EVENT STATE
** -----------------------------------------------------------------------------
*/

function void SetEventState(int state)
{
	LogDebug(StrParam(s:"Setting event state to ", d:state));
	eventState = state;
	SyncEventState();
}

function void SyncEventState(void)
{
	if (!IsServer()) {
		LogError("SyncEventState was called clientside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	SyncVariable(SYNC_EVENTSTATE, eventState);

	// Receive on all clients.
	if (!ACS_NamedExecuteAlways("SyncEventState_Client", 0)) {
		LogError("Failed to execute SyncEventState_Client.");
	}
}

script "SyncEventState_Client" (void) clientside
{
	ClientSyncEventState();
}

// Called clientside to fetch the synced state.
function void ClientSyncEventState(void)
{
	if (!IsClient()) {
		LogError("ClientSyncEventState was called serverside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int state = GetSyncVarDefault(SYNC_EVENTSTATE, EVENTSTATE_NONE);
	eventState = state;

	LogDebug(StrParam(s:"Synced event state client: ", d:eventState));
}

