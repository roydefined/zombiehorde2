internal void TemperatureTickClient()
{
	VALIDATE_IS_CLIENTSIDE_FUNCTION();

	if (Round::GetGameIsEnding())
		return;

	if (Player::GetIsZombie())
		return;

	// Client is in water
	bool inWater = BCSutils::GetActorWaterLevel(ActivatorTID()) > 0;
	if (!_consoleClientIsWarm && inWater)
	{
		SetHudSize(640, 480, false);
		SetFont("smallfont");
		HudMessage(s:"Watch out! The water is incredibly cold, get out!"; HUDMSG_FADEOUT, HUDID_INTERACTION + 1, CR_YELLOW, 320.0, 400.0, 5.0, 0.6, 0.6);
	}

	// Inform client to get warm
	else if (!_consoleClientIsWarm && NightHasFallen())
	{
		SetHudSize(640, 480, false);
		SetFont("smallfont");
		HudMessage(s:"Caution! It is very cold at night, get somewhere warm!"; HUDMSG_FADEOUT, HUDID_INTERACTION + 1, CR_YELLOW, 320.0, 400.0, 5.0, 0.6, 0.6);
	}

	SetHudSize(480, 480, 0);
	DrawFrostScreen(240.0, 240.0, HUDID_TEMPERATURE);
}

internal raw OnDrawTemperatureGaugeHud(void[]* data)
{
	if (data == null)
		return 0;

	_hudHookDataRef = data;

	if (_hudHookDataRef.Type != Hud::HUDHOOK_PLAYERSTATUS)
		return 0;

	if (_consoleClientIsInBunker)
		return 0;

	Hud::SetRelativePoint(160.0, -80.0);
	BCSUtils::HudDrawImage(HUDID_TEMPERATURE + 4, "TEMPICON");

	// Flicker effect for the value.
	if (_consoleClientTemperature == TEMPERATURE_MIN && Timer() % 10 >= 5)
		return 0;

	int color = _consoleClientTemperature > 32
		? CR_WHITE
		: _consoleClientTemperature > 30
			? CR_YELLOW
			: CR_RED;

	Hud::SetRelativePoint(176.0, -85.0);
	BCSUtils::HudSetTextColor(color);
	BCSUtils::HudDrawText(HUDID_TEMPERATURE + 5, str((int)_consoleClientTemperature));
	return 0;
}

internal void DrawFrostScreen(int x, int y, int id)
{
	// The values at which the graphics are going to be displayed.
	static int frostGraphicValues[4] = {
		35, 33, 31, 29
	};

	// Update every three tics.
	if (Timer() % 3 != 0)
		return;

	// Determine graphic.
	int graphicIndex = 0;
	for (int i = lengthof(frostGraphicValues) - 1; i >= 0; --i)
	{
		if (_consoleClientTemperature > frostGraphicValues[i])
			continue;

		graphicIndex = i + 1;
		break;
	}

	// Always show the last graphic if outside at night or in water.
	bool inWater = BCSUtils::GetActorWaterLevel(ActivatorTID()) > 0;
	if (!_consoleClientIsWarm && (NightHasFallen() || inWater))
		graphicIndex = 4;

	if (graphicIndex == 0)
		return;

	SetFont(StrParam(s:"FROSTSC", d:graphicIndex));
	HudMessage(s:"a"; HUDMSG_FADEINOUT | HUDMSG_ADDBLEND, 0, CR_UNTRANSLATED, 240.0, 240.0, 0.0, 0.5, 0.1);
}

