// Nighttime event
Script "Event_Night"
{
	if (_eventState != EVENTSTATE_NONE)
		terminate;

	_eventState = EVENTSTATE_NIGHT;
	_eventStartTimestamp = Timer();
	SyncEvent();

	// Note: we don't run a loop as soon as the map starts, as anybody that joins after this script starts should see the changes immediately.
	ACS_NamedExecute("Event_Night_client", 0);
}

Script "Event_Night_client" clientside
{
	// Safety guard, to ensure that we received all info necessary to run the event.
	while (_eventState != EVENTSTATE_NIGHT
		|| _eventStartTimestamp == 0)
	{
		delay(const: 1);
	}

	int fadeValue  = 156,
		colorValue = 255;

	setFont("bigfont");
	SetHudSize(640, 480, FALSE);
	HudMessage(s:"Night approaches"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 100.0, 5.0, 1.0, 5.0);

	delay(35 * 3);
	Music::SetMusic("");
	Music::SetDefaultMusic("SUBZERO");
	delay(35 * 8);

	while (--fadeValue > 20 && --colorValue)
	{
		if (fadeValue < 30 && Player::GetPlayerIsHuman(ConsolePlayerNumber()))
		{
			SetHudSize(640, 480, FALSE);
			HudMessage(s:"As the night approaches"; HUDMSG_TYPEON, 0, CR_WHITE, 320.0, 93.0, 3.0, 0.04, 1.0);
			HudMessage(s:"it suddenly becomes very, very cold..."; HUDMSG_TYPEON, 0, CR_WHITE, 320.0, 107.0, 2.5, 0.04, 1.0);
		}

		SetLevelAtmosphere(fadeValue, colorValue, colorValue);
		delay(5);
	}

	Music::PlayDefaultMusic();
}

internal bool NightHasFallen()
{
	return _eventState == EVENTSTATE_NIGHT && GetTicsUntilNightFallen() == 0;
}

internal int GetTicsUntilNightFallen()
{
	if (_eventState != EVENTSTATE_NIGHT)
		return 0;

	return BCSUtils::Max(_eventStartTimestamp + EVENT_NIGHT_STARTTICS - Utils::GetSynchronizedTimer(), 0);
}

/*
** -----------------------------------------------------------------------------
** EVENTS - Nuke
** -----------------------------------------------------------------------------
*/

Script "Event_Nuke"
{
	if (_eventState != EVENTSTATE_NONE)
		terminate;

	_eventState = EVENTSTATE_NUKE;
	_eventStartTimestamp = Timer();
	SyncEvent();

	// Note: we don't run a loop as soon as the map starts, as anybody that joins after this script starts should see the changes immediately.
	ACS_NamedExecute("Event_Nuke_client", 0);

	int waitTics = EVENT_NUKE_STARTTICS;
	while(--waitTics)
		Delay(const: 1);

	// Delay before the nuke truly hits
	Delay(35 * 11);

	for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
	{
		if (!PlayerInGame(i))
			continue;

		NamedExecuteClientScript("Event_Nuke_Final_client", i);
	}

	Delay(12);

	// TODO: Use safety API
	for (i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
	{
		if (!PlayerInGame(i) || _isInBunker[i])
			continue;

		int tid = Identity::GetTid(i);
		Thing_Damage(tid, 10000, MOD_EXIT);
	}

	// Set boundaries by raising rocks
	SetLineBlocking(2, BLOCK_PLAYERS);
	for (i = 0; i < lengthof(_nukeBoundaryRocks); ++i)
	{
		int tag = _nukeBoundaryRocks[i].SectorTag;
		int height = _nukeBoundaryRocks[i].Height;

		Floor_MoveToValue(tag, 999, height);
		ChangeFloor(tag, "FLAT5_8");
	}
}

Script "Event_Nuke_client" clientside
{
	// Safety guard, to ensure that we received all info necessary to run the event.
	while (_eventState != EVENTSTATE_NUKE
		|| _eventStartTimestamp == 0)
	{
		delay(const: 1);
	}

	SetActivatorToPlayer(ConsolePlayerNumber());

	int passedTime = 0;

	Music::SetDefaultMusic("");
	Music::PlayDefaultMusic();

	while(GetTicsUntilExplosion())
	{
		SetHudSize(640, 480, FALSE);

		// Alarm every four seconds.
		if (passedTime % (35 * 4) == 0)
		{
			AmbientSound("sound/nukealarm", 255);
		}

		// Message every two seconds.
		if (passedTime % (35 * 2) == 0)
		{
			setFont("bigfont");
			HudMessage(s:"Civil defence siren"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 93.0, 1.0, 0.6, 0.6);
		}

		// After at least two seconds, every two seconds.
		if (passedTime > (35 * 2) && passedTime % (35 * 2) == 0)
		{
			setFont("bigfont");
			HudMessage(s:"Nuke incoming"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 107.0, 1.0, 0.6, 0.6);
		}

		// Once after four seconds.
		if (passedTime == 35 * 4)
		{
			Music::SetDefaultMusic("Disposal");
			Music::PlayDefaultMusic();
		}

		// Inform of shelter after 6 seconds.
		if (passedTime == 35 * 6)
		{
			if (!_consoleClientIsInBunker)
			{
				setFont("smallfont");
				HudMessage(s:"Seek shelter in the indicated bunkers"; HUDMSG_TYPEON, 0, CR_WHITE, 320.0, 120.0, 2.0, 0.04, 1.0);
			}

			for (int i = 0; i < lengthof(_shelterMarkers); ++i)
				SpawnSpotForced("ZH2ZM31MNukeMarker", _shelterMarkers[i], 0, 0);
		}

		// Display time until explosion after 10.5 seconds.
		if(passedTime > 35 * 10 + 18)
		{
			setFont("smallfont");
			HudMessage(s:"Explosion in: ", s:Utils::FormatTics(GetTicsUntilExplosion(), true); HUDMSG_PLAIN, 0, CR_WHITE, 320.0, 120.0, BCSUtils::HUDTIC);
		}

		// Display safety markers on map avery tic after 6 seconds.
		if(passedTime > 35 * 6 && !_consoleClientIsInBunker)
		{
			BCSUtils::HudResetState();
			BCSUtils::HudSetCameraActor(0);
			BCSUtils::HudSetVirtualSize(120.0, 90.0);
			BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);
			BCSUtils::HudSetShowOnFullAutomap(FALSE);

			for (i = 0; i < lengthof(_shelterMarkers); ++i)
			{
				int tag = _shelterMarkers[i];

				if (BCSUtils::ActorDistance2D(0, tag) < 1000.0 || _consoleClientIsInBunker)
					continue;

				BCSUtils::HudSetPoint3D(GetActorX(tag), GetActorY(tag), GetActorZ(tag)+150.0);
				BCSUtils::HudDrawImage(0, "NMARA0");
			}
		}

		passedTime++;
		Delay(const: 1);
	}

	if (!_consoleClientIsInBunker)
	{
		FadeTo(150, 20, 20, 1.0, 0);
	}

	// Spawn nuke, red atmosphere, and remove clouds which actually also mess with the nuke's flare.
	SetLevelAtmosphere(10, 255, 10);
	SpawnSpot("ZH2ZM31MNuke", 6);
	ChangeFloor(48, "-");
	ChangeFloor(49, "-");
	Radius_Quake2(0, 1, 35*5, 0, 1, "");
	delay(35);

	if (!_consoleClientIsInBunker)
	{
		FadeTo(0, 0, 0, 0, 8.0);
	}

	delay(35*2);
	for (i = 2; i <= 4; ++i)
	{
		Radius_Quake2(0, i, 35*2, 0, 1, "");
		delay(35*2);
	}

	Radius_Quake2(0, i, 35*3, 0, 1, "");
}

script "Event_Nuke_Final_client" clientside
{
	SetActivatorToPlayer(ConsolePlayerNumber());
	if (!_consoleClientIsInBunker)
	{
		AmbientSound("sound/nukeexplosion", 255);
		delay(6);
		Spawn("ZH2ZM31MNukeSmoke", GetActorX(0), GetActorY(0), GetActorZ(0));
	}
	else
	{
		AmbientSound("sound/nukeexplosionfar", 255);
		delay(6);
		SpawnSpotForced("ZH2ZM31MNukeSmokeBunker", 1, 0, 0);
		SpawnSpotForced("ZH2ZM31MNukeSmokeBunker", 4, 0, 0);
	}

	// TODO: Doesn't work.
	for (int i = 0; i < lengthof(_shelterMarkers); ++i)
		Thing_Remove(_shelterMarkers[i]);
}

internal bool NukeHasDropped()
{
	return _eventState == EVENTSTATE_NUKE && GetTicsUntilExplosion() == 0;
}

internal int GetTicsUntilExplosion()
{
	if (_eventState != EVENTSTATE_NUKE)
		return 0;

	return BCSUtils::Max(_eventStartTimestamp + EVENT_NUKE_STARTTICS - Utils::GetSynchronizedTimer(), 0);
}

