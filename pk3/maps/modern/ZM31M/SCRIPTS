/*
** -----------------------------------------------------------------------------
** EVENT STATE
** -----------------------------------------------------------------------------
*/

function void SetEventState(int state)
{
	Logger::LogDebug(LOGSOURCE, StrParam(s:"Setting event state to ", d:state));
	eventState = state;
	SyncEventState();
}

function void SyncEventState(void)
{
	if (!BCSUtils::IsServer()) {
		Logger::LogError(LOGSOURCE, "SyncEventState was called clientside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	BCSUtils::SyncVariable(SYNC_EVENTSTATE, eventState);

	// Receive on all clients.
	if (!ACS_NamedExecuteAlways("SyncEventState_Client", 0)) {
		Logger::LogError(LOGSOURCE, "Failed to execute SyncEventState_Client.");
	}
}

script "SyncEventState_Client" (void) clientside
{
	ClientSyncEventState();
}

// Called clientside to fetch the synced state.
function void ClientSyncEventState(void)
{
	if (!BCSUtils::IsClient()) {
		Logger::LogError(LOGSOURCE, "ClientSyncEventState was called serverside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int state = BCSUtils::GetSyncVarDefault(SYNC_EVENTSTATE, EVENTSTATE_NONE);
	eventState = state;

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced event state client: ", d:eventState));
}

