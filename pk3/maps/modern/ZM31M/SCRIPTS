    }

    // For debugging.
    script "FrozenDebug" clientside
    {
        if (!Environment::IsDevelopment())
            terminate;

        while(true)
        {
            if (!BCSUtils::SetActivatorToConsolePlayer() || GetCVar("cl_zh2_zm31mdebug") == 0)
            {
                Delay(const: 1);
                continue;
            }

            SetHudSize(640, 480, FALSE);
            SetFont("smallfont");

            str message;
            buildmsg(message = StrParam())
            {
                str currentEvent;
                switch(_eventState)
                {
                    case EVENTSTATE_NIGHT:
                        currentEvent = "night";
                        break;
                    case EVENTSTATE_NUKE:
                        currentEvent = "nuke";
                        break;
                    default:
                        currentEvent = "none";
                        break;
                }

                Append(s:"Current event: ", s:currentEvent, s:"\n");

                if (_eventStartTimestamp != 0)
                {
                    int elapsed = Utils::GetSynchronizedTimer() - _eventStartTimestamp;
                    Append(s:"Elapsed since event start: ", d:elapsed, s:"\n");
                }

                if (_eventState == EVENTSTATE_NIGHT)
                {
                    Append(s:"Night falls in: ", d:GetTicsUntilNightFallen(), s:"\n");
                    Append(s:"Night has fallen: ", s:(NightHasFallen() ? "true" : "false"), s:"\n");
                }

                if (_eventState == EVENTSTATE_NUKE)
                {
                    Append(s:"Nuke explosion in: ", d:GetTicsUntilDrop(), s:"\n");
                    Append(s:"Nuke has dropped: ", s:(NukeHasDropped() ? "true" : "false"), s:"\n");
                    Append(s:"Nuke has blown over: ", s:(NukeHasBlownOver() ? "true" : "false"), s:"\n");
                }

                Append(s:"Is cold: ", s:(GetIsCold() ? "true" : "false"), s:"\n");
                Append(s:"Temperature: ", d:GetTemperature(), s:"\n");
                Append(s:"Next temperature update: ", d:(GetNextTemperatureTic() - Utils::GetSynchronizedTimer()), s:"\n");

                Append(s:"Is in bunker: ", s:(GetIsInBunker() ? "true" : "false"), s:"\n");

                Append(s:"Is at elevator doors: ", d:CheckActorInventory(ActivatorTid(), AT_ELEVATOR_DOORS_ITEM), s:"\n");
                Append(s:"Is in elevator: ", d:CheckActorInventory(ActivatorTid(), IN_ELEVATOR_ITEM), s:"\n");
            }

            HudMessage(s:message; HUDMSG_PLAIN, 0, CR_WHITE, 20.1, 45.0, 0.03);
            Delay(const: 1);
        }
    }

