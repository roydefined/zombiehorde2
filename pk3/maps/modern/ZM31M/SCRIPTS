Script "OnOpenClient" Open CLIENTSIDE
{
	ClientSyncEventState();
	ClientSyncNightModeTimestamp();
	ClientSyncNukeTimestamp();

	// Atmosphere and music depends on current events.
	// If clients join later and an event has triggered, this ensures the atmosphere and music is correct.
	// FYI, if the event JUST started, they still don't get the correct data since they didn't trigger the script.
	// These checks ensure everything works.
	if (eventState == EVENTSTATE_NONE)
	{
		SetMapMusic("PSXMUS05", MAPMUSICSETDEFAULT);
		SetLevelAtmosphere(156, 255, 255);
	}
	else if (eventState == EVENTSTATE_NIGHT)
	{
		SetMapMusic("SUBZERO", MAPMUSICSETDEFAULT);
		SetLevelAtmosphere(20, 120, 120);
	}
	else
	{
		SetMapMusic("DISPOSAL", MAPMUSICSETDEFAULT);
		SetLevelAtmosphere(10, 255, 10);
		SpawnSpot("Nuke", 6);
		ChangeFloor(48, "-");
		ChangeFloor(49, "-");
	}

	CreateWeather(WEATHERTYPESNOW, true, false, 15, 200, 500, 50, 150);
	CreateWeather(WEATHERTYPEDUST, false, true, 10, 30, 500, -200, 200);
	StartWeather(0);

	if (!ACS_NamedExecute("FrozenDebug", 0))
	{
		LogError("Failed to invoke FrozenDebug");
	}
}

