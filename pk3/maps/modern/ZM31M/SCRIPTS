    internal void SyncEvent()
    {
        VALIDATE_IS_SERVERSIDE_FUNCTION();

        if (!IsNetworkGame())
            return;

        BCSUtils::SyncVariable(SYNC_EVENT, _eventState);
        BCSUtils::SyncVariable(SYNC_EVENT + 1, _eventStartTimestamp);

        ACS_NamedExecuteAlways("SyncEvent_Client", 0);
    }

    script "SyncEvent_Client" clientside
    {
        ClientSyncEvent();
    }

    // Called clientside to fetch the synced state.
    internal void ClientSyncEvent()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION();

        if (!IsNetworkGame())
            return;

        _eventState = BCSUtils::GetSyncVarDefault(SYNC_EVENT, EVENTSTATE_NONE);
        _eventStartTimestamp = BCSUtils::GetSyncVarDefault(SYNC_EVENT + 1, 0);

        Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced event state client: ", d:_eventState, s:", event start timestamp: ", d:_eventStartTimestamp));
    }

