    internal void TemperatureTickClient()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION();

        if (Round::GetGameIsEnding())
            return;

        if (Player::GetIsZombie())
            return;

        // Client is in water
        bool inWater = BCSutils::GetActorWaterLevel(ActivatorTID()) > 0;
        if (GetIsCold() && inWater)
        {
            SetHudSize(640, 480, false);
            SetFont("smallfont");
            HudMessage(s:"Watch out! The water is incredibly cold, get out!"; HUDMSG_FADEOUT, HUDID_INTERACTION + 1, CR_YELLOW, 320.0, 400.0, 5.0, 0.6, 0.6);
        }

        // Inform client to get warm
        else if (GetIsCold() && NightHasFallen())
        {
            SetHudSize(640, 480, false);
            SetFont("smallfont");
            HudMessage(s:"Caution! It is very cold at night, get somewhere warm!"; HUDMSG_FADEOUT, HUDID_INTERACTION + 1, CR_YELLOW, 320.0, 400.0, 5.0, 0.6, 0.6);
        }

        // Explain the temperature system once when we go below maximum temperature.
        if (!_hasExplainedTemperature && GetTemperature() < TEMPERATURE_MAX)
        {
            _hasExplainedTemperature = true;

            setFont("smallfont");
            SetHudSize(640, 480, FALSE);
            HudMessage(s:"Careful, this place is freezing!"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 360.0, 5.0, 1.0, 5.0);
            HudMessage(s:"Either stay inside, or make sure you find warm places."; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 370.0, 5.0, 1.0, 5.0);
            HudMessage(s:"Keep your body temperature above \cf28 degrees \cjat all times."; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 380.0, 5.0, 1.0, 5.0);
        }

        SetHudSize(480, 480, false);
        DrawFrostScreen(240.0, 240.0, HUDID_TEMPERATURE);
    }

    internal raw OnDrawTemperatureGaugeHud(void[]* data)
    {
        if (data == null)
            return 0;

        _hudHookDataRef = data;

        if (_hudHookDataRef.Type != Hud::HUDHOOK_PLAYERSTATUS)
            return 0;

        if (GetIsInBunker())
            return 0;

        if (Player::GetIsZombie())
            return 0;

        Hud::SetRelativePoint(160.0, -100.0);
        BCSUtils::HudDrawImage(HUDID_TEMPERATURE + 4, "TEMPICON");

        int temperature = GetTemperature();

        // Flicker effect for the value.
        if (temperature == 0 && Timer() % 10 >= 5)
            return 0;

        int color = temperature > 5
            ? CR_WHITE
            : temperature > 3
                ? CR_YELLOW
                : CR_RED;

        Hud::SetRelativePoint(176.0, -105.0);
        BCSUtils::HudSetFont("smallfont");
        BCSUtils::HudSetTextColor(color);
        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_RIGHT, BCSUtils::HUD_ALIGN_TOP);
        BCSUtils::HudDrawText(HUDID_TEMPERATURE + 5, str((int)(temperature + TEMPERATURE_BASE)));
        return 0;
    }

    internal void DrawFrostScreen(fixed x, fixed y, int id)
    {
        // The values at which the graphics are going to be displayed.
        static int frostGraphicValues[4] = {
            7, 5, 3, 1
        };

        // Update every three tics.
        if (Timer() % 3 != 0)
            return;

        int temperature = GetTemperature();

        // Determine graphic.
        int graphicIndex = 0;
        for (int i = lengthof(frostGraphicValues) - 1; i >= 0; --i)
        {
            if (temperature > frostGraphicValues[i])
                continue;

            graphicIndex = i + 1;
            break;
        }

        // Always show the last graphic if outside at night or in water.
        bool inWater = BCSUtils::GetActorWaterLevel(ActivatorTID()) > 0;
        if (GetIsCold() && (NightHasFallen() || inWater))
            graphicIndex = 4;

        if (graphicIndex == 0)
            return;

        SetFont(StrParam(s:"FROSTSC", d:graphicIndex));
        HudMessage(s:"a"; HUDMSG_FADEINOUT | HUDMSG_ADDBLEND, 0, CR_UNTRANSLATED, 240.0, 240.0, 0.0, 0.5, 0.1);
    }

