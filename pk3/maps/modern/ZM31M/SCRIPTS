** -----------------------------------------------------------------------------
** EVENTS - Night
** -----------------------------------------------------------------------------
*/

// Return true if night has fallen.
function bool NightHasFallen(void)
{
	return eventState == EVENTSTATE_NIGHT
		&& nightModeStartTimestamp < Utils::GetSynchronizedTimer();
}

// Nighttime event
Script "Events_Night" (void)
{
