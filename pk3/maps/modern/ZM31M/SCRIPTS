    // Trigger the player as outside / inside an elevator
    script "TogglePlayerElevatorId" (int elevatorId)
    {
        bool entersElevator = LineSide() == LINE_FRONT;
        if (entersElevator)
        {
            Logger::LogDebug(LOGSOURCE, StrParam(s:"Player ", n:0, s:" has entered elevator ", d:elevatorId));

            UnsetPlayerIsAtElevatorDoors(PlayerNumber());
            SetPlayerIsInElevator(PlayerNumber(), elevatorId);

            terminate;
        }

        Logger::LogDebug(LOGSOURCE, StrParam(s:"Player ", n:0, s:" has exited the elevator"));

        UnsetPlayerIsInElevator(PlayerNumber());
        SetPlayerIsAtElevatorDoors(PlayerNumber(), elevatorId);
    }

    script "TogglePlayerAtElevatorDoorsId" (int elevatorId)
    {
        bool entersElevator = LineSide() == LINE_FRONT;
        if (entersElevator)
        {
            SetPlayerIsAtElevatorDoors(PlayerNumber(), elevatorId);
            terminate;
        }

        UnsetPlayerIsAtElevatorDoors(PlayerNumber());
    }

    // Main elevator logic. Parameters indicate pressed elevator id, target elevator id, and wether the button inside the elevator was pressed.
    script "ElevatorLogic" (int elevatorId, int targetElevatorId, int pressedInside)
    {
        bool isInBunker = _elevatorData[elevatorId].IsInBunker;
        bool targetIsInBunker = _elevatorData[targetElevatorId].IsInBunker;

        // Checks should never prevent players from getting out of an elevator.
        if (!pressedInside)
        {
            // Can't do this one, because then players can just hide in the elevator forever.
            //if(Player::GetIsZombie())
            //{
            //    Chat::SendSelfActivator("Brainz...?");
            //    terminate;
            //}

            // These checks have all also been moved downwards to make sure the doors can open after the nuke to avoid camping.
            //if(NukeHasDropped())
            //{
            //    Logger::LogActivator("The lift circuits are fried by the nuke. The elevator can not be used.");
            //    terminate;
            //}

            //if (isInBunker && _eventState == EVENTSTATE_NUKE)
            //{
            //    Logger::LogActivator("Don't go back up! You're safe down here from the nuke.");
            //    terminate;
            //}

            if(!_labUnlocked)
            {
                Logger::LogActivator("The lifts have been locked down for quarantine.");
                terminate;
            }
        }

        if(_elevatorInUse[elevatorId])
        {
            Logger::LogActivator("The elevator is currently in use.");
            terminate;
        }

        int id = PlayerNumber();
        SetActivator(-1);

        // Elevator is now in use
        _elevatorInUse[elevatorId] = true;
        _elevatorInUse[targetElevatorId] = true;

        // Elevator sound.
        int dingSoundTag = _elevatorData[elevatorId].DingSoundAndSourceTeleportTag;
        ThingSound(dingSoundTag, "sound/ding1", 127);
        Delay(35);

        Logger::LogDebug(LOGSOURCE, StrParam(s:"Start elevator logic. Elevator id: ", d:elevatorId, s:", target elevatorId: ", d:targetElevatorId));

        // Open doors.
        int polyRightTag = _elevatorData[elevatorId].PolyTagRight;
        int polyLeftTag = polyRightTag++;
        int polyRightAngle = _elevatorData[elevatorId].PolyRightAngle;
        int polyLeftAngle = polyRightAngle + 128;
        Polyobj_OR_Move(polyRightTag, 5, polyRightAngle, 32);
        Polyobj_OR_Move(polyLeftTag, 5, polyLeftAngle, 32);
        PolyWait(polyRightTag);
        PolyWait(polyLeftTag);

        Delay(35*4);

        Polyobj_OR_Move(polyRightTag, 5, polyLeftAngle, 32);
        Polyobj_OR_Move(polyLeftTag, 5, polyRightAngle, 32);

        ACS_NamedExecuteAlways("CrushPlayersBetweenDoors", 0, elevatorId);

        // Stop here if we pressed from the inside.
        if (pressedInside)
        {
            delay(35);

            _elevatorInUse[elevatorId] = false;
            _elevatorInUse[targetElevatorId] = false;
            terminate;
        }

        // To avoid the elevators not working because people block it, we should not wait for these to close.
        //PolyWait(polyRightTag);
        //PolyWait(polyLeftTag);

        delay(35 * 2);

        // Check if elevator or target elevator have occupands.
        if (!GetElevatorHasOccupands(elevatorId) && !GetElevatorHasOccupands(targetElevatorId))
        {
            _elevatorInUse[elevatorId] = false;
            _elevatorInUse[targetElevatorId] = false;
            terminate;
        }

        // Can't use the elevator after the nuke has blow over.
        if(NukeHasBlownOver() && isInBunker)
        {
            for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
            {
                if (!PlayerInGame(i) || !GetPlayerIsInElevator(i, elevatorId))
                    continue;

                Logger::LogTo(i, "The elevator does not respond. The nuke must have fried its circuits.");
            }

            _elevatorInUse[elevatorId] = false;
            _elevatorInUse[targetElevatorId] = false;
            terminate;
        }

        // Remaining logic to move the elevators on both sides.
        ACS_NamedExecuteAlways("ElevatorLogic2", 0, elevatorId, targetElevatorId);
        ACS_NamedExecuteAlways("ElevatorLogic2", 0, targetElevatorId, elevatorId);

        // This must match the inner delay in ElevatorLogic2
        delay(35 * 8);

        // Failsafe, anybody that just took the elevator going outside the bunker will die when the nuke dropped.
        if (NukeHasBlownOver())
        {
            int killElevatorId = isInBunker ? elevatorId : targetElevatorId;
            for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
            {
                if (!PlayerInGame(i) || !GetPlayerIsInElevator(i, killElevatorId))
                    continue;

                Game::KillPlayer(i, MOD_EXIT);
            }
        }

        // Set occupands in the elevator as in/outside the bunker
        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            if (PlayerInGame(i) && GetPlayerIsInElevator(i, elevatorId))
                SetPlayerIsInBunker(i, targetIsInBunker);

            else if (PlayerInGame(i) && GetPlayerIsInElevator(i, targetElevatorId))
                SetPlayerIsInBunker(i, isInBunker);
        }

        // Switch players into the new elevator
        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            if (GetPlayerIsInElevator(i, elevatorId))
                SetPlayerIsInElevator(i, targetElevatorId);
            else if (GetPlayerIsInElevator(i, targetElevatorId))
                SetPlayerIsInElevator(i, elevatorId);
        }

        // Remaining time to close the doors, plus 1 second to close them fully.
        delay(35 * 4 + 35);

        // Elevators no longer in use.
        _elevatorInUse[elevatorId] = false;
        _elevatorInUse[targetElevatorId] = false;
    }

    script "ElevatorLogic2" (int elevatorId, int targetElevatorId)
    {
        // Move to a temporary room.
        int sourceTag = _elevatorData[elevatorId].DingSoundAndSourceTeleportTag;
        int sourceSectorTag = _elevatorData[elevatorId].SourceSectorTag;
        int tempDestTag = _elevatorData[elevatorId].TempTargetTeleportTag;
        int tempDestSectorTag = _elevatorData[elevatorId].TempTargetSectorTag;
        int destTag = _elevatorData[elevatorId].TargetTeleportTag;
        delay(35*3);

        // Move all players in the elevator to the new one.
        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            if (GetPlayerIsInElevator(i, elevatorId))
                TeleportInSector(sourceSectorTag, sourceTag, tempDestTag, 0, Identity::GetTid(i));
        }

        PlaySound(tempDestTag, "sound/lift1", CHAN_AUTO, 1.0);
        delay(35*5);

        // Move all players from the temporary elevator to the final one.
        // This one doesn't need a special check since we're in a temporary room anyway.
        TeleportInSector(tempDestSectorTag, tempDestTag, destTag, 0);

        ThingSound(destTag, "sound/ding1", 127);

        // Open doors.
        int polyRightTag = _elevatorData[targetElevatorId].PolyTagRight;
        int polyLeftTag = polyRightTag++;
        int polyRightAngle = _elevatorData[targetElevatorId].PolyRightAngle;
        int polyLeftAngle = polyRightAngle + 128;
        Polyobj_OR_Move(polyRightTag, 5, polyRightAngle, 32);
        Polyobj_OR_Move(polyLeftTag, 5, polyLeftAngle, 32);
        PolyWait(polyRightTag);
        PolyWait(polyLeftTag);

        Delay(35*4);

        Polyobj_OR_Move(polyRightTag, 5, polyLeftAngle, 32);
        Polyobj_OR_Move(polyLeftTag, 5, polyRightAngle, 32);

        ACS_NamedExecuteAlways("CrushPlayersBetweenDoors", 0, elevatorId);

        // Don't wait here either, doors will properly reopen if recalled anyway.
        //PolyWait(polyRightTag);
        //PolyWait(polyLeftTag);
    }

    script "CrushPlayersBetweenDoors"(int elevatorId)
    {
        Delay(35);

        int angle = _elevatorData[elevatorId].CrushThrustAngle;
        for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
        {
            if (!PlayerInGame(i) || !GetPlayerIsAtElevatorDoors(i, elevatorId))
                continue;

            int tid = Identity::GetTid(i);
            Thing_Damage(tid, 20, MOD_CRUSH);
            ThrustThing(angle, 10, 0, tid);
            Logger::LogTo(i, "You got crushed by the elevator doors, careful!");
        }
    }

