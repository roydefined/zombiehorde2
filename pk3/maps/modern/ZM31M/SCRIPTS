Script "Events_Night_client" (void) clientside
{
	int fadeValue  = 156,
		colorValue = 255;

	setFont("bigfont");
	SetHudSize(640, 480, FALSE);
    HudMessage(s:"Night approaches"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 100.0, 5.0, 1.0, 5.0);

	delay(35 * 3);
	Music::SetDefaultMusic("");
    Music::PlayDefaultMusic();
	delay(35 * 8);

	while (--fadeValue > 20 && --colorValue)
	{
		if (fadeValue < 30 && Player::GetPlayerIsHuman(ConsolePlayerNumber()))
		{
			SetHudSize(640, 480, FALSE);
			HudMessage(s:"As the night approaches"; HUDMSG_TYPEON, 0, CR_WHITE, 320.0, 93.0, 3.0, 0.04, 1.0);
			HudMessage(s:"it suddenly becomes very, very cold..."; HUDMSG_TYPEON, 0, CR_WHITE, 320.0, 107.0, 2.5, 0.04, 1.0);
		}

		SetLevelAtmosphere(fadeValue, colorValue, colorValue);
        delay(5);
    }

	Music::SetDefaultMusic("SUBZERO");
    Music::PlayDefaultMusic();
}

function void SyncNightModeTimestamp(void)
{
	if (!BCSUtils::IsServer()) {
		Logger::LogError(LOGSOURCE, "SyncNightModeTimestamp was called clientside.");
		return;
	}

	if (!IsNetworkGame()) {
		return;
	}

	BCSUtils::SyncVariable(SYNC_NIGHTTIMESTAMP, nightModeStartTimestamp);
	if (!ACS_NamedExecuteAlways("ClientSyncNightModeTimestamp_Client", 0)) {
		Logger::LogError(LOGSOURCE, "Failed to execute ClientSyncNightModeTimestamp_Client.");
	}
}

script "ClientSyncNightModeTimestamp_Client" (void) clientside
{
	ClientSyncNightModeTimestamp();
}

function void ClientSyncNightModeTimestamp(void)
{
	if (!BCSUtils::IsClient()) {
		Logger::LogError(LOGSOURCE, "ClientSyncNightModeStartTimestamp was called serverside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	int timeStamp = BCSUtils::GetSyncVarDefault(SYNC_NIGHTTIMESTAMP, 0);
	nightModeStartTimestamp = timeStamp;

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced night mode time stamp: ", d:nightModeStartTimestamp));
}

