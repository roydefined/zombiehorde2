    internal void SetLevelAtmosphere (int fade, int color1, int color2)
    {
        static int colorTags[] =
        {
            0, 1, 3, 5, 6, 10, 36,
            25, 26, 27, 28, 29
        };

        // General relevant map geometry.
        for(int i = 0; i < lengthof(colorTags); ++i)
        {
            sector_setfade(colorTags[i], fade, fade, fade);
            sector_setcolor(colorTags[i], color1, color2, color2);
        }

        // Boundary rocks.
        for (int i = 0; i < lengthof(_nukeBoundaryRocks); ++i)
        {
            sector_setfade(_nukeBoundaryRocks[i].SectorTag, fade, fade, fade);
            sector_setcolor(_nukeBoundaryRocks[i].SectorTag, color1, color2, color2);
        }
    }

    Script "OnOpen" open
    {
        // Red key card spawner
        spawnspot(KEY_RED_KEYCARD, random(10, 16));

        // The underground water stream
        scroll_floor(4, 0, 100, CARRY);
        scroll_ceiling(5, 0, 150, SCROLL);

        // Holy cross room
        sector_setfade(14, 0, 255, 0);
        sector_setcolor(14, 255, 200, 255);
        sector_setfade(15, 0, 255, 0);
        sector_setcolor(15, 255, 200, 255);

        // Skybox
        scroll_floor(48, 1, 10, 0);
        scroll_floor(49, 3, 5, 0);

        // Reset nuke boundaries to display snow.
        for (int i = 0; i < lengthof(_nukeBoundaryRocks); ++i)
        {
            int sectorTag = _nukeBoundaryRocks[i].SectorTag;
            Floor_MoveToValue(sectorTag, 999, 0);
            ChangeFloor(sectorTag, "SNOW");
        }

        ACS_NamedExecute("TemperatureLoop", 0);

        int gameTime = GetCvar("sv_zh2_zm31meventtics");
        while (--gameTime)
            delay(1);

        // Events. In case of random pick:
        // - Night: 2/6
        // - Nuke:  1/6
        // - Nothing: 3/6
        int eventIndex = GetCVar("sv_zh2_zm31mevent");
        if (eventIndex == 0)
        {
            int chance = Random(0, 5);
            switch(chance)
            {
                case 0:
                case 1:
                    eventIndex = 2;
                    break;
                case 2:
                    eventIndex = 3;
                    break;
                default:
                    eventIndex = 1;
                    break;
            }
        }

        str event;
        switch(eventIndex)
        {
            case 2: event = "Event_Night"; break;
            case 3: event = "Event_Nuke"; break;
            default: return;
        }

        if (!ACS_NamedExecute(event, 0))
            Logger::LogError(LOGSOURCE, StrParam(s:"Failed to call script ", s:event, s:"."));
    }

    Script "OnOpenClient" Open CLIENTSIDE
    {
        ClientSyncEvent();

        Hook::Register(Hook::HOOK_CLIENTDRAWHUD, OnDrawTemperatureGaugeHud);

        // Atmosphere and music depends on current events.
        // If clients join later and an event has triggered, this ensures the atmosphere and music is correct.
        // FYI, if the event JUST started, they still don't get the correct data since they didn't trigger the script.
        // These checks ensure everything works.
        if (_eventState == EVENTSTATE_NONE)
        {
            Music::SetDefaultMusic("PSXMUS05");
            Music::PlayDefaultMusic();

            SetLevelAtmosphere(156, 255, 255);
        }
        else if (_eventState == EVENTSTATE_NIGHT)
        {
            Music::SetDefaultMusic("SUBZERO");
            Music::PlayDefaultMusic();

            SetLevelAtmosphere(20, 120, 120);
        }
        else
        {
            Music::SetDefaultMusic("DISPOSAL");
            Music::PlayDefaultMusic();

            SetLevelAtmosphere(10, 255, 10);
            SpawnSpot("ZH2ZM31MNuke", 6);
            ChangeFloor(48, "-");
            ChangeFloor(49, "-");

            // Nuke wind
            Thing_Activate(57);
        }

        ACS_NamedExecute("FrozenDebug", 0);
    }

