    // Mark the player as inside/outside depending on lineside.
    script "SetPlayerWarm"
    {
        SetIsCold(LineSide() != LINE_FRONT);
    }

    // Main loop of the temperature system.
    // This script handles the behavior of the temperature timer and ensures it increments/decrements.
    script "TemperatureLoop"
    {
        while(true)
        {
            for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
            {
                int tid = Identity::GetTid(i);

                if (!BCSUtils::ActorIsAlive(tid) || Player::GetPlayerIsZombie(i) || Round::GetGameIsEnding())
                    continue;

                int temperature = GetPlayerTemperature(i);
                bool isCold = GetPlayerIsCold(i);
                bool isInWater = BCSUtils::GetActorWaterLevel(tid) > 0;

                // Hurt the player every 5 tics if they are at minimum temperature.
                if (temperature == 0 && isCold)
                {
                    if (!_firstDamageTic[i])
                    {
                        _firstDamageTic[i] = true;
                        Logger::LogTo(i, "You are freezing to death! Seek shelter.");
                    }

                    if (Timer() % 5 == 0)
                        Thing_damage2(tid, 1, "silent");

                    continue;
                }

                _firstDamageTic[i] = false;

                // Check if the next tic passed.
                if (GetPlayerNextTemperatureTic(i) > Timer())
                    continue;

                // Change temperature if the player's situation is the same.
                if (_isColdLast[i] == isCold)
                {
                    temperature += isCold ? -1 : 1;
                    temperature = BCSUtils::clamp(temperature, 0, TEMPERATURE_MAX);
                    SetPlayerTemperature(i, temperature);
                }

                int nextTic;
                if (!isCold) nextTic = TEMPERATURE_TIC_WARM;
                else if (isInWater) nextTic = TEMPERATURE_TIC_WATER;
                else if (NightHasFallen()) nextTic = TEMPERATURE_TIC_NIGHT;
                else nextTic = TEMPERATURE_TIC_NORMAL;

                SetPlayerNextTemperatureTic(i, Timer() + nextTic);
                _isColdLast[i] = isCold;
            }

            Delay(const: 1);
        }
    }

