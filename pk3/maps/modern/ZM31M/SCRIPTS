    // Handle damaging players that are in the toxic room, and are not protected.
    script "ToxicRoomTrigger"
    {
        bool toxicLineSide = LineSide() == LINE_FRONT;
        _inToxicRoom[PlayerNumber()] = toxicLineSide;

        while (_inToxicRoom[PlayerNumber()])
        {
            if (!CheckInventory("ZH2ZM31MIronFeet")
                && Player::GetIsHuman()
                && Timer() % 2 == 0)
            {
                Thing_damage2(ActivatorTID(), 1, "silent");
            }

            delay(const: 1);
        }
    }

