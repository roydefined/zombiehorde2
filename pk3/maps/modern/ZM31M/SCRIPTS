// Mark the player as inside/outside depending on lineside.
script "SetPlayerWarm" (void) {

	bool warm = LineSide() == LINE_FRONT;
    isWarm[PlayerNumber()] = warm;
	SynchronizeWarm(warm);
}

function bool GetIsWarm(int playerId)
{
	return isWarm[playerId];
}

// Main loop, runs on each client.
// This script handles the behavior of the temperature timer and ensures it increments/decrements.
script "TemperatureLoop" (void)
{
	int nextTemperatureTic = Timer() + TEMPERATURE_TIC_NORMAL;
	bool lastTicWarm = false;
	bool firstDamageTic = false;

	// Sync initial value. Also keep track of last value for synchronization.
	int temperature = TEMPERATURE_MAX;
	int lastTemperature = TEMPERATURE_MAX;
	SynchronizeTemperature(temperature);

	while(BCSUtils::IsAlive())
	{
		// Game ended.
		if (Round::GetGameIsEnding())
		{
			Delay(const: 1);
			continue;
		}

		// Zombies are not affected by the temperature.
		// Make sure the temperature is reset.
		if (Player::GetIsZombie()) {

			if (temperature != TEMPERATURE_MAX) {
				temperature = TEMPERATURE_MAX;
				SynchronizeTemperature(temperature);
			}

			Delay(const: 1);
			continue;
		}

		bool warm = GetIsWarm(PlayerNumber());
		bool inWater = BCSUtils::GetActorWaterLevel(ActivatorTID()) > 0;

		// Hurt the player every 5 tics if they are at minimum temperature.
		if (temperature == TEMPERATURE_MIN && !warm)
		{
			if (!firstDamageTic) {
				firstDamageTic = true;
				Logger::LogActivator("You are freezing to death! Seek shelter.");
			}

			if (Timer() % 5 == 0) {
				Thing_damage2(ActivatorTID(), 1, "silent");
			}

			Delay(const: 1);
			continue;
		}

		firstDamageTic = false;

		// Check if the next tic passed.
		if (nextTemperatureTic > Timer()) {
			Delay(const: 1);
			continue;
		}

		// If the player's situation changed and they changed inside state, ignore the changes in the next tic.
		if (lastTicWarm == warm)
		{
			// If the player is inside, add temperature. Otherwise take it.
			temperature += BCSUtils::cond(warm, 1, -1);
			temperature = BCSUtils::clamp(temperature, TEMPERATURE_MIN, TEMPERATURE_MAX);

			if (temperature != lastTemperature)
			{
				SynchronizeTemperature(temperature);
			}
		}

		// Determine next tic to check based on the player's state.
		// If outside at night, the next tic happens quicker.
		int addedTics = BCSUtils::cond(warm,
			TEMPERATURE_TIC_WARM,
			BCSUtils::cond(inWater,
				TEMPERATURE_TIC_WATER, BCSUtils::cond(NightHasFallen(),
					TEMPERATURE_TIC_NIGHT, TEMPERATURE_TIC_NORMAL)));

		nextTemperatureTic = Timer() + addedTics;
		lastTicWarm = warm;
		lastTemperature = temperature;
		Delay(const: 1);
	}
}

function void SynchronizeTemperature(int amount)
{
	if (!NamedExecuteClientScript("TemperatureSync", PlayerNumber(), amount)) {
		Logger::LogError(LOGSOURCE, StrParam(s:"Failed to call script TemperatureSync."));
	}
}

function void SynchronizeWarm(int warm)
{
	if (!NamedExecuteClientScript("WarmSync", PlayerNumber(), warm)) {
		Logger::LogError(LOGSOURCE, StrParam(s:"Failed to call script WarmSync."));
	}
}

