// For debugging.
script "FrozenDebug" (void) CLIENTSIDE
{
	if (!IsDevelopment())
	{
		terminate;
	}

	while(true)
	{
		if (GetUserCVar(ConsolePlayerNumber(), "zm20debug") == 0)
		{
			Delay(const: 1);
			continue;
		}

		SetHudSize(640, 480, FALSE);
		SetFont("smallfont");

		str currentEvent = cond(eventState == EVENTSTATE_NONE, "none",
			cond(eventState == EVENTSTATE_NIGHT, "night",
				"nuke"));

		int nightFallsIn = cond(eventState == EVENTSTATE_NIGHT, nightModeStartTimestamp - Timer(), 0);
		str nightFallen = cond(NightHasFallen(), "true", "false");

		int nukeExplosionIn = cond(eventState == EVENTSTATE_NUKE, nukeExplosionTimestamp - Timer(), 0);

		str warm = cond(consoleClientIsWarm, "true", "false");
		str inBunker = cond(consoleClientIsInBunker, "true", "false");

		HudMessage(s:"Current event: ", s:currentEvent; HUDMSG_PLAIN, 0, CR_WHITE, 20.1, 45.0, 0.03);

		HudMessage(s:"Night falls in: ", d:nightFallsIn; HUDMSG_PLAIN, 0, CR_WHITE, 20.1, 60.0, 0.03);
		HudMessage(s:"Night has fallen: ", s:nightFallen; HUDMSG_PLAIN, 0, CR_WHITE, 20.1, 70.0, 0.03);

		HudMessage(s:"Nuke explosion in: ", d:nukeExplosionIn; HUDMSG_PLAIN, 0, CR_WHITE, 20.1, 85.0, 0.03);

		HudMessage(s:"Is warm: ", s:warm; HUDMSG_PLAIN, 0, CR_WHITE, 20.1, 100.0, 0.03);
		HudMessage(s:"Is in bunker: ", s:inBunker; HUDMSG_PLAIN, 0, CR_WHITE, 20.1, 110.0, 0.03);
		Delay(const: 1);
	}
}

