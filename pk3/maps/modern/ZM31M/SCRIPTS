function void TemperatureTickClient(void)
{
	if (IsServerOnly()) {
		LogError("TemperatureTickClient must be called clientside.");
		return;
	}

	// Game ended.
	if (GetGameState() > statePlaying) {
		return;
	}

	// The temperature does not exist on zombies.
	if (IsZombie()) {
		return;
	}


	int x = GetHudX(),
		xLeft = GetHudLeftX(),
	    xRight = GetHudRightX(),
	    y = GetHudY();

	// Client is in water
	bool inWater = GetActorWaterLevel(ActivatorTID()) > 0;
	if (!consoleClientIsWarm && inWater)
	{
		SetHudSize(640, 480, false);
		SetFont("smallfont");
		HudMessage(s:"Watch out! The water is incredibly cold, get out!"; HUDMSG_FADEOUT, HUDID_INTERACTION + 1, CR_YELLOW, 320.0, 400.0, 5.0, 0.6, 0.6);
	}

	// Inform client to get warm
	else if (!consoleClientIsWarm && NightHasFallen())
	{
		SetHudSize(640, 480, false);
		SetFont("smallfont");
		HudMessage(s:"Caution! It is very cold at night, get somewhere warm!"; HUDMSG_FADEOUT, HUDID_INTERACTION + 1, CR_YELLOW, 320.0, 400.0, 5.0, 0.6, 0.6);
	}

	SetHudSize(480, 480, 0);
	DrawFrostScreen(240.0, 240.0, HUDID_TEMPERATURE);

	if (!HudEnabledZH()) {
		return;
	}

	SetHudResolution();
	DrawTemperatureValue(consoleClientTemperature, xLeft - 55.0, y - 95.0, HUDID_TEMPERATURE + 4);
	DrawTemperatureGauge(xLeft - 55.0, y - 95.0, HUDID_TEMPERATURE + 5);
}

function void DrawFrostScreen(int x, int y, int id)
{
	// The values at which the graphics are going to be displayed.
	static int frostGraphicValues[4] = {
		35, 33, 31, 29
	};

	// Update every three tics.
	if (Timer() % 3 != 0) {
		return;
	}

	// Determine graphic.
	int graphicIndex = 0;
	for (int i = 3; i >= 0; --i)
	{
		if (consoleClientTemperature > frostGraphicValues[i]) {
			continue;
		}

		graphicIndex = i + 1;
		break;
	}

	// Always show the last graphic if outside at night or in water.
	bool inWater = GetActorWaterLevel(ActivatorTID()) > 0;
	if (!consoleClientIsWarm && (NightHasFallen() || inWater)) {
		graphicIndex = 4;
	}

	if (graphicIndex == 0) {
		return;
	}

}

