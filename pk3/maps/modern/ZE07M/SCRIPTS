    function void ResistMessage (int restime)
    {
        SetFont("BIGFONT");
        HudMessageBold(s:"Resist for \cJ", d:restime, s:" \cGseconds"; HUDMSG_FADEOUT, 999, CR_RED, 0.5, 0.2, 0.5, 0.5);
    }

    function void ResistMessage4 (int restime, str whyresist) // PURPLE
    {
        SetFont("BIGFONT");
        HudMessageBold(s:"\cTResist for \cJ", d:restime, s:" \cTseconds"; HUDMSG_FADEOUT, 999, CR_RED, 0.5, 0.2, 0.5, 0.5);
        SetFont("SMALLFONT");
        HudMessageBold(s:whyresist; HUDMSG_FADEOUT, 998, CR_WHITE, 0.5, 0.17, 1.5, 0.5);
    }


