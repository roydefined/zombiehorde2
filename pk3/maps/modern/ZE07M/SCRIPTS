    Script 3 (int who) // Drowning
    {
        SetActivator(Identity::GetTid(who));
        Delay(35*2);
        FadeTo(0, 0, 128, 1.0, 0.5);
        Delay(18);
        LocalAmbientSound("sound/drowning1", 127);
        Game::Kill(MOD_WATER);
        FadeTo(0, 0, 128, 0.0, 0.5);
    }

