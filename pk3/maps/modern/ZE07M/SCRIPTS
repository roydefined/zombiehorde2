    Script 02 (void)
    {
        SetFont("CONFONT");
        HudMessageBold(n:0, s:" \cGhas reached the rescue point!\nSecure the place until the helicopter flies!";
                HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 3.0, 2.0);

        SetActivator(-1);
        Thing_Remove(1);
        Delay(35*5);

        for(int k = resist3; k > 0; k--)
        {
            ResistMessage4(k, "The Helicopter is going to fly");
            Delay(35);
        }

        Delay(15*5);

        SetLineBlocking(21, BLOCK_PLAYERS);
        Floor_RaiseByValue(30, 8, 256);
        Ceiling_RaiseByValue(30, 8, 256);

        Delay(35*5);

        SetFont("BIGFONT");
        HudMessageBold(s:"\cGWarning : \cKThe Island will collapse!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);

        Delay(15*3);

        for(int k = 0; k < BCSUtils::MAX_PLAYERS; k++)
        {
            if(PlayerInGame(k) && !Game::GetPlayerIsSafe(k))
