    script "pre_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            case 1:
            {
                Floor_LowerByValue(57, 255, 32);
                break;
            }

            case 4:
            {
                SetFont("CONFONT");
                HudMessageBold(n:0, s:" \cGhas reached the rescue point!\nSecure the place until the helicopter flies!";
                        HUDMSG_FADEOUT, 0, CR_RED, 0.05, 0.85, 3.0, 2.0);

                SetActivator(-1);
                Thing_Remove(1);
                Delay(35*5);
                break;
            }
        }
    }

    script "post_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            case 0:
            {
                Door_Open(53, 32);
                ACS_NamedExecute("resist0_door_open", 0);
                break;
            }

            case 1:
            {
                Door_Open(54, 32);
                break;
            }

            case 2:
            {
                Door_Open(55, 32);
                break;
            }

            case 3:
            {
                SetLineBlocking(58, BLOCK_NOTHING);
                Floor_LowerByValue(56, 32, 112);
                break;
            }

            case 4:
            {
                Delay(15*5);

                SetLineBlocking(21, BLOCK_PLAYERS);
                Floor_RaiseByValue(30, 8, 256);
                Ceiling_RaiseByValue(30, 8, 256);

                Delay(35*5);

                SetFont("BIGFONT");
                HudMessageBold(s:"\cGWarning : \cKThe Island will collapse!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);

                Delay(15*3);

                for(int k = 0; k < BCSUtils::MAX_PLAYERS; k++)
                {
                    if(PlayerInGame(k) && !Game::GetPlayerIsSafe(k))
                        Acs_ExecuteAlways(3, 0, k, 0, 0);
                }

                Delay(35 * 2 + 18);

                Sector_SetDamage(00, 10000, 12);
                Sector_SetDamage(01, 10000, 12);
                Sector_SetDamage(02, 10000, 12);
                Sector_SetDamage(03, 10000, 12);
                Sector_SetDamage(04, 10000, 12);
                Sector_SetDamage(05, 10000, 12);
                Sector_SetDamage(06, 10000, 12);
                Sector_SetDamage(07, 10000, 12);
                Sector_SetDamage(08, 10000, 12);
                Sector_SetDamage(09, 10000, 12);
                Sector_SetDamage(10, 10000, 12);
                Sector_SetDamage(11, 10000, 12);
                Sector_SetDamage(12, 10000, 12);
                Sector_SetDamage(13, 10000, 12);
                Sector_SetDamage(14, 10000, 12);
                Sector_SetDamage(15, 10000, 12);
                Sector_SetDamage(16, 10000, 12);
                Sector_SetDamage(17, 10000, 12);
                Sector_SetDamage(18, 10000, 12);
                Sector_SetDamage(19, 10000, 12);
                Sector_SetDamage(20, 10000, 12);
                Sector_SetDamage(21, 10000, 12);
                Sector_SetDamage(22, 10000, 12);
                Sector_SetDamage(23, 10000, 12);
                Sector_SetDamage(24, 10000, 12);
