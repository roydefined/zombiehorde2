    // General hudmessage prepare used for all messages.
    internal void PrepareDeloreanMessage(fixed offsetY = 0.0)
    {
        BCSUtils::HudResetState();
        BCSUtils::HudSetVirtualSize(640.0, 480.0);
        BCSUtils::HudSetStayTime(BCSUtils::HUDTIC);
        BCSUtils::HudSetAlignment(BCSUtils::HUD_ALIGN_CENTER, BCSUtils::HUD_ALIGN_BOTTOM);

        BCSUtils::HudSetTextColor(CR_WHITE);
        BCSUtils::HudSetCenterText(true);

        BCSUtils::HudSetStayTime(4.0);
        BCSUtils::HudSetDisappearTime(0.5);

        BCSUtils::HudSetPoint(320.0, 100.0 + offsetY);
    }

    script "TeleportToTrain"
    {
        static bool trainReached;
        if(!trainReached)
        {
            PrepareDeloreanMessage();
            BCSUtils::HudSetShowToEveryone(true);
            BCSUtils::HudSetFont("smallfont");
            BCSUtils::HudDrawText(0, StrParam(s:BCSUtils::PlayerName(PlayerNumber()), s:" \cjhas reached the train!\nGet on the Delorean before it reaches 88mph!"));
        }

        // Humans are teleported further ahead.
        if(Player::GetIsHuman())
            TeleportUtil::TeleportAreaBetween(400, 405, 90, TeleportUtil::TELEPORT_PROFILE_TELEPORTSPOTFOG);
        else
            TeleportUtil::TeleportAreaBetween(300, 305, 90, TeleportUtil::TELEPORT_PROFILE_TELEPORTSPOTFOG);

        if(!trainReached)
        {
            trainReached = true;

            SetActivator(-1);
            Delay(35*5);
            ACS_NamedExecute("DeloreanSpeedOMeter", 0);
        }
    }

    script "DeloreanSpeedOMeter"
    {
        _deloreanSpeed = 20;
        SyncDeloreanSpeed();

        // Increase speed at different intervals depending on how fast the Delorean is going.
        While(_deloreanSpeed < 88)
        {
            int speedDelay = 40;
            if (_deloreanSpeed < 70) speedDelay = 30;
            if (_deloreanSpeed < 50) speedDelay = 20;

            _deloreanSpeed++;
            SyncDeloreanSpeed();

            Delay(speedDelay);
        }

        Delay(35);

        _deloreanSpeed = 0;
        SyncDeloreanSpeed();

        // Initial message to unsafe players.
        for(int i = 0; i < BCSUtils::MAX_PLAYERS; i++)
        {
            if (!PlayerInGame(i))
                continue;

            SetActivatorToPlayer(i);

            if(Game::GetIsSafe())
                continue;

            PrepareDeloreanMessage();
            BCSUtils::HudSetFont("bigfont");
            BCSUtils::HudDrawText(0, "Warning: Abyss right ahead!");
        }

        SetActivator(-1);
        Delay(35*2);

        // Start blocking players from getting on the delorean.
        SetLineBlocking(33, BLOCK_CREATURES);

        // For players that are safe we flash an effect clientside.
        ACS_NamedExecute("SafetyFlash", 0);

        SetActivator(-1);
        Delay(21);

        // For players that are not safe we do a camera effect.
        ACS_NamedExecute("CliffCamera", 0);

        // Start teleporting non-safe players.
        for(i = 0; i < BCSUtils::MAX_PLAYERS; i++)
        {
            if (!PlayerInGame(i))
                continue;

            SetActivatorToPlayer(i);

            // If safe
            if(Game::GetIsSafe())
            {
                if(Player::GetIsHuman())
                    TeleportUtil::TeleportArea(800, 200, TeleportUtil::TELEPORT_PROFILE_TELEPORTSPOT);
                else
                    TeleportUtil::TeleportArea(900, 200, TeleportUtil::TELEPORT_PROFILE_TELEPORTSPOT);
                continue;
            }

            // For players that are not safe.
            TeleportUtil::TeleportArea(700, 120, TeleportUtil::TELEPORT_USETELEPORTSPOTHEIGHT);
            ThrustThing(64, 100, 0, ActivatorTID());
            ThrustThingZ(ActivatorTID(), 20, 0, 0);
        }

        for(i = 0; i < BCSUtils::MAX_PLAYERS; i++)
        {
            if (!PlayerInGame(i))
                continue;

            SetActivatorToPlayer(i);

            if(!Game::GetIsSafe())
                continue;

            PrepareDeloreanMessage();
            BCSUtils::HudSetStayTime(6.0);
            BCSUtils::HudSetFont("smallfont");
            BCSUtils::HudDrawText(0, "The Delorean has passed through time...");
        }

        SetActivator(-1);
        Delay(35*2);

        for(i = 0; i < BCSUtils::MAX_PLAYERS; i++)
        {
            if (!PlayerInGame(i))
                continue;

            SetActivatorToPlayer(i);

            if(!Game::GetIsSafe())
                continue;

            PrepareDeloreanMessage(10.0);
            BCSUtils::HudSetFont("smallfont");
            BCSUtils::HudDrawText(0, "The train and its passengers have fallen over the cliff!");
        }

        Delay(35);
        Game::KillUnsafePlayers();

    }

    internal raw OnDrawDeloreanSpeedHud(void[]* data)
    {
        if (data == null)
            return 0;

        hudHookDataRef = data;

        if (hudHookDataRef.Type != Hud::HUDHOOK_PLAYERSTATUS)
            return 0;

        if (_deloreanSpeed == 0)
            return 0;

        Hud::SetRelativePoint(180.0, -100.0);
        BCSUtils::HudDrawImage(HUDID_DELOREAN, "DELOREAN");

        Hud::SetRelativePoint(200.0, -100.0);
        BCSUtils::HudSetTextColor(CR_WHITE);
        BCSUtils::HudDrawText(HUDID_DELOREAN + 1, str((int)_deloreanSpeed));

        Hud::SetRelativePoint(228.0, -100.0);
        BCSUtils::HudSetTextColor(CR_WHITE);
        BCSUtils::HudDrawText(HUDID_DELOREAN + 2, "mph");

        return 0;
    }

    script "SafetyFlash" clientside
    {
        BCSUtils::SetActivatorToConsolePlayer();

        // Camera must be on somebody that is safe.
        int tid = CheckPlayerCamera(ConsolePlayerNumber());
        if (!Identity::IsValidTid(tid))
            terminate;

        if(!Game::GetPlayerIsSafe(Identity::GetId(tid)))
            terminate;

        SetActivator(tid);

        // The player the client looks at is safe, do the effect.
        FadeTo(255, 255, 0, 1.0, 0.2);
        Delay(7);
        FadeTo(255, 255, 0, 0.0, 0.2);
        Delay(7);
        FadeTo(255, 255, 0, 1.0, 0.2);
        Delay(7);
        FadeTo(255, 255, 0, 0.0, 0.2);
    }

    script "CliffCamera" clientside
    {
        BCSUtils::SetActivatorToConsolePlayer();

        // Camera must be on somebody that is not safe.
        int tid = CheckPlayerCamera(ConsolePlayerNumber());
        if (!Identity::IsValidTid(tid))
            terminate;

        if(Game::GetPlayerIsSafe(Identity::GetId(tid)))
            terminate;

        // The player the client looks at is not safe, do the effect.
        ChangeCamera(26, 0, 0);
        delay(35 * 8);
        ChangeCamera(0, 1, 0);
    }

    // Delorean music trigger that plays on the client if the Delorean is about to teleport.
    // Runs clientside on players to avoid issues with the music cutting of prematurely.
    script "DeloreanMusicLoop" clientside
    {
        SetActivator(-1);

        // We specifically want 70mph to trigger the music to it's at the correct moment.
        // This also means late joiners won't get the music anymore.
        if (_deloreanSpeed != 70)
        {
            delay(const: 1);
            restart;
        }

        Music::PlayMusic("ROUTE3", 0);
        Delay(35*55);
        Music::PlayMusic("", 0);
    }

    internal void SyncDeloreanSpeed()
    {
        VALIDATE_IS_SERVERSIDE_FUNCTION();

        if (!IsNetworkGame())
            return;

        BCSUtils::SyncVariable(SYNC_DELOREAN, _deloreanSpeed);
        ACS_NamedExecuteAlways("SyncDeloreanSpeed_Client", 0);
    }

    script "SyncDeloreanSpeed_Client" clientside
    {
        ClientSyncDeloreanSpeed();
    }

    // Called clientside to fetch the synced state.
    internal void ClientSyncDeloreanSpeed()
    {
        VALIDATE_IS_CLIENTSIDE_FUNCTION();

        if (!IsNetworkGame())
            return;

        _deloreanSpeed = BCSUtils::GetSyncVarDefault(SYNC_DELOREAN, 0);
        Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced delorean speed to client: ", d:_deloreanSpeed, s:"."));
    }

    #undef LOGSOURCE
}
