#pragma raw include on
#pragma raw define on

#pragma pointer_space global 0

#import "zcommon.bcs"
#import "acs_source/bcsutils.acs"

#include "acs_source/zh2lib.h.acs"
#include "acs_source/zh2game.h.acs"

strict namespace
{
    // The TID that is used for synchronising the Delorean state with clients.
    #define SYNC_DELOREAN 100

    #define HUDID_DELOREAN 50

    // The current speed of the Delorean.
    // Synchronized to clients.
    // If 0, the value is not drawn on the HUD.
    internal int _deloreanSpeed = 0;

    // Used with the delorean speed-o-meter, which hooks on the HUD.
    internal Hud::HudHookDataT? hudHookDataRef;

    #define LOGSOURCE "Map"

    script "OnOpen" open
    {
        // Resists
        Resist::CreateResist(20);
        Resist::CreateResist(25);
        Resist::CreateResist(20);

        // Resist blocking lines.
        SetLineBlocking(1, BLOCK_CREATURES);
        SetLineBlocking(2, BLOCK_CREATURES);
        SetLineBlocking(7, BLOCK_CREATURES);
    }

    script "OnOpenClient" open CLIENTSIDE
    {
        ClientSyncDeloreanSpeed();

        Hook::Register(Hook::HOOK_CLIENTDRAWHUD, OnDrawDeloreanSpeedHud);

        ACS_NamedExecute("DeloreanMusicLoop", 0);
    }

    script "Resist1"
    {
        SetActivator(-1);
        Delay(Resist::StartResistByIndex(0));

        Floor_LowerByValue(9, 32, 248);
        SetLineBlocking(1, BLOCK_NOTHING);

        Delay(35*5);

        Logger::LogBold("A secondary path has opened.");
        Floor_LowerByValue(5, 32, 64);
    }

    script "Resist2"
    {
        SetActivator(-1);
        Delay(Resist::StartResistByIndex(1));
        Floor_LowerByValue(8, 16, 120);
        SetLineBlocking(2, BLOCK_NOTHING);
    }

    script "Resist3"
    {
        Delay(Resist::StartResistByIndex(2));
        Floor_LowerByValue(30, 16, 120);
        SetLineBlocking(7, BLOCK_NOTHING);

        Delay(35*5);

        Logger::LogBold("A secondary path has opened.");
        Floor_LowerByValue(15, 32, 64);
    }

    script "FellSouthSpawn"
    {
        TeleportUtil::TeleportAreaBetween(7, 9, 90, TeleportUtil::TELEPORT_PROFILE_TELEPORTSPOTFOG);
    }

    script "FellResist2"
