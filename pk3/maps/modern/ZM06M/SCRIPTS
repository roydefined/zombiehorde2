    // This simplifies the Angel's logic a lot by conditionally triggering its see behavior based on a timer.
    script "zh2_dec_angel_checksee"
    {
        static int nextSeeTrigger;
        if (nextSeeTrigger < Timer())
        {
            nextSeeTrigger = Timer() + ANGEL_NEXT_SEE_SCREAM;
            SetResultValue((int)true);
