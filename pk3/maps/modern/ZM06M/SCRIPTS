	angelEventTriggered = true;

    Setfont("smallfont");
    InteractionMessageBold(StrParam(n:0, s:" has come back from heaven! ...that was a mistake."));
	SetActivator(-1);

	Music::SetDefaultMusic("");
    Music::PlayDefaultMusic();

	delay(35 * 10);
	ACS_NamedExecute("Event_Angels", 0);
}

script "Event_Angels" (void)
{
	if (eventState != EVENTSTATE_NONE && eventState != EVENTSTATE_PREANGELS)
	{
		terminate;
	}

	// Spawn angels (should already be the case but it would not be if this script is called directly)
	if(!angelsSpawned)
	{
		angelsSpawned = true;

		for(int i = 0; i < MAX_ANGELS; i++) {
			SpawnSpot("angel", TAG_ANGELSPAWN + i, TAG_ANGEL + i);
		}
	}

    int angelCount = 0;
    while(true)
	{
        // This is a small random count that becomes rarer to pass the more it passes.
        while(random(0, 2 + angelCount))
		{
			delay(35 * random(5, 15));
		}

        // Teleport an angel.
		teleportother(TAG_ANGEL + angelCount, Random(500, 517), 1);
        InteractionMessageBold("\cgSomething has crossed from beyond...");
		angelCount++;

		// Replace hospital and music on first spawn
		if (angelCount == 1)
		{
			SetEventState(EVENTSTATE_ANGELS);
			ACS_NamedExecuteAlways("Event_Angels_Client", 0);

			Music::SetDefaultMusic("ANGELS");
            Music::PlayDefaultMusic();

			// Replace hospital textures
			SetActorState(TAG_MAPSPOTCEILINGLAMP, "inactive");
			SetActorState(TAG_MAPSPOTLIGHTBULB, "inactive");
			ReplaceTextures ("HOSPWR1", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWR2", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWR3", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWG1", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWG2", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWG3", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWB1", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWB2", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPWB3", "SPOOKW01" , 0);
			ReplaceTextures ("HSWALL12", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPFL01", "SPOOKW01" , 0);
			ReplaceTextures ("HOSPFL02", "SPOOKW01" , 0);
			ReplaceTextures ("DGRAY07", "SPOOKW01" , 0);
			ReplaceTextures ("DRROCK16", "SPOOKW01" , 0);
			ReplaceTextures ("RUFLAT01", "SPOOKW01" , 0);
			ReplaceTextures ("RUFLAT02", "SPOOKW01" , 0);
			ReplaceTextures ("BRBRIK03", "SPOOKW01" , 0);
			SetLineTexture(120, SIDE_FRONT, TEXTURE_BOTTOM, "SPOOKW01");
		}

		Logger::LogDebug(LOGSOURCE, StrParam(s:"Angel count: ", d:angelCount));

        // No more than 5 angels should leave.
        if(angelCount == 5)
		{
			terminate;
		};
    }
}

script "Event_Angels_Client" (void) clientside
{
	// TODO: Is this even required? Already handled serverside.
	Music::SetDefaultMusic("ANGELS");
    Music::PlayDefaultMusic();

	int startTimestamp = Timer();
	int targetColor = 0;
	int currentColor = DEFAULTLEVELCOLOR;

	while(eventState == EVENTSTATE_ANGELS)
	{
		if ((Timer() - startTimestamp) % 5 == 0)
		{
			targetColor = random(1, 150);
		}

		int diff = (targetColor - currentColor) / 3;
		currentColor += diff;

		SetLevelAtmosphere(currentColor, currentColor, currentColor);
		Delay(const: 1);
	}
}