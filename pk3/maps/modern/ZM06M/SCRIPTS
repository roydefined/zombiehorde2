    Script "UboaSpawnLoot" (raw x, raw y, raw z)
    {
        int singleBulletsSpawned = 0;
        int doubleBulletsSpawned = 0;
        int weaponsSpawned = 0;

        // Manage the total count to spawn so we know when to break out
        int totalAmount =
            UBOA_DIED_JACKSGUN_SINGLE_BULLET_COUNT +
            UBOA_DIED_JACKSGUN_DOUBLE_BULLET_COUNT +
            UBOA_DIED_JACKSGUN_WEAPON_COUNT;

        for (int i = 0; i < totalAmount; ++i)
        {
            // Note, always reassign or the value from the last iteration actually sticks.
            str spawnName = (raw)0;

            while (spawnName == (raw)0)
            {
                switch (random(0, 2))
                {
                    case 0:
                        if (singleBulletsSpawned < UBOA_DIED_JACKSGUN_SINGLE_BULLET_COUNT)
                        {
                            spawnName = WEAPON_JACKSGUN_AMMOSINGLE_NAME;
                            ++singleBulletsSpawned;
                        }
                        break;

                    case 1:
                        if (doubleBulletsSpawned < UBOA_DIED_JACKSGUN_DOUBLE_BULLET_COUNT)
                        {
                            spawnName = WEAPON_JACKSGUN_AMMODOUBLE_NAME;
                            ++doubleBulletsSpawned;
                        }
                        break;

                    case 2:
                        if (weaponsSpawned < UBOA_DIED_JACKSGUN_WEAPON_COUNT)
                        {
                            spawnName = Weapon::GetWeaponSpawnClassName(Weapon::WEAPONTYPE_JACKSGUN);
                            ++weaponsSpawned;
                        }
                        break;
                }
            }

            fixed angle = Math::FRandom(0.0, 1.0);
            fixed offsetX = FixedMul(cos(angle), Math::FRandom(UBOA_DIED_ITEM_SPAWN_DISTANCE_MIN, UBOA_DIED_ITEM_SPAWN_DISTANCE_MAX));
            fixed offsetY = FixedMul(sin(angle), Math::FRandom(UBOA_DIED_ITEM_SPAWN_DISTANCE_MIN, UBOA_DIED_ITEM_SPAWN_DISTANCE_MAX));

            fixed spawnX = x + offsetX;
            fixed spawnY = y + offsetY;
            fixed spawnZ = z + Math::FRandom(UBOA_DIED_ITEM_SPAWN_HEIGHT_MIN, UBOA_DIED_ITEM_SPAWN_HEIGHT_MAX);

            SpawnForced(spawnName, spawnX, spawnY, spawnZ, 0, int(angle * 255.0));
            Delay(const: UBOA_DIED_ITEM_SPAWN_DELAY);
        }
    }

