        ReplaceTextures("0_RUS17", "WEBBIN03", 0);
        ReplaceTextures("0_RUS23", "WEBBIN03", 0);
        ReplaceTextures("0_RUS26", "WEBBIN03", 0);

        ReplaceTextures("0_RUS20", "WEBBIN03", 0);
        ReplaceTextures("0_RUS24", "WEBBIN03", 0);
        ReplaceTextures("0_RUS27", "WEBBIN03", 0);

        ReplaceTextures("0694", "WEBBIN03" , 0);

        ReplaceTextures("0690", "WEBBIN03", 0);
        ReplaceTextures("0691", "WEBBIN03", 0);
        ReplaceTextures("0_RUS14", "WEBBIN03", 0);
        ReplaceTextures("1171", "WEBBIN03", 0);


        ReplaceTextures("GRAFFI00", "WEBBIN03", 0);
        ReplaceTextures("GRAFFI00", "WEBBIN03", 0);

        SetLineTexture(69, SIDE_FRONT, TEXTURE_MIDDLE, "WEBBIN05");
        SetLineTexture(69, SIDE_BACK, TEXTURE_MIDDLE, "WEBBIN05");
        SetLineTexture(66, SIDE_FRONT, TEXTURE_MIDDLE, "WEBBIN04");
        SetLineTexture(66, SIDE_BACK, TEXTURE_MIDDLE, "WEBBIN04");
        SetLineTexture(73, SIDE_FRONT, TEXTURE_MIDDLE, "WEBBIN08");

        // This loop determines if each spot has had its initial count filled in. After each iteration we decrement.
        // It's a bit of a loose check but each spot will have been iterated once when it reaches 0.
        int initialSpidersLeft = MAX_SPIDERSPOT;

        // A constant loop checking if there needs to be any refilling of spiders on each spot.
        while(true)
        {
            // Prevent the map from getting too many spiders.
            // THis is an extra failsafe.
            int totalSpiderCount = thingcountname("ZH2SpiderRed", 0)
                + thingcountname("ZH2SpiderGreen", 0)
                + thingcountname("ZH2SpiderBlue", 0)
                + thingcountname("ZH2SpiderBlack", 0)
                + thingcountname("ZH2SpiderGray", 0);

            if (totalSpiderCount >= MAX_SPIDER)
                terminate;

            for(int i = 0; i < TAG_SPIDERSPAWNMAX - TAG_SPIDERSPAWNMIN; i++)
            {
                int spiderCount = thingcountname("ZH2SpiderRed", TAG_SPIDER + i)
                    + thingcountname("ZH2SpiderGreen", TAG_SPIDER + i)
                    + thingcountname("ZH2SpiderBlue", TAG_SPIDER + i)
                    + thingcountname("ZH2SpiderBlack", TAG_SPIDER + i)
                    + thingcountname("ZH2SpiderGray", TAG_SPIDER + i);

                // Enough spiders on spot.
                if (spiderCount >= MAX_SPIDERSPOT)
                    continue;

                int spot = TAG_SPIDERSPAWNMIN + i;
                spawnspot("ZH2SpiderSpawner", spot, TAG_SPIDER + i);
            }

            int tics = initialSpidersLeft > 0
                ? random(SPIDER_INITIAL_SPAWN_DELAY_MIN, SPIDER_INITIAL_SPAWN_DELAY_MAX)
                : random(SPIDER_REFILL_SPAWN_DELAY_MIN, SPIDER_REFILL_SPAWN_DELAY_MAX);

            delay(tics);
            initialSpidersLeft--;
        }
    }

