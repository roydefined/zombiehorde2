    script "OnOpenClient" open clientside
    {
        SetLevelAtmosphere(DEFAULT_LEVEL_COLOR, DEFAULT_LEVEL_COLOR, DEFAULT_LEVEL_COLOR);

        // Check for active events.
        ClientSyncEventState();
        switch(eventState)
        {
            case EVENTSTATE_NONE:
                terminate;

            case EVENTSTATE_DISCO:
                ACS_NamedExecute("Event_Disco_Client", 0);
                terminate;

            case EVENTSTATE_UBOA:
                ACS_NamedExecute("Event_Uboa_Client", 0);
                terminate;

            case EVENTSTATE_NIGHTMARE:
                ACS_NamedExecute("Event_Nightmare_Client", 0);
                terminate;

            case EVENTSTATE_ANGELS:
                ACS_NamedExecute("Event_Angels_Client", 0);
                terminate;
        }
    }

    // Handles giving rewards when uboa dies.
    script "OnEvent" (raw type, raw damage, raw unused) event
    {
        if (type != GAMEEVENT_ACTOR_DAMAGED)
            terminate;

        str actorClass = GetActorClass(ActivatorTID());

        bool isUboa = BCSUtils::StrEquals(actorClass, "ZH2Uboa");
        bool isAngel = BCSUtils::StrEquals(actorClass, "ZH2Angel");
        bool isSpider = BCSUtils::StrEquals(actorClass, "ZH2SpiderRed")
            || BCSUtils::StrEquals(actorClass, "ZH2SpiderGreen")
            || BCSUtils::StrEquals(actorClass, "ZH2SpiderBlue")
            || BCSUtils::StrEquals(actorClass, "ZH2SpiderBlack")
            || BCSUtils::StrEquals(actorClass, "ZH2SpiderGray");

        if (!isUboa && !isAngel && !isSpider)
            terminate;

        int targetHealth = BCSUtils::GetActorHealth(0);
        bool targetDied = targetHealth - damage <= 0;

        if (!targetDied)
            terminate;

        if (isUboa)
            ACS_NamedExecuteAlways("UboaDied", 0);

        if (isAngel)
            ACS_NamedExecuteAlways("AngelDied", 0);

        if (isSpider)
            ACS_NamedExecuteAlways("SpiderDied", 0);
    }

