    script "Event_Disco" (void)
    {
        if (eventState != EVENTSTATE_NONE)
            terminate;

        TurnOffGenerator();
        SetEventState(EVENTSTATE_DISCO);
        ACS_NamedExecuteAlways("Event_Disco_Client", 0);

        delay(35*8);

        // Replace lights.
        SpawnSpotForced("ZH2DiscoBowl", TAG_MAPSPOTCEILINGLAMP, TAG_MAPSPOTDISCOBOWL);
        Thing_Remove(TAG_MAPSPOTCEILINGLAMP);

        // Stop the event after a certain time
        // This is exactly how long the track takes.
        delay(35 * 177 + 18);

        // Replace lights again.
        SpawnSpotForced("ZH2CeilingLamp", TAG_MAPSPOTDISCOBOWL, TAG_MAPSPOTCEILINGLAMP);
        Thing_Remove(TAG_MAPSPOTDISCOBOWL);

