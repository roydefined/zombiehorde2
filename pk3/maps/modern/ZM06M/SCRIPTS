    Script "EnterAltar" (void)
    {
        static bool angelEventTriggered = false;

        if (eventState == EVENTSTATE_PREANGELS || eventState == EVENTSTATE_ANGELS)
        {
            teleport(19);
            terminate;
        }

        SetEventState(EVENTSTATE_PREANGELS);

        // TODO: Support parameter?
        Music::PlayMusic("");//, MAPMUSICLOCAL | MAPMUSICREPLACERADIO);
        LocalAmbientSound("sound/musicsting", 50);

        Setfont("smallfont");
        HudMessageBold(n:0, s:" found the door to heaven."; HUDMSG_FADEOUT, 1, CR_GOLD, 0.5, 0.2, 3.0, 1.0, 1.0);
        teleport_nofog(6, 1, 0);

        int tid = ActivatorTID();
        SetActivator(-1);

        // Spawn angels
        if(!angelsSpawned)
        {
            angelsSpawned = true;

            for(int i = 0; i < MAX_ANGELS; i++) {
                SpawnSpot("ZH2Angel", TAG_ANGELSPAWN + i, TAG_ANGEL + i);
            }
        }

        delay(35*4);

        // Not triggering the event if the player died.
        if (!BCSUtils::ActorIsAlive(tid))
        {
            SetEventState(EVENTSTATE_NONE);
            terminate;
        }

        SetActivator(tid);
        teleport(19);

        if (angelEventTriggered)
            terminate;

        angelEventTriggered = true;

        Setfont("smallfont");
        InteractionMessageBold(StrParam(n:0, s:" has come back from heaven! ...that was a mistake."));
        SetActivator(-1);

        Music::SetDefaultMusic("");
        Music::PlayDefaultMusic();

        delay(35 * 10);
        ACS_NamedExecute("Event_Angels", 0);
    }

