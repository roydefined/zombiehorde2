script "Event_Spiders" (void)
{
	if (eventState != EVENTSTATE_NONE)
	{
		terminate;
	}

	TurnOffGenerator();
	SetEventState(EVENTSTATE_SPIDERS);
	ACS_NamedExecuteAlways("Event_Spiders_Client", 0);

	SetActorState (TAG_MAPSPOTCEILINGLAMP, "inactive");
	SetActorState (TAG_MAPSPOTLIGHTBULB, "inactive");

	ReplaceTextures ("HOSPWR1", "WEBBIN03", 0);
	ReplaceTextures ("HOSPWR2", "WEBBIN03", 0);
	ReplaceTextures ("HOSPWR3", "WEBBIN03", 0);

	ReplaceTextures ("HOSPWG1", "WEBBIN03", 0);
	ReplaceTextures ("HOSPWG2", "WEBBIN03", 0);
	ReplaceTextures ("HOSPWG3", "WEBBIN03", 0);

	ReplaceTextures ("HOSPWB1", "WEBBIN03", 0);
	ReplaceTextures ("HOSPWB2", "WEBBIN03", 0);
	ReplaceTextures ("HOSPWB3", "WEBBIN03", 0);

	ReplaceTextures ("HSWALL12", "WEBBIN03" , 0);

	ReplaceTextures ("HOSPFL01", "WEBBIN03", 0);
	ReplaceTextures ("HOSPFL02", "WEBBIN03", 0);
	ReplaceTextures ("RUFLAT01", "WEBBIN03", 0);
	ReplaceTextures ("WALBRWN1", "WEBBIN03", 0);


	ReplaceTextures ("HOSPWK2", "WEBBIN03", 0);
	ReplaceTextures ("HOSPWK2", "WEBBIN03", 0);

	SetLineTexture(69, SIDE_FRONT, TEXTURE_Middle, "WEBBIN05");
	SetLineTexture(69, SIDE_BACK, TEXTURE_Middle, "WEBBIN05");
	SetLineTexture(66, SIDE_FRONT, TEXTURE_MIDDLE, "WEBBIN04");
	SetLineTexture(66, SIDE_BACK, TEXTURE_MIDDLE, "WEBBIN04");
	SetLineTexture(73, SIDE_FRONT, TEXTURE_MIDDLE, "WEBBIN08");

    // A constant loop checking if there needs to be any refilling of spiders on each spot.
    while(true)
	{
		int spawnTagMin = TAG_SPIDERSPAWNMIN;
		int spawnTagMax = TAG_SPIDERSPAWNMAX;

		// Failsafe
		int totalSpiderCount = thingcountname("SpiderRed", 0)
              + thingcountname("SpiderGreen", 0)
              + thingcountname("SpiderBlue", 0)
              + thingcountname("SpiderBlack", 0)
              + thingcountname("SpiderGray", 0);
		if (totalSpiderCount >= MAX_SPIDER) {
			terminate;
		}

        for(int i = 0; i < spawnTagMax - spawnTagMin; i++)
		{
			int spiderCount = thingcountname("SpiderRed", TAG_SPIDER + i)
              + thingcountname("SpiderGreen", TAG_SPIDER + i)
              + thingcountname("SpiderBlue", TAG_SPIDER + i)
              + thingcountname("SpiderBlack", TAG_SPIDER + i)
              + thingcountname("SpiderGray", TAG_SPIDER + i);

			// Enough spiders on spot.
            if (spiderCount >= MAX_SPIDERSPOT) {
				continue;
			}

			int spot = spawnTagMin + i;
            spawnspot("SpiderSpawner", spot, TAG_SPIDER + i);
        }

        delay(random(30, 60));
    }
}

