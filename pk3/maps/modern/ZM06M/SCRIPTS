script "Event_Disco" (void)
{
	if (eventState != EVENTSTATE_NONE)
	{
		terminate;
	}

	TurnOffGenerator();
	SetEventState(EVENTSTATE_DISCO);
	ACS_NamedExecuteAlways("Event_Disco_Client", 0);

	delay(35*8);

	// Replace lights.
	Thing_Remove(TAG_MAPSPOTCEILINGLAMP);
	SpawnSpot(TAG_MAPSPOTDISCOBOWL, "DiscoBowl", 0, 0);
	SpawnSpot(TAG_MAPSPOTCEILINGLAMP, "DiscoBowl", 0, 0);

	// Stop the event after a certain time
	// This is exactly how long the track takes.
	delay(35 * 177 + 18);

	// Replace lights again.
	Thing_Remove(TAG_MAPSPOTDISCOBOWL);
	Thing_Remove(TAG_MAPSPOTCEILINGLAMP);
	SpawnSpot(TAG_MAPSPOTCEILINGLAMP, "CeilingLamp", 0, 0);

	SetEventState(EVENTSTATE_NONE);
}

script "Event_Disco_Client" (void) clientside
{
	// This wait until the client is aware of the new event.
	while (eventState != EVENTSTATE_DISCO)
	{
		delay(const: 1);
	}

	Music::SetDefaultMusic("DISCO2");
    Music::PlayDefaultMusic();

	delay(35*2);

	Log(s:"It's getting a bit funky in here!");

	delay(35*6);

	// Stop the event after a certain time
	// This is exactly how long the track takes.
	int discoTime = 35 * 177 + 18;

	str message = "DISCOPARTY";
	int counter;
	while (discoTime--)
	{
		if (counter % 150 == 0 && counter != 0) {
			DrawDiscoMessage();
		}

		if (counter % 18 == 0)
		{
			SetLevelAtmosphere(random(1,255), random(1,255), random(1,255));
			DrawDiscoMessageHeader(message);
		}

		counter++;
		delay(const: 1);
	}

	Log(s:"The hospital has returned to its former charm.");

	Music::SetDefaultMusic("UNSETTLE");
	SetLevelAtmosphere(DEFAULTLEVELCOLOR, DEFAULTLEVELCOLOR, DEFAULTLEVELCOLOR);

	for (int i = 0; i < StrLen(message); ++i) {
		BCSUtils::ClearHudMessageBold(HUDID_DISCO + i);
	}
}

