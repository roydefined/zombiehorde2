script "Event_Uboa_Client" (void) clientside
{
	// This wait until the client is aware of the new event.
	while (eventState != EVENTSTATE_UBOA)
	{
		delay(const: 1);
	}

	Music::SetDefaultMusic(BCSUtils::cond(Random(0, 1), "FUCKED", "FUCKED2"));
    Music::PlayDefaultMusic();

	int startTimestamp = Timer();
	int targetColor = 0;
	int currentColor = DEFAULTLEVELCOLOR;

	// TODO: From past testing it was determined that this might be incredibly laggy.
	while(eventState == EVENTSTATE_UBOA)
	{
		if (Timer() - startTimestamp == 35 * 2)
		{
			Log(s:"Uboa has entered the hospital.");
		}

		if ((Timer() - startTimestamp) % 10 == 0)
		{
			targetColor = random(1,255);
		}

		int diff = (targetColor - currentColor) / 5;
		currentColor += diff;

		SetLevelAtmosphere(currentColor, currentColor, currentColor);
		Delay(const: 1);
	}
}

