    Polyobj_Move(1, 12, 0, 56);
	Delay(35 * 5);
	Polyobj_Move(1, 12, 128, 56);
	Delay(35 * 2);
}

// Bricks that can be pressed to open the teleporter to the Jack's gun.
script "TriggerBrick" (int tag)
{
	static int count;
	count++;

	Floor_LowerToNearest(tag, 2);
	if (count == 3) {
		Ceiling_RaiseByValue(136, 15, 120);
		Floor_LowerByValue(136, 5, 8);
	}
}

script "TeleportToJacks" (void) // Secret teleport to jacksgun
{
	static bool jacksActivated;

    if (jacksActivated)
	{
		Log(s:"someone activated this already...");
		terminate;
    }

    if (Player::GetIsZombie()){
		terminate;
    }

    teleport(61,0,0);
	Floor_LowerByValue(143, 2, 56);
}

script "FruitPicker" (void)
{
	static bool fruitTaken[BCSUtils::MAX_PLAYERS];
    if(Player::GetIsZombie())
	{
		terminate;
    }

    else if(fruitTaken[PlayerNumber()])
	{
		terminate;
    }

	fruitTaken[PlayerNumber()] = true;
    switch(Random(1,5))
	{
        case 1:
			healthing(15);
			SelfChat("Mmm, tasty!");
			break;

        case 2:
			healthing(25);
			SelfChat("Damn, that's good!");
			break;

        case 3:
			healthing(10);
			SelfChat("Not half bad...");
			break;

        case 4:
			healthing(5);
			SelfChat("Urgh! it's rotten.");
			break;

        case 5:
			healthing(20);
			SelfChat("I want some more!");
			break;
	}
}

