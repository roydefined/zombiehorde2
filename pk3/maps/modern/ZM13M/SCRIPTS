script "OnOpen" open
{
	// River that pulls the player east.
	scroll_ceiling(41, 100, 0, 2);
	scroll_ceiling(61, 20, 0, 2);
	scroll_floor(39, 200, 0, 1);
	scroll_floor(42, 200,0, 1);

	// Close Jack's gun teleporter
	Ceiling_LowerByValue(136, 50, 120);
	Floor_RaiseByValue(136, 50, 8);

	// TODO: This should become its own key, not a legacy key!
	SpawnSpot("ZH2LegacyCaveKey", Random(132, 135));

	// Small change for the other music to play.
	_mapType = Random(0, 5) == 5 ? MAPTYPE_DAYTIME : MAPTYPE_EVENING;
	SyncMapType();
}

script "OnOpenClient" open clientside
{
	ClientSyncMapType();

	if (_mapType == MAPTYPE_DAYTIME)
	{
		ChangeSky("SUNSSKY1", "SUNSSKY1");

		Music::SetDefaultMusic("STRANGE");
		Music::PlayDefaultMusic();
	}
	else
	{
		ChangeSky("SUNSSKY2", "SUNSSKY2");
		Weather::StartEmitterWeather(Weather::EMITTERWEATHER_RAIN);

		Music::SetDefaultMusic("STRANGE2");
		Music::PlayDefaultMusic();
	}
}

