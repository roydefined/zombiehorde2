script "CellarDoor" (void)
{
	static bool firstOpened;

	// TODO: Support?
	if (false) {
	//if (!CheckLock(0)) {
		Logger::LogActivator("You need the key for this wine cellar.");
		terminate;
	}

	if (!firstOpened) {
		Logger::LogBold(StrParam(s:BCSUtils::PlayerName(PlayerNumber()), s:" has opened the wine cellar."));
		AmbientSound("ambient/reveal", 127);
		ActivatorSound("sequence/door1", 127);
