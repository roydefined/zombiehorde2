script "CellarDoor" (void)
{
	static bool opened;

	if (!opened && !CheckInventory("ZH2LegacyCaveKey")) {
		Logger::LogActivator("You need the key for this wine cellar.");
		terminate;
	}

	if (!opened)
	{
		Logger::LogBold(StrParam(s:BCSUtils::PlayerName(PlayerNumber()), s:" has opened the wine cellar."));
		AmbientSound("ambient/reveal1", 127);
		ActivatorSound("sequence/lift1door", 127);
		opened = true;
	}

	Polyobj_Move(1, 12, 0, 56);
	Delay(35 * 5);
	Polyobj_Move(1, 12, 128, 56);
	Delay(35 * 2);
}

// Bricks that can be pressed to open the teleporter to the Jack's gun.
script "TriggerBrick" (int tag)
{
	static int count;
	count++;

	Floor_LowerToNearest(tag, 2);
	if (count == 3) {
		Ceiling_RaiseByValue(136, 15, 120);
		Floor_LowerByValue(136, 5, 8);
	}
}

script "TeleportToJacks" (void) // Secret teleport to jacksgun
{
	static bool jacksActivated;

	if (jacksActivated)
	{
		Log(s:"someone activated this already...");
		terminate;
	}

	if (Player::GetIsZombie()){
		terminate;
	}

	teleport(61,0,0);
	Floor_LowerByValue(143, 2, 56);
	jacksActivated = true;
}

script "FruitPicker" (void)
{
	static bool fruitTaken[BCSUtils::MAX_PLAYERS];
	if(Player::GetIsZombie())
	{
		terminate;
	}

	else if(fruitTaken[PlayerNumber()])
	{
		terminate;
	}

	fruitTaken[PlayerNumber()] = true;
	switch(Random(1,5))
	{
		case 1:
			healthing(15);
			Chat::SendSelfActivator("Mmm, tasty!");
			break;

		case 2:
			healthing(25);
			Chat::SendSelfActivator("Damn, that's good!");
			break;

		case 3:
			healthing(10);
			Chat::SendSelfActivator("Not half bad...");
			break;

		case 4:
			healthing(5);
			Chat::SendSelfActivator("Urgh! it's rotten.");
			break;

		case 5:
			healthing(20);
			Chat::SendSelfActivator("I want some more!");
			break;
	}
}

