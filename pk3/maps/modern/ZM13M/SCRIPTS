/*
** -----------------------------------------------------------------------------
** MAP TYPE SYNC
** -----------------------------------------------------------------------------
*/

internal void SyncMapType()
{
	VALIDATE_IS_SERVERSIDE_FUNCTION();

	if (!IsNetworkGame())
		return;

	BCSUtils::SyncVariable(SYNC_MAPTYPE, _mapType);
	ACS_NamedExecuteAlways("SyncMapType_Client", 0);
}

script "SyncMapType_Client" clientside
{
	ClientSyncMapType();
}

// Called clientside to fetch the synced state.
internal void ClientSyncMapType()
{
	VALIDATE_IS_CLIENTSIDE_FUNCTION();

	if (!IsNetworkGame())
		return;

	_mapType = BCSUtils::GetSyncVarDefault(SYNC_MAPTYPE, MAPTYPE_EVENING);

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced map type client: ", d:_mapType));
}

#undef LOGSOURCE
