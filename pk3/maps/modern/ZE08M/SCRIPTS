    script "post_resist_handler" (int resistIndex)
    {
        switch(resistIndex)
        {
            case 0:
            {
                Floor_LowerByValue(5, 16, 120);
                break;
            }

            // Note, this resist is unused.
            case 1:
            {
                Floor_LowerByValue(10, 32, 128);
                break;
            }

            case 2:
            {
                Floor_LowerByValue(19, 32, 128);
                break;
            }

            case 3:
            {
                Floor_LowerByValue(32, 32, 128);
                break;
            }

            case 4:
            {
                Floor_LowerByValue(42, 32, 128);
                break;
            }

            case 5:
            {
                Door_Open(45, 32);
                break;
            }

            case 6:
            {
                Door_Open(50, 32);
                Floor_LowerByValue(52, 255, 32);
                break;
            }

            case 7:
            {
                Door_Open(55, 32);
                Floor_lowerbyvalue(54, 255, 96);
                Ceiling_lowerbyvalue(54, 255, 96);
                break;
            }

            case 8:
            {
                //Generic_Ceiling(69, 16, 144, 5, 16); //ZH2 [AQW]
                Ceiling_LowerAndCrush(69,16,20,2); //ZH2 [AQW]
                TagWait(69); //ZH2 [AQW]
                Ceiling_LowerByValueTimes8(69,16,1); //ZH2 [AQW]
                Delay(35*2);
                SetFont("BIGFONT");
                HudMessageBold(s:"\cGWarning : \cKAir Raid attack!!"; HUDMSG_FADEOUT, 0, CR_GOLD, 0.5, 0.2, 3.0, 2.0);
                Delay(35*2);
                AmbientSound("world/rocket1", 100);
                Radius_Quake(10, 500, 0, 64, 68);
                SpawnSpot("ZH2LegacyZE29Explosion", 70, 0, 0);
                Delay(35);
                SpawnSpot("ZH2LegacyZE29Explosion", 71, 0, 0);
                Delay(15);
                SpawnSpot("ZH2LegacyZE29Explosion", 72, 0, 0);
                Delay(35);
                Game::KillUnsafePlayers();
                SpawnSpot("ZH2LegacyZE29Explosion", 70, 0, 0);
                Delay(35);
                SpawnSpot("ZH2LegacyZE29Explosion", 71, 0, 0);
                Delay(25);
                SpawnSpot("ZH2LegacyZE29Explosion", 72, 0, 0);
                Delay(15);
                SpawnSpot("ZH2LegacyZE29Explosion", 70, 0, 0);
                Delay(15);
                SpawnSpot("ZH2LegacyZE29Explosion", 71, 0, 0);
                Delay(25);
                SpawnSpot("ZH2LegacyZE29Explosion", 72, 0, 0);
                Delay(15*2);
                SpawnSpot("ZH2LegacyZE29Explosion", 70, 0, 0);
                Delay(35);
                SpawnSpot("ZH2LegacyZE29Explosion", 71, 0, 0);
                Delay(25);
                SpawnSpot("ZH2LegacyZE29Explosion", 72, 0, 0);
                Delay(15);
                SpawnSpot("ZH2LegacyZE29Explosion", 70, 0, 0);
                Delay(35);
                SpawnSpot("ZH2LegacyZE29Explosion", 71, 0, 0);
                Delay(25);
                SpawnSpot("ZH2LegacyZE29Explosion", 72, 0, 0);
                Delay(35);
                break;
            }
        }
    }

