#define LOGSOURCE "Map"

script "OnOpen" open
{
	// Unset the beam opacity to appear later.
	TranslucentLine(1, 0);
	TranslucentLine(2, 0);
	TranslucentLine(3, 0);
	TranslucentLine(5, 0);

	// Scrolling of the quicksand.
	Scroll_Floor(48, -15, -80, SCROLL_AND_CARRY);
	Scroll_Floor(49, -80, -80, SCROLL_AND_CARRY);
	Scroll_Floor(50, -80, -15, SCROLL_AND_CARRY);
	Scroll_Floor(51, -80,  15, SCROLL_AND_CARRY);
	Scroll_Floor(52, -80,  80, SCROLL_AND_CARRY);
	Scroll_Floor(53, -15,  80, SCROLL_AND_CARRY);
	Scroll_Floor(54,  15,  80, SCROLL_AND_CARRY);
	Scroll_Floor(55,  80,  80, SCROLL_AND_CARRY);
	Scroll_Floor(56,  80,  15, SCROLL_AND_CARRY);
	Scroll_Floor(57,  80, -15, SCROLL_AND_CARRY);
	Scroll_Floor(58,  80, -80, SCROLL_AND_CARRY);
	Scroll_Floor(59,  15, -80, SCROLL_AND_CARRY);

	// Resists
	// TODO: Support the additional parameter?
	Resist::CreateResist(20, "\cjActivating eastern Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(20, "\cjActivating northern Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(20, "\cjActivating western Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(20, "\cjActivating southern Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(30, "\cjOpening pyramid", "\ccResist for \cd%t \ccseconds"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(40, "\cjReach the burial chamber", "%t \ciseconds left"); //, RESISTTYPEPLAIN);

	// TODO: Support
	//SetGlobalZombieTeleports(1);

	// Determine the game to run.
	// Randomize if 0. Do a randomized switch with chance for certain flows.
	int flow = GetCVar("sv_zh2_ze12mflow");
	if (flow == 0)
	{
		switch(Random(0, 8))
		{
			case 0:
				flow = 1;

			case 1:
			case 2:
				flow = 2;

			default:
				flow = 3;
		}
	}

	if (flow == 1)
		SetNonLinearGame();
	else
		SetLinearGame(flow == 3);

	// HACK: Why does this map not want to properly synchronize when we changemap to it?
	// We have to delay to ensure we get the data properly. Yet on maps like ZE13M we do the same thing and it works fine.
	Delay(const: 25);

	SyncGameType();
	SyncActivePillars();
}

script "OnOpenClient" open clientside
{
	ClientSyncGameType();
	ClientSyncActivePillars();
	ClientSyncMapProgressState();

	ACS_NamedExecute("FinalMusicLoop", 0);
	ACS_NamedExecute("PillarDebug", 0);

	SpawnSpot("ZH2ZE12MMarkerNorth", 83);
	SpawnSpot("ZH2ZE12MMarkerEast", 84);
	SpawnSpot("ZH2ZE12MMarkerSouth", 85);
	SpawnSpot("ZH2ZE12MMarkerWest", 86);

	// Late joiners must get the correct music.
	if (_mapProgressState != STATE_NONE)
	{
		Music::SetDefaultMusic("D_EGYPT2");
		Music::PlayDefaultMusic();
	}

	delay(70);

	// Logo
	SetHudSize(640, 480, FALSE);
	SetFont("ze12logo");
	HudMessageBold(s:"a"; HUDMSG_FADEINOUT, 0, 0, 320.0, 80.0, 1.0, 3.0, 2.0);
}

script "StartTrigger"
{
	NamedExecuteClientScript("StartTrigger_Client", PlayerNumber());

	// Map state must advance if we didn't do so already.
	if (_mapProgressState == STATE_NONE)
	{
		_mapProgressState = STATE_PLAYINGOUTSIDE;
		SyncMapProgressState();

		// Tell all spectators to change music.
		ACS_NamedExecute("UpdateSpectatorMusic", 0);
	}
}

script "StartTrigger_Client" clientside
{
	static bool hasRun;
	if (hasRun)
		terminate;

	hasRun = true;
	SetActivator(-1);

	// Only run if we aren't ending yet.
	if (_mapProgressState == STATE_ENDING || _mapProgressState == STATE_ENDED)
		terminate;

	Music::SetDefaultMusic("D_EGYPT2");
	Music::PlayDefaultMusic();

	// The rest only makes sense if we didn't open the pyramid yet
	if (_mapProgressState == STATE_PLAYINGINSIDE)
		terminate;

	delay(18);

	int stayTime = _gameType == GAMETYPE_LINEAR ? 3.75 : 5.75;

	SetHudSize(640, 480, FALSE);
	SetFont("smallfont");
	HudMessageBold(s:"You must activate all four pillars"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 42.0, stayTime + 0.25, 1.0, 0.5);
	delay(9);
	HudMessageBold(s:"on each cardinal direction in order to open the pyramid"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 52.0, stayTime, 1.0, 0.5);

	delay(35 * 2);

	// Extra message with some gamemodes.
	if (_gameType == GAMETYPE_QUICKLINEAR)
		HudMessageBold(s:"You're in luck! Some of the pillars are already active."; HUDMSG_FADEOUT, 0, CR_GREEN, 320.0, 62.0, 4.5, 0.5);
	else if (_gameType == GAMETYPE_NONLINEAR)
		HudMessageBold(s:"The desert is in your favor. You can freely move to any pillar!"; HUDMSG_FADEOUT, 0, CR_GREEN, 320.0, 62.0, 4.5, 0.5);
}

script "UpdateSpectatorMusic" clientside
{
	if (!PlayerIsSpectator(ConsolePlayerNumber()))
		terminate;

	Music::SetDefaultMusic("D_EGYPT2");
	Music::PlayDefaultMusic();
}

internal void TriggerBeaconActivateAmbience()
{
	AmbientSound("world/beacon1", 127);
}

// The general function to activate a beacon.
// If silent is `true`, do not play the ambient sound.
internal void ActivateBeacon(int index)
{
	int tag = _pillarTids[index];
	TranslucentLine(tag, 128, true);

	// Call directly to the client offline.
	if (!IsNetworkGame())
		ActivateBeaconClient(index);

	// Open up the pillar if all four are activated.
	// The quick game type will have a seperate resist first.
	if (GetPillarsDoneCount() == 4 && _gameType != GAMETYPE_QUICKLINEAR)
	{
		floor_lowerinstant(28, 0, 2048);
		ceiling_lowerinstant(28, 0, 2048);
		ACS_NamedExecute("PyramidOpened", 0);
	}
}

internal void ActivateBeaconClient (int index)
{
	int tag = _pillarTids[index];
	Thing_Activate(tag);

	// Activate the Light flare at the pyramid with the first finished beacon.
	Thing_Activate(4);
}

// General map teleport that uses a different id based on map flow.
script "MapTeleport" (raw linearTid, raw quickLinearTid, raw nonLinearTid)
{
	int teleportTid;
	switch(_gameType)
	{
		case GAMETYPE_QUICKLINEAR:
			teleportTid = quickLinearTid;
			break;
		case GAMETYPE_NONLINEAR:
			teleportTid = nonLinearTid;
			break;
		default:
			teleportTid = linearTid;
			break;
	}

	TeleportUtil::TeleportArea(teleportTid, 32, TeleportUtil::TELEPORT_PROFILE_TELEPORTSPOTFOG);
}

// Enables the zombie teleports after 10 seconds, and the shortcut after another 5 seconds. Called after the last pillar was activated.
script "PyramidOpened"
{
	Delay(35 * 3);

	_mapProgressState = STATE_PLAYINGINSIDE;
	SyncMapProgressState();

	SetHudSize(640, 480, FALSE);
	AmbientSound("world/reveal1", 127);
	HudMessageBold(s:"The top into the pyramid has been opened."; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, 50.0, 2.0, 0.5);

	delay(35 * 7);

	Game::SetZombieTeleportingEnabled(true);
	Logger::LogBold("Zombies can now teleport to the pyramid entrance.");

	delay (35*5);

	floor_LowerByValue(33, 16, 112);
	Logger::LogBold("A shortcut has been opened north of the beacon for anyone left behind.");
}

// Resist to open the pyramid.
// Specific to the quick linear game type.
script "OpenPyramidResist"
{
	if(_gameType != GAMETYPE_QUICKLINEAR)
		terminate;

	static bool hasRun;
	if (hasRun)
		terminate;

	hasRun = true;

	SetActivator(-1);
	Delay(Resist::StartResistByIndex(4));

	floor_lowerinstant(28, 0, 2048);
	ceiling_lowerinstant(28, 0, 2048);

	_mapProgressState = STATE_PLAYINGINSIDE;
	SyncMapProgressState();

	SetHudSize(640, 480, FALSE);
	AmbientSound("world/reveal1", 127);
	HudMessageBold(s:"The top into the pyramid has been opened."; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, 50.0, 2.0, 0.5);
}

// Small teleport script that fixes the fade inside the pyramid for software users.
script "EnterPyramid" (void) clientside
{
	if(ConsolePlayerNumber() != PlayerNumber())
		terminate;

	BCSUtils::SetActivatorToConsolePlayer();

	if (!BCSUtils::IsOpenGL())
	{
		for(int i=0; i < 999; ++i)
		{
			Light_RaiseByValue(i, 80);
			sector_setfade(i, 0, 0, 0);
		}
	}
}

function int GetPillarsDoneCount(void)
{
	return _pillarDone[0] + _pillarDone[1] + _pillarDone[2] + _pillarDone[3];
}

Script "FinalResist" (void)
{
	SetActivator(-1);

	int y = 40.0;

	SetHudSize(640, 480, FALSE);
	SetFont("BIGFONT");
	HudMessageBold(s:"A curse is about to befall the area!"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, y, 0.5, 0.5);
	HudMessageBold(s:"Take shelter in the Pharaoh's burial chamber!"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, y+15.0, 0.5, 0.5);
	delay(18);
	HudMessageBold(s:"A curse is about to befall the area!"; HUDMSG_FADEINOUT, 0, CR_RED, 320.0, y, 0.0, 0.5, 0.5);
	HudMessageBold(s:"Take shelter in the Pharaoh's burial chamber!"; HUDMSG_FADEINOUT, 0, CR_RED, 320.0, y+15.0, 0.0, 0.5, 0.5);
	delay(18);
	HudMessageBold(s:"A curse is about to befall the area!"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, y, 2.0, 0.5, 0.5);
	HudMessageBold(s:"Take shelter in the Pharaoh's burial chamber!"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, y+15.0, 2.0, 0.5, 0.5);
	Delay(35*3);
	ACS_NamedExecute("FinalMusic",0,0,0,0);
	Delay(Resist::StartResistByIndex(5));
	//Generic_Ceiling(31, 16, 128, 5, 16);
	Ceiling_LowerAndCrush(31,16,50,2);
	tagwait(31);
	delay(35);
	SetFont("BIGFONT");
	HudMessageBold(s:"The curse is here"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, y, 5.0, 3.0);
	Delay(35);
	for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i)
	{
		if (Game::GetPlayerIsSafe(i) || !PlayerInGame(i))
			continue;

		NamedExecuteClientScript("DeathQuake", i);
	}

	delay(35*4+18);
	Game::KillUnsafePlayers();
}

// The earthquake to trigger on clients that did not make it.
script "DeathQuake"
{
	FadeTo(0, 0, 0, 1.0, 4.0);
	for (int i = 1; i < 4; i++)
	{
		Radius_Quake2(ActivatorTID(), i, 35, 0, 1, "");
		delay(35);
	}

	Radius_Quake2(ActivatorTID(), i, 35, 0, 1, "");
	delay(35*2);
	FadeTo(0, 0, 0, 0.0, 1.0);
}

// Called just before the final resist.
// Handles setting the map's state which is useful for the final music to run properly.
Script "FinalMusic"
{
	Delay(525);

	_mapProgressState = STATE_ENDING;
	SyncMapProgressState();

	Delay(1100);

	_mapProgressState = STATE_ENDED;
	SyncMapProgressState();
}

// Runs clientside on players to avoid issues with the music cutting of prematurely.
script "FinalMusicLoop" clientside
{
	SetActivator(-1);
	if (_mapProgressState != STATE_ENDING)
	{
		delay(const: 1);
		restart;
	}

	Music::PlayMusic("D_EGYPT3", 0);
	Delay(1225);
	Music::PlayMusic("", 0);
}

