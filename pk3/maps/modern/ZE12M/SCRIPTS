// Sets up a linear game mode by changing the map.
// If quick is `true`, three pillars will prematurely raise as was done with the last version made by DrDoctor.
internal void SetLinearGame(bool quick)
{
	// General linedef changes
	Line_SetBlocking(22, BLOCK_PLAYERS, 0);

	// General linedef changes when the map is not being played quickly.
	if (!quick)
	{
		Line_SetBlocking(73, BLOCK_PLAYERS, 0);
	}

	// Sectors and linedefs near south beacon
	Floor_RaiseByValue(12, 999, 150);
	Floor_RaiseByValue(16, 999, 200);
	SetLineBlocking(4, BLOCK_PLAYERS);
	Floor_RaiseByValue(3, 10, 40);

	if (!quick)
	{
		Floor_LowerByValue(21, 999, 200);
	}
	if (quick)
	{
		Floor_RaiseByValue(7, 999, 100);
		Line_SetBlocking(77, BLOCK_PLAYERS, 0);
	}

	// Sector and linedefs near east beacon
	Floor_RaiseByValue(37, 999, 100);
	Floor_RaiseByValue(40, 999, 200);
	floor_RaiseByValue(36, 32, 150);

	// Sectors and linedefs between west and north beacon
	floor_RaiseByValue(42, 150, 150);
	floor_RaiseByValue(69, 200, 150);
	floor_RaiseByValue(69, 96, 150);

	// Sectors and linedefs near west beacon
	if (!quick)
	{
		Line_SetBlocking(7, 0, BLOCK_PLAYERS);
		TranslucentLine(7, 0);

		// The ceiling textures will be set to F_SKY1 to imitate a sky.
		ChangeCeiling(71, "F_SKY1");
		ChangeCeiling(72, "F_SKY1");
		ChangeCeiling(38, "F_SKY1");
	}

	if (quick)
	{
		// North of the beacon, blocked off and door opened to take a shortcut to the west beacon.
		floor_RaiseByValue(74, 80, 150);
		Line_SetBlocking(75, BLOCK_PLAYERS, 0);
		floor_LowerByValue(33, 16, 112);

		// Set the teleport of the shortcut to the west beacon
		SetThingSpecial(17, 77, 0, 17, 76);

		// North
		floor_LowerByValue(44, 16, 112);
		floor_raisebyvalue(5, 8, 128);
		_pillarDone[1] = true;
		ActivateBeacon(1);

		// West
		ceiling_raisebyvalue(43, 64, 108);
		ceiling_raisebyvalue(23, 64, 88);
		Floor_LowerByValue(18, 999, 120);
		floor_raisebyvalue(17, 8, 48);
		floor_raisebyvalue(11, 8, 48 + 128);
		_pillarDone[2] = true;
		ActivateBeacon(2);

		// South
		floor_raisebyvalue(32, 8, 64);
		floor_raisebyvalue(10, 8, 64 + 128);
		_pillarDone[3] = true;
		ActivateBeacon(3);
	}

	_gameType = quick ? GAMETYPE_QUICKLINEAR : GAMETYPE_LINEAR;
	Logger::LogDebug(LOGSOURCE, "The game has been initialized as a linear game.");
}

// Sets up a non linear game mode by changing the map.
internal void SetNonLinearGame()
{
	Line_SetBlocking(6, BLOCK_PLAYERS, 0);

	// Sectors and linedefs near south beacon
	Floor_RaiseByValue(7, 999, 100);
	Line_SetBlocking(77, BLOCK_PLAYERS, 0);

	// Sectors and linedefs near west beacon
	ceiling_raisebyvalue(43, 999, 108);
	ceiling_raisebyvalue(23, 999, 88);
	Floor_LowerByValue(18, 999, 120);

	// The ceiling textures will be set to F_SKY1 to imitate a sky.
	ChangeCeiling(71, "F_SKY1");
	ChangeCeiling(72, "F_SKY1");
	ChangeCeiling(38, "F_SKY1");

	_gameType = GAMETYPE_NONLINEAR;
	Logger::LogDebug(LOGSOURCE, "The game has been initialized as a non-linear game.");
}

