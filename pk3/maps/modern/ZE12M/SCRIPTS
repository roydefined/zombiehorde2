internal void SyncGameType()
{
	VALIDATE_IS_SERVERSIDE_FUNCTION();

	if (!IsNetworkGame())
		return;

	BCSUtils::SyncVariable(SYNC_GAMETYPE, _gameType);
	ACS_NamedExecuteAlways("SyncGameType_Client", 0);
}

script "SyncGameType_Client" clientside
{
	ClientSyncGameType();
}

// Called clientside to fetch the synced state.
internal void ClientSyncGameType()
{
	VALIDATE_IS_CLIENTSIDE_FUNCTION();

	if (!IsNetworkGame())
		return;

	_gameType = BCSUtils::GetSyncVarDefault(SYNC_GAMETYPE, GAMETYPE_LINEAR);
	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced game type to client: ", d:_gameType, s:"."));
}

