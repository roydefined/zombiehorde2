// MAP STATE SYNC
//
// -------------------------------------------

function void SyncMapState(int state)
{
	if (!BCSUtils::IsServer()) {
		Logger::LogError(LOGSOURCE, "SyncMapState was called clientside.");
		return;
	}

	mapState = state;

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	BCSUtils::SyncVariable(SYNC_MAPSTATE, state);

	// Receive on all clients.
	if (!ACS_NamedExecuteAlways("SyncMapState_Client", 0)) {
		Logger::LogError(LOGSOURCE, "Failed to execute SyncMapState_Client.");
	}
}

script "SyncMapState_Client" (void) clientside
{
	ClientSyncMapState();
}

// Called clientside to fetch the synced state.
function void ClientSyncMapState(void)
{
	if (!BCSUtils::IsClient()) {
		Logger::LogError(LOGSOURCE, "ClientSyncMapState was called serverside.");
		return;
	}

	// Do not sync when not in a network game.
	if (!IsNetworkGame()) {
		return;
	}

	mapState = BCSUtils::GetSyncVarDefault(SYNC_MAPSTATE, MAPSTATE_NONE);
	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced map state to client: ", d:mapState, s:"."));
}

