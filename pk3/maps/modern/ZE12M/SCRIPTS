// Used for synchronization
#define SYNC_MAPSTATE 100
#define SYNC_PILLARSTATE 101

// Indicates the finished pillars
bool pillarDone[4];

// The tids used for the lens flare on each pillar.
int pillarTids[4] = { 3, 2, 5, 1 };

// This specifies the gameType that is being played.
#define GAMETYPE_LINEAR 0
#define GAMETYPE_QUICKLINEAR 1
#define GAMETYPE_NONLINEAR 2
int mapGameType;

// The state type of the map.
// Used during synchronization to indicate if the music should be played to joining players.
#define MAPSTATE_NONE 0
#define MAPSTATE_ENDING 1
#define MAPSTATE_ENDED 2

// The actual map state.
int mapState = MAPSTATE_NONE;

#define LOGSOURCE "Map"

script "OnEnterClient" enter clientside
{
	PlaySound(0, "ambient/wind1", CHAN_UI, 1.0, true);
}

script "OnOpenClient" open clientside
{
	ClientSyncActivePillars();
	ClientSyncMapState();
	if(!ACS_NamedExecute("FinalMusicLoop", 0))
	{
		Logger::LogError(LOGSOURCE, "Failed to start FinalMusicLoop");
	}

	if (!ACS_NamedExecute("PillarDebug", 0))
	{
		Logger::LogError(LOGSOURCE, "Failed to invoke PillarDebug");
	}

	delay(70);

	// Logo
	SetHudSize(640, 480, FALSE);
	SetFont("ze12logo");
	HudMessageBold(s:"a"; HUDMSG_FADEINOUT, 0, 0, 320.0, 80.0, 1.0, 3.0, 2.0);
}

script "OnOpen" open
{
	Delay(const: 1);

	// Resists
	// TODO: Support the additional parameter?
	Resist::CreateResist(20, "\cjActivating eastern Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(20, "\cjActivating northern Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(20, "\cjActivating western Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(20, "\cjActivating southern Beacon", "\cc%t"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(30, "\cjOpening pyramid", "\ccResist for \cd%t \ccseconds"); //, RESISTTYPEFADEOUT);
	Resist::CreateResist(40, "\cjReach the burial chamber", "%t \ciseconds left"); //, RESISTTYPEPLAIN);

	// TODO: Support
    //SetGlobalZombieTeleports(1);

	// Determine the game to run.
	// In a developmental environment, this can instead be done with switches which will be available.
	if (Environment::IsDevelopment())
	{
		Logger::LogBold("Please press one of the switches in order to choose the game.");
	}
	else
	{
		if (Random(0, 8) == 8) {
			SetNonLinearGame();
		}
		else
		{
			SetLinearGame(Random(0, 5) >= 1);
		}

		Floor_LowerToLowest(43, 999);
	}

	// Scrolling of the quicksand.
	// These are specific angles.
	Scroll_Floor(48, -15, -80, SCROLL_AND_CARRY);
	Scroll_Floor(49, -80, -80, SCROLL_AND_CARRY);
	Scroll_Floor(50, -80, -15, SCROLL_AND_CARRY);
	Scroll_Floor(51, -80,  15, SCROLL_AND_CARRY);
	Scroll_Floor(52, -80,  80, SCROLL_AND_CARRY);
	Scroll_Floor(53, -15,  80, SCROLL_AND_CARRY);
	Scroll_Floor(54,  15,  80, SCROLL_AND_CARRY);
	Scroll_Floor(55,  80,  80, SCROLL_AND_CARRY);
	Scroll_Floor(56,  80,  15, SCROLL_AND_CARRY);
	Scroll_Floor(57,  80, -15, SCROLL_AND_CARRY);
	Scroll_Floor(58,  80, -80, SCROLL_AND_CARRY);
	Scroll_Floor(59,  15, -80, SCROLL_AND_CARRY);

	// Unset the beam opacity to appear later.
	TranslucentLine(1, 0);
	TranslucentLine(2, 0);
	TranslucentLine(3, 0);
	TranslucentLine(5, 0);
}

// Switch used to set the game type in development mode.
script "SwitchSetGame"(int game)
{
	if (!Environment::IsDevelopment())
		terminate;

	if (mapGameType != 0)
	{
		terminate;
	}

	if (game == 1)
	{
		SetLinearGame(false);
	}
	else if (game == 2)
	{
		SetLinearGame(true);
	}
	else
	{
		SetNonLinearGame();
	}

	Floor_LowerToLowest(43, 999);
}

script "StartTrigger" (void) CLIENTSIDE
{
	static bool _startTriggerRun;
	if (_startTriggerRun) {
		terminate;
	}

	_startTriggerRun = true;
	SetActivator(-1);
	ClearLineSpecial();

	Music::SetDefaultMusic("d_egypt2");
    Music::PlayDefaultMusic();

	delay(18);

	int stayTime = BCSUtils::cond(mapGameType == GAMETYPE_LINEAR, 3.75, 5.75);

	SetHudSize(640, 480, FALSE);
    SetFont("smallfont");
    HudMessage(s:"You must activate all four pillars"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 42.0, stayTime + 0.25, 1.0, 0.5);
	delay(9);
	HudMessage(s:"on each cardinal direction in order to open the pyramid"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, 52.0, stayTime, 1.0, 0.5);

	delay(35 * 2);
	if (mapGameType == GAMETYPE_QUICKLINEAR)
	{
		HudMessage(s:"You're in luck! Some of the pillars are already active."; HUDMSG_FADEOUT, 0, CR_GREEN, 320.0, 62.0, 4.5, 0.5);
	}
	if (mapGameType == GAMETYPE_NONLINEAR)
	{
		HudMessage(s:"The desert is in your favour. You can freely move to any pillar!"; HUDMSG_FADEOUT, 0, CR_GREEN, 320.0, 62.0, 4.5, 0.5);
	}
}

// The general function to activate a beacon.
// If silent is `true`, do not play the ambient sound.
function void TriggerBeaconActive (int tag, bool silent)
{
	TranslucentLine(tag, 128, true);

	if (!silent) {
		AmbientSound("world/beaconactive", 127);
	}

	if (!IsNetworkGame())
	{
		TriggerBeaconActiveClient(tag);
	}

	// Open up the pillar if all four are activated.
	// The quick game type will have a seperate resist first.
	if (GetPillarsDoneCount() == 4 && mapGameType != GAMETYPE_QUICKLINEAR)
	{
		floor_lowerinstant(28, 0, 2048);
		ceiling_lowerinstant(28, 0, 2048);
		ACS_NamedExecute("PyramidOpened", 0);
	}
}

function void TriggerBeaconActiveClient (int tag)
{
	Thing_Activate(tag);

	// Activate the Light flare at the pyramid with the first finished beacon.
	if (GetPillarsDoneCount() == 1) {
		Thing_Activate(4);
	}
}

// Enables the zombie teleports after 10 seconds, and the shortcut after another 5 seconds. Called after the last pillar was activated.
script "PyramidOpened"(void)
{
	Delay(35 * 3);

	SetHudSize(640, 480, FALSE);
	AmbientSound("world/reveal", 127);
	HudMessageBold(s:"The top into the pyramid has been opened."; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, 50.0, 2.0, 0.5);

	delay(35 * 7);

	// TODO: Support
	//SetZombieTeleportSpotTid(8);
	//LogMessageToHumans("Zombies can now teleport to the pyramid entrance.");
	//LogMessageToZombies("You can now teleport to the pyramid entrance.");

	delay (35*5);

	floor_LowerByValue(33, 16, 112);
	Logger::LogBold("A shortcut has been opened north of the beacon for anyone left behind.");
}

// Resist to open the pyramid.
// Specific to the quick linear game type.
script "OpenPyramidResist" (void)
{
	if(mapGameType != GAMETYPE_QUICKLINEAR) {
		terminate;
	}

    static bool hasRun;
	if (hasRun) {
		terminate;
	}
	hasRun = true;

    SetActivator(-1);
	Delay(Resist::StartResistByIndex(4));

    floor_lowerinstant(28, 0, 2048);
	ceiling_lowerinstant(28, 0, 2048);


	SetHudSize(640, 480, FALSE);
	AmbientSound("world/reveal", 127);
	HudMessageBold(s:"The top into the pyramid has been opened."; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, 50.0, 2.0, 0.5);
}

// Small teleport script that fixes the fade inside the pyramid for software users, disables the wind sound and also disables the pillar icons.
script "EnterPyramid" (void) clientside
{
	if(ConsolePlayerNumber() != PlayerNumber()) {
		terminate;
	}

	// TODO: Won't stop the wind sound.
	StopSound(0, CHAN_UI);
	SoundVolume(0, CHAN_UI, 0.0);

	if (!BCSUtils::IsOpenGL())
	{
		for(int i=0; i<999; ++i)
        {
            Light_RaiseByValue(i, 80);
            sector_setfade(i, 0, 0, 0);
        }
	}
}

function int GetPillarsDoneCount(void)
{
	return pillarDone[0] + pillarDone[1] + pillarDone[2] + pillarDone[3];
}

Script "FinalResist" (void)
{
    SetActivator(-1);

    int y = 40.0;

	SetHudSize(640, 480, FALSE);
	SetFont("BIGFONT");
	HudMessageBold(s:"A curse is about to befall the area!"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, y, 0.5, 0.5);
	HudMessageBold(s:"Take shelter in the Pharaoh's burial chamber!"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, y+15.0, 0.5, 0.5);
	delay(18);
	HudMessageBold(s:"A curse is about to befall the area!"; HUDMSG_FADEINOUT, 0, CR_RED, 320.0, y, 0.0, 0.5, 0.5);
	HudMessageBold(s:"Take shelter in the Pharaoh's burial chamber!"; HUDMSG_FADEINOUT, 0, CR_RED, 320.0, y+15.0, 0.0, 0.5, 0.5);
	delay(18);
	HudMessageBold(s:"A curse is about to befall the area!"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, y, 2.0, 0.5, 0.5);
	HudMessageBold(s:"Take shelter in the Pharaoh's burial chamber!"; HUDMSG_FADEINOUT, 0, CR_WHITE, 320.0, y+15.0, 2.0, 0.5, 0.5);
    Delay(35*3);
    ACS_NamedExecute("FinalMusic",0,0,0,0);
	Delay(Resist::StartResistByIndex(5));
	Generic_Ceiling(31, 16, 128, 5, 16);
	tagwait(31);
	delay(35);
    SetFont("BIGFONT");
    HudMessageBold(s:"The curse is here"; HUDMSG_FADEOUT, 0, CR_WHITE, 320.0, y, 5.0, 3.0);
    Delay(35);
	for (int i = 0; i < BCSUtils::MAX_PLAYERS; ++i) {
		if (Game::GetPlayerIsSafe(i) || !PlayerInGame(i)) {
			continue;
		}

		NamedExecuteClientScript("DeathQuake", i);
	}

	delay(35*4+18);
    Game::KillUnsafePlayers();
}

// The earthquake to trigger on clients that did not make it.
script "DeathQuake" (void) {
	FadeTo(0, 0, 0, 1.0, 4.0);
	for (int i = 1; i < 4; i++) {
		Radius_Quake2(ActivatorTID(), i, 35, 0, 1, "");
		delay(35);
	}

	Radius_Quake2(ActivatorTID(), i, 35, 0, 1, "");
	delay(35*2);
	FadeTo(0, 0, 0, 0.0, 1.0);
}

// Called just before the final resist.
// Handles setting the map's state which is useful for the final music to run properly.
Script "FinalMusic" (void)
{
    Delay(525);
	SyncMapState(MAPSTATE_ENDING);
    Delay(1100);
	SyncMapState(MAPSTATE_ENDED);
}

// Runs clientside on players to avoid issues with the music cutting of prematurely.
script "FinalMusicLoop" (void) clientside
{
	SetActivator(-1);
	if (mapState != MAPSTATE_ENDING)
	{
		delay(const: 1);
		restart;
	}

	Music::SetMusic("d_egypt3", 0);
    Delay(1225);
	Music::SetMusic("", 0);
}

