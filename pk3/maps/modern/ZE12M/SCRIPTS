#define SYNC_GAMETYPE 100
#define SYNC_MAPPROGRESSSTATE 101
#define SYNC_PILLARSTATE 102

internal enum MapGameTypeT
{
	GAMETYPE_LINEAR,
	GAMETYPE_QUICKLINEAR,
	GAMETYPE_NONLINEAR,
};

internal enum MapProgressStateT
{
	STATE_NONE,
	STATE_PLAYINGOUTSIDE,
	STATE_PLAYINGINSIDE,
	STATE_ENDING,
	STATE_ENDED,
};

