// Synchronizes the current active pillars with clients.
function void SyncActivePillars(void)
{
	if (IsNetworkGame())
	{
		return;
	}

	int value = BCSUtils::PackBytes(pillarDone[0], pillarDone[1], pillarDone[2], pillarDone[3]);
	BCSUtils::SyncVariable(SYNC_PILLARSTATE, value);

	// Receive on all clients.
	if (!ACS_NamedExecuteAlways("SyncActivePillars_Client", 0)) {
		Logger::LogError(LOGSOURCE, "Failed to execute SyncBaseTID_Client.");
	}
}

script "SyncActivePillars_Client"(void) clientside
{
	ClientSyncActivePillars();
}

// Called clientside to synchronize the active pillars.
function void ClientSyncActivePillars(void)
{
	int value = BCSUtils::GetSyncVarDefault(SYNC_PILLARSTATE, 0);
	if (!pillarDone[0] && BCSUtils::UnpackByte1(value)) {
		pillarDone[0] = true;
		TriggerBeaconActiveClient(pillarTids[0]);
	}
	if (!pillarDone[1] && BCSUtils::UnpackByte2(value)) {
		pillarDone[1] = true;
		TriggerBeaconActiveClient(pillarTids[1]);
	}
	if (!pillarDone[2] && BCSUtils::UnpackByte3(value)) {
		pillarDone[2] = true;
		TriggerBeaconActiveClient(pillarTids[2]);
	}
	if (!pillarDone[3] && BCSUtils::UnpackByte4(value)) {
		pillarDone[3] = true;
		TriggerBeaconActiveClient(pillarTids[3]);
	}

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced active pillars to client: ", d:value, s:"."));
}

