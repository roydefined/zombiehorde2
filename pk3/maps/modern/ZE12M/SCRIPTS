// Synchronizes the current active pillars with clients.
internal void SyncActivePillars()
{
	VALIDATE_IS_SERVERSIDE_FUNCTION();

	if (!IsNetworkGame())
		return;

	int value = BCSUtils::PackBytes(_pillarDone[0], _pillarDone[1], _pillarDone[2], _pillarDone[3]);
	BCSUtils::SyncVariable(SYNC_PILLARSTATE, value);

	ACS_NamedExecuteAlways("SyncActivePillars_Client", 0);
}

script "SyncActivePillars_Client" clientside
{
	ClientSyncActivePillars();
}

// Called clientside to synchronize the active pillars.
internal void ClientSyncActivePillars()
{
	VALIDATE_IS_CLIENTSIDE_FUNCTION();

	if (!IsNetworkGame())
		return;

	int value = BCSUtils::GetSyncVarDefault(SYNC_PILLARSTATE, 0);
	_pillarDone[0] = BCSUtils::UnpackByte1(value);
	_pillarDone[1] = BCSUtils::UnpackByte2(value);
	_pillarDone[2] = BCSUtils::UnpackByte3(value);
	_pillarDone[3] = BCSUtils::UnpackByte4(value);

	if (_pillarDone[0])
		ActivateBeaconClient(0);

	if (_pillarDone[1])
		ActivateBeaconClient(1);

	if (_pillarDone[2])
		ActivateBeaconClient(2);

	if (_pillarDone[3])
		ActivateBeaconClient(3);

	Logger::LogDebug(LOGSOURCE, StrParam(s:"Synced active pillars to client: ", d:_pillarDone[0], s:", ", d:_pillarDone[1], s:", ", d:_pillarDone[2], s:", ", d:_pillarDone[3], s:"."));
}

#undef LOGSOURCE
