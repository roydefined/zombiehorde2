#pragma raw include on
#pragma raw define on

#import "zcommon.bcs"
#import "acs_source/bcsutils.acs"

#include "acs_source/zh2lib.h.acs"
#include "acs_source/zh2game.h.acs"

script "Map_Start" open
{
	Resist::CreateResist(10, "Lowering walls", "Resist for %t seconds");
	Resist::CreateResist(10, "Removing wall", "Resist for %t seconds");
	Resist::CreateResist(10, "Shutting down simulation", "Escape in %t seconds");
}

script "Teste_map_start_resist_index" (int index)
{
	switch(index)
	{
		case 0:
			Delay(Resist::StartResistByIndex(0));
			Floor_MoveToValue(1, 10, 24);
			break;
		case 1:
			Delay(Resist::StartResistByIndex(1));
			Floor_RaiseByValue(3, 100, 136);
			Ceiling_LowerByValue(3, 100, 136);
			break;
		case 2:
			Delay(Resist::StartResistByIndex(2));
			Ceiling_LowerAndCrush(2, 10, 999);
			Tagwait(2);
			Game::KillUnsafePlayers();
			break;
	}
}